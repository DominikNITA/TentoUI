@namespace TentoUI.Docs.Components

<div class="mt-8 space-y-3">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>@Title</span>
            <span class="text-xs font-normal text-slate-400">API Reference</span>
        </h3>
    }

    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 uppercase tracking-wider font-semibold text-[11px]">
                <tr>
                    <th class="py-3 px-4">Property</th>
                    <th class="py-3 px-4">Description</th>
                    <th class="py-3 px-4">Type</th>
                    <th class="py-3 px-4">Default</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-normal text-slate-700 dark:text-slate-300">
                @if (Properties != null)
                {
                    @foreach (var prop in Properties)
                    {
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="py-3 px-4 font-mono font-semibold text-primary-600 dark:text-primary-400">
                                @prop.Property
                            </td>
                            <td class="py-3 px-4 leading-relaxed max-w-md">
                                @prop.Description
                            </td>
                            <td class="py-3 px-4 font-mono text-purple-600 dark:text-purple-400">
                                <span class="px-1.5 py-0.5 rounded bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800 text-[11px]">
                                    @prop.Type
                                </span>
                            </td>
                            <td class="py-3 px-4 font-mono text-slate-500 dark:text-slate-400">
                                @if (!string.IsNullOrEmpty(prop.Default))
                                {
                                    <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[11px]">
                                        @prop.Default
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-300 dark:text-slate-600">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    public record ApiProp(string Property, string Description, string Type, string? Default = null);

    [Parameter] public string? Title { get; set; }
    [Parameter] public IEnumerable<ApiProp>? Properties { get; set; }
}
