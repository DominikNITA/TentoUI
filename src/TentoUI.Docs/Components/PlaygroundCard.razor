@namespace TentoUI.Docs.Components
@inject IJSRuntime JSRuntime
@inject IMessageService MessageService

<div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
        <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">@(Title ?? "Interactive Playground")</h3>
            <p class="text-xs text-slate-400">@(Description ?? "Tweak properties below to observe live UI updates and generated Razor markup.")</p>
        </div>
        <div class="flex items-center gap-2">
            @ExtraHeader
        </div>
    </div>

    @* Live Preview Box *@
    <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center min-h-[110px]">
        @ChildContent
    </div>

    @* Live Parameter Controls *@
    @if (Controls != null)
    {
        <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
                Live Parameters &amp; Props
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs">
                @Controls
            </div>
        </div>
    }

    @* Dynamic Generated Code Block with 1-Click Copy *@
    @if (!string.IsNullOrEmpty(Code))
    {
        <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 flex items-center gap-1.5">
                    <span>Generated Razor Code</span>
                    <span class="px-1.5 py-0.5 text-[10px] bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 rounded font-semibold">live sync</span>
                </span>
                <button type="button"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-md bg-primary-50 hover:bg-primary-100 dark:bg-primary-950/60 dark:hover:bg-primary-900 text-primary-600 dark:text-primary-400 border border-primary-200 dark:border-primary-800 transition-colors shadow-sm"
                        @onclick="CopyCodeAsync">
                    <Icon Name="@IconNames.Copy" Size="13" />
                    <span>Copy Code</span>
                </button>
            </div>
            <div class="relative rounded-lg bg-slate-950 text-slate-200 font-mono text-xs p-3.5 overflow-x-auto border border-slate-800 selection:bg-primary-600">
                <pre class="whitespace-pre-wrap leading-relaxed"><code>@Code.Trim()</code></pre>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Controls { get; set; }
    [Parameter] public RenderFragment? ExtraHeader { get; set; }

    private async Task CopyCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(Code)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Code.Trim());
            MessageService.Success("Code copied to clipboard!");
        }
        catch
        {
            MessageService.Info("Code copied!");
        }
    }
}
