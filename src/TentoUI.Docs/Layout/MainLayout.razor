@namespace TentoUI.Docs.Layout
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject VersionService VersionService
@inject NavigationManager NavigationManager
@implements IDisposable

<TentoConfigProvider Theme="@_theme" ComponentSize="@_componentSize">
    <div class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans"
         @onkeydown="HandleGlobalKeyDown">
        @* Cross-Version Status Banner when viewing Preview or Legacy docs *@
        @if (!VersionService.CurrentVersion.IsLatest)
        {
            <div role="status"
                 class="tento-version-banner px-4 py-1.5 text-xs font-medium flex flex-wrap items-center justify-center gap-2 border-b @(VersionService.CurrentVersion.IsPreview ? "bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-800" : "bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700")">
                <span>
                    @if (VersionService.CurrentVersion.IsPreview)
                    {
                        <strong>Preview Documentation (@VersionService.CurrentVersion.Label):</strong>
                        <span>You are viewing pre-release documentation for the upcoming release.</span>
                    }
                    else
                    {
                        <strong>Archived Documentation (@VersionService.CurrentVersion.Label):</strong>
                        <span>You are viewing an older version of TentoUI documentation.</span>
                    }
                </span>
                <button type="button"
                        class="underline font-bold hover:opacity-80 cursor-pointer ml-1"
                        @onclick="SwitchToLatestVersion">
                    Switch to Latest Stable (@(VersionService.AvailableVersions.FirstOrDefault(v => v.IsLatest)?.Label ?? "Latest")) →
                </button>
            </div>
        }

        @* Top Navigation Header *@
        <header class="h-16 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-40 px-4 sm:px-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <button type="button"
                        class="md:hidden p-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800"
                        aria-label="Toggle navigation"
                        @onclick="@(() => _mobileNavOpen = !_mobileNavOpen)">
                    <Icon Name="@IconNames.Menu" Size="20" />
                </button>

                <a href="" class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-primary-600 to-fuchsia-400 flex items-center justify-center text-white shadow-md shadow-primary-500/20 font-bold text-lg">
                        T
                    </div>
                    <span class="font-extrabold text-base tracking-tight text-slate-900 dark:text-white">
                        Tento<span class="text-primary-600 dark:text-primary-400">UI</span>
                    </span>
                </a>

                <div class="ml-1 sm:ml-2">
                    <VersionSelector />
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-2.5">
                @* Command Palette Search Trigger *@
                <button type="button"
                        aria-label="Open command palette"
                        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400 hover:border-primary-400 transition-colors cursor-pointer"
                        @onclick="@(() => _commandPaletteOpen = true)">
                    <Icon Name="@IconNames.Search" Size="13" />
                    <span>Quick Search...</span>
                    <kbd class="ml-2 px-1.5 py-0.2 text-[10px] font-mono font-semibold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded">
                        Ctrl K
                    </kbd>
                </button>

                @* Showcase Portal Link *@
                <a href="showcase"
                   class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary-50 dark:bg-primary-950/60 hover:bg-primary-100 dark:hover:bg-primary-900/60 text-primary-700 dark:text-primary-300 border border-primary-200 dark:border-primary-800 inline-flex items-center gap-1.5 transition-colors">
                    <Icon Name="@IconNames.Eye" Size="13" />
                    <span class="hidden sm:inline">Showcases</span>
                    <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-primary-600 text-white">Live</span>
                </a>

                @* Theme Customizer Trigger *@
                <button type="button"
                        aria-label="Open theme customizer"
                        class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 inline-flex items-center gap-1.5 transition-colors cursor-pointer"
                        @onclick="@(() => _themeDrawerOpen = true)">
                    <Icon Name="@IconNames.Settings" Size="14" />
                    <span class="hidden lg:inline">Theme</span>
                </button>

                @* Dark / Light mode toggle *@
                <button type="button"
                        class="p-2 rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                        aria-label="Toggle color mode"
                        @onclick="ToggleDarkModeAsync">
                    <Icon Name="@(_theme.DarkMode ? IconNames.Sun : IconNames.Moon)" Size="18" />
                </button>

                @* GitHub link *@
                <a href="https://github.com/DominikNITA/TentoUI"
                   target="_blank"
                   rel="noreferrer"
                   class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 inline-flex items-center gap-1.5 transition-colors">
                    <Icon Name="@IconNames.ExternalLink" Size="13" />
                    <span class="hidden sm:inline">GitHub</span>
                </a>
            </div>
        </header>

        @* Body Content with Sidebar and Right TOC *@
        <div class="flex-1 flex max-w-[96rem] 2xl:max-w-[104rem] w-full mx-auto px-2 sm:px-4 lg:px-6">
            @* Desktop Sidebar *@
            <aside class="hidden md:block w-64 shrink-0 sticky top-16 h-[calc(100vh-4rem)]">
                <NavMenu />
            </aside>

            @* Mobile Drawer Sidebar *@
            @if (_mobileNavOpen)
            {
                <div class="md:hidden fixed inset-0 z-50 flex" @onclick="@(() => _mobileNavOpen = false)">
                    <div class="fixed inset-0 bg-black/40 backdrop-blur-xs"></div>
                    <div class="relative w-72 max-w-[80vw] h-full bg-white dark:bg-slate-900 shadow-2xl z-10" @onclick:stopPropagation="true">
                        <NavMenu />
                    </div>
                </div>
            }

            @* Main Content Area *@
            <main class="flex-1 min-w-0 px-4 py-6 sm:px-8 sm:py-8 lg:px-10">
                @Body
            </main>

            @* Right-side Table of Contents *@
            <TableOfContents />
        </div>

        @* Global Footer *@
        <footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60 py-6 px-4 sm:px-6">
            <div class="max-w-[96rem] 2xl:max-w-[104rem] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center gap-2">
                    <span class="font-bold text-slate-800 dark:text-slate-200">TentoUI</span>
                    <span>&bull;</span>
                    <span>Clean, accessible Blazor components styled with Tailwind CSS v4</span>
                    <span>&bull;</span>
                    <span>MIT License</span>
                </div>
                <div class="flex items-center gap-4">
                    <a href="https://github.com/DominikNITA/TentoUI"
                       target="_blank"
                       rel="noreferrer"
                       class="hover:text-primary-600 dark:hover:text-primary-400 inline-flex items-center gap-1.5 transition-colors">
                        <Icon Name="@IconNames.ExternalLink" Size="13" />
                        <span>GitHub Repository</span>
                    </a>
                </div>
            </div>
        </footer>

        @* Global Command Palette *@
        <CommandPalette @bind-Open="_commandPaletteOpen"
                        Placeholder="Jump to any component, guide, or showcase..."
                        Items="@CommandItems"
                        OnSelect="HandleCommandSelect" />

        @* Live Theme Customizer Drawer *@
        <ThemeCustomizerDrawer @bind-Open="_themeDrawerOpen"
                               Theme="@_theme"
                               @bind-ComponentSize="_componentSize"
                               OnThemeUpdated="StateHasChanged" />

        @* Global Feedback Hosts *@
        <MessageHost />
        <NotificationHost />
        <ModalHost />
    </div>
</TentoConfigProvider>

@code {
    private readonly TentoTheme _theme = new();
    private ComponentSize _componentSize = ComponentSize.Middle;
    private bool _mobileNavOpen;
    private bool _commandPaletteOpen;
    private bool _themeDrawerOpen;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private IReadOnlyList<CommandItem> CommandItems =>
        NavMenu.AllSections
            .SelectMany(section => section.Items.Select(item => new CommandItem(
                Key: item.Href,
                Title: item.Label,
                Category: section.Title,
                Subtitle: string.IsNullOrEmpty(item.Href) ? "/" : $"/{item.Href}",
                Icon: section.Title == "Showcases" ? IconNames.Eye : IconNames.File,
                Shortcut: item.Tag,
                Href: item.Href)))
            .ToList();

    protected override void OnInitialized()
    {
        VersionService.OnVersionChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("tentoCommandPalette.registerCallback", _dotNetRef, nameof(ToggleCommandPalette));
            }
            catch
            {
                // Ignored if JS Interop unavailable
            }
        }
    }

    [JSInvokable]
    public void ToggleCommandPalette()
    {
        _commandPaletteOpen = !_commandPaletteOpen;
        StateHasChanged();
    }

    private void SwitchToLatestVersion()
    {
        VersionService.SwitchToLatest();
    }

    private void HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && string.Equals(e.Key, "k", StringComparison.OrdinalIgnoreCase))
        {
            _commandPaletteOpen = !_commandPaletteOpen;
        }
    }

    private void HandleCommandSelect(CommandItem item)
    {
        if (item.Href != null)
        {
            NavigationManager.NavigateTo(item.Href);
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _theme.DarkMode = !_theme.DarkMode;
        try
        {
            if (_theme.DarkMode)
            {
                await JSRuntime.InvokeVoidAsync("document.documentElement.classList.add", "dark");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("document.documentElement.classList.remove", "dark");
            }
        }
        catch { }
    }

    public void Dispose()
    {
        VersionService.OnVersionChanged -= StateHasChanged;
        _dotNetRef?.Dispose();
    }
}
