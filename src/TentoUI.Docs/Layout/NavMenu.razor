    private IEnumerable<NavSection> FilteredSections
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm)) return AllSections;
            return AllSections
                .Select(s => new NavSection(s.Title, s.Items.Where(i => i.Label.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToArray()))
                .Where(s => s.Items.Length > 0);
        }
    }
