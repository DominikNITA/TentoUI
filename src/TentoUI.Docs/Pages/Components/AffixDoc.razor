@page "/components/affix"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Affix - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Affix</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Pins an element or toolbar to a fixed position at the top or bottom of the viewport during page scrolling.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Test pinning offset and child action button.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40">
            <Affix OffsetTop="_offsetTop">
                <Button Type="ButtonType.Primary">
                    Pinned Button (OffsetTop: @_offsetTop px)
                </Button>
            </Affix>
        </div>

        <div class="max-w-xs text-xs">
            <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Offset Top (px)</label>
            <input type="number"
                   min="0"
                   max="200"
                   step="10"
                   class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                   @bind="_offsetTop" />
        </div>
    </div>

    <ApiTable Title="Affix Properties" Properties="@_props" />
</div>

@code {
    private int? _offsetTop = 20;

    private readonly ApiProp[] _props =
    [
        new("OffsetTop", "Pixels from top of viewport to trigger sticky affix.", "int?", "0"),
        new("OffsetBottom", "Pixels from bottom of viewport to trigger sticky affix.", "int?", "null"),
        new("ChildContent", "Element to affix.", "RenderFragment?", "null")
    ];
}
