@page "/components/affix"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Affix - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Affix</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Pins an element or toolbar to a fixed position at the top or bottom of the viewport during page scrolling.
        </p>
    </div>

    @* Example 1: Basic Affix (Top Offset) *@
    <DemoCard Title="Affix Top Offset" Description="Fixes an action button when scrolling beyond the specified pixel offset." Code="@_topCode">
        <div class="p-4">
            <Affix OffsetTop="20">
                <Button Type="ButtonType.Primary">
                    Pinned Button (OffsetTop: 20px)
                </Button>
            </Affix>
        </div>
    </DemoCard>

    @* Example 2: Affix Bottom *@
    <DemoCard Title="Affix Bottom Offset" Description="Fixes a floating status bar near the bottom of the visible viewport." Code="@_bottomCode">
        <div class="p-4">
            <Affix OffsetBottom="20">
                <Button Type="ButtonType.Default">
                    Pinned to Bottom (OffsetBottom: 20px)
                </Button>
            </Affix>
        </div>
    </DemoCard>

    <ApiTable Title="Affix Properties" Properties="@_props" />
</div>

@code {
    private const string _topCode = """
        <Affix OffsetTop="20">
            <Button Type="ButtonType.Primary">Pinned Button (OffsetTop: 20px)</Button>
        </Affix>
        """;

    private const string _bottomCode = """
        <Affix OffsetBottom="20">
            <Button Type="ButtonType.Default">Pinned to Bottom (OffsetBottom: 20px)</Button>
        </Affix>
        """;

    private readonly ApiProp[] _props =
    [
        new("OffsetTop", "Pixels from top of viewport to trigger sticky affix.", "int?", "0"),
        new("OffsetBottom", "Pixels from bottom of viewport to trigger sticky affix.", "int?", "null"),
        new("ChildContent", "Element to affix.", "RenderFragment?", "null")
    ];
}