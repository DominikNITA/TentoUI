@page "/components/alert"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Alert - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Alert</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Alert component for displaying important feedback messages with colored accents, dismiss buttons, and descriptions.
        </p>
    </div>

    @* Example 1: 4 Alert Types *@
    <DemoCard Title="Alert Types" Description="Four semantic types: Success, Info, Warning, and Error with clean vertical separation." Code="@_typesCode">
        <div class="flex flex-col gap-4 w-full">
            <Alert Type="AlertType.Success" Message="Success Text" ShowIcon="true" />
            <Alert Type="AlertType.Info" Message="Informational Notes" ShowIcon="true" />
            <Alert Type="AlertType.Warning" Message="Warning: Your subscription renews soon" ShowIcon="true" />
            <Alert Type="AlertType.Error" Message="Error: Failed to connect to payment gateway" ShowIcon="true" />
        </div>
    </DemoCard>

    @* Example 2: With Description *@
    <DemoCard Title="With Detailed Description" Description="Alerts can display secondary descriptions for detailed context." Code="@_descCode">
        <div class="flex flex-col gap-4 w-full">
            <Alert Type="AlertType.Success"
                   Message="Order Processed Successfully"
                   Description="Your payment has been cleared and invoice #2026-992 was sent to your email."
                   ShowIcon="true"
                   Closable="true" />
            <Alert Type="AlertType.Warning"
                   Message="Security Recommendation"
                   Description="You have not enabled multi-factor authentication yet. We strongly advise setting it up."
                   ShowIcon="true" />
        </div>
    </DemoCard>

    @* Example 3: Closable and Banner *@
    <DemoCard Title="Closable &amp; Banner Mode" Description="Dismissible alerts with close callbacks and banner mode for top announcements." Code="@_closableCode">
        <div class="flex flex-col gap-4 w-full">
            <Alert Type="AlertType.Info"
                   Message="System Maintenance Scheduled"
                   Description="Platform will undergo scheduled updates on Sunday from 02:00 to 04:00 UTC."
                   Closable="true"
                   OnClose="@(() => MessageService.Info("Alert closed"))" />
            <Alert Type="AlertType.Warning"
                   Banner="true"
                   Message="Notice: Running in preview sandbox mode" />
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Alert Properties" ComponentType="@typeof(Alert)" />
</div>

@code {
    private const string _typesCode = """
        <div class="flex flex-col gap-4 w-full">
            <Alert Type="AlertType.Success" Message="Success Text" ShowIcon="true" />
            <Alert Type="AlertType.Info" Message="Informational Notes" ShowIcon="true" />
            <Alert Type="AlertType.Warning" Message="Warning: Your subscription renews soon" ShowIcon="true" />
            <Alert Type="AlertType.Error" Message="Error: Failed to connect to payment gateway" ShowIcon="true" />
        </div>
        """;

    private const string _descCode = """
        <div class="flex flex-col gap-4 w-full">
            <Alert Type="AlertType.Success"
                   Message="Order Processed Successfully"
                   Description="Your payment has been cleared and invoice #2026-992 was sent to your email."
                   ShowIcon="true"
                   Closable="true" />
            <Alert Type="AlertType.Warning"
                   Message="Security Recommendation"
                   Description="You have not enabled multi-factor authentication yet."
                   ShowIcon="true" />
        </div>
        """;

    private const string _closableCode = """
        <div class="flex flex-col gap-4 w-full">
            <Alert Type="AlertType.Info"
                   Message="System Maintenance Scheduled"
                   Description="Platform updates on Sunday from 02:00 to 04:00 UTC."
                   Closable="true"
                   OnClose="@HandleClose" />
            <Alert Type="AlertType.Warning"
                   Banner="true"
                   Message="Notice: Running in preview sandbox mode" />
        </div>
        """;
}