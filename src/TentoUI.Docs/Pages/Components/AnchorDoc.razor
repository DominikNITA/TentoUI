@page "/components/anchor"
@page "/v1.0/components/anchor"
@page "/v0.9/components/anchor"
@page "/next/components/anchor"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Anchor - TentoUI</PageTitle>

<div class="space-y-8 max-w-5xl">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-2">Anchor</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">
            In-page table-of-contents navigation with active indicator bar and hierarchical <code class="font-mono text-primary-600 dark:text-primary-400">AnchorLink</code> items for jumping between document sections.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Anchor Interactive Playground"
                     ComponentTag="Anchor"
                     Controls="@_playgroundControls" />

    <!-- Interactive Split-Pane Document + Anchor Sidebar -->
    <DemoCard Title="Document Navigation with Nested AnchorLinks"
              Description="Click any AnchorLink on the left to highlight it and jump to the corresponding section inside the scrollable article panel."
              Code="@_anchorCode">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/50 p-4">
            <div class="md:col-span-4 border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 pr-4">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-3">On This Page</div>
                <Anchor Affix="false">
                    <AnchorLink Href="#anchor-intro" Title="1. Introduction" />
                    <AnchorLink Href="#anchor-tokens" Title="2. Design Tokens">
                        <AnchorLink Href="#anchor-colors" Title="2.1 Color Palette" />
                        <AnchorLink Href="#anchor-radius" Title="2.2 Border Radius" />
                    </AnchorLink>
                    <AnchorLink Href="#anchor-a11y" Title="3. Accessibility" />
                    <AnchorLink Href="#anchor-ssr" Title="4. Blazor SSR & WASM" />
                </Anchor>
            </div>

            <div class="md:col-span-8 h-80 overflow-y-auto scroll-smooth space-y-6 pr-2">
                <section id="anchor-intro" class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">1. Introduction</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        TentoUI provides 75+ enterprise Blazor components built on Tailwind CSS v4 and semantic CSS custom properties. Use Anchor on documentation or settings pages so users can jump directly to any section.
                    </p>
                </section>

                <section id="anchor-tokens" class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">2. Design Tokens</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        All visual surfaces reference CSS variables scoped by TentoConfigProvider, enabling instant runtime switching between Light and Dark themes.
                    </p>
                    <div id="anchor-colors" class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700">
                        <div class="text-xs font-semibold text-primary-600 dark:text-primary-400">2.1 Color Palette</div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                            Primary shades (50–950) are automatically derived in CSS via color-mix(in srgb, ...).
                        </p>
                    </div>
                    <div id="anchor-radius" class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700">
                        <div class="text-xs font-semibold text-primary-600 dark:text-primary-400">2.2 Border Radius</div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                            Configure BorderRadius globally on TentoTheme to shift between sharp, rounded, or pill aesthetics.
                        </p>
                    </div>
                </section>

                <section id="anchor-a11y" class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">3. Accessibility</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        Every interactive component is verified against WCAG 2.1 AA keyboard navigation and ARIA role contracts.
                    </p>
                </section>

                <section id="anchor-ssr" class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">4. Blazor SSR &amp; WASM</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        Works seamlessly across Blazor WebAssembly, Interactive Server, and Auto render modes in .NET 10.
                    </p>
                </section>
            </div>
        </div>
    </DemoCard>

    <ApiTable Title="Anchor Properties" ComponentType="@typeof(Anchor)" />

    <ApiTable Title="AnchorLink Properties" ComponentType="@typeof(AnchorLink)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
