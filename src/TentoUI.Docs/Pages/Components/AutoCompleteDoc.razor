@page "/components/autocomplete"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>AutoComplete - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">AutoComplete</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Dynamic input completion offering suggestions as the user types into the field.
            Supports inline options strings as well as strongly-typed options.
        </p>
    </div>

    @* Example 1: Email Domain Suggestions *@
    <DemoCard Title="Email AutoComplete"
              Description="Provides common email domain suffix suggestions. The options are directly visible and editable in the snippet."
              Code="@_emailCode" />

    @* Example 2: Search Terms Suggestions *@
    <DemoCard Title="Search Suggestions"
              Description="Instant keyword suggestions for searching products or documentation."
              Code="@_searchCode" />

    <ApiTable Title="AutoComplete Properties" Properties="@_props" />
</div>

@code {
    private const string _emailCode = """
        <div class="max-w-xs p-2">
            <AutoComplete Placeholder="Enter email address..."
                          OptionsString="gmail.com, outlook.com, yahoo.com, icloud.com, proton.me"
                          AllowClear="true" />
        </div>
        """;

    private const string _searchCode = """
        <div class="max-w-xs p-2">
            <AutoComplete Placeholder="Search components..."
                          OptionsString="Button, Badge, Card, Modal, Table, Tabs, Tree, Segmented"
                          AllowClear="true" />
        </div>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("OptionsString", "Comma-separated string of suggestions (e.g. 'Option 1, Option 2').", "string?", "null"),
        new("SimpleOptions", "Array or list of string suggestions.", "IEnumerable<string>?", "null"),
        new("Options", "List of strongly-typed AutoCompleteOption items.", "IEnumerable<AutoCompleteOption>?", "null"),
        new("Value", "Current text value in the input (bindable via @bind-Value).", "string?", "null"),
        new("Placeholder", "Placeholder prompt text.", "string?", "null"),
        new("AllowClear", "Whether clear button is visible.", "bool", "true"),
        new("OnSelect", "Callback invoked when a suggestion is clicked.", "EventCallback<string>", "null")
    ];
}
