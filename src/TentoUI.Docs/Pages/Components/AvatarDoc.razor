@page "/components/avatar"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Avatar - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Avatar</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Avatars can be used to represent people or objects, supporting images, icon glyphs, or initials with fallback styling.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Change shape, size, and initials dynamically.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Avatar Shape="_shape" Size="_size" Text="@_text" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Shape</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_shape">
                    <option value="@AvatarShape.Circle">Circle</option>
                    <option value="@AvatarShape.Square">Square</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Size Scale</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_size">
                    <option value="@ComponentSize.Small">Small</option>
                    <option value="@ComponentSize.Middle">Middle</option>
                    <option value="@ComponentSize.Large">Large</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Initials / Text</label>
                <input type="text"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_text"
                       @bind:event="oninput" />
            </div>
        </div>
    </div>

    @* Use Cases *@
    <DemoCard Title="Avatar Group" Description="Stack overlapping avatars with grouped boundaries." Code="@_groupCode">
        <AvatarGroup>
            <Avatar Text="AD" />
            <Avatar Text="BW" />
            <Avatar Text="CP" />
            <Avatar Text="+3" />
        </AvatarGroup>
    </DemoCard>

    <ApiTable Title="Avatar Properties" Properties="@_avatarProps" />
    <ApiTable Title="AvatarGroup Properties" Properties="@_groupProps" />
</div>

@code {
    private AvatarShape _shape = AvatarShape.Circle;
    private ComponentSize _size = ComponentSize.Large;
    private string _text = "JD";

    private const string _groupCode = @"<AvatarGroup>
    <Avatar Text=""AD"" />
    <Avatar Text=""BW"" />
    <Avatar Text=""CP"" />
    <Avatar Text=""+3"" />
</AvatarGroup>";

    private readonly ApiTable.ApiProp[] _avatarProps =
    [
        new("Shape", "Shape of avatar (Circle or Square).", "AvatarShape", "AvatarShape.Circle"),
        new("Size", "Size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Src", "Image address for image avatar.", "string?", "null"),
        new("Text", "Letter initials to display.", "string?", "null"),
        new("Icon", "Icon name to display.", "string?", "null"),
        new("Alt", "Alternative text description of image.", "string?", "null")
    ];

    private readonly ApiTable.ApiProp[] _groupProps =
    [
        new("ChildContent", "Avatar children elements.", "RenderFragment?", "null")
    ];
}
