@page "/components/avatar"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Avatar - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Avatar</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Avatars can be used to represent people or objects, supporting images, icon glyphs, or initials with fallback styling.
        </p>
    </div>

    @* Example 1: Basic Types *@
    <DemoCard Title="Avatar Types" Description="Initials, icon glyphs, and image avatars." Code="@_typesCode">
        <div class="flex items-center gap-4">
            <Avatar Text="JD" />
            <Avatar Icon="@IconNames.User" />
            <Avatar Text="Tento" />
        </div>
    </DemoCard>

    @* Example 2: Shapes & Sizes *@
    <DemoCard Title="Shapes &amp; Sizes" Description="Supports circle and square shapes across Small, Middle, and Large scales." Code="@_shapesSizesCode">
        <div class="space-y-4">
            <div class="flex items-center gap-4">
                <Avatar Size="ComponentSize.Small" Text="S" />
                <Avatar Size="ComponentSize.Middle" Text="M" />
                <Avatar Size="ComponentSize.Large" Text="L" />
            </div>
            <div class="flex items-center gap-4">
                <Avatar Shape="AvatarShape.Square" Size="ComponentSize.Small" Text="S" />
                <Avatar Shape="AvatarShape.Square" Size="ComponentSize.Middle" Text="M" />
                <Avatar Shape="AvatarShape.Square" Size="ComponentSize.Large" Text="L" />
            </div>
        </div>
    </DemoCard>

    @* Example 3: Avatar Group *@
    <DemoCard Title="Avatar Group" Description="Stack overlapping avatars with grouped boundaries." Code="@_groupCode">
        <AvatarGroup>
            <Avatar Text="AD" />
            <Avatar Text="BW" />
            <Avatar Text="CP" />
            <Avatar Text="+3" />
        </AvatarGroup>
    </DemoCard>

    <ApiTable Title="Avatar Properties" Properties="@_avatarProps" />
    <ApiTable Title="AvatarGroup Properties" Properties="@_groupProps" />
</div>

@code {
    private const string _typesCode = """
        <Avatar Text="JD" />
        <Avatar Icon="@IconNames.User" />
        <Avatar Text="Tento" />
        """;

    private const string _shapesSizesCode = """
        <Avatar Size="ComponentSize.Small" Text="S" />
        <Avatar Size="ComponentSize.Middle" Text="M" />
        <Avatar Size="ComponentSize.Large" Text="L" />

        <Avatar Shape="AvatarShape.Square" Size="ComponentSize.Small" Text="S" />
        <Avatar Shape="AvatarShape.Square" Size="ComponentSize.Middle" Text="M" />
        <Avatar Shape="AvatarShape.Square" Size="ComponentSize.Large" Text="L" />
        """;

    private const string _groupCode = """
        <AvatarGroup>
            <Avatar Text="AD" />
            <Avatar Text="BW" />
            <Avatar Text="CP" />
            <Avatar Text="+3" />
        </AvatarGroup>
        """;

    private readonly ApiTable.ApiProp[] _avatarProps =
    [
        new("Shape", "Shape of avatar (Circle or Square).", "AvatarShape", "AvatarShape.Circle"),
        new("Size", "Size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Src", "Image address for image avatar.", "string?", "null"),
        new("Text", "Letter initials to display.", "string?", "null"),
        new("Icon", "Icon name to display.", "string?", "null"),
        new("Alt", "Alternative text description of image.", "string?", "null")
    ];

    private readonly ApiTable.ApiProp[] _groupProps =
    [
        new("MaxCount", "Max number of avatars shown before truncation.", "int?", "null"),
        new("ChildContent", "Avatar children elements.", "RenderFragment?", "null")
    ];
}