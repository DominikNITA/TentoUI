@page "/components/badge"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Badge - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Badge</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Small numerical value or status descriptor for referring to unread notifications or active states.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Increment counts or toggle red dot notification modes.</p>
            </div>
            <div class="text-xs text-slate-400">
                Count: <strong class="text-primary-600 dark:text-primary-400 font-mono text-sm">@_count</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center gap-8">
            <Badge Count="_count" Dot="_dot" OverflowCount="_overflowCount">
                <div class="w-12 h-12 rounded-lg bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300">
                    <TentoUI.Icon Name="@IconNames.Bell" Size="20" />
                </div>
            </Badge>

            <div class="flex items-center gap-2">
                <Button Size="ComponentSize.Small" OnClick="@(() => _count = Math.Max(0, _count - 1))">- 1</Button>
                <Button Size="ComponentSize.Small" OnClick="@(() => _count++)">+ 1</Button>
                <Button Size="ComponentSize.Small" OnClick="@(() => _count = 120)">Set 120 (Overflow)</Button>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Max Overflow Count</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_overflowCount" />
            </div>
            <div class="flex items-center pt-5">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_dot" class="rounded text-primary-600" />
                    <span>Red Dot Only Mode</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="Badge Properties" Properties="@_props" />
</div>

@code {
    private int _count = 8;
    private int _overflowCount = 99;
    private bool _dot;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Count", "Number to show in badge.", "int?", "null"),
        new("OverflowCount", "Max count to show; counts above this will display as '{OverflowCount}+'.", "int", "99"),
        new("Dot", "Whether to display red dot badge instead of count.", "bool", "false"),
        new("ShowZero", "Whether to show badge when count is zero.", "bool", "false"),
        new("Color", "Custom background color of badge dot/pill.", "string?", "null"),
        new("Status", "Badge status dot style (Success, Processing, Default, Error, Warning).", "BadgeStatus?", "null"),
        new("Text", "Label text when status is used.", "string?", "null"),
        new("ChildContent", "Wrapped element that badge attaches to.", "RenderFragment?", "null")
    ];
}
