@page "/components/badge"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Badge - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Badge</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Small numerical value or status descriptor for referring to unread notifications or active states.
        </p>
    </div>

    @* Example 1: Basic Count Badges *@
    <DemoCard Title="Basic Count Badges" Description="Badges wrapping avatar or card elements to display unread item counts." Code="@_basicCode">
        <div class="flex items-center gap-6 p-4">
            <Badge Count="5">
                <div class="w-10 h-10 rounded-lg bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300">
                    <Icon Name="@IconNames.Inbox" Size="18" />
                </div>
            </Badge>
            <Badge Count="0" ShowZero="true">
                <div class="w-10 h-10 rounded-lg bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300">
                    <Icon Name="@IconNames.Bell" Size="18" />
                </div>
            </Badge>
        </div>
    </DemoCard>

    @* Example 2: Overflow Count *@
    <DemoCard Title="Overflow Count" Description="Displays 99+ when count exceeds the configured overflow limit." Code="@_overflowCode">
        <div class="flex items-center gap-6 p-4">
            <Badge Count="120" OverflowCount="99">
                <div class="w-10 h-10 rounded-lg bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300">
                    <Icon Name="@IconNames.Bell" Size="18" />
                </div>
            </Badge>
            <Badge Count="1000" OverflowCount="999">
                <div class="w-10 h-10 rounded-lg bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300">
                    <Icon Name="@IconNames.Inbox" Size="18" />
                </div>
            </Badge>
        </div>
    </DemoCard>

    @* Example 3: Red Dot & Status Badges *@
    <DemoCard Title="Dot &amp; Status Badges" Description="Red notification dot for unread status, or standalone colored status indicators." Code="@_statusDotCode">
        <div class="space-y-4 p-4">
            <div class="flex items-center gap-6">
                <Badge Dot="true">
                    <Icon Name="@IconNames.Bell" Size="20" />
                </Badge>
                <Badge Dot="true">
                    <a href="javascript:void(0)" class="text-sm text-primary-600 dark:text-primary-400">Link with Notification</a>
                </Badge>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-xs">
                <Badge Status="BadgeStatus.Success" Text="Active Service" />
                <Badge Status="BadgeStatus.Processing" Text="Deploying" />
                <Badge Status="BadgeStatus.Warning" Text="High Latency" />
                <Badge Status="BadgeStatus.Error" Text="Service Outage" />
            </div>
        </div>
    </DemoCard>

    <ApiTable Title="Badge Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <Badge Count="5">
            <div class="w-10 h-10 rounded-lg bg-slate-200 flex items-center justify-center">
                <Icon Name="@IconNames.Inbox" Size="18" />
            </div>
        </Badge>
        <Badge Count="0" ShowZero="true">
            <div class="w-10 h-10 rounded-lg bg-slate-200 flex items-center justify-center">
                <Icon Name="@IconNames.Bell" Size="18" />
            </div>
        </Badge>
        """;

    private const string _overflowCode = """
        <Badge Count="120" OverflowCount="99">
            <div class="w-10 h-10 rounded-lg bg-slate-200 flex items-center justify-center">
                <Icon Name="@IconNames.Bell" Size="18" />
            </div>
        </Badge>
        """;

    private const string _statusDotCode = """
        <Badge Dot="true">
            <Icon Name="@IconNames.Bell" Size="20" />
        </Badge>

        <Badge Status="BadgeStatus.Success" Text="Active Service" />
        <Badge Status="BadgeStatus.Processing" Text="Deploying" />
        <Badge Status="BadgeStatus.Warning" Text="High Latency" />
        <Badge Status="BadgeStatus.Error" Text="Service Outage" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Count", "Number to show in badge.", "int?", "null"),
        new("OverflowCount", "Max count to show; counts above this will display as '{OverflowCount}+'.", "int", "99"),
        new("Dot", "Whether to display red dot badge instead of count.", "bool", "false"),
        new("ShowZero", "Whether to show badge when count is zero.", "bool", "false"),
        new("Color", "Custom background color of badge dot/pill.", "string?", "null"),
        new("Status", "Badge status dot style (Success, Processing, Default, Error, Warning).", "BadgeStatus?", "null"),
        new("Text", "Label text when status is used.", "string?", "null"),
        new("ChildContent", "Wrapped element that badge attaches to.", "RenderFragment?", "null")
    ];
}