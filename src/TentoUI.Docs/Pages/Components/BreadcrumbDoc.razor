@page "/components/breadcrumb"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Breadcrumb - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Breadcrumb</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A hierarchical navigation element indicating the current page location within a site structure.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Change custom separator character dynamically.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40">
            <Breadcrumb Separator="@_separator">
                <BreadcrumbItem Href="#">Home</BreadcrumbItem>
                <BreadcrumbItem Href="#">Components</BreadcrumbItem>
                <BreadcrumbItem Href="#">Navigation</BreadcrumbItem>
                <BreadcrumbItem IsLast="true">Breadcrumb</BreadcrumbItem>
            </Breadcrumb>
        </div>

        <div class="max-w-xs text-xs">
            <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Custom Separator</label>
            <input type="text"
                   class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                   @bind="_separator"
                   @bind:event="oninput" />
        </div>
    </div>

    @* Use Cases *@
    <DemoCard Title="Breadcrumb with Icons" Description="Include SVG icons alongside section labels." Code="@_iconCode">
        <Breadcrumb>
            <BreadcrumbItem Href="#">
                <Icon><TentoUI.Icon Name="@IconNames.Home" Size="14" /></Icon>
                <ChildContent>Home</ChildContent>
            </BreadcrumbItem>
            <BreadcrumbItem Href="#">
                <Icon><TentoUI.Icon Name="@IconNames.Folder" Size="14" /></Icon>
                <ChildContent>Documents</ChildContent>
            </BreadcrumbItem>
            <BreadcrumbItem IsLast="true">Report.pdf</BreadcrumbItem>
        </Breadcrumb>
    </DemoCard>

    <ApiTable Title="Breadcrumb Properties" Properties="@_breadcrumbProps" />
    <ApiTable Title="BreadcrumbItem Properties" Properties="@_itemProps" />
</div>

@code {
    private string _separator = "/";

    private const string _iconCode = @"<Breadcrumb>
    <BreadcrumbItem Href=""#"">
        <Icon><Icon Name=""@IconNames.Home"" Size=""14"" /></Icon>
        <ChildContent>Home</ChildContent>
    </BreadcrumbItem>
    <BreadcrumbItem IsLast=""true"">Report.pdf</BreadcrumbItem>
</Breadcrumb>";

    private readonly ApiTable.ApiProp[] _breadcrumbProps =
    [
        new("Separator", "Custom separator string (e.g. '/', '>', '→').", "string", "'/'"),
        new("SeparatorTemplate", "Custom separator template fragment.", "RenderFragment?", "null"),
        new("ChildContent", "BreadcrumbItem items.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Href", "Target URL link.", "string?", "null"),
        new("IsLast", "Whether this is the current active tail page (styled as active).", "bool", "false"),
        new("Icon", "Optional icon rendered preceding the label.", "RenderFragment?", "null"),
        new("OnClick", "Click callback.", "EventCallback<MouseEventArgs>", "null"),
        new("ChildContent", "Label content.", "RenderFragment?", "null")
    ];
}
