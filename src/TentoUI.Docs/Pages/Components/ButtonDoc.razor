@page "/components/button"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Button - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Button</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Buttons allow users to take actions, and make choices, with a single tap. Supports variants, shapes, loading states, and size scales.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Button Interactive Playground"
                     ComponentTag="Button"
                     Controls="@_playgroundControls" />

    @* Example 1: Button Types *@
    <DemoCard Title="Button Types" Description="5 basic types: Primary, Default, Dashed, Link, and Text." Code="@_typesCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Primary">Primary Button</Button>
            <Button Type="ButtonType.Default">Default Button</Button>
            <Button Type="ButtonType.Dashed">Dashed Button</Button>
            <Button Type="ButtonType.Text">Text Button</Button>
            <Button Type="ButtonType.Link" Href="#">Link Button</Button>
        </div>
    </DemoCard>

    @* Example 2: Danger & Ghost *@
    <DemoCard Title="Danger &amp; Ghost" Description="Danger highlights destructive actions. Ghost buttons are transparent with inverted borders." Code="@_dangerCode">
        <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-3">
                <Button Type="ButtonType.Primary" Danger="true">Primary Danger</Button>
                <Button Type="ButtonType.Default" Danger="true">Default Danger</Button>
                <Button Type="ButtonType.Dashed" Danger="true">Dashed Danger</Button>
                <Button Type="ButtonType.Text" Danger="true">Text Danger</Button>
            </div>
            <div class="p-4 rounded-lg bg-slate-900 flex flex-wrap items-center gap-3">
                <Button Type="ButtonType.Primary" Ghost="true">Primary Ghost</Button>
                <Button Type="ButtonType.Default" Ghost="true">Default Ghost</Button>
                <Button Type="ButtonType.Dashed" Ghost="true">Dashed Ghost</Button>
                <Button Danger="true" Ghost="true">Danger Ghost</Button>
            </div>
        </div>
    </DemoCard>

    @* Example 3: Interactive Loading *@
    <DemoCard Title="Loading State" Description="Click to trigger an asynchronous operation with animated loading spinner." Code="@_loadingCode">
        <div class="flex items-center gap-3">
            <Button Type="ButtonType.Primary"
                    Loading="_asyncLoading"
                    OnClick="SimulateAsyncActionAsync">
                @(_asyncLoading ? "Processing..." : "Click to Trigger Task")
            </Button>
            <Button Loading="true">Always Loading</Button>
        </div>
    </DemoCard>

    @* Example 4: Sizes & Shapes *@
    <DemoCard Title="Sizes &amp; Shapes" Description="Three size scales (Small, Middle, Large) and round or circular shapes." Code="@_sizesCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Primary" Size="ComponentSize.Small">Small</Button>
            <Button Type="ButtonType.Primary" Size="ComponentSize.Middle">Middle</Button>
            <Button Type="ButtonType.Primary" Size="ComponentSize.Large">Large</Button>
            <Button Type="ButtonType.Primary" Shape="ButtonShape.Round">Round</Button>
            <Button Type="ButtonType.Primary" Shape="ButtonShape.Circle">
                <TentoUI.Icon Name="@IconNames.Search" Size="14" />
            </Button>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Button Properties" ComponentType="@typeof(Button)" Properties="@_buttonProps" />
</div>

@code {
    private bool _asyncLoading;

    private readonly System.Collections.Generic.List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Label", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Primary Action", IsChildContent = true },
        new() { Name = "Type", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "ButtonType.Primary", DefaultValue = "ButtonType.Default", Options = ["ButtonType.Default", "ButtonType.Primary", "ButtonType.Dashed", "ButtonType.Text", "ButtonType.Link"] },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "ComponentSize.Middle", DefaultValue = "ComponentSize.Middle", Options = ["ComponentSize.Small", "ComponentSize.Middle", "ComponentSize.Large"] },
        new() { Name = "Shape", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "ButtonShape.Default", DefaultValue = "ButtonShape.Default", Options = ["ButtonShape.Default", "ButtonShape.Round", "ButtonShape.Circle"] },
        new() { Name = "Danger", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Loading", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Block", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private async Task SimulateAsyncActionAsync()
    {
        _asyncLoading = true;
        await Task.Delay(1500);
        _asyncLoading = false;
        MessageService.Success("Operation finished successfully!");
    }

    private const string _typesCode = """
        <Button Type="ButtonType.Primary">Primary Button</Button>
        <Button Type="ButtonType.Default">Default Button</Button>
        <Button Type="ButtonType.Dashed">Dashed Button</Button>
        <Button Type="ButtonType.Text">Text Button</Button>
        <Button Type="ButtonType.Link" Href="#">Link Button</Button>
        """;

    private const string _dangerCode = """
        <Button Type="ButtonType.Primary" Danger="true">Primary Danger</Button>
        <Button Type="ButtonType.Default" Danger="true">Default Danger</Button>
        <Button Type="ButtonType.Dashed" Danger="true">Dashed Danger</Button>
        <Button Type="ButtonType.Text" Danger="true">Text Danger</Button>
        """;

    private const string _loadingCode = """
        <Button Type="ButtonType.Primary" Loading="true">
            Loading Action
        </Button>
        """;

    private const string _sizesCode = """
        <Button Type="ButtonType.Primary" Size="ComponentSize.Small">Small</Button>
        <Button Type="ButtonType.Primary" Size="ComponentSize.Middle">Middle</Button>
        <Button Type="ButtonType.Primary" Size="ComponentSize.Large">Large</Button>
        <Button Type="ButtonType.Primary" Shape="ButtonShape.Round">Round</Button>
        """;

    private readonly ApiProp[] _buttonProps =
    [
        new("Type", "Sets the visual button type variant (Primary, Default, Dashed, Link, Text).", "ButtonType", "ButtonType.Default"),
        new("Size", "Sets the size scale of the button (Small, Middle, Large).", "ComponentSize?", "null (Middle)"),
        new("Shape", "Sets the shape of the button (Default, Circle, Round).", "ButtonShape", "ButtonShape.Default"),
        new("Danger", "Applies danger state styling for destructive operations.", "bool", "false"),
        new("Ghost", "Makes button background transparent, ideal for colored backgrounds.", "bool", "false"),
        new("Loading", "Displays a spinner indicator and prevents further clicks.", "bool", "false"),
        new("Disabled", "Disables user interaction and applies muted opacity styling.", "bool", "false"),
        new("Block", "Expands the button to span the full width of its parent container.", "bool", "false"),
        new("Href", "If set, renders an <a> anchor link styled as a button.", "string?", "null"),
        new("Target", "Target attribute when Href is specified (e.g. '_blank').", "string?", "null"),
        new("Icon", "Custom icon template rendered before or after the child content.", "RenderFragment?", "null"),
        new("IconPosition", "Placement of the icon (Start or End).", "IconPosition", "IconPosition.Start"),
        new("OnClick", "Callback triggered when the button is clicked by mouse or keyboard.", "EventCallback<MouseEventArgs>", "null"),
        new("ChildContent", "Label or custom content rendered inside the button.", "RenderFragment?", "null")
    ];
}
