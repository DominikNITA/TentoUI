@page "/components/button"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Button - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Button</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            To trigger an operation or navigate to another page.
        </p>
    </div>

    <DemoCard Title="Button Types" Description="5 primary button types: Primary, Default, Dashed, Text, and Link." Code="@_typesCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Primary" OnClick="@(() => MessageService.Success("Primary clicked"))">Primary</Button>
            <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Info("Default clicked"))">Default</Button>
            <Button Type="ButtonType.Dashed">Dashed</Button>
            <Button Type="ButtonType.Text">Text</Button>
            <Button Type="ButtonType.Link" Href="https://ant.design" Target="_blank">Link</Button>
        </div>
    </DemoCard>

    <DemoCard Title="Loading and Danger States" Description="Buttons support loading indicators and danger styles for destructive actions." Code="@_dangerCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Primary" Danger="true">Danger Primary</Button>
            <Button Type="ButtonType.Default" Danger="true">Danger Default</Button>
            <Button Type="ButtonType.Primary" Loading="true">Loading</Button>
            <Button Type="ButtonType.Default" Disabled="true">Disabled</Button>
        </div>
    </DemoCard>

    <DemoCard Title="FloatButton (FAB)" Description="Corner floating action button for quick actions and back to top." Code="@_floatCode">
        <div class="flex items-center gap-4">
            <FloatButton Type="FloatButtonType.Primary" Icon="@IconNames.HelpCircle" OnClick="@(() => MessageService.Info("Help clicked"))" />
            <FloatButton Shape="FloatButtonShape.Square" Icon="@IconNames.Settings" />
        </div>
    </DemoCard>
</div>

@code {
    private const string _typesCode = @"<Button Type=""ButtonType.Primary"">Primary</Button>
<Button Type=""ButtonType.Default"">Default</Button>
<Button Type=""ButtonType.Dashed"">Dashed</Button>
<Button Type=""ButtonType.Text"">Text</Button>
<Button Type=""ButtonType.Link"" Href=""..."" Target=""_blank"">Link</Button>";

    private const string _dangerCode = @"<Button Type=""ButtonType.Primary"" Danger=""true"">Danger Primary</Button>
<Button Type=""ButtonType.Default"" Danger=""true"">Danger Default</Button>
<Button Type=""ButtonType.Primary"" Loading=""true"">Loading</Button>";

    private const string _floatCode = @"<FloatButton Type=""FloatButtonType.Primary"" Icon=""@IconNames.HelpCircle"" />
<FloatButton Shape=""FloatButtonShape.Square"" Icon=""@IconNames.Settings"" />";
}
