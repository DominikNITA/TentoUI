@page "/components/card"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Card - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Card</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A flexible container for displaying structured content with title headers, action bars, and cover images.
        </p>
    </div>

    @* Example 1: Basic Card *@
    <DemoCard Title="Basic Card" Description="Card with title header, right-aligned extra action, and body content." Code="@_basicCode">
        <div class="max-w-md">
            <Card Title="Default Size Card">
                <Extra>
                    <a href="javascript:void(0)" class="text-xs text-primary-500 font-semibold hover:underline">More</a>
                </Extra>
                <ChildContent>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Card content line 1</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Card content line 2</p>
                </ChildContent>
            </Card>
        </div>
    </DemoCard>

    @* Example 2: Hoverable Card *@
    <DemoCard Title="Hoverable Card" Description="Hoverable cards elevate with a smooth shadow effect on mouse enter." Code="@_hoverCode">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
            <Card Title="Cloud Instance" Hoverable="true">
                <p class="text-sm text-slate-600 dark:text-slate-400">CPU: 8 vCPU</p>
                <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Memory: 32 GB RAM</p>
            </Card>
            <Card Title="Database Cluster" Hoverable="true">
                <p class="text-sm text-slate-600 dark:text-slate-400">Engine: PostgreSQL 16</p>
                <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Storage: 500 GB NVMe</p>
            </Card>
        </div>
    </DemoCard>

    @* Example 3: Card with Actions *@
    <DemoCard Title="Card with Actions" Description="Includes interactive bottom action toolbar." Code="@_actionsCode">
        <div class="max-w-md">
            <Card Title="Project Management">
                <ChildContent>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        Sprint 42 deliverables are ready for review and deployment to staging.
                    </p>
                </ChildContent>
                <Actions>
                    <div class="flex items-center justify-around w-full py-2 text-xs font-medium text-slate-600 dark:text-slate-300">
                        <button class="hover:text-primary-600">Edit</button>
                        <span class="text-slate-200 dark:text-slate-700">|</span>
                        <button class="hover:text-primary-600">Share</button>
                        <span class="text-slate-200 dark:text-slate-700">|</span>
                        <button class="hover:text-primary-600">Archive</button>
                    </div>
                </Actions>
            </Card>
        </div>
    </DemoCard>

    <ApiTable Title="Card Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <Card Title="Default Size Card">
            <Extra>
                <a href="#" class="text-xs text-primary-500 font-semibold">More</a>
            </Extra>
            <ChildContent>
                <p class="text-sm text-slate-600">Card content line 1</p>
                <p class="text-sm text-slate-600">Card content line 2</p>
            </ChildContent>
        </Card>
        """;

    private const string _hoverCode = """
        <Card Title="Cloud Instance" Hoverable="true">
            <p class="text-sm text-slate-600">CPU: 8 vCPU</p>
            <p class="text-sm text-slate-600">Memory: 32 GB RAM</p>
        </Card>
        """;

    private const string _actionsCode = """
        <Card Title="Project Management">
            <ChildContent>
                <p class="text-sm text-slate-600">Sprint 42 deliverables are ready for review.</p>
            </ChildContent>
            <Actions>
                <div class="flex justify-around py-2 text-xs">
                    <button>Edit</button>
                    <button>Share</button>
                </div>
            </Actions>
        </Card>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Title", "Title text displayed in card header.", "string?", "null"),
        new("TitleTemplate", "Custom template for card title header.", "RenderFragment?", "null"),
        new("Extra", "Right-aligned content in the card header.", "RenderFragment?", "null"),
        new("Cover", "Cover image rendered at the top of the card.", "RenderFragment?", "null"),
        new("Actions", "Action buttons bar rendered at the bottom.", "RenderFragment?", "null"),
        new("Bordered", "Whether to show border around the card.", "bool", "true"),
        new("Hoverable", "Lift up on hover with elevated drop shadow.", "bool", "false"),
        new("Loading", "Shows skeleton loading state inside card.", "bool", "false"),
        new("Size", "Size scale of card (Small or Middle).", "ComponentSize?", "null"),
        new("ChildContent", "Card body content.", "RenderFragment?", "null")
    ];
}