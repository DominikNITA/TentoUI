@page "/components/card"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Card - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Card</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A flexible container for displaying structured content with title headers, action bars, and cover images.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Toggle hover effects, borders, and sizes live.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <div class="w-full max-w-sm">
                <Card Title="@_title"
                      Bordered="_bordered"
                      Hoverable="_hoverable"
                      Loading="_loading"
                      Size="_size">
                    <Extra>
                        <a href="#" class="text-xs text-primary-500 font-semibold hover:underline">Action</a>
                    </Extra>
                    <ChildContent>
                        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                            Card content containing detailed metrics, descriptions, and user attributes.
                        </p>
                    </ChildContent>
                </Card>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Card Title</label>
                <input type="text"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_title" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Size Scale</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_size">
                    <option value="@ComponentSize.Small">Small</option>
                    <option value="@ComponentSize.Middle">Middle</option>
                </select>
            </div>
            <div class="sm:col-span-2 flex items-center gap-4 pt-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_bordered" class="rounded text-primary-600" />
                    <span>Bordered</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_hoverable" class="rounded text-primary-600" />
                    <span>Hover Shadow Effect</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_loading" class="rounded text-primary-600" />
                    <span>Loading Skeleton</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="Card Properties" Properties="@_props" />
</div>

@code {
    private string _title = "Workspace Metrics";
    private bool _bordered = true;
    private bool _hoverable = true;
    private bool _loading;
    private ComponentSize _size = ComponentSize.Middle;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Title", "Title text displayed in card header.", "string?", "null"),
        new("TitleTemplate", "Custom template for card title header.", "RenderFragment?", "null"),
        new("Extra", "Right-aligned content in the card header.", "RenderFragment?", "null"),
        new("Cover", "Cover image rendered at the top of the card.", "RenderFragment?", "null"),
        new("Actions", "Action buttons bar rendered at the bottom.", "RenderFragment?", "null"),
        new("Bordered", "Whether to show border around the card.", "bool", "true"),
        new("Hoverable", "Lift up on hover with elevated drop shadow.", "bool", "false"),
        new("Loading", "Shows skeleton loading state inside card.", "bool", "false"),
        new("Size", "Size scale of card (Small or Middle).", "ComponentSize?", "null"),
        new("ChildContent", "Card body content.", "RenderFragment?", "null")
    ];
}
