@page "/components/carousel"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Carousel - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Carousel</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A carousel of rotating text, images, or cards with navigation dots, arrow triggers, and automatic rotation.
        </p>
    </div>

    @* Example 1: Basic Autoplay Carousel *@
    <DemoCard Title="Autoplay Carousel with Arrows" Description="Cycles automatically through slides with navigation arrows and bottom dots." Code="@_autoplayCode">
        <div class="max-w-xl mx-auto">
            <Carousel AutoPlay="true" AutoPlaySpeed="4000" Dots="true" Arrows="true">
                <CarouselPanel>
                    <div class="h-44 rounded-lg flex flex-col items-center justify-center bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-6 text-center">
                        <h4 class="font-bold text-lg mb-1">Modern Blazor UI</h4>
                        <p class="text-xs opacity-90">Tailwind CSS powered components patterned after AntDesign</p>
                    </div>
                </CarouselPanel>
                <CarouselPanel>
                    <div class="h-44 rounded-lg flex flex-col items-center justify-center bg-gradient-to-r from-emerald-600 to-teal-600 text-white p-6 text-center">
                        <h4 class="font-bold text-lg mb-1">WebAssembly Ready</h4>
                        <p class="text-xs opacity-90">Runs directly in the browser with zero server prerequisites</p>
                    </div>
                </CarouselPanel>
                <CarouselPanel>
                    <div class="h-44 rounded-lg flex flex-col items-center justify-center bg-gradient-to-r from-purple-600 to-pink-600 text-white p-6 text-center">
                        <h4 class="font-bold text-lg mb-1">Production Tested</h4>
                        <p class="text-xs opacity-90">Comprehensive unit tests and GitHub Actions deployment</p>
                    </div>
                </CarouselPanel>
            </Carousel>
        </div>
    </DemoCard>

    @* Example 2: Static Carousel with Top Dots *@
    <DemoCard Title="Top Indicator Dots" Description="Carousel with indicator dots placed at the top position." Code="@_topDotsCode">
        <div class="max-w-xl mx-auto">
            <Carousel Dots="true" DotPosition="CarouselDotPosition.Top">
                <CarouselPanel>
                    <div class="h-36 rounded-lg flex items-center justify-center bg-slate-800 text-white font-semibold">
                        Slide 1: Overview
                    </div>
                </CarouselPanel>
                <CarouselPanel>
                    <div class="h-36 rounded-lg flex items-center justify-center bg-slate-700 text-white font-semibold">
                        Slide 2: Features
                    </div>
                </CarouselPanel>
                <CarouselPanel>
                    <div class="h-36 rounded-lg flex items-center justify-center bg-slate-600 text-white font-semibold">
                        Slide 3: Documentation
                    </div>
                </CarouselPanel>
            </Carousel>
        </div>
    </DemoCard>

    <ApiTable Title="Carousel Properties" Properties="@_props" />
</div>

