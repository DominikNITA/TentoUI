@page "/components/carousel"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Carousel - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Carousel</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A carousel of rotating text, images, or cards with navigation dots, arrow triggers, and automatic rotation.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Toggle autoplay, arrow navigation, and dot indicators live.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-lg mx-auto">
            <Carousel AutoPlay="_autoPlay"
                      AutoPlaySpeed="_speed"
                      Dots="_dots"
                      Arrows="_arrows"
                      DotPosition="_dotPos">
                <CarouselPanel>
                    <div class="h-44 rounded-lg flex flex-col items-center justify-center bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-6 text-center">
                        <h4 class="font-bold text-lg mb-1">Modern Blazor UI</h4>
                        <p class="text-xs opacity-90">Tailwind CSS powered components patterned after AntDesign</p>
                    </div>
                </CarouselPanel>
                <CarouselPanel>
                    <div class="h-44 rounded-lg flex flex-col items-center justify-center bg-gradient-to-r from-emerald-600 to-teal-600 text-white p-6 text-center">
                        <h4 class="font-bold text-lg mb-1">WebAssembly Ready</h4>
                        <p class="text-xs opacity-90">Runs directly in the browser with zero server prerequisites</p>
                    </div>
                </CarouselPanel>
                <CarouselPanel>
                    <div class="h-44 rounded-lg flex flex-col items-center justify-center bg-gradient-to-r from-purple-600 to-pink-600 text-white p-6 text-center">
                        <h4 class="font-bold text-lg mb-1">Production Tested</h4>
                        <p class="text-xs opacity-90">Comprehensive unit tests and GitHub Actions deployment</p>
                    </div>
                </CarouselPanel>
            </Carousel>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Dot Position</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_dotPos">
                    <option value="@CarouselDotPosition.Bottom">Bottom</option>
                    <option value="@CarouselDotPosition.Top">Top</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Speed (ms)</label>
                <input type="number"
                       min="1000"
                       max="10000"
                       step="500"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_speed" />
            </div>
            <div class="sm:col-span-2 flex items-center gap-4 pt-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_autoPlay" class="rounded text-primary-600" />
                    <span>Auto Play</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_dots" class="rounded text-primary-600" />
                    <span>Show Indicator Dots</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_arrows" class="rounded text-primary-600" />
                    <span>Show Prev / Next Arrows</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="Carousel Properties" Properties="@_props" />
</div>

@code {
    private bool _autoPlay = true;
    private int _speed = 3500;
    private bool _dots = true;
    private bool _arrows = true;
    private CarouselDotPosition _dotPos = CarouselDotPosition.Bottom;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("AutoPlay", "Whether to scroll slides automatically.", "bool", "false"),
        new("AutoPlaySpeed", "Duration between slide transitions in milliseconds.", "int", "3000"),
        new("Dots", "Whether to show pagination indicator dots.", "bool", "true"),
        new("Arrows", "Whether to show next/previous arrow navigation buttons.", "bool", "false"),
        new("DotPosition", "Position of dots (Top, Bottom, Left, Right).", "CarouselDotPosition", "CarouselDotPosition.Bottom"),
        new("ChildContent", "CarouselPanel child elements.", "RenderFragment?", "null")
    ];
}
