@page "/components/cascader"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Cascader - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Cascader</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Cascade selection allows selection from a set of associated multi-level datasets (e.g. continent &gt; country &gt; city).
        </p>
    </div>

    @* Example 1: Basic Cascader *@
    <DemoCard Title="Geographic Cascade" Description="Navigate continent, country, and city in adjacent dropdown panels." Code="@_geoCode">
        <div class="max-w-xs p-2 space-y-2">
            <Cascader Options="@_options"
                      @bind-Values="_selectedValues"
                      Placeholder="Select location..."
                      AllowClear="true" />
            <div class="text-xs text-slate-400 font-mono">Selected Path: @string.Join(" / ", _selectedValues)</div>
        </div>
    </DemoCard>

    @* Example 2: Category Selector *@
    <DemoCard Title="Category Hierarchy" Description="Classify items by departmental and subdepartmental categories." Code="@_catCode">
        <div class="max-w-xs p-2 space-y-2">
            <Cascader Options="@_categoryOptions"
                      @bind-Values="_selectedCategory"
                      Placeholder="Select department..."
                      AllowClear="true" />
            <div class="text-xs text-slate-400 font-mono">Department Path: @string.Join(" / ", _selectedCategory)</div>
        </div>
    </DemoCard>

    <ApiTable Title="Cascader Properties" Properties="@_props" />
</div>

@code {
    private IReadOnlyList<string> _selectedValues = new[] { "eu", "pl", "waw" };
    private IReadOnlyList<string> _selectedCategory = new[] { "tech", "frontend" };

    private readonly CascaderOption[] _options =
    [
        new("eu", "Europe",
        [
            new("pl", "Poland",
            [
                new("waw", "Warsaw"),
                new("krk", "Krakow")
            ]),
            new("de", "Germany",
            [
                new("ber", "Berlin"),
                new("muc", "Munich")
            ])
        ]),
        new("na", "North America",
        [
            new("us", "United States",
            [
                new("nyc", "New York"),
                new("sf", "San Francisco")
            ])
        ])
    ];

    private readonly CascaderOption[] _categoryOptions =
    [
        new("tech", "Engineering",
        [
            new("frontend", "Frontend & UI"),
            new("backend", "Cloud & Backend"),
            new("devops", "Infrastructure & SRE")
        ]),
        new("design", "Product Design",
        [
            new("ux", "User Research"),
            new("design-system", "Design Tokens & System")
        ])
    ];

    private const string _geoCode = """
        <Cascader Options="@options"
                  @bind-Values="selectedValues"
                  Placeholder="Select location..."
                  AllowClear="true" />
        """;

    private const string _catCode = """
        <Cascader Options="@categoryOptions"
                  @bind-Values="selectedCategory"
                  Placeholder="Select department..."
                  AllowClear="true" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Options", "Hierarchical data options array.", "IEnumerable<CascaderOption>?", "null"),
        new("Values", "Selected keys at each cascade depth (bindable via @bind-Values).", "IReadOnlyList<string>", "[]"),
        new("Placeholder", "Input placeholder text.", "string?", "'Please select'"),
        new("AllowClear", "Whether clear icon is enabled.", "bool", "true"),
        new("ChangeOnSelect", "Whether selecting any parent level triggers value update immediately.", "bool", "false")
    ];
}