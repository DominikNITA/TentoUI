@page "/components/checkbox"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Checkbox - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Checkbox</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Used for selecting one or more values from a set, or toggling between two binary states.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Checkbox Interactive Playground"
                     ComponentTag="Checkbox"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Checkbox *@
    <DemoCard Title="Basic Checkbox" Description="Two-way boolean binding with interactive toggle." Code="@_basicCode">
        <div class="flex items-center gap-4 p-2">
            <Checkbox @bind-Checked="_checked">
                Accept Terms of Service and Privacy Policy
            </Checkbox>
            <span class="text-xs text-slate-400 font-mono">Value: @_checked</span>
        </div>
    </DemoCard>

    @* Example 2: Indeterminate & Disabled *@
    <DemoCard Title="Indeterminate &amp; Disabled States" Description="Partial check state for parent nodes and read-only disabled states." Code="@_statesCode">
        <div class="flex flex-wrap items-center gap-6 p-2">
            <Checkbox Indeterminate="true">
                Partially Selected
            </Checkbox>
            <Checkbox Disabled="true">
                Disabled Unchecked
            </Checkbox>
            <Checkbox Checked="true" Disabled="true">
                Disabled Checked
            </Checkbox>
        </div>
    </DemoCard>

    @* Example 3: Multiple Options *@
    <DemoCard Title="Feature Selection" Description="Select multiple independent features from a list." Code="@_multipleCode">
        <div class="space-y-2 p-2">
            <Checkbox @bind-Checked="_opt1">Automated Cloud Backups</Checkbox>
            <Checkbox @bind-Checked="_opt2">Sub-domain SSL Certificate</Checkbox>
            <Checkbox @bind-Checked="_opt3">Dedicated IP Address</Checkbox>
        </div>
    </DemoCard>

    <ApiTable Title="Checkbox Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Label", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Accept Terms & Conditions", DefaultValue = "" },
        new() { Name = "Checked", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "" },
        new() { Name = "Indeterminate", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private bool _checked = true;
    private bool _opt1 = true;
    private bool _opt2 = true;
    private bool _opt3;

    private const string _basicCode = """
        <Checkbox @bind-Checked="isChecked">
            Accept Terms of Service and Privacy Policy
        </Checkbox>
        """;

    private const string _statesCode = """
        <Checkbox Indeterminate="true">Partially Selected</Checkbox>
        <Checkbox Disabled="true">Disabled Unchecked</Checkbox>
        <Checkbox Checked="true" Disabled="true">Disabled Checked</Checkbox>
        """;

    private const string _multipleCode = """
        <div class="space-y-2">
            <Checkbox @bind-Checked="opt1">Automated Cloud Backups</Checkbox>
            <Checkbox @bind-Checked="opt2">Sub-domain SSL Certificate</Checkbox>
            <Checkbox @bind-Checked="opt3">Dedicated IP Address</Checkbox>
        </div>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Checked", "Specifies whether the checkbox is checked (bindable via @bind-Checked).", "bool", "false"),
        new("Indeterminate", "Sets indeterminate (partially checked) visual state.", "bool", "false"),
        new("Disabled", "Whether the checkbox is disabled.", "bool", "false"),
        new("ChildContent", "Label text rendered next to the box.", "RenderFragment?", "null")
    ];
}