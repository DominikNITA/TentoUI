@page "/components/checkbox"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Checkbox - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Checkbox</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Used for selecting one or more values from a set, or toggling between two binary states.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Toggle checked and indeterminate states dynamically.</p>
            </div>
            <div class="text-xs text-slate-400">
                Checked: <strong class="text-primary-600 dark:text-primary-400 font-mono">@_checked</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40">
            <Checkbox @bind-Checked="_checked"
                      Indeterminate="_indeterminate"
                      Disabled="_disabled">
                Accept Terms of Service and Privacy Policy
            </Checkbox>
        </div>

        <div class="flex items-center gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_indeterminate" class="rounded text-primary-600" />
                <span>Indeterminate (Partial)</span>
            </label>
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                <span>Disabled</span>
            </label>
        </div>
    </div>

    <ApiTable Title="Checkbox Properties" Properties="@_props" />
</div>

@code {
    private bool _checked = true;
    private bool _indeterminate;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Checked", "Specifies whether the checkbox is checked (bindable via @bind-Checked).", "bool", "false"),
        new("Indeterminate", "Sets indeterminate (partially checked) visual state.", "bool", "false"),
        new("Disabled", "Whether the checkbox is disabled.", "bool", "false"),
        new("ChildContent", "Label text rendered next to the box.", "RenderFragment?", "null")
    ];
}
