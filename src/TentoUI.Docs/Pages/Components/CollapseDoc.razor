@page "/components/collapse"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Collapse - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Collapse</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A content area which can be collapsed and expanded, supporting single-panel accordion or multi-panel unfold.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Collapse Interactive Playground"
                     ComponentTag="Collapse"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Collapse *@
    <DemoCard Title="Basic Collapse" Description="Multi-panel unfoldable list with bordered containers." Code="@_basicCode">
        <Collapse Bordered="true">
            <CollapsePanel Key="1" Header="What is TentoUI?">
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    TentoUI is an AntDesign-patterned UI component library styled with Tailwind CSS for .NET 10 Blazor.
                </p>
            </CollapsePanel>
            <CollapsePanel Key="2" Header="Can it be used in WebAssembly and Server?">
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Yes! TentoUI works cleanly across Blazor WebAssembly and Blazor Server / Auto modes.
                </p>
            </CollapsePanel>
        </Collapse>
    </DemoCard>

    @* Example 2: Accordion Mode *@
    <DemoCard Title="Accordion Mode" Description="In accordion mode, only a single panel can be expanded at any time." Code="@_accordionCode">
        <Collapse Accordion="true" Bordered="true">
            <CollapsePanel Key="1" Header="Section A: Cloud Architecture">
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Deploys globally distributed edge nodes with sub-millisecond response latency.
                </p>
            </CollapsePanel>
            <CollapsePanel Key="2" Header="Section B: Data Security &amp; Compliance">
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    End-to-end encryption at rest and in transit with SOC 2 compliance certifications.
                </p>
            </CollapsePanel>
            <CollapsePanel Key="3" Header="Section C: Automated Backups">
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Daily snapshot replication with point-in-time restore functionality.
                </p>
            </CollapsePanel>
        </Collapse>
    </DemoCard>

    @* Example 3: Ghost Style *@
    <DemoCard Title="Ghost Transparency" Description="Seamless transparent background with no outer container borders." Code="@_ghostCode">
        <Collapse Ghost="true">
            <CollapsePanel Key="1" Header="System Status &amp; Telemetry">
                <p class="text-xs text-slate-600 dark:text-slate-400">All regional services operating normally.</p>
            </CollapsePanel>
            <CollapsePanel Key="2" Header="Network Diagnostics">
                <p class="text-xs text-slate-600 dark:text-slate-400">Packet loss 0.00%, DNS lookup 12ms.</p>
            </CollapsePanel>
        </Collapse>
    </DemoCard>

    <ApiTable Title="Collapse Properties" Properties="@_collapseProps" />
    <ApiTable Title="CollapsePanel Properties" Properties="@_panelProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Bordered", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Accordion", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Ghost", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "DefaultActiveKey", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "1", DefaultValue = "" }
    ];

    private const string _basicCode = """
        <Collapse Bordered="true">
            <CollapsePanel Key="1" Header="What is TentoUI?">
                <p class="text-xs text-slate-600">TentoUI is an AntDesign-patterned UI library.</p>
            </CollapsePanel>
            <CollapsePanel Key="2" Header="Can it be used in WebAssembly?">
                <p class="text-xs text-slate-600">Yes! Completely client-side ready.</p>
            </CollapsePanel>
        </Collapse>
        """;

    private const string _accordionCode = """
        <Collapse Accordion="true" Bordered="true">
            <CollapsePanel Key="1" Header="Section A">
                <p class="text-xs text-slate-600">Deploys globally distributed edge nodes.</p>
            </CollapsePanel>
            <CollapsePanel Key="2" Header="Section B">
                <p class="text-xs text-slate-600">End-to-end encryption at rest and in transit.</p>
            </CollapsePanel>
        </Collapse>
        """;

    private const string _ghostCode = """
        <Collapse Ghost="true">
            <CollapsePanel Key="1" Header="System Status">
                <p class="text-xs text-slate-600">All services operating normally.</p>
            </CollapsePanel>
        </Collapse>
        """;

    private readonly ApiTable.ApiProp[] _collapseProps =
    [
        new("Accordion", "If true, only one panel can be opened at a time.", "bool", "false"),
        new("Bordered", "Whether to show outer panel border.", "bool", "true"),
        new("Ghost", "Make background transparent and remove outer borders.", "bool", "false"),
        new("ActiveKeys", "List of keys of currently active/unfolded panels.", "IEnumerable<string>?", "null"),
        new("ChildContent", "CollapsePanel child elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _panelProps =
    [
        new("Key", "Unique identifier for this panel.", "string", "required"),
        new("Header", "Title text rendered in panel header.", "string?", "null"),
        new("Disabled", "Whether panel cannot be collapsed or expanded.", "bool", "false"),
        new("ChildContent", "Panel body content.", "RenderFragment?", "null")
    ];
}