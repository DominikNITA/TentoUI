@page "/components/collapse"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Collapse - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Collapse</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A content area which can be collapsed and expanded, supporting single-panel accordion or multi-panel unfold.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Toggle accordion mode, borders, and ghost transparency.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40">
            <Collapse Accordion="_accordion" Bordered="_bordered" Ghost="_ghost">
                <CollapsePanel Key="1" Header="What is TentoUI?">
                    <p class="text-xs text-slate-600 dark:text-slate-400">
                        TentoUI is an AntDesign-patterned UI component library styled with Tailwind CSS for .NET 10 Blazor.
                    </p>
                </CollapsePanel>
                <CollapsePanel Key="2" Header="Can it be used in WebAssembly and Server?">
                    <p class="text-xs text-slate-600 dark:text-slate-400">
                        Yes! TentoUI is compiled as a multi-environment Razor Class Library that works in both Blazor WebAssembly and Blazor Server / Auto modes.
                    </p>
                </CollapsePanel>
                <CollapsePanel Key="3" Header="How does theming work?">
                    <p class="text-xs text-slate-600 dark:text-slate-400">
                        TentoUI components use CSS variables synchronized via TentoConfigProvider and bridged to Tailwind v4 colors.
                    </p>
                </CollapsePanel>
            </Collapse>
        </div>

        <div class="flex items-center gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_accordion" class="rounded text-primary-600" />
                <span>Accordion Mode (Single panel open)</span>
            </label>
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_bordered" class="rounded text-primary-600" />
                <span>Bordered</span>
            </label>
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_ghost" class="rounded text-primary-600" />
                <span>Ghost Transparency</span>
            </label>
        </div>
    </div>

    <ApiTable Title="Collapse Properties" Properties="@_collapseProps" />
    <ApiTable Title="CollapsePanel Properties" Properties="@_panelProps" />
</div>

@code {
    private bool _accordion = true;
    private bool _bordered = true;
    private bool _ghost;

    private readonly ApiTable.ApiProp[] _collapseProps =
    [
        new("Accordion", "If true, only one panel can be opened at a time.", "bool", "false"),
        new("Bordered", "Whether to show outer panel border.", "bool", "true"),
        new("Ghost", "Make background transparent and remove outer borders.", "bool", "false"),
        new("ActiveKeys", "List of keys of currently active/unfolded panels.", "IEnumerable<string>?", "null"),
        new("ChildContent", "CollapsePanel child elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _panelProps =
    [
        new("Key", "Unique identifier for this panel.", "string", "required"),
        new("Header", "Title text rendered in panel header.", "string?", "null"),
        new("Disabled", "Whether panel cannot be collapsed or expanded.", "bool", "false"),
        new("ChildContent", "Panel body content.", "RenderFragment?", "null")
    ];
}
