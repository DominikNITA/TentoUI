@page "/components/color-picker"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>ColorPicker - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">ColorPicker</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            A component for selecting colors through predefined palettes or a native hex picker.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="ColorPicker Interactive Playground"
                     ComponentTag="ColorPicker"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic ColorPicker *@
    <DemoCard Title="Basic ColorPicker" Description="Select a color swatch with two-way binding and hex code indicator." Code="@_basicCode">
        <div class="max-w-xs p-2 space-y-4">
            <ColorPicker @bind-Value="_color" ShowText="true" />
            <div class="w-full h-12 rounded-lg shadow-sm flex items-center justify-center font-bold text-white text-xs" style="background-color: @_color">
                Selected: @_color
            </div>
        </div>
    </DemoCard>

    @* Example 2: Minimal Swatch Only *@
    <DemoCard Title="Minimal Swatch" Description="Compact color swatch trigger without text label." Code="@_swatchCode">
        <div class="flex items-center gap-4 p-2">
            <ColorPicker Value="#10b981" ShowText="false" />
            <ColorPicker Value="#8b5cf6" ShowText="false" />
            <ColorPicker Value="#f59e0b" ShowText="false" />
        </div>
    </DemoCard>

    <ApiTable Title="ColorPicker Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Value", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "#1677ff", DefaultValue = "" },
        new() { Name = "ShowText", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string _color = "#3b82f6";

    private const string _basicCode = """
        <ColorPicker @bind-Value="color" ShowText="true" />
        <div style="background-color: @color">Preview</div>
        """;

    private const string _swatchCode = """
        <ColorPicker Value="#10b981" ShowText="false" />
        <ColorPicker Value="#8b5cf6" ShowText="false" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Selected hex color code (bindable via @bind-Value).", "string", "#1677ff"),
        new("ShowText", "Whether to show hex text alongside the color swatch.", "bool", "true"),
        new("Disabled", "Whether the color picker is disabled.", "bool", "false"),
        new("Presets", "List of preset color hex codes for quick selection.", "IEnumerable<string>?", "10 presets")
    ];
}