@page "/components/command-palette"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>CommandPalette - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 mb-2">
            <span>New in v1.1.0</span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">CommandPalette</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Spotlight-style global command menu (Ctrl+K) with grouped actions, keyboard arrow navigation, and instant filtering.
        </p>
    </div>

    <DemoCard Title="Interactive Command Palette" Description="Click the button to launch the spotlight command palette modal." Code="@_cmdCode">
        <Button Type="ButtonType.Primary" OnClick="@(() => _open = true)">
            Open Command Palette (Ctrl+K)
        </Button>
        <CommandPalette @bind-Open="_open"
                        Items="@_commands"
                        OnSelect="@(item => MessageService.Success($"Executed: {item.Title}"))" />
    </DemoCard>

    <ApiTable Title="CommandPalette Properties" ComponentType="@typeof(CommandPalette)" />
</div>

@code {
    private bool _open;

    private readonly CommandItem[] _commands =
    [
        new("new-proj", "Create New Project", "Workspace", "Scaffold a .NET 10 application", IconNames.Plus, "Ctrl+N"),
        new("deploy", "Deploy to Production", "Operations", "Trigger GitHub Actions workflow", IconNames.Upload, "Ctrl+D"),
        new("dark-mode", "Toggle Dark Theme", "Appearance", "Switch color palette", IconNames.Moon, "Ctrl+J")
    ];

    private const string _cmdCode = """
        <Button Type="ButtonType.Primary" OnClick="@(() => _open = true)">
            Open Command Palette (Ctrl+K)
        </Button>
        <CommandPalette @bind-Open="_open" Placeholder="Type a command or search..." />
        """;
}
