@page "/components/command-palette"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>CommandPalette - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">CommandPalette</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Keyboard-first spotlight command launcher with live search filtering, grouped actions, and arrow-key navigation.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="CommandPalette Interactive Playground"
                     ComponentTag="CommandPalette"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Spotlight Command Launcher"
              Description="Click the button to open the command palette, filter by keyword, and navigate with ArrowUp / ArrowDown / Enter."
              Code="@_paletteCode">
        <div class="space-y-3">
            <Button Type="ButtonType.Primary" IconName="@IconNames.Search" OnClick="@(() => _open = true)">
                Open Command Palette
            </Button>
            <CommandPalette @bind-Open="_open"
                            Items="@_commands"
                            OnSelect="@OnSelectCommand" />
        </div>
    </DemoCard>

    <ApiTable Title="CommandPalette Properties" ComponentType="@typeof(CommandPalette)" />

    <ApiTable Title="CommandItem Properties" ComponentType="@typeof(CommandItem)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Placeholder", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Type a command or search...", DefaultValue = "Type a command or search..." }
    ];

    private bool _open;

    private readonly CommandItem[] _commands =
    [
        new("new-project", "Create New Project", "Workspace", "Initialize a new .NET 10 solution", IconNames.Plus, "Ctrl+N"),
        new("search-docs", "Search Documentation", "Navigation", "Jump to any component API table", IconNames.Search, "Ctrl+K"),
        new("toggle-theme", "Toggle Dark Mode", "Appearance", "Switch between light and dark themes", IconNames.Moon, "Ctrl+J"),
        new("export-tokens", "Export Tailwind Theme", "Developer", "Download tentoui.theme.css tokens", IconNames.Download, "Ctrl+E")
    ];

    private void OnSelectCommand(CommandItem item)
    {
        MessageService.Success($"Executed command: {item.Title}");
    }

    private const string _paletteCode = """
        <Button Type="ButtonType.Primary" IconName="@IconNames.Search" OnClick="@(() => _open = true)">
            Open Command Palette
        </Button>

        <CommandPalette @bind-Open="_open"
                        Items="@_commands"
                        OnSelect="@(cmd => MessageService.Success($"Executed: {cmd.Title}"))" />
        """;
}
