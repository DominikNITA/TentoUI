@page "/components/context-menu"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>ContextMenu - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">ContextMenu</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Right-click context menu wrapper supporting keyboard Escape dismissal, icons, shortcuts, dividers, and destructive actions.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="ContextMenu Interactive Playground"
                     ComponentTag="ContextMenu"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Right-Click Target Area"
              Description="Right-click anywhere inside the dashed surface below to open the context menu at the cursor position."
              Code="@_contextCode">
        <ContextMenu Items="@_menuItems" OnItemClick="@(key => MessageService.Info($"Selected context action: {key}"))">
            <div class="h-40 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 flex flex-col items-center justify-center gap-2 text-slate-500 dark:text-slate-400 select-none cursor-context-menu">
                <Icon Name="@IconNames.MoreHorizontal" Size="24" />
                <span class="text-xs font-semibold">Right-click anywhere inside this canvas</span>
                <span class="text-[11px] text-slate-400">Right-clicking again while open repositions the menu at the cursor</span>
            </div>
        </ContextMenu>
    </DemoCard>

    <ApiTable Title="ContextMenu Properties" ComponentType="@typeof(ContextMenu)" />

    <ApiTable Title="DropdownMenuItem Properties" ComponentType="@typeof(DropdownMenuItem)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls = [];

    private readonly DropdownMenuItem[] _menuItems =
    [
        new("copy", "Copy Selection", IconNames.Copy, Shortcut: "Ctrl+C"),
        new("duplicate", "Duplicate Layer", IconNames.Plus, Shortcut: "Ctrl+D"),
        new("rename", "Rename Item", IconNames.Edit2, Shortcut: "F2"),
        new("delete", "Delete Permanently", IconNames.Trash2, Danger: true, DividerBefore: true, Shortcut: "Del")
    ];

    private const string _contextCode = """
        <ContextMenu Items="@_menuItems" OnItemClick="@OnAction">
            <div class="h-40 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 flex flex-col items-center justify-center gap-2 text-slate-500 dark:text-slate-400 select-none cursor-context-menu">
                <span class="text-xs font-semibold">Right-click anywhere inside this canvas</span>
                <span class="text-[11px] text-slate-400">Right-clicking again while open repositions the menu at the cursor</span>
            </div>
        </ContextMenu>
        """;
}
