@page "/components/cron-builder"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>CronBuilder - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">CronBuilder</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Visual 5-field cron expression generator and human-readable schedule preview for background jobs and recurring pipelines.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="CronBuilder Interactive Playground"
                     ComponentTag="CronBuilder"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Interactive Cron Schedule Builder" Description="Switch tabs between Minutes, Hourly, Daily, Weekly, Monthly, or Custom cron expressions." Code="@_cronCode">
        <div class="space-y-3">
            <CronBuilder @bind-Value="_cron" />
            <div class="text-xs text-slate-500 dark:text-slate-400">
                Bound Cron Value: <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-primary-600 dark:text-primary-400">@_cron</code>
            </div>
        </div>
    </DemoCard>

    <ApiTable Title="CronBuilder Properties" ComponentType="@typeof(CronBuilder)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string? _cron = "0 9 * * 1,2,3,4,5";

    private const string _cronCode = """
        <CronBuilder Value="0 9 * * *" />
        """;
}
