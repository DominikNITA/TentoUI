@page "/components/datagrid-virtual"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>DataGridVirtual - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">DataGridVirtual &amp; Sticky/Resizable Columns</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            High-density virtualized data grid rendering 1,000+ rows smoothly using Blazor's Virtualize engine, with sticky left/right columns and resizable headers.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="DataGridVirtual Interactive Playground"
                     ComponentTag="DataGridVirtual"
                     Controls="@_playgroundControls" />

    <DemoCard Title="1,000-Row Virtualized DataGrid with Sticky &amp; Resizable Columns"
              Description="Scroll smoothly through 1,000 live telemetry records without pagination overhead."
              Code="@_gridCode">
        <div class="space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-3 px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-800/60 text-xs">
                <div class="flex items-center gap-4">
                    <span>Total Virtual Records: <strong class="font-mono text-primary-600 dark:text-primary-400">@_rows.Count</strong></span>
                    <span class="text-slate-300 dark:text-slate-700">|</span>
                    <span class="text-emerald-600 dark:text-emerald-400 font-medium">Healthy: @_rows.Count(r => r.Status == "Healthy")</span>
                    <span class="text-rose-500 font-medium">Degraded: @_rows.Count(r => r.Status == "Degraded")</span>
                </div>
                <span class="text-slate-400 font-mono text-[11px]">ScrollHeight: 360px (ItemSize: 44px)</span>
            </div>

            <DataGridVirtual TItem="TelemetryRow" DataSource="@_rows" Bordered="true" Striped="true" ScrollHeight="360px">
                <TableColumn TItem="TelemetryRow" Title="ID" Property="x => x.Id" Width="90px" Fixed="ColumnFixed.Left" Sortable="true" />
                <TableColumn TItem="TelemetryRow" Title="Service" Property="x => x.Service" Resizable="true" Sortable="true" Filterable="true" />
                <TableColumn TItem="TelemetryRow" Title="Region" Property="x => x.Region" Resizable="true" Sortable="true" />
                <TableColumn TItem="TelemetryRow" Title="Latency (ms)" Property="x => x.LatencyMs" Align="Align.Right" Sortable="true" />
                <TableColumn TItem="TelemetryRow" Title="Status" Property="x => x.Status" Fixed="ColumnFixed.Right" Width="110px" Context="row">
                    <Tag Color="@(row.Status == "Healthy" ? "green" : "red")">@row.Status</Tag>
                </TableColumn>
            </DataGridVirtual>
        </div>
    </DemoCard>

    <ApiTable Title="DataGridVirtual Properties" ComponentType="@typeof(DataGridVirtual<object>)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Bordered", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Striped", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "ScrollHeight", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "360px", DefaultValue = "400px" }
    ];

    private sealed record TelemetryRow(int Id, string Service, string Region, int LatencyMs, string Status);

    private static readonly string[] Services = ["AuthGateway", "OrderProcessor", "BillingEngine", "SearchIndexer", "NotificationHub"];
    private static readonly string[] Regions = ["eu-central-1", "us-east-1", "ap-northeast-1", "eu-west-1"];

    private readonly List<TelemetryRow> _rows = Enumerable.Range(1, 1000)
        .Select(i => new TelemetryRow(
            1000 + i,
            Services[i % Services.Length],
            Regions[i % Regions.Length],
            12 + (i * 17) % 180,
            i % 11 == 0 ? "Degraded" : "Healthy"))
        .ToList();

    private const string _gridCode = """
        <DataGridVirtual DataSource="@telemetryRows" Bordered="true" Striped="true" ScrollHeight="360px">
            <TableColumn Title="ID" Property="x => x.Id" Width="90px" Fixed="ColumnFixed.Left" Sortable="true" />
            <TableColumn Title="Service" Property="x => x.Service" Resizable="true" Sortable="true" Filterable="true" />
            <TableColumn Title="Region" Property="x => x.Region" Resizable="true" Sortable="true" />
            <TableColumn Title="Latency (ms)" Property="x => x.LatencyMs" Align="Align.Right" Sortable="true" />
            <TableColumn Title="Status" Property="x => x.Status" Fixed="ColumnFixed.Right" Width="110px" />
        </DataGridVirtual>
        """;
}