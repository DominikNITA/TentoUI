@page "/components/date-picker"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>DatePicker - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">DatePicker</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            To select or input a date with popup calendar, format strings, and clearing support.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Select dates and inspect formatting outputs dynamically.</p>
            </div>
            <div class="text-xs text-slate-400">
                Selected: <strong class="text-primary-600 dark:text-primary-400 font-mono text-sm">@(_date?.ToString("yyyy-MM-dd") ?? "None")</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-xs mx-auto">
            <DatePicker @bind-Value="_date"
                        Format="@_format"
                        Placeholder="Select target date"
                        AllowClear="_allowClear"
                        Disabled="_disabled" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Format String</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_format">
                    <option value="yyyy-MM-dd">yyyy-MM-dd</option>
                    <option value="MM/dd/yyyy">MM/dd/yyyy</option>
                    <option value="dd.MM.yyyy">dd.MM.yyyy</option>
                </select>
            </div>
            <div class="flex items-center gap-4 pt-5">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_allowClear" class="rounded text-primary-600" />
                    <span>Allow Clear</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="DatePicker Properties" Properties="@_props" />
</div>

@code {
    private DateTime? _date = DateTime.Today;
    private string _format = "yyyy-MM-dd";
    private bool _allowClear = true;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current selected date (bindable via @bind-Value).", "DateTime?", "null"),
        new("Format", "Format string for displaying date.", "string", "yyyy-MM-dd"),
        new("Placeholder", "Placeholder text when date is empty.", "string?", "Select date"),
        new("AllowClear", "Whether to show clear button.", "bool", "true"),
        new("Disabled", "Whether picker is disabled.", "bool", "false"),
        new("Size", "Size scale of input.", "ComponentSize?", "null")
    ];
}
