@page "/components/date-picker"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>DatePicker - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">DatePicker</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            To select or input a date with popup calendar, format strings, and clearing support.
        </p>
    </div>

    @* Example 1: Basic DatePicker *@
    <DemoCard Title="Basic DatePicker" Description="Select a single date using the popup calendar grid." Code="@_basicCode">
        <div class="max-w-xs p-2 space-y-2">
            <DatePicker @bind-Value="_date"
                        Format="yyyy-MM-dd"
                        Placeholder="Select target date"
                        AllowClear="true" />
            <div class="text-xs text-slate-400 font-mono">Selected: @(_date?.ToString("yyyy-MM-dd") ?? "None")</div>
        </div>
    </DemoCard>

    @* Example 2: Custom Date Format *@
    <DemoCard Title="Custom Date Formatting" Description="Format strings such as MM/dd/yyyy or dd.MM.yyyy." Code="@_formatCode">
        <div class="max-w-xs p-2">
            <DatePicker Value="@DateTime.Today"
                        Format="dd.MM.yyyy"
                        Placeholder="dd.MM.yyyy" />
        </div>
    </DemoCard>

    @* Example 3: Disabled State *@
    <DemoCard Title="Disabled DatePicker" Description="Read-only calendar input that prevents user interaction." Code="@_disabledCode">
        <div class="max-w-xs p-2">
            <DatePicker Value="@DateTime.Today"
                        Disabled="true"
                        Placeholder="Locked date" />
        </div>
    </DemoCard>

    <ApiTable Title="DatePicker Properties" Properties="@_props" />
</div>

@code {
    private DateTime? _date = DateTime.Today;

    private const string _basicCode = """
        <DatePicker @bind-Value="date"
                    Format="yyyy-MM-dd"
                    Placeholder="Select target date"
                    AllowClear="true" />
        """;

    private const string _formatCode = """
        <DatePicker Value="@DateTime.Today"
                    Format="dd.MM.yyyy" />
        """;

    private const string _disabledCode = """
        <DatePicker Value="@DateTime.Today"
                    Disabled="true" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current selected date (bindable via @bind-Value).", "DateTime?", "null"),
        new("Format", "Format string for displaying date.", "string", "yyyy-MM-dd"),
        new("Placeholder", "Placeholder text when date is empty.", "string?", "Select date"),
        new("AllowClear", "Whether to show clear button.", "bool", "true"),
        new("Disabled", "Whether picker is disabled.", "bool", "false"),
        new("Size", "Size scale of input.", "ComponentSize?", "null")
    ];
}