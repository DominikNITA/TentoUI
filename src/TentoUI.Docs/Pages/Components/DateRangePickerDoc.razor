@page "/components/date-range-picker"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>DateRangePicker - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">DateRangePicker</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Start and end date range selector with quick presets ("Today", "Last 7 Days", "Last 30 Days", "This Month") and range highlighting.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="DateRangePicker Interactive Playground"
                     ComponentTag="DateRangePicker"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Date Range with Presets" Description="Click the range input to pick a start and end date or apply a quick range preset." Code="@_rangeCode">
        <div class="max-w-sm">
            <DateRangePicker @bind-StartDate="_start"
                             @bind-EndDate="_end"
                             ShowPresets="true"
                             AllowClear="true" />
        </div>
    </DemoCard>

    <ApiTable Title="DateRangePicker Properties" ComponentType="@typeof(DateRangePicker)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "PlaceholderStart", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Start date", DefaultValue = "Start date" },
        new() { Name = "PlaceholderEnd", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "End date", DefaultValue = "End date" },
        new() { Name = "Format", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "yyyy-MM-dd", DefaultValue = "yyyy-MM-dd", Options = ["yyyy-MM-dd", "MM/dd/yyyy", "dd.MM.yyyy"] },
        new() { Name = "ShowPresets", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "AllowClear", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private DateTime? _start = DateTime.Today.AddDays(-6);
    private DateTime? _end = DateTime.Today;

    private const string _rangeCode = """
        <DateRangePicker ShowPresets="true" AllowClear="true" />
        """;
}
