@page "/components/descriptions"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Descriptions - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Descriptions</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Display multiple field terms and key-value properties in a compact, structured layout.
        </p>
    </div>

    @* Example 1: Bordered Descriptions *@
    <DemoCard Title="Bordered Descriptions Grid" Description="Standard structured grid layout with clear borders and shaded headers." Code="@_borderedCode">
        <Descriptions Title="System Cluster Info" Bordered="true" Column="3">
            <DescriptionsItem Label="Cluster Name">prod-cluster-us-east-1</DescriptionsItem>
            <DescriptionsItem Label="Status">Healthy</DescriptionsItem>
            <DescriptionsItem Label="Nodes">12 / 12 Active</DescriptionsItem>
            <DescriptionsItem Label="Kubernetes Version">v1.31.2</DescriptionsItem>
            <DescriptionsItem Label="Uptime">99.99% (94 days)</DescriptionsItem>
            <DescriptionsItem Label="Primary Region">us-east-1</DescriptionsItem>
        </Descriptions>
    </DemoCard>

    @* Example 2: Borderless Descriptions *@
    <DemoCard Title="Borderless Profile Info" Description="Minimalist layout without borders for sleek embedded panels." Code="@_borderlessCode">
        <Descriptions Title="User Information" Bordered="false" Column="2">
            <DescriptionsItem Label="Full Name">Sarah Connor</DescriptionsItem>
            <DescriptionsItem Label="Telephone">+1 555-0199</DescriptionsItem>
            <DescriptionsItem Label="Email">sarah.connor@sky.net</DescriptionsItem>
            <DescriptionsItem Label="Department">Autonomous Defense Systems</DescriptionsItem>
        </Descriptions>
    </DemoCard>

    <ApiTable Title="Descriptions Properties" Properties="@_descProps" />
    <ApiTable Title="DescriptionsItem Properties" Properties="@_itemProps" />
</div>

@code {
    private const string _borderedCode = """
        <Descriptions Title="System Cluster Info" Bordered="true" Column="3">
            <DescriptionsItem Label="Cluster Name">prod-cluster-us-east-1</DescriptionsItem>
            <DescriptionsItem Label="Status">Healthy</DescriptionsItem>
            <DescriptionsItem Label="Nodes">12 / 12 Active</DescriptionsItem>
            <DescriptionsItem Label="Kubernetes Version">v1.31.2</DescriptionsItem>
            <DescriptionsItem Label="Uptime">99.99% (94 days)</DescriptionsItem>
            <DescriptionsItem Label="Primary Region">us-east-1</DescriptionsItem>
        </Descriptions>
        """;

    private const string _borderlessCode = """
        <Descriptions Title="User Information" Bordered="false" Column="2">
            <DescriptionsItem Label="Full Name">Sarah Connor</DescriptionsItem>
            <DescriptionsItem Label="Telephone">+1 555-0199</DescriptionsItem>
            <DescriptionsItem Label="Email">sarah.connor@sky.net</DescriptionsItem>
            <DescriptionsItem Label="Department">Autonomous Defense Systems</DescriptionsItem>
        </Descriptions>
        """;

    private readonly ApiTable.ApiProp[] _descProps =
    [
        new("Title", "The title of the description list.", "string?", "null"),
        new("Bordered", "Whether to display bordered grid lines around cells.", "bool", "false"),
        new("Column", "The number of descriptions items in one row.", "int", "3"),
        new("Size", "Size scale of descriptions (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Extra", "Action button or title header extra element.", "RenderFragment?", "null"),
        new("ChildContent", "DescriptionsItem child elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Label", "Label of the description item.", "string?", "null"),
        new("Span", "The number of columns included.", "int", "1"),
        new("ChildContent", "The value content.", "RenderFragment?", "null")
    ];
}