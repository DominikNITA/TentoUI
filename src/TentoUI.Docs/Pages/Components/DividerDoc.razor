@page "/components/divider"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Divider - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Divider</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            A divider line separates different content areas, supporting horizontal, vertical, solid, dashed, and titled alignments.
        </p>
    </div>

    @* Interactive Playground *@
    <PropsPlayground Title="Divider Interactive Playground"
                     ComponentTag="Divider"
                     Controls="@_playgroundControls" />

    @* Example 1: Horizontal with Title *@
    <DemoCard Title="Horizontal Divider &amp; Title Orientations" Description="Dividers can be plain lines or contain center, left, or right-aligned titles." Code="@_titleCode">
        <div class="w-full space-y-2 text-xs text-slate-600 dark:text-slate-400">
            <p>Standard solid horizontal divider without label:</p>
            <Divider />
            <p>Centered section title:</p>
            <Divider Orientation="DividerOrientation.Center">Section Overview</Divider>
            <p>Left-aligned section title:</p>
            <Divider Orientation="DividerOrientation.Left">Left Title</Divider>
            <p>Right-aligned section title:</p>
            <Divider Orientation="DividerOrientation.Right">Right Title</Divider>
        </div>
    </DemoCard>

    @* Example 2: Dashed Divider *@
    <DemoCard Title="Dashed Divider" Description="Use Dashed='true' on both plain and titled dividers for secondary section breaks." Code="@_dashedCode">
        <div class="w-full space-y-2 text-xs text-slate-600 dark:text-slate-400">
            <p>Plain dashed horizontal line:</p>
            <Divider Dashed="true" />
            <p>Dashed horizontal line with centered title:</p>
            <Divider Dashed="true">Optional Configurations</Divider>
            <p>Advanced environment parameters.</p>
        </div>
    </DemoCard>

    @* Example 3: Vertical Inline Divider *@
    <DemoCard Title="Vertical Divider" Description="Use vertical dividers between inline links or actions." Code="@_verticalCode">
        <div class="flex items-center text-xs text-slate-600 dark:text-slate-400">
            <a href="#" class="hover:text-primary-600">Home</a>
            <Divider Type="DividerType.Vertical" />
            <a href="#" class="hover:text-primary-600">Settings</a>
            <Divider Type="DividerType.Vertical" Dashed="true" />
            <a href="#" class="hover:text-primary-600">Documentation</a>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Divider Properties" ComponentType="@typeof(Divider)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Section Header", DefaultValue = "" },
        new() { Name = "Orientation", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "DividerOrientation.Center", DefaultValue = "DividerOrientation.Center", Options = ["DividerOrientation.Left", "DividerOrientation.Center", "DividerOrientation.Right"] },
        new() { Name = "Dashed", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private const string _titleCode = """
        <div class="w-full space-y-2 text-xs">
            <p>Standard solid horizontal divider without label:</p>
            <Divider />
            <p>Centered section title:</p>
            <Divider Orientation="DividerOrientation.Center">Section Overview</Divider>
            <p>Left-aligned section title:</p>
            <Divider Orientation="DividerOrientation.Left">Left Title</Divider>
            <p>Right-aligned section title:</p>
            <Divider Orientation="DividerOrientation.Right">Right Title</Divider>
        </div>
        """;

    private const string _dashedCode = """
        <div class="w-full space-y-2 text-xs">
            <p>Plain dashed horizontal line:</p>
            <Divider Dashed="true" />
            <p>Dashed horizontal line with centered title:</p>
            <Divider Dashed="true">Optional Configurations</Divider>
            <p>Advanced environment parameters.</p>
        </div>
        """;

    private const string _verticalCode = """
        <div class="flex items-center text-xs text-slate-600">
            <a href="#">Home</a>
            <Divider Type="DividerType.Vertical" />
            <a href="#">Settings</a>
            <Divider Type="DividerType.Vertical" Dashed="true" />
            <a href="#">Documentation</a>
        </div>
        """;
}
