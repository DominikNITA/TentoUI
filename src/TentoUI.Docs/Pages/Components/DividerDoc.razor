@page "/components/divider"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Divider - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Divider</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A divider line separates different content areas, supporting horizontal, vertical, dashed, and titled alignments.
        </p>
    </div>

    @* Example 1: Horizontal with Title *@
    <DemoCard Title="Horizontal Divider with Title" Description="Dividers can contain center, left, or right-aligned titles." Code="@_titleCode">
        <div class="space-y-4">
            <p class="text-xs text-slate-500">Above the divider content region.</p>
            <Divider Orientation="DividerOrientation.Center">Section Overview</Divider>
            <p class="text-xs text-slate-500">Content placed between distinct sections.</p>
            <Divider Orientation="DividerOrientation.Left">Left Title</Divider>
            <p class="text-xs text-slate-500">Section details continuation.</p>
        </div>
    </DemoCard>

    @* Example 2: Dashed Divider *@
    <DemoCard Title="Dashed Divider" Description="Use dashed borders for subtle or secondary section breaks." Code="@_dashedCode">
        <div class="space-y-4">
            <p class="text-xs text-slate-500">Primary task instructions.</p>
            <Divider Dashed="true">Optional Configurations</Divider>
            <p class="text-xs text-slate-500">Advanced environment parameters.</p>
        </div>
    </DemoCard>

    @* Example 3: Vertical Inline Divider *@
    <DemoCard Title="Vertical Divider" Description="Use vertical dividers between inline links or actions." Code="@_verticalCode">
        <div class="flex items-center text-xs text-slate-600 dark:text-slate-400">
            <a href="#" class="hover:text-primary-600">Home</a>
            <Divider Type="DividerType.Vertical" />
            <a href="#" class="hover:text-primary-600">Settings</a>
            <Divider Type="DividerType.Vertical" />
            <a href="#" class="hover:text-primary-600">Documentation</a>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Divider Properties" Properties="@_props" />
</div>

@code {
    private const string _titleCode = """
        <p>Above the divider content region.</p>
        <Divider Orientation="DividerOrientation.Center">Section Overview</Divider>
        <p>Content placed between distinct sections.</p>
        <Divider Orientation="DividerOrientation.Left">Left Title</Divider>
        """;

    private const string _dashedCode = """
        <Divider Dashed="true">Optional Configurations</Divider>
        """;

    private const string _verticalCode = """
        <div class="flex items-center text-xs text-slate-600">
            <a href="#">Home</a>
            <Divider Type="DividerType.Vertical" />
            <a href="#">Settings</a>
            <Divider Type="DividerType.Vertical" />
            <a href="#">Documentation</a>
        </div>
        """;

    private readonly ApiProp[] _props =
    [
        new("Type", "Direction of divider: Horizontal or Vertical.", "DividerType", "DividerType.Horizontal"),
        new("Orientation", "Alignment of inner text: Left, Center, Right.", "DividerOrientation", "DividerOrientation.Center"),
        new("Dashed", "Whether the divider line is dashed.", "bool", "false"),
        new("ChildContent", "Inner label or text rendered in the middle of the divider.", "RenderFragment?", "null")
    ];
}
