@page "/components/drawer"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Drawer - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Drawer</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A panel which slides out from the edge of the screen, supporting custom edge placements, widths, and nested forms.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Drawer Interactive Playground"
                     ComponentTag="Drawer"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Drawer *@
    <DemoCard Title="Basic Drawer" Description="Standard sliding drawer panel triggered by an action button." Code="@_basicCode">
        <div>
            <Button Type="ButtonType.Primary" OnClick="@(() => _openBasic = true)">
                Open Right Drawer
            </Button>

            <Drawer @bind-Open="_openBasic"
                    Title="Workspace Configurations"
                    Placement="DrawerPlacement.Right"
                    Width="360px">
                <div class="space-y-4 text-xs text-slate-600 dark:text-slate-300">
                    <p>Customize project repository and notification webhooks.</p>
                    <Input Placeholder="Webhook URL" />
                    <Button Type="ButtonType.Primary" Block="true" OnClick="@(() => _openBasic = false)">
                        Save Settings
                    </Button>
                </div>
            </Drawer>
        </div>
    </DemoCard>

    @* Example 2: Placements (Left / Top / Bottom) *@
    <DemoCard Title="Alternative Placements" Description="Drawers can slide out from Left, Top, or Bottom screen edges." Code="@_leftCode">
        <div class="flex items-center gap-3">
            <Button OnClick="@(() => _openLeft = true)">Slide from Left</Button>

            <Drawer @bind-Open="_openLeft"
                    Title="Navigation Menu"
                    Placement="DrawerPlacement.Left"
                    Width="280px">
                <div class="space-y-2 text-xs">
                    <p class="font-semibold text-slate-900 dark:text-white">Quick Links</p>
                    <ul class="space-y-1 text-slate-600 dark:text-slate-400">
                        <li><a href="#" class="hover:text-primary-600">Dashboard</a></li>
                        <li><a href="#" class="hover:text-primary-600">Analytics</a></li>
                        <li><a href="#" class="hover:text-primary-600">Settings</a></li>
                    </ul>
                </div>
            </Drawer>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Drawer Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Workspace Configuration", DefaultValue = "" },
        new() { Name = "Placement", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "DrawerPlacement.Right", DefaultValue = "DrawerPlacement.Right", Options = ["DrawerPlacement.Right", "DrawerPlacement.Left", "DrawerPlacement.Top", "DrawerPlacement.Bottom"] },
        new() { Name = "Width", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "360px", DefaultValue = "378px" },
        new() { Name = "Closable", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Mask", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Content", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "<p class=\"text-xs text-slate-500\">Manage integration webhooks and team permissions.</p>", DefaultValue = "", IsChildContent = true }
    ];

    private bool _openBasic;
    private bool _openLeft;

    private const string _basicCode = """
        <Button Type="ButtonType.Primary" OnClick="@(() => _open = true)">
            Open Drawer
        </Button>

        <Drawer @bind-Open="_open"
                Title="Workspace Configurations"
                Placement="DrawerPlacement.Right"
                Width="360px">
            <p>Drawer content goes here...</p>
        </Drawer>
        """;

    private const string _leftCode = """
        <Button Type="ButtonType.Primary" OnClick="@(() => _openLeft = true)">
            Slide from Left
        </Button>

        <Drawer @bind-Open="_openLeft"
                Title="Navigation Menu"
                Placement="DrawerPlacement.Left"
                Width="280px">
            <p>Navigation links...</p>
        </Drawer>
        """;

    private readonly ApiProp[] _props =
    [
        new("Open", "Whether the drawer dialog is visible (two-way bindable).", "bool", "false"),
        new("Title", "The header title of the drawer.", "string?", "null"),
        new("Placement", "Screen edge: Right, Left, Top, Bottom.", "DrawerPlacement", "DrawerPlacement.Right"),
        new("Width", "Width of horizontal drawer (e.g. '360px').", "string", "378px"),
        new("Height", "Height of vertical drawer (e.g. '300px').", "string", "378px"),
        new("Closable", "Whether to show dismiss close 'X' icon.", "bool", "true"),
        new("MaskClosable", "Clicking backdrop mask closes the drawer.", "bool", "true"),
        new("ChildContent", "Body content rendered inside drawer.", "RenderFragment?", "null")
    ];
}
