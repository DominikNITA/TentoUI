@page "/components/dropdown"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Dropdown - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Dropdown</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A dropdown menu triggered by hover or click, positioning a floating contextual overlay next to its trigger.
        </p>
    </div>

    @* Example 1: Basic Click Dropdown *@
    <DemoCard Title="Click Trigger Dropdown" Description="Standard button that opens a contextual action list on click." Code="@_clickCode">
        <div class="p-4 flex items-center justify-center">
            <Dropdown Text="Options Menu" Trigger="DropdownTrigger.Click" Placement="DropdownPlacement.BottomLeft">
                <Overlay>
                    <div class="py-1 w-48 bg-white dark:bg-slate-900 rounded-lg shadow-lg border border-slate-200 dark:border-slate-800 text-xs text-slate-700 dark:text-slate-300">
                        <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                                @onclick="@(() => HandleSelect("Export PDF"))">
                            Export as PDF
                        </button>
                        <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                                @onclick="@(() => HandleSelect("Export CSV"))">
                            Export as CSV
                        </button>
                        <div class="h-px bg-slate-100 dark:bg-slate-800 my-1"></div>
                        <button type="button" class="w-full text-left px-3 py-1.5 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40"
                                @onclick="@(() => HandleSelect("Archive"))">
                            Archive Record
                        </button>
                    </div>
                </Overlay>
            </Dropdown>
        </div>
    </DemoCard>

    @* Example 2: Hover Trigger *@
    <DemoCard Title="Hover Trigger Dropdown" Description="Expands immediately when hovering over the trigger element." Code="@_hoverCode">
        <div class="p-4 flex items-center justify-center">
            <Dropdown Text="Hover for Actions" Trigger="DropdownTrigger.Hover" Placement="DropdownPlacement.BottomLeft">
                <Overlay>
                    <div class="py-1 w-40 bg-white dark:bg-slate-900 rounded-lg shadow-lg border border-slate-200 dark:border-slate-800 text-xs text-slate-700 dark:text-slate-300">
                        <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                                @onclick="@(() => HandleSelect("Quick Edit"))">
                            Quick Edit
                        </button>
                        <button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                                @onclick="@(() => HandleSelect("Duplicate"))">
                            Duplicate
                        </button>
                    </div>
                </Overlay>
            </Dropdown>
        </div>
    </DemoCard>

    <ApiTable Title="Dropdown Properties" Properties="@_props" />
</div>

@code {
    private void HandleSelect(string action)
    {
        MessageService.Success($"Selected: {action}");
    }

    private const string _clickCode = """
        <Dropdown Text="Options Menu" Trigger="DropdownTrigger.Click">
            <Overlay>
                <div class="py-1 w-48 bg-white dark:bg-slate-900 rounded-lg shadow-lg border border-slate-200">
                    <button class="w-full text-left px-3 py-1.5 hover:bg-slate-100">Export as PDF</button>
                    <button class="w-full text-left px-3 py-1.5 hover:bg-slate-100">Export as CSV</button>
                    <div class="h-px bg-slate-100 my-1"></div>
                    <button class="w-full text-left px-3 py-1.5 text-rose-500">Archive</button>
                </div>
            </Overlay>
        </Dropdown>
        """;

    private const string _hoverCode = """
        <Dropdown Text="Hover for Actions" Trigger="DropdownTrigger.Hover">
            <Overlay>
                <div class="py-1 w-40 bg-white dark:bg-slate-900 rounded-lg shadow-lg border border-slate-200">
                    <button class="w-full text-left px-3 py-1.5 hover:bg-slate-100">Quick Edit</button>
                    <button class="w-full text-left px-3 py-1.5 hover:bg-slate-100">Duplicate</button>
                </div>
            </Overlay>
        </Dropdown>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Text", "Label for default button trigger.", "string?", "null"),
        new("Trigger", "Event triggering the overlay: Click or Hover.", "DropdownTrigger", "DropdownTrigger.Hover"),
        new("Placement", "Placement position relative to trigger (BottomLeft, BottomRight, TopLeft, TopRight).", "DropdownPlacement", "DropdownPlacement.BottomLeft"),
        new("Disabled", "Whether dropdown interaction is disabled.", "bool", "false"),
        new("Overlay", "Dropdown popup content template.", "RenderFragment?", "null"),
        new("ChildContent", "Custom trigger element template.", "RenderFragment?", "null")
    ];
}