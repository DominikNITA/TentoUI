@page "/components/dropdown"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Dropdown - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Dropdown</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A contextual overlay menu triggered by click or hover, supporting structured DropdownMenuItem models or custom Overlay content.
        </p>
    </div>

    <PropsPlayground Title="Dropdown Interactive Playground"
                     ComponentTag="Dropdown"
                     Controls="@_playgroundControls" />

    <!-- Structured Items Dropdown -->
    <DemoCard Title="Structured Menu Items"
              Description="Bind a collection of DropdownMenuItem records with icons, shortcuts, dividers, and destructive actions."
              Code="@_itemsCode">
        <div class="h-36 flex items-start gap-4">
            <Dropdown Text="Account Actions"
                      Items="@_menuItems"
                      OnItemClick="@(key => MessageService.Info($"Selected action: {key}"))" />
        </div>
    </DemoCard>

    <!-- Custom Overlay Dropdown -->
    <DemoCard Title="Custom Overlay Content"
              Description="Use the Overlay RenderFragment for custom menu items inside the dropdown container."
              Code="@_clickCode">
        <div class="h-36 flex items-start">
            <Dropdown Trigger="DropdownTrigger.Click">
                <ChildContent>
                    <Button Type="ButtonType.Default" IconName="@IconNames.ChevronDown" IconPosition="IconPosition.End">
                        Workspace Menu
                    </Button>
                </ChildContent>
                <Overlay>
                    <div class="w-48">
                        <button type="button" class="w-full text-left px-3 py-2 text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2 border-0">
                            <Icon Name="@IconNames.User" Size="14" /> Profile
                        </button>
                        <button type="button" class="w-full text-left px-3 py-2 text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2 border-0">
                            <Icon Name="@IconNames.Settings" Size="14" /> Settings
                        </button>
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
                        <button type="button" class="w-full text-left px-3 py-2 text-xs text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 flex items-center gap-2 border-0">
                            <Icon Name="@IconNames.Trash2" Size="14" /> Delete Workspace
                        </button>
                    </div>
                </Overlay>
            </Dropdown>
        </div>
    </DemoCard>

    <!-- Hover Trigger & Placement -->
    <DemoCard Title="Hover Trigger &amp; Placement"
              Description="Open the dropdown on mouse hover and customize the overlay placement."
              Code="@_hoverCode">
        <div class="h-36 flex items-start gap-4">
            <Dropdown Trigger="DropdownTrigger.Hover"
                      Placement="DropdownPlacement.BottomLeft"
                      Text="Hover Me"
                      Items="@_menuItems" />
            <Dropdown Trigger="DropdownTrigger.Click"
                      Placement="DropdownPlacement.BottomRight"
                      Text="Bottom Right"
                      Items="@_menuItems" />
        </div>
    </DemoCard>

    <ApiTable Title="Dropdown Properties" ComponentType="@typeof(Dropdown)" />

    <ApiTable Title="DropdownMenuItem Properties" ComponentType="@typeof(DropdownMenuItem)" />
</div>

@code {
    private readonly DropdownMenuItem[] _menuItems =
    [
        new("profile", "Profile Settings", IconNames.User, Shortcut: "Ctrl+P"),
        new("billing", "Workspace Settings", IconNames.Settings),
        new("logout", "Delete Account", IconNames.Trash2, Danger: true, DividerBefore: true)
    ];

    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Text", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Account Actions", DefaultValue = "" },
        new() { Name = "Trigger", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "DropdownTrigger.Click", DefaultValue = "DropdownTrigger.Click", Options = ["DropdownTrigger.Click", "DropdownTrigger.Hover"] },
        new() { Name = "Placement", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "DropdownPlacement.BottomLeft", DefaultValue = "DropdownPlacement.BottomLeft", Options = ["DropdownPlacement.BottomLeft", "DropdownPlacement.BottomCenter", "DropdownPlacement.BottomRight", "DropdownPlacement.TopLeft"] },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private const string _itemsCode = """
        <div class="h-36 flex items-start gap-4">
            <Dropdown Text="Account Actions" Items="@_menuItems" />
        </div>
        """;

    private const string _clickCode = """
        <div class="h-36 flex items-start">
            <Dropdown Trigger="DropdownTrigger.Click">
                <ChildContent>
                    <Button Type="ButtonType.Default" IconName="@IconNames.ChevronDown" IconPosition="IconPosition.End">
                        Workspace Menu
                    </Button>
                </ChildContent>
                <Overlay>
                    <div class="w-48">
                        <button type="button" class="w-full text-left px-3 py-2 text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2 border-0">
                            <Icon Name="@IconNames.User" Size="14" /> Profile
                        </button>
                        <button type="button" class="w-full text-left px-3 py-2 text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2 border-0">
                            <Icon Name="@IconNames.Settings" Size="14" /> Settings
                        </button>
                        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
                        <button type="button" class="w-full text-left px-3 py-2 text-xs text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 flex items-center gap-2 border-0">
                            <Icon Name="@IconNames.LogOut" Size="14" /> Logout
                        </button>
                    </div>
                </Overlay>
            </Dropdown>
        </div>
        """;

    private const string _hoverCode = """
        <div class="h-36 flex items-start gap-4">
            <Dropdown Trigger="DropdownTrigger.Hover" Placement="DropdownPlacement.BottomLeft" Text="Hover Me" Items="@_menuItems" />
            <Dropdown Trigger="DropdownTrigger.Click" Placement="DropdownPlacement.BottomRight" Text="Bottom Right" Items="@_menuItems" />
        </div>
        """;
}
