@page "/components/empty"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Empty - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Empty</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Empty state placeholder for displaying when there is no data, table rows, or search results available.
        </p>
    </div>

    @* Example 1: Basic Empty *@
    <DemoCard Title="Basic Empty State" Description="Default placeholder icon and message." Code="@_basicCode">
        <div class="p-4">
            <Empty Description="No Data" />
        </div>
    </DemoCard>

    @* Example 2: Empty with Action *@
    <DemoCard Title="Empty with Action Button" Description="Provides a call-to-action button to guide the user to create their first item." Code="@_actionCode">
        <div class="p-4">
            <Empty Description="No projects created yet">
                <Button Type="ButtonType.Primary" Size="ComponentSize.Small">
                    Create New Project
                </Button>
            </Empty>
        </div>
    </DemoCard>

    @* Example 3: Search Results Empty *@
    <DemoCard Title="Search Not Found" Description="Contextual message when a filter or search produces zero results." Code="@_searchCode">
        <div class="p-4">
            <Empty Description="No records matched your search filters. Try adjusting query terms." />
        </div>
    </DemoCard>

    <ApiTable Title="Empty Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <Empty Description="No Data" />
        """;

    private const string _actionCode = """
        <Empty Description="No projects created yet">
            <Button Type="ButtonType.Primary" Size="ComponentSize.Small">
                Create New Project
            </Button>
        </Empty>
        """;

    private const string _searchCode = """
        <Empty Description="No records matched your search filters." />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Description", "Display text for empty state.", "string?", "'No Data'"),
        new("DescriptionTemplate", "Custom template for description.", "RenderFragment?", "null"),
        new("Image", "Custom SVG/image URI to replace default illustration.", "string?", "null"),
        new("ChildContent", "Bottom action slot (e.g. create button).", "RenderFragment?", "null")
    ];
}