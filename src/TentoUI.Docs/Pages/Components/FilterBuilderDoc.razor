@page "/components/filter-builder"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>FilterBuilder - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">FilterBuilder</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Structured multi-condition query builder with AND/OR logical operators that outputs filter dictionaries directly compatible with Table&lt;TItem&gt;.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="FilterBuilder Interactive Playground"
                     ComponentTag="FilterBuilder"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Interactive Query Builder" Description="Add, modify, or remove filter conditions and apply them to your data view." Code="@_filterCode">
        <FilterBuilder Title="Employee Directory Filters"
                       OnApply="@(filters => MessageService.Success($"Applied {filters.Count} active filter(s)"))" />
    </DemoCard>

    <ApiTable Title="FilterBuilder Properties" ComponentType="@typeof(FilterBuilder)" />
    <ApiTable Title="FilterRule Properties" ComponentType="@typeof(FilterRule)" />
    <ApiTable Title="FilterFieldDefinition Properties" ComponentType="@typeof(FilterFieldDefinition)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Employee Directory Filters", DefaultValue = "Filter Builder" },
        new() { Name = "ShowApplyButton", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" }
    ];

    private const string _filterCode = """
        <FilterBuilder Title="Employee Directory Filters" ShowApplyButton="true" />
        """;
}
