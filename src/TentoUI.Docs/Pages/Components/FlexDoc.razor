        new() { Name = "Justify", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "FlexJustify.Start", DefaultValue = "FlexJustify.Start", Options = ["FlexJustify.Start", "FlexJustify.Center", "FlexJustify.End", "FlexJustify.SpaceBetween", "FlexJustify.SpaceAround", "FlexJustify.SpaceEvenly"] },
        new() { Name = "Align", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "FlexAlign.Center", DefaultValue = "FlexAlign.Stretch", Options = ["FlexAlign.Start", "FlexAlign.Center", "FlexAlign.End", "FlexAlign.Stretch", "FlexAlign.Baseline"] },
        new() { Name = "Gap", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "FlexGap.Middle", DefaultValue = "FlexGap.None", Options = ["FlexGap.None", "FlexGap.Small", "FlexGap.Middle", "FlexGap.Large"] },
        new() { Name = "Wrap", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "FlexWrap.Wrap", DefaultValue = "FlexWrap.NoWrap", Options = ["FlexWrap.NoWrap", "FlexWrap.Wrap", "FlexWrap.WrapReverse"] },
        new() { Name = "Class", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "w-full p-4 rounded-xl bg-slate-100 dark:bg-slate-800/60", DefaultValue = "" },
        new() { Name = "Content", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "<Button Type=\"ButtonType.Primary\">One</Button><Button>Two</Button><Button Type=\"ButtonType.Dashed\">Three</Button>", DefaultValue = "", IsChildContent = true }
