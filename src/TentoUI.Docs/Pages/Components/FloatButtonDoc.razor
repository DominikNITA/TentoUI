@page "/components/float-button"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>FloatButton - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">FloatButton</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A button that floats over page content to provide quick access to key contextual actions or scroll-to-top helpers.
        </p>
    </div>

    @* Example 1: Basic FloatButton *@
    <DemoCard Title="Basic FloatButton" Description="Circular floating button with an icon." Code="@_basicCode">
        <div class="flex items-center gap-4">
            <FloatButton Type="FloatButtonType.Default"
                         Icon="@IconNames.HelpCircle"
                         Tooltip="Get Help"
                         OnClick="@(() => MessageService.Info("Help requested!"))" />
            <FloatButton Type="FloatButtonType.Primary"
                         Icon="@IconNames.Plus"
                         Tooltip="Create New"
                         OnClick="@(() => MessageService.Success("Created!"))" />
        </div>
    </DemoCard>

    @* Example 2: Square Shape with Description *@
    <DemoCard Title="Square Shape with Description" Description="Square float buttons can display a label beneath the icon." Code="@_squareCode">
        <div class="flex items-center gap-4">
            <FloatButton Type="FloatButtonType.Primary"
                         Shape="FloatButtonShape.Square"
                         Icon="@IconNames.Copy"
                         Description="COPY" />
            <FloatButton Type="FloatButtonType.Default"
                         Shape="FloatButtonShape.Square"
                         Icon="@IconNames.Download"
                         Description="DOCS" />
        </div>
    </DemoCard>

    @* Example 3: BackTop Helper *@
    <DemoCard Title="BackTop Quick Action" Description="Dedicated back-to-top floating button for long document pages." Code="@_backTopCode">
        <div class="flex items-center gap-4">
            <BackTop VisibilityHeight="0" OnClick="@(() => MessageService.Success("Scrolled to top!"))" />
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="FloatButton Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <FloatButton Type="FloatButtonType.Default" Icon="@IconNames.HelpCircle" Tooltip="Get Help" />
        <FloatButton Type="FloatButtonType.Primary" Icon="@IconNames.Plus" Tooltip="Create New" />
        """;

    private const string _squareCode = """
        <FloatButton Type="FloatButtonType.Primary" Shape="FloatButtonShape.Square" Icon="@IconNames.Copy" Description="COPY" />
        <FloatButton Type="FloatButtonType.Default" Shape="FloatButtonShape.Square" Icon="@IconNames.Download" Description="DOCS" />
        """;

    private const string _backTopCode = """
        <BackTop VisibilityHeight="300" />
        """;

    private readonly ApiProp[] _props =
    [
        new("Type", "Button variant type: Default or Primary.", "FloatButtonType", "FloatButtonType.Default"),
        new("Shape", "Shape of the button: Circle or Square.", "FloatButtonShape", "FloatButtonShape.Circle"),
        new("Icon", "Lucide icon name string.", "string?", "null"),
        new("Description", "Text description placed beneath the icon (Square only).", "string?", "null"),
        new("Tooltip", "Floating tooltip message on hover.", "string?", "null"),
        new("OnClick", "Callback executed on button click.", "EventCallback<MouseEventArgs>", "null")
    ];
}
