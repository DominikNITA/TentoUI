@page "/components/float-button"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>FloatButton &amp; BackTop - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">FloatButton &amp; BackTop</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Floating action buttons (<code class="font-mono">FloatButton</code>, <code class="font-mono">FloatButtonGroup</code>) and scroll-to-top helpers (<code class="font-mono">BackTop</code>) for quick contextual actions.
        </p>
    </div>

    @* Interactive Playground *@
    <PropsPlayground Title="FloatButton Interactive Playground"
                     ComponentTag="FloatButton"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic FloatButton *@
    <DemoCard Title="Basic FloatButton" Description="Circular floating action buttons in Default and Primary variants." Code="@_basicCode">
        <div class="flex flex-wrap items-center gap-4">
            <FloatButton Type="FloatButtonType.Default"
                         Icon="@IconNames.HelpCircle"
                         Tooltip="Get Help"
                         OnClick="@(() => MessageService.Info("Help requested!"))" />
            <FloatButton Type="FloatButtonType.Primary"
                         Icon="@IconNames.Plus"
                         Tooltip="Create New"
                         OnClick="@(() => MessageService.Success("Created!"))" />
        </div>
    </DemoCard>

    @* Example 2: Square Shape with Description *@
    <DemoCard Title="Square Shape with Description" Description="Square float buttons can display a short label beneath the icon." Code="@_squareCode">
        <div class="flex flex-wrap items-center gap-4">
            <FloatButton Type="FloatButtonType.Primary"
                         Shape="FloatButtonShape.Square"
                         Icon="@IconNames.Copy"
                         Description="COPY" />
            <FloatButton Type="FloatButtonType.Default"
                         Shape="FloatButtonShape.Square"
                         Icon="@IconNames.Download"
                         Description="DOCS" />
        </div>
    </DemoCard>

    @* Example 3: BackTop Component *@
    <DemoCard Title="BackTop (Scroll to Top)" Description="Smoothly scrolls the window back to the top. Supports Circle and Square shapes, Primary/Default styles, descriptions, and Fixed viewport pinning." Code="@_backTopCode">
        <div class="flex flex-wrap items-center gap-4">
            <BackTop Tooltip="Scroll to top" OnClick="@(() => MessageService.Success("Scrolled to top!"))" />
            <BackTop Type="FloatButtonType.Primary" Tooltip="Back to top (Primary)" OnClick="@(() => MessageService.Success("Scrolled to top!"))" />
            <BackTop Shape="FloatButtonShape.Square" Description="TOP" Tooltip="Scroll to top" OnClick="@(() => MessageService.Success("Scrolled to top!"))" />
        </div>
    </DemoCard>

    @* API Reference Tables *@
    <ApiTable Title="FloatButton Properties" ComponentType="@typeof(FloatButton)" />
    <ApiTable Title="BackTop Properties" ComponentType="@typeof(BackTop)" />
    <ApiTable Title="FloatButtonGroup Properties" ComponentType="@typeof(FloatButtonGroup)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Type", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "FloatButtonType.Primary", DefaultValue = "FloatButtonType.Default", Options = ["FloatButtonType.Default", "FloatButtonType.Primary"] },
        new() { Name = "Shape", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "FloatButtonShape.Circle", DefaultValue = "FloatButtonShape.Circle", Options = ["FloatButtonShape.Circle", "FloatButtonShape.Square"] },
        new() { Name = "Icon", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "plus", DefaultValue = "", Options = ["plus", "help-circle", "settings", "bell", "download", "arrow-up"] },
        new() { Name = "Description", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "", DefaultValue = "" },
        new() { Name = "Tooltip", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Quick Action", DefaultValue = "" }
    ];

    private const string _basicCode = """
        <FloatButton Type="FloatButtonType.Default" Icon="@IconNames.HelpCircle" Tooltip="Get Help" OnClick="@(() => MessageService.Info("Help requested!"))" />
        <FloatButton Type="FloatButtonType.Primary" Icon="@IconNames.Plus" Tooltip="Create New" OnClick="@(() => MessageService.Success("Created!"))" />
        """;

    private const string _squareCode = """
        <FloatButton Type="FloatButtonType.Primary" Shape="FloatButtonShape.Square" Icon="@IconNames.Copy" Description="COPY" />
        <FloatButton Type="FloatButtonType.Default" Shape="FloatButtonShape.Square" Icon="@IconNames.Download" Description="DOCS" />
        """;

    private const string _backTopCode = """
        <BackTop Tooltip="Scroll to top" OnClick="@(() => MessageService.Success("Scrolled to top!"))" />
        <BackTop Type="FloatButtonType.Primary" Tooltip="Back to top (Primary)" />
        <BackTop Shape="FloatButtonShape.Square" Description="TOP" />
        """;
}
