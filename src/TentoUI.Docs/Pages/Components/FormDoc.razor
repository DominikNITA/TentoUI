@page "/components/form"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Form - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Form</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Form component for collecting and validating data entries, supporting vertical, horizontal, and inline layouts.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Form Interactive Playground"
                     ComponentTag="Form"
                     Controls="@_playgroundControls" />

    @* Example 1: Vertical Form *@
    <DemoCard Title="Vertical Form" Description="Standard stacked form layout where labels appear above inputs." Code="@_verticalCode">
        <div class="max-w-md p-2">
            <Form Model="@_model" Layout="FormLayout.Vertical" OnFinish="HandleFinish">
                <FormItem Label="Username" Required="true" Help="Unique identity handle">
                    <Input @bind-Value="_model.Username" Placeholder="Enter your handle..." />
                </FormItem>

                <FormItem Label="Email Address" Required="true">
                    <Input @bind-Value="_model.Email" Placeholder="name@company.com" />
                </FormItem>

                <FormItem Label="Remember Me">
                    <Checkbox @bind-Checked="_model.RememberMe">Keep me signed in</Checkbox>
                </FormItem>

                <div class="pt-2 flex items-center gap-3">
                    <Button Type="ButtonType.Primary" HtmlType="ButtonHtmlType.Submit">Submit Form</Button>
                    <Button Type="ButtonType.Default" OnClick="@(() => _model = new())">Reset</Button>
                </div>
            </Form>
        </div>
    </DemoCard>

    @* Example 2: Horizontal Form *@
    <DemoCard Title="Horizontal Form" Description="Labels and fields aligned side-by-side in columns." Code="@_horizontalCode">
        <div class="max-w-lg p-2">
            <Form Model="@_model" Layout="FormLayout.Horizontal" OnFinish="HandleFinish">
                <FormItem Label="Full Name" Required="true">
                    <Input @bind-Value="_model.Username" />
                </FormItem>
                <FormItem Label="Work Email" Required="true">
                    <Input @bind-Value="_model.Email" />
                </FormItem>
                <div class="pt-2 flex justify-end">
                    <Button Type="ButtonType.Primary" HtmlType="ButtonHtmlType.Submit">Save Changes</Button>
                </div>
            </Form>
        </div>
    </DemoCard>

    @* Example 3: DataAnnotations Validation *@
    <DemoCard Title="Validation with DataAnnotations" Description="Automatic integration with EditContext. FormItem displays animated validation alerts directly under fields when invalid." Code="@_validationCode">
        <div class="max-w-md p-2">
            <Form Model="@_validationModel" Layout="FormLayout.Vertical" OnFinish="HandleValidationFinish" OnFinishFailed="HandleValidationFailed">
                <FormItem Label="Account Handle" For="@(() => _validationModel.Username)" Help="Allowed 3-20 characters">
                    <Input @bind-Value="_validationModel.Username" Placeholder="username..." />
                </FormItem>

                <FormItem Label="Corporate Email" For="@(() => _validationModel.Email)">
                    <Input @bind-Value="_validationModel.Email" Placeholder="user@domain.com" />
                </FormItem>

                <FormItem Label="Master Password" For="@(() => _validationModel.Password)">
                    <Input @bind-Value="_validationModel.Password" Type="InputType.Password" Placeholder="Minimum 6 characters..." />
                </FormItem>

                <div class="pt-3 flex items-center gap-3">
                    <Button Type="ButtonType.Primary" HtmlType="ButtonHtmlType.Submit">Validate &amp; Submit</Button>
                    <Button Type="ButtonType.Default" OnClick="ResetValidationModel">Clear to Trigger Errors</Button>
                </div>
            </Form>
        </div>
    </DemoCard>

    <ApiTable Title="Form Properties" Properties="@_formProps" />
    <ApiTable Title="FormItem Properties" Properties="@_itemProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Layout", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Vertical", DefaultValue = "Vertical", Options = ["Vertical", "Horizontal", "Inline"] },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    public class UserLoginForm
    {
        public string Username { get; set; } = "dominik";
        public string Email { get; set; } = "dominik@tento.dev";
        public bool RememberMe { get; set; } = true;
    }

    public class ValidatedAccountForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Account handle is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(20, MinimumLength = 3, ErrorMessage = "Handle must be between 3 and 20 characters.")]
        public string Username { get; set; } = "dominik";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email address is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please provide a valid corporate email.")]
        public string Email { get; set; } = "dominik@tento.dev";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Password must be at least 6 characters long.")]
        public string Password { get; set; } = "strongPass123";
    }

    private UserLoginForm _model = new();
    private ValidatedAccountForm _validationModel = new();

    private void HandleFinish()
    {
        MessageService.Success($"Submitted form for: {_model.Username} ({_model.Email})");
    }

    private void HandleValidationFinish()
    {
        MessageService.Success("Form validated successfully! All rules passed.");
    }

    private void HandleValidationFailed()
    {
        MessageService.Error("Validation failed. Please review errors marked in red.");
    }

    private void ResetValidationModel()
    {
        _validationModel = new ValidatedAccountForm { Username = "", Email = "invalid-mail", Password = "12" };
    }

    private const string _validationCode = """
        <Form Model="@accountModel" Layout="FormLayout.Vertical" OnFinish="HandleValid">
            <FormItem Label="Account Handle" For="@(() => accountModel.Username)">
                <Input @bind-Value="accountModel.Username" />
            </FormItem>
            <FormItem Label="Corporate Email" For="@(() => accountModel.Email)">
                <Input @bind-Value="accountModel.Email" />
            </FormItem>
            <FormItem Label="Master Password" For="@(() => accountModel.Password)">
                <Input @bind-Value="accountModel.Password" Type="InputType.Password" />
            </FormItem>
            <Button Type="ButtonType.Primary" HtmlType="ButtonHtmlType.Submit">Submit</Button>
        </Form>
        """;

    private const string _verticalCode = """
        <Form Model="@model" Layout="FormLayout.Vertical" OnFinish="HandleFinish">
            <FormItem Label="Username" Required="true">
                <Input @bind-Value="model.Username" />
            </FormItem>
            <FormItem Label="Email Address" Required="true">
                <Input @bind-Value="model.Email" />
            </FormItem>
            <Button Type="ButtonType.Primary" HtmlType="ButtonHtmlType.Submit">Submit</Button>
        </Form>
        """;

    private const string _horizontalCode = """
        <Form Model="@model" Layout="FormLayout.Horizontal" OnFinish="HandleFinish">
            <FormItem Label="Full Name" Required="true">
                <Input @bind-Value="model.Username" />
            </FormItem>
            <FormItem Label="Work Email" Required="true">
                <Input @bind-Value="model.Email" />
            </FormItem>
            <Button Type="ButtonType.Primary" HtmlType="ButtonHtmlType.Submit">Save</Button>
        </Form>
        """;

    private readonly ApiTable.ApiProp[] _formProps =
    [
        new("Model", "Form model data object.", "object?", "null"),
        new("Layout", "Form item alignment layout: Vertical, Horizontal, Inline.", "FormLayout", "FormLayout.Vertical"),
        new("OnFinish", "Callback triggered on successful form submission.", "EventCallback<EditContext>", "null"),
        new("OnFinishFailed", "Callback triggered when form validation fails.", "EventCallback<EditContext>", "null"),
        new("ChildContent", "FormItem elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Label", "Label text for the form field.", "string?", "null"),
        new("Required", "Displays a red required asterisk next to the label.", "bool", "false"),
        new("Help", "Helper or validation message text rendered below the input.", "string?", "null"),
        new("ChildContent", "Input control to host inside form item.", "RenderFragment?", "null")
    ];
}