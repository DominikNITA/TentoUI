@page "/components/gauge"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Gauge &amp; MeterGroup - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Gauge &amp; MeterGroup</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Radial SVG gauges and multi-segment stacked capacity meters for telemetry, storage quotas, and health dashboards.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Gauge Interactive Playground"
                     ComponentTag="Gauge"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Semi-Circular Radial Gauges" Description="Automatically colors thresholds (Healthy < 65%, Warning 65–85%, Critical >= 85%) or accepts explicit GaugeStatus." Code="@_gaugeCode">
        <div class="flex flex-wrap items-center justify-around gap-6">
            <Gauge Value="42" Label="CPU Load" Unit="%" />
            <Gauge Value="74" Label="Memory Pressure" Unit="%" />
            <Gauge Value="92" Label="Disk Saturation" Unit="%" />
        </div>
    </DemoCard>

    <DemoCard Title="Multi-Segment MeterGroup" Description="Stacked proportional bar with legend for multi-category resource usage." Code="@_meterCode">
        <MeterGroup Label="Cluster Storage Allocation"
                    TotalCapacity="100"
                    Unit="GB"
                    SegmentsString="Database:42,Media Assets:28,Backups:14,Logs:6" />
    </DemoCard>

    <ApiTable Title="Gauge Properties" ComponentType="@typeof(Gauge)" />
    <ApiTable Title="MeterGroup Properties" ComponentType="@typeof(MeterGroup)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Value", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "68", DefaultValue = "68" },
        new() { Name = "Min", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "0", DefaultValue = "0" },
        new() { Name = "Max", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "100", DefaultValue = "100" },
        new() { Name = "Unit", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "%", DefaultValue = "%" },
        new() { Name = "Label", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "CPU Utilization", DefaultValue = "" },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "160", DefaultValue = "160" },
        new() { Name = "StrokeWidth", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "10", DefaultValue = "10" },
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Default", DefaultValue = "Default", Options = ["Default", "Success", "Warning", "Error"] },
        new() { Name = "AutoThresholdColor", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" }
    ];

    private const string _gaugeCode = """
        <Gauge Value="42" Label="CPU Load" Unit="%" />
        <Gauge Value="74" Label="Memory Pressure" Unit="%" />
        <Gauge Value="92" Label="Disk Saturation" Unit="%" />
        """;

    private const string _meterCode = """
        <MeterGroup Label="Cluster Storage Allocation" TotalCapacity="100" Unit="GB" SegmentsString="Database:42,Media:28,Backups:14" />
        """;
}
