            <Col Span="6"><div class="bg-indigo-600 py-3 rounded-lg">col-6</div></Col>
            <Col Span="6"><div class="bg-indigo-500 py-3 rounded-lg">col-6</div></Col>
            <Col Span="6"><div class="bg-indigo-600 py-3 rounded-lg">col-6</div></Col>
            <Col Span="6"><div class="bg-indigo-600 py-3 rounded-lg">col-6 (Row 2)</div></Col>
