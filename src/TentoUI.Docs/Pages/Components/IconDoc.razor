@page "/components/icon"
@namespace TentoUI.Docs.Pages.Components
@using System.Reflection
@inject IJSRuntime JSRuntime
@inject IMessageService MessageService

<PageTitle>Icon - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Icon</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Semantic SVG icons bundled directly in TentoUI with zero external font dependencies or network requests. Click any icon in the gallery below to copy its Razor snippet.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Icon Interactive Playground"
                     ComponentTag="Icon"
                     Controls="@_playgroundControls" />

    @* Complete Searchable Icon Gallery *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">All Bundled Icons (@FilteredIcons.Count)</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Click any icon tile to copy <code class="font-mono">&lt;Icon Name="@@IconNames.X" /&gt;</code> to your clipboard.</p>
            </div>
            <div class="w-full sm:w-64">
                <input type="text"
                       placeholder="Search icons (e.g. arrow, check, user)..."
                       value="@_searchQuery"
                       @oninput="@(e => _searchQuery = e.Value?.ToString() ?? string.Empty)"
                       class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-primary-500" />
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2.5">
            @foreach (var item in FilteredIcons)
            {
                <button type="button"
                        title="@($"Copy <Icon Name=\"@IconNames.{item.ConstName}\" />")"
                        class="group p-3 rounded-xl border border-slate-200/80 dark:border-slate-800 hover:border-primary-500 dark:hover:border-primary-500 hover:bg-primary-50/40 dark:hover:bg-primary-950/30 transition-all flex flex-col items-center justify-center gap-2 cursor-pointer text-slate-700 dark:text-slate-200"
                        @onclick="@(() => CopyIconSnippetAsync(item.ConstName, item.Value))">
                    <Icon Name="@item.Value" Size="22" Class="group-hover:scale-110 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-transform" />
                    <div class="text-center w-full truncate">
                        <div class="text-[11px] font-semibold truncate">@item.ConstName</div>
                        <div class="text-[9px] font-mono text-slate-400 truncate">"@item.Value"</div>
                    </div>
                </button>
            }
        </div>
    </div>

    @* Example: Spin & SpinSpeed Presets *@
    <DemoCard Title="Spin &amp; Rotation Speed Control" Description="Control rotation speed using SpinSpeed (Slow, Normal, Fast) or pass a custom CSS duration via SpinDuration." Code="@_spinCode">
        <div class="flex flex-wrap items-center gap-8">
            <div class="flex flex-col items-center gap-2">
                <Icon Name="@IconNames.RefreshCw" Spin="true" SpinSpeed="IconSpinSpeed.Slow" Size="26" Class="text-slate-600 dark:text-slate-300" />
                <span class="text-xs font-mono text-slate-500">Slow (2.5s)</span>
            </div>
            <div class="flex flex-col items-center gap-2">
                <Icon Name="@IconNames.Loader" Spin="true" SpinSpeed="IconSpinSpeed.Normal" Size="26" Class="text-primary-600 dark:text-primary-400" />
                <span class="text-xs font-mono text-slate-500">Normal (1s)</span>
            </div>
            <div class="flex flex-col items-center gap-2">
                <Icon Name="@IconNames.Loader2" Spin="true" SpinSpeed="IconSpinSpeed.Fast" Size="26" Class="text-emerald-600 dark:text-emerald-400" />
                <span class="text-xs font-mono text-slate-500">Fast (0.4s)</span>
            </div>
            <div class="flex flex-col items-center gap-2">
                <Icon Name="@IconNames.Settings" Spin="true" SpinDuration="4s" Size="26" Class="text-amber-500" />
                <span class="text-xs font-mono text-slate-500">Custom (4s)</span>
            </div>
        </div>
    </DemoCard>

    @* Example: Sizing and Colors *@
    <DemoCard Title="Sizing and Custom Colors" Description="Control icon scale via Size parameter and color using standard Tailwind text classes." Code="@_sizingCode">
        <div class="flex items-center gap-6 text-slate-800 dark:text-slate-100">
            <Icon Name="@IconNames.Bell" Size="16" Class="text-slate-400" />
            <Icon Name="@IconNames.Bell" Size="20" Class="text-primary-500" />
            <Icon Name="@IconNames.Bell" Size="28" Class="text-amber-500" />
            <Icon Name="@IconNames.Bell" Size="36" Class="text-rose-500" />
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Icon Properties" ComponentType="@typeof(Icon)" />
</div>

@code {
    private string _searchQuery = string.Empty;

    private sealed record IconEntry(string ConstName, string Value);

    private static readonly IReadOnlyList<IconEntry> s_allIcons = typeof(IconNames)
        .GetFields(BindingFlags.Public | BindingFlags.Static | BindingFlags.FlattenHierarchy)
        .Where(f => f.IsLiteral && !f.IsInitOnly && f.FieldType == typeof(string))
        .Select(f => new IconEntry(f.Name, (string)f.GetRawConstantValue()!))
        .OrderBy(x => x.ConstName)
        .ToList();

    private IReadOnlyList<IconEntry> FilteredIcons =>
        string.IsNullOrWhiteSpace(_searchQuery)
            ? s_allIcons
            : s_allIcons.Where(i =>
                i.ConstName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Value.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Name", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "sparkles", DefaultValue = "", Options = ["sparkles", "check", "refresh-cw", "loader", "loader-2", "settings", "bell", "search", "star", "user", "home"] },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "28", DefaultValue = "16" },
        new() { Name = "Spin", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "SpinSpeed", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "IconSpinSpeed.Normal", DefaultValue = "IconSpinSpeed.Normal", Options = ["IconSpinSpeed.Slow", "IconSpinSpeed.Normal", "IconSpinSpeed.Fast"] },
        new() { Name = "Rotate", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "0", DefaultValue = "0" }
    ];

    private async Task CopyIconSnippetAsync(string constName, string value)
    {
        var snippet = $"<Icon Name=\"@IconNames.{constName}\" />";
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", snippet);
        }
        catch { }
        MessageService.Success($"Copied: {snippet} (\"{value}\")");
    }

    private const string _spinCode = """
        <Icon Name="@IconNames.RefreshCw" Spin="true" SpinSpeed="IconSpinSpeed.Slow" Size="26" />
        <Icon Name="@IconNames.Loader" Spin="true" SpinSpeed="IconSpinSpeed.Normal" Size="26" Class="text-primary-600" />
        <Icon Name="@IconNames.Loader2" Spin="true" SpinSpeed="IconSpinSpeed.Fast" Size="26" Class="text-emerald-600" />
        <Icon Name="@IconNames.Settings" Spin="true" SpinDuration="4s" Size="26" Class="text-amber-500" />
        """;

    private const string _sizingCode = """
        <Icon Name="@IconNames.Bell" Size="16" Class="text-slate-400" />
        <Icon Name="@IconNames.Bell" Size="20" Class="text-primary-500" />
        <Icon Name="@IconNames.Bell" Size="28" Class="text-amber-500" />
        <Icon Name="@IconNames.Bell" Size="36" Class="text-rose-500" />
        """;
}
