@page "/components/image"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Image - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Image</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Previewable image element supporting fallback error handlers, zoom, rotation, and modal lightbox preview.
        </p>
    </div>

    @* Example 1: Lightbox Preview *@
    <DemoCard Title="Interactive Lightbox Preview" Description="Click the image to trigger an interactive lightbox modal with zoom and rotate controls." Code="@_previewCode">
        <div class="p-4 flex items-center justify-center">
            <Image Src="https://picsum.photos/400/250"
                   Alt="Scenic Mountain"
                   Width="260"
                   Height="160"
                   Preview="true" />
        </div>
    </DemoCard>

    @* Example 2: Static Dimensions *@
    <DemoCard Title="Fixed Dimensions &amp; Aspect Ratio" Description="Display images at constrained dimensions with smooth border radiuses." Code="@_fixedCode">
        <div class="flex flex-wrap items-center gap-4 p-4">
            <Image Src="https://picsum.photos/300/200"
                   Alt="Workspace"
                   Width="180"
                   Height="120"
                   Preview="false" />
            <Image Src="https://picsum.photos/301/200"
                   Alt="Architecture"
                   Width="180"
                   Height="120"
                   Preview="false" />
        </div>
    </DemoCard>

    <ApiTable Title="Image Properties" Properties="@_props" />
</div>

@code {
    private const string _previewCode = """
        <Image Src="https://picsum.photos/400/250"
               Alt="Scenic Mountain"
               Width="260"
               Height="160"
               Preview="true" />
        """;

    private const string _fixedCode = """
        <Image Src="https://picsum.photos/300/200"
               Alt="Workspace"
               Width="180"
               Height="120"
               Preview="false" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Src", "Image address link.", "string?", "null"),
        new("Alt", "Image text alternative.", "string?", "'Image'"),
        new("Width", "Image width dimension (px or string).", "string?", "null"),
        new("Height", "Image height dimension (px or string).", "string?", "null"),
        new("Preview", "Whether clicking opens interactive modal lightbox with zoom and rotate.", "bool", "true"),
        new("Fallback", "Fallback image URL when loading fails.", "string?", "null")
    ];
}