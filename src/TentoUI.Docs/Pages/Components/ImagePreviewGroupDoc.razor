@page "/components/image-preview-group"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>ImagePreviewGroup - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">ImagePreviewGroup</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Multi-image lightbox gallery wrapper with Next/Previous arrows, keyboard navigation, zoom/rotate controls, and thumbnail strip.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="ImagePreviewGroup Interactive Playground"
                     ComponentTag="ImagePreviewGroup"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Multi-Image Lightbox Gallery" Description="Click any image below to open the shared full-screen gallery modal." Code="@_galleryCode">
        <ImagePreviewGroup>
            <Image Src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=400&q=80" Alt="Yosemite Valley" Width="160px" Height="110px" />
            <Image Src="https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=400&q=80" Alt="Alpine Peaks" Width="160px" Height="110px" />
            <Image Src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=400&q=80" Alt="Mountain Lake" Width="160px" Height="110px" />
        </ImagePreviewGroup>
    </DemoCard>

    <ApiTable Title="ImagePreviewGroup Properties" ComponentType="@typeof(ImagePreviewGroup)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls = [];

    private const string _galleryCode = """
        <ImagePreviewGroup>
            <Image Src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=400&q=80" Width="160px" Height="110px" />
            <Image Src="https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=400&q=80" Width="160px" Height="110px" />
            <Image Src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=400&q=80" Width="160px" Height="110px" />
        </ImagePreviewGroup>
        """;
}
