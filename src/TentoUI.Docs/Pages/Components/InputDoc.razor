@page "/components/input"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Input - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Input</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A basic widget for getting user input is a text field. Keyboard and mouse can be used for providing or modifying values.
        </p>
    </div>

    @* Example 1: Basic Input *@
    <DemoCard Title="Basic Input with AllowClear" Description="Standard text input with two-way binding and 1-click clear button." Code="@_basicCode">
        <div class="max-w-sm space-y-2 p-2">
            <Input @bind-Value="_value"
                   Placeholder="Type your username..."
                   AllowClear="true"
                   OnPressEnter="@(() => MessageService.Info($"Pressed Enter: {_value}"))" />
            <div class="text-xs text-slate-400 font-mono">Bound Value: @_value</div>
        </div>
    </DemoCard>

    @* Example 2: Prefix and Suffix *@
    <DemoCard Title="Prefix &amp; Suffix Icons" Description="Include helpful iconography or domain prefixes inside the input border." Code="@_iconsCode">
        <div class="space-y-3 max-w-sm p-2">
            <Input Placeholder="Search documentation...">
                <Prefix><TentoUI.Icon Name="@IconNames.Search" Size="14" Class="text-slate-400" /></Prefix>
            </Input>
            <Input Placeholder="my-company">
                <Prefix><span class="text-xs text-slate-400">https://</span></Prefix>
                <Suffix><span class="text-xs text-slate-400">.tento.io</span></Suffix>
            </Input>
        </div>
    </DemoCard>

    @* Example 3: Sizes & Password Field *@
    <DemoCard Title="Input Sizes &amp; Password" Description="Three size scales (Small, Middle, Large) and secure password masking." Code="@_sizesCode">
        <div class="space-y-3 max-w-sm p-2">
            <Input Size="ComponentSize.Small" Placeholder="Small input (size=small)" />
            <Input Size="ComponentSize.Middle" Placeholder="Middle input (default)" />
            <Input Size="ComponentSize.Large" Placeholder="Large input (size=large)" />
            <Input Type="InputType.Password" Placeholder="Enter secure password" />
        </div>
    </DemoCard>

    <ApiTable Title="Input Properties" Properties="@_props" />
</div>

@code {
    private string _value = "Hello TentoUI";

    private const string _basicCode = """
        <Input @bind-Value="value"
               Placeholder="Type your username..."
               AllowClear="true" />
        """;

    private const string _iconsCode = """
        <Input Placeholder="Search documentation...">
            <Prefix><Icon Name="@IconNames.Search" Size="14" /></Prefix>
        </Input>
        <Input Placeholder="my-company">
            <Prefix><span class="text-xs text-slate-400">https://</span></Prefix>
            <Suffix><span class="text-xs text-slate-400">.tento.io</span></Suffix>
        </Input>
        """;

    private const string _sizesCode = """
        <Input Size="ComponentSize.Small" Placeholder="Small input" />
        <Input Size="ComponentSize.Middle" Placeholder="Middle input" />
        <Input Size="ComponentSize.Large" Placeholder="Large input" />
        <Input Type="InputType.Password" Placeholder="Password" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current value of the input field (bindable via @bind-Value).", "string?", "null"),
        new("Placeholder", "Placeholder text displayed when empty.", "string?", "null"),
        new("Type", "Input HTML type (Text, Password).", "InputType", "InputType.Text"),
        new("Size", "Size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("AllowClear", "Whether to show an 'x' icon to clear text.", "bool", "false"),
        new("Disabled", "Whether input is disabled.", "bool", "false"),
        new("Prefix", "Leading prefix icon or text template.", "RenderFragment?", "null"),
        new("Suffix", "Trailing suffix icon or text template.", "RenderFragment?", "null"),
        new("OnPressEnter", "Callback fired when pressing Enter.", "EventCallback", "null")
    ];
}