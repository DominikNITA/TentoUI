@page "/components/input"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Input - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Input</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A basic widget for getting the user input is a text field. Keyboard and mouse can be used for providing or modifying values.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Type in the field and adjust sizes, prefixes, and clear button toggles.</p>
            </div>
            <div class="text-xs text-slate-400">
                Bound Value: <strong class="text-primary-600 dark:text-primary-400 font-mono">"@_value"</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-md mx-auto">
            <Input @bind-Value="_value"
                   Placeholder="@_placeholder"
                   Size="_size"
                   AllowClear="_allowClear"
                   Disabled="_disabled"
                   Type="_type"
                   OnPressEnter="@(() => MessageService.Info($"Pressed Enter: {_value}"))" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Size Scale</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_size">
                    <option value="@ComponentSize.Small">Small</option>
                    <option value="@ComponentSize.Middle">Middle (Default)</option>
                    <option value="@ComponentSize.Large">Large</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Input Type</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_type">
                    <option value="@InputType.Text">Text</option>
                    <option value="@InputType.Password">Password</option>
                </select>
            </div>
            <div class="flex flex-col gap-2 pt-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_allowClear" class="rounded text-primary-600" />
                    <span>Allow Clear Button</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    @* Use Cases *@
    <DemoCard Title="Prefix &amp; Suffix Icons" Description="Include helpful iconography inside the input border." Code="@_iconsCode">
        <div class="space-y-3 max-w-sm">
            <Input Placeholder="Search documentation...">
                <Prefix><TentoUI.Icon Name="@IconNames.Search" Size="14" Class="text-slate-400" /></Prefix>
            </Input>
            <Input Placeholder="Enter website address">
                <Prefix><span class="text-xs text-slate-400">https://</span></Prefix>
                <Suffix><span class="text-xs text-slate-400">.com</span></Suffix>
            </Input>
        </div>
    </DemoCard>

    <ApiTable Title="Input Properties" Properties="@_props" />
</div>

@code {
    private string _value = "Hello TentoUI";
    private string _placeholder = "Type something...";
    private ComponentSize _size = ComponentSize.Middle;
    private InputType _type = InputType.Text;
    private bool _allowClear = true;
    private bool _disabled;

    private const string _iconsCode = @"<Input Placeholder=""Search documentation..."">
    <Prefix><Icon Name=""@IconNames.Search"" Size=""14"" /></Prefix>
</Input>";

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current value of the input field (bindable via @bind-Value).", "string?", "null"),
        new("Placeholder", "Placeholder text displayed when empty.", "string?", "null"),
        new("Type", "Input HTML type (Text, Password).", "InputType", "InputType.Text"),
        new("Size", "Visual size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("AllowClear", "Display clear icon button when value is non-empty.", "bool", "false"),
        new("Disabled", "Whether input field is disabled.", "bool", "false"),
        new("ReadOnly", "Whether input field is read-only.", "bool", "false"),
        new("MaxLength", "Maximum allowed character count.", "int?", "null"),
        new("Prefix", "Template rendered inside input at the start.", "RenderFragment?", "null"),
        new("Suffix", "Template rendered inside input at the end.", "RenderFragment?", "null"),
        new("OnPressEnter", "Callback triggered when Enter key is pressed.", "EventCallback", "null")
    ];
}
