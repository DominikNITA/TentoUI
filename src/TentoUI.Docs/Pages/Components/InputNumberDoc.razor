@page "/components/input-number"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>InputNumber - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">InputNumber</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Enter a number within a certain range using mouse or keyboard, complete with up/down stepper handlers.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Step through values and inspect constraints dynamically.</p>
            </div>
            <div class="text-xs text-slate-400">
                Current Number: <strong class="text-primary-600 dark:text-primary-400 font-mono text-sm">@_number</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-xs mx-auto">
            <TentoUI.InputNumber TValue="double"
                                 @bind-Value="_number"
                                 Min="_min"
                                 Max="_max"
                                 Step="_step"
                                 Size="_size"
                                 Disabled="_disabled"
                                 Controls="_controls" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Step Increment</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_step" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Min Value</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_min" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Max Value</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_max" />
            </div>
            <div class="sm:col-span-3 flex items-center gap-4 pt-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_controls" class="rounded text-primary-600" />
                    <span>Show Stepper Controls</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="InputNumber Properties" Properties="@_props" />
</div>

@code {
    private double _number = 42;
    private double? _min = 0;
    private double? _max = 100;
    private double _step = 5;
    private ComponentSize _size = ComponentSize.Middle;
    private bool _controls = true;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current numeric value (bindable via @bind-Value).", "TValue", "0"),
        new("Min", "Minimum value allowed.", "double?", "null"),
        new("Max", "Maximum value allowed.", "double?", "null"),
        new("Step", "The number to which current value is increased or decreased.", "double", "1"),
        new("Controls", "Whether to show the up/down stepper arrows.", "bool", "true"),
        new("Size", "Visual size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Disabled", "Whether input is disabled.", "bool", "false"),
        new("Placeholder", "Placeholder text.", "string?", "null")
    ];
}
