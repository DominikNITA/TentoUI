@page "/components/inputs"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Inputs - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Inputs, Radio &amp; Checkbox</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Fundamental form controls including text fields, search inputs, multi-line textareas, and selection choices.
        </p>
    </div>

    <DemoCard Title="Text Inputs &amp; Search" Description="Standard text inputs with clear buttons and instant search callback." Code="@_inputsCode">
        <div class="space-y-4 max-w-sm">
            <Input @bind-Value="_text" Placeholder="Standard text input" AllowClear="true" />
            <SearchInput @bind-Value="_search" Placeholder="Instant search..." AllowClear="true" />
            <TextArea @bind-Value="_notes" Placeholder="Multi-line comments or instructions..." Rows="3" />
        </div>
    </DemoCard>

    <DemoCard Title="Checkbox &amp; Radio Groups" Description="Single toggle switches and grouped mutually-exclusive choices." Code="@_choicesCode">
        <div class="space-y-4">
            <div class="flex items-center gap-4">
                <Checkbox @bind-Checked="_rememberMe">Remember my login</Checkbox>
                <Switch @bind-Checked="_enableNotifications">
                    <CheckedChildren>ON</CheckedChildren>
                    <UnCheckedChildren>OFF</UnCheckedChildren>
                </Switch>
            </div>

            <div>
                <span class="block text-xs font-semibold text-slate-500 mb-2">Billing Frequency:</span>
                <RadioGroup @bind-Value="_plan" TValue="string">
                    <Radio Value="@("monthly")">Monthly ($19/mo)</Radio>
                    <Radio Value="@("annual")">Annual ($190/yr)</Radio>
                </RadioGroup>
            </div>
        </div>
    </DemoCard>
</div>

@code {
    private string _text = string.Empty;
    private string? _search;
    private string _notes = string.Empty;
    private bool _rememberMe = true;
    private bool _enableNotifications = true;
    private string _plan = "annual";

    private const string _inputsCode = @"<Input @bind-Value=""_text"" Placeholder=""Standard text input"" AllowClear=""true"" />
<SearchInput @bind-Value=""_search"" Placeholder=""Instant search..."" AllowClear=""true"" />
<TextArea @bind-Value=""_notes"" Placeholder=""Multi-line comments..."" Rows=""3"" />";

    private const string _choicesCode = @"<Checkbox @bind-Checked=""_rememberMe"">Remember me</Checkbox>
<Switch @bind-Checked=""_enableNotifications"" CheckedChildren=""ON"" UnCheckedChildren=""OFF"" />
<RadioGroup @bind-Value=""_plan"" TValue=""string"">
    <Radio Value=""monthly"">Monthly</Radio>
    <Radio Value=""annual"">Annual</Radio>
</RadioGroup>";
}
