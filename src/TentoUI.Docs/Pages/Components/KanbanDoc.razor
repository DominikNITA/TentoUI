@page "/components/kanban"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>KanbanBoard - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 mb-2">
            <span>New in v1.1.0</span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">KanbanBoard</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Multi-column Kanban workflow board with HTML5 drag-and-drop, accessible card movement buttons, custom card templates, and column WIP limits.
        </p>
    </div>

    <DemoCard Title="Interactive Project Pipeline" Description="Drag cards between columns or click the directional arrow buttons on any card." Code="@_kanbanCode">
        <KanbanBoard TItem="KanbanCardItem"
                     Columns="@_columns"
                     Items="@_cards"
                     OnCardMove="@(args => MessageService.Info($"Moved '{args.Item.Title}' to {args.TargetColumnKey}"))" />
    </DemoCard>

    <ApiTable Title="KanbanBoard Properties" ComponentType="@typeof(KanbanBoard<KanbanCardItem>)" />
</div>

@code {
    private readonly KanbanColumnDefinition[] _columns =
    [
        new("todo", "To Do", MaxItems: 4),
        new("in-progress", "In Progress", MaxItems: 2),
        new("done", "Done")
    ];

    private readonly System.Collections.Generic.List<KanbanCardItem> _cards =
    [
        new() { Id = "c1", Title = "Multi-version docs manifest", Description = "Fetch versions.json and preserve routes across builds", ColumnKey = "todo", Tag = "Docs" },
        new() { Id = "c2", Title = "CommandPalette Ctrl+K shortcut", Description = "Global spotlight search modal", ColumnKey = "in-progress", Tag = "Navigation" },
        new() { Id = "c3", Title = "Source-verified ApiTable", Description = "Reflect Parameter & Since attributes automatically", ColumnKey = "done", Tag = "Architecture" }
    ];

    private const string _kanbanCode = """
        <KanbanBoard TItem="KanbanCardItem" />
        """;
}
