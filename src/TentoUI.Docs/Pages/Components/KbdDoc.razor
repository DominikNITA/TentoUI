@page "/components/kbd"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Kbd &amp; HotkeyListener - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Kbd &amp; HotkeyListener</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Tactile keyboard shortcut badges (<code class="font-mono">&lt;Kbd&gt;</code>) and focusable keyboard shortcut listeners (<code class="font-mono">&lt;HotkeyListener&gt;</code>).
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Kbd Interactive Playground"
                     ComponentTag="Kbd"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Keyboard Shortcut Badges (Kbd)" Description="Each Kbd component splits a '+'-delimited chord into individual tactile keycaps. Displayed vertically below so each shortcut chord is distinct." Code="@_kbdCode">
        <div class="flex flex-col gap-3 text-xs text-slate-700 dark:text-slate-300">
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">Save File</span>
                <Kbd Keys="Alt+S" />
            </div>
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">Run Diagnostics</span>
                <Kbd Keys="Shift+K" />
            </div>
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">Format Document</span>
                <Kbd Keys="Shift+Alt+F" />
            </div>
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">macOS Quick Open</span>
                <Kbd Keys="⌘+P" />
            </div>
        </div>
    </DemoCard>

    <DemoCard Title="Interactive HotkeyListener" Description="Click either listener box below to focus it, then press the displayed key combination (e.g. Alt+S or Shift+K) to trigger the action without conflicting with browser shortcuts." Code="@_hotkeyCode">
        <div class="flex flex-col gap-3">
            <HotkeyListener Shortcut="Alt+S" Description="Click here, then press shortcut to Save Draft:" />
            <HotkeyListener Shortcut="Shift+K" Description="Click here, then press shortcut to Run Check:" />
        </div>
    </DemoCard>

    <ApiTable Title="Kbd Properties" ComponentType="@typeof(Kbd)" />
    <ApiTable Title="HotkeyListener Properties" ComponentType="@typeof(HotkeyListener)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Keys", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Ctrl+Shift+P", DefaultValue = "" }
    ];

    private const string _kbdCode = """
        <div class="flex flex-col gap-3 text-xs">
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">Save File</span>
                <Kbd Keys="Alt+S" />
            </div>
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">Run Diagnostics</span>
                <Kbd Keys="Shift+K" />
            </div>
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">Format Document</span>
                <Kbd Keys="Shift+Alt+F" />
            </div>
            <div class="flex items-center justify-between max-w-xs p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <span class="font-medium">macOS Quick Open</span>
                <Kbd Keys="⌘+P" />
            </div>
        </div>
        """;

    private const string _hotkeyCode = """
        <div class="flex flex-col gap-3">
            <HotkeyListener Shortcut="Alt+S" Description="Click here, then press shortcut to Save Draft:" />
            <HotkeyListener Shortcut="Shift+K" Description="Click here, then press shortcut to Run Check:" />
        </div>
        """;
}
