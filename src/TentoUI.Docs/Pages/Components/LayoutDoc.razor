@page "/components/layout"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Layout - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Layout</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Standard full-page application scaffolding including Header, Sider, Content, and Footer.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Layout Interactive Playground"
                     ComponentTag="Layout"
                     Controls="@_playgroundControls" />

    @* Example 1: Sider on Left *@
    <DemoCard Title="Application Layout Structure" Description="Nested layout with sidebar on the left, top header, main content body, and footer." Code="@_leftSiderCode">
        <div class="h-64 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 text-xs">
            <Layout Class="h-full">
                <Sider Collapsible="false" Width="140" Class="bg-slate-800 text-slate-200 p-3 flex items-center justify-center font-medium">
                    Sider
                </Sider>
                <Layout>
                    <Header Class="bg-slate-100 dark:bg-slate-900 px-4 py-2 border-b border-slate-200 dark:border-slate-800 flex items-center font-medium text-slate-700 dark:text-slate-300">
                        Header
                    </Header>
                    <Content Class="p-4 bg-white dark:bg-slate-950 text-slate-600 dark:text-slate-400">
                        Content Body Area
                    </Content>
                    <Footer Class="px-4 py-2 text-center bg-slate-50 dark:bg-slate-900 text-[11px] text-slate-600 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800">
                        Footer © 2026 TentoUI
                    </Footer>
                </Layout>
            </Layout>
        </div>
    </DemoCard>

    @* Example 2: Header at Top *@
    <DemoCard Title="Top Header with Nested Sider" Description="Full-width header at the top spanning above both the sidebar and content." Code="@_topHeaderCode">
        <div class="h-64 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800 text-xs">
            <Layout Class="h-full">
                <Header Class="bg-slate-900 text-white px-4 py-2 flex items-center font-semibold">
                    Global Top Bar
                </Header>
                <Layout>
                    <Sider Collapsible="false" Width="130" Class="bg-slate-100 dark:bg-slate-800 p-3 flex items-center justify-center font-medium text-slate-700 dark:text-slate-300">
                        Navigation Sider
                    </Sider>
                    <Content Class="p-4 bg-white dark:bg-slate-950 text-slate-600 dark:text-slate-400">
                        Main Application Content
                    </Content>
                </Layout>
                <Footer Class="px-4 py-1.5 text-center bg-slate-50 dark:bg-slate-900 text-[11px] text-slate-600 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800">
                    Footer
                </Footer>
            </Layout>
        </div>
    </DemoCard>

    <ApiTable Title="Layout Properties" Properties="@_layoutProps" />
    <ApiTable Title="Sider Properties" Properties="@_siderProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "HasSider", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private const string _leftSiderCode = """
        <Layout>
            <Sider Width="140">Sider</Sider>
            <Layout>
                <Header>Header</Header>
                <Content>Content Body</Content>
                <Footer>Footer</Footer>
            </Layout>
        </Layout>
        """;

    private const string _topHeaderCode = """
        <Layout>
            <Header>Global Top Bar</Header>
            <Layout>
                <Sider Width="130">Navigation Sider</Sider>
                <Content>Main Content</Content>
            </Layout>
            <Footer>Footer</Footer>
        </Layout>
        """;

    private readonly ApiTable.ApiProp[] _layoutProps =
    [
        new("HasSider", "Whether the layout contains a child Sider component.", "bool?", "null"),
        new("Class", "Additional CSS class names.", "string?", "null"),
        new("ChildContent", "Layout children elements (Header, Sider, Content, Footer).", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _siderProps =
    [
        new("Width", "Width in pixels of the sider.", "int", "200"),
        new("CollapsedWidth", "Width when sider is collapsed.", "int", "80"),
        new("Collapsible", "Whether the sider can be collapsed.", "bool", "false"),
        new("Collapsed", "Whether the sider is currently collapsed (bindable via @bind-Collapsed).", "bool", "false"),
        new("OnCollapse", "Callback when collapse state changes.", "EventCallback<bool>", "null"),
        new("ChildContent", "Sider content.", "RenderFragment?", "null")
    ];
}