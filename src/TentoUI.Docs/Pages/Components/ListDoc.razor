@page "/components/list"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>List - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">List</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Simple and clean list view for text, avatars, actions, and metadata rows.
            Items can be declared directly as child components or bound to dynamic data collections.
        </p>
    </div>

    @* Example 1: Basic List *@
    <DemoCard Title="Basic List with Metadata"
              Description="List items featuring letter avatars, titles, and descriptions. All items are visible and editable in the snippet."
              Code="@_basicCode" />

    @* Example 2: List with Header & Footer *@
    <DemoCard Title="Header &amp; Footer Slots"
              Description="Includes header title bar and summary footer slots with declarative items."
              Code="@_headerFooterCode" />

    <ApiTable Title="List Properties" Properties="@_listProps" />
    <ApiTable Title="ListItem Properties" Properties="@_itemProps" />
</div>

@code {
    private const string _basicCode = """
        <div class="max-w-lg">
            <ListView Bordered="true">
                <ListItem>
                    <ListItemMeta Title="Setup Blazor WASM Showcase" Description="Assigned to Engineering Core Team">
                        <Avatar><Avatar Text="S" Size="ComponentSize.Small" /></Avatar>
                    </ListItemMeta>
                </ListItem>
                <ListItem>
                    <ListItemMeta Title="Implement Table with customizable columns" Description="Assigned to Engineering Core Team">
                        <Avatar><Avatar Text="I" Size="ComponentSize.Small" /></Avatar>
                    </ListItemMeta>
                </ListItem>
                <ListItem>
                    <ListItemMeta Title="Add GitHub Pages automated workflow" Description="Assigned to Engineering Core Team">
                        <Avatar><Avatar Text="A" Size="ComponentSize.Small" /></Avatar>
                    </ListItemMeta>
                </ListItem>
            </ListView>
        </div>
        """;

    private const string _headerFooterCode = """
        <div class="max-w-lg">
            <ListView Bordered="true">
                <Header>
                    <span class="font-bold text-xs text-slate-700 dark:text-slate-300">Upcoming Release Roadmap</span>
                </Header>
                <Footer>
                    <span class="text-xs text-slate-400">Total Milestones: 3 Scheduled</span>
                </Footer>
                <ListItem><span class="text-xs font-medium text-slate-800 dark:text-slate-200">v1.0.0 - General Availability</span></ListItem>
                <ListItem><span class="text-xs font-medium text-slate-800 dark:text-slate-200">v1.1.0 - Form Validation Suite</span></ListItem>
                <ListItem><span class="text-xs font-medium text-slate-800 dark:text-slate-200">v1.2.0 - Rich Text Editor Integration</span></ListItem>
            </ListView>
        </div>
        """;

    private readonly ApiTable.ApiProp[] _listProps =
    [
        new("Bordered", "Whether to show outer bordered container.", "bool", "false"),
        new("Header", "List header slot.", "RenderFragment?", "null"),
        new("Footer", "List footer slot.", "RenderFragment?", "null"),
        new("ChildContent", "Declarative ListItem child elements.", "RenderFragment?", "null"),
        new("DataSource", "Data source collection for list rows.", "IEnumerable<TItem>?", "null"),
        new("ItemTemplate", "Custom template for each list item row.", "RenderFragment<TItem>?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Actions", "Actions slot for edit/delete buttons.", "RenderFragment?", "null"),
        new("Extra", "Extra right-side content slot.", "RenderFragment?", "null"),
        new("ChildContent", "Item content (typically ListItemMeta).", "RenderFragment?", "null")
    ];
}
