@page "/components/list"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>List - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">List</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Simple and clean list view for text, avatars, actions, and metadata rows.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Toggle borders and header/footer slots dynamically.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-lg mx-auto">
            <TentoUI.List TItem="string" DataSource="@_tasks" Bordered="_bordered">
                <Header>
                    <span class="font-bold text-xs text-slate-700 dark:text-slate-300">Sprint Backlog Items</span>
                </Header>
                <ItemTemplate Context="task">
                    <ListItem>
                        <ListItemMeta Title="@task" Description="Assigned to Core Team">
                            <Avatar><Avatar Text="@task[..1]" Size="ComponentSize.Small" /></Avatar>
                        </ListItemMeta>
                    </ListItem>
                </ItemTemplate>
            </TentoUI.List>
        </div>

        <div class="flex items-center gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_bordered" class="rounded text-primary-600" />
                <span>Show Outer Border</span>
            </label>
        </div>
    </div>

    <ApiTable Title="List Properties" Properties="@_listProps" />
    <ApiTable Title="ListItem Properties" Properties="@_itemProps" />
</div>

@code {
    private readonly string[] _tasks =
    [
        "Setup Blazor WASM Showcase",
        "Implement Table with customizable columns",
        "Add GitHub Pages automated workflow",
        "Verify .NET 10 compilation and tests"
    ];

    private bool _bordered = true;

    private readonly ApiTable.ApiProp[] _listProps =
    [
        new("DataSource", "Data source collection for list rows.", "IEnumerable<TItem>?", "null"),
        new("Bordered", "Whether to show outer bordered container.", "bool", "false"),
        new("Header", "List header renderer.", "RenderFragment?", "null"),
        new("Footer", "List footer renderer.", "RenderFragment?", "null"),
        new("ItemTemplate", "Custom template for each list item row.", "RenderFragment<TItem>?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Actions", "Actions slot for edit/delete buttons.", "RenderFragment?", "null"),
        new("Extra", "Extra right-side content slot.", "RenderFragment?", "null"),
        new("ChildContent", "Item content (typically ListItemMeta).", "RenderFragment?", "null")
    ];
}
