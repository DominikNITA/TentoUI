@page "/components/media"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Calendar &amp; QRCode - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Calendar &amp; QRCode</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Full-month calendar view with date selection and dynamic SVG QR Code generation.
        </p>
    </div>

    <DemoCard Title="QRCode Generator" Description="Generate scannable QR codes with custom size, colors, and error correction." Code="@_qrCode">
        <div class="flex items-center gap-6">
            <QRCode Value="https://github.com/dominik/TentoUI" Size="140" />
            <div class="space-y-1 text-xs">
                <p class="font-semibold text-slate-800 dark:text-slate-200">Scan to visit repository</p>
                <p class="text-slate-500">Supports direct SVG rendering with zero external images.</p>
            </div>
        </div>
    </DemoCard>

    <DemoCard Title="Full Calendar" Description="Interactive calendar grid with month navigation and day picking." Code="@_calendarCode">
        <div class="max-w-xl rounded-lg border border-slate-200 dark:border-slate-800 overflow-hidden bg-white dark:bg-slate-900">
            <Calendar @bind-Value="_selectedDate" />
        </div>
        <p class="text-xs text-slate-400 mt-2">Selected Date: @_selectedDate</p>
    </DemoCard>
</div>

@code {
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);

    private const string _qrCode = @"<QRCode Value=""https://github.com/dominik/TentoUI"" Size=""140"" />";
    private const string _calendarCode = @"<Calendar @bind-Value=""_selectedDate"" />";
}
