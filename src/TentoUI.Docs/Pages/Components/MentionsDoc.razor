@page "/components/mentions"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Mentions - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Mentions</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Input and textarea control with @("@") or # trigger popups for tagging team members, issues, or channels.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Mentions Interactive Playground"
                     ComponentTag="Mentions"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Team Member Mentions" Description="@("Type @ followed by a name to filter and insert a mention handle.")" Code="@_mentionsCode">
        <Mentions @bind-Value="_text"
                  OptionsString="dominik, sarah, alex, elena"
                  Placeholder="@("Type @ to mention a teammate...")"
                  AllowClear="true" />
    </DemoCard>

    <ApiTable Title="Mentions Properties" ComponentType="@typeof(Mentions)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Prefix", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "@", DefaultValue = "@", Options = ["@", "#"] },
        new() { Name = "Placeholder", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Type @ to mention someone...", DefaultValue = "" },
        new() { Name = "OptionsString", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "dominik, sarah, alex, elena", DefaultValue = "" },
        new() { Name = "Rows", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "2", DefaultValue = "1" },
        new() { Name = "AllowClear", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "None", DefaultValue = "None", Options = ["None", "Error", "Warning", "Success"] },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string? _text = "Hey @dominik please review this PR";

    private const string _mentionsCode = """
        <Mentions OptionsString="dominik, sarah, alex, elena"
                  Placeholder="Type @ to mention a teammate..."
                  AllowClear="true" />
        """;
}
