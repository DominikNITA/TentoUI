@page "/components/menu"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Menu - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Menu</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            A versatile navigation menu supporting horizontal top bars, vertical sidebars, and nested accordion submenus.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Menu Interactive Playground"
                     ComponentTag="Menu"
                     Controls="@_playgroundControls" />

    @* Example 1: Inline Menu *@
    <DemoCard Title="Inline Sidebar Navigation" Description="Accordion-style expandable menu designed for application sidebars." Code="@_inlineCode">
        <div class="max-w-xs p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800">
            <Menu @bind-SelectedKey="_selectedKey" Mode="MenuMode.Inline">
                <MenuItem Key="dashboard">
                    <Icon><TentoUI.Icon Name="@IconNames.Home" Size="14" /></Icon>
                    <ChildContent>Dashboard</ChildContent>
                </MenuItem>
                <SubMenu Key="sub-users" Title="User Management">
                    <Icon><TentoUI.Icon Name="@IconNames.User" Size="14" /></Icon>
                    <ChildContent>
                        <MenuItem Key="all-users">All Users</MenuItem>
                        <MenuItem Key="roles">Roles &amp; Permissions</MenuItem>
                    </ChildContent>
                </SubMenu>
                <MenuItem Key="settings">
                    <Icon><TentoUI.Icon Name="@IconNames.Settings" Size="14" /></Icon>
                    <ChildContent>Settings</ChildContent>
                </MenuItem>
            </Menu>
        </div>
    </DemoCard>

    @* Example 2: Horizontal Menu *@
    <DemoCard Title="Horizontal Top Navbar" Description="Top-level horizontal navigation bar." Code="@_horizontalCode">
        <div class="w-full bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 p-2">
            <Menu Mode="MenuMode.Horizontal" SelectedKey="nav-home">
                <MenuItem Key="nav-home">Overview</MenuItem>
                <MenuItem Key="nav-features">Features</MenuItem>
                <MenuItem Key="nav-docs">Documentation</MenuItem>
                <MenuItem Key="nav-pricing">Pricing</MenuItem>
            </Menu>
        </div>
    </DemoCard>

    <ApiTable Title="Menu Properties" Properties="@_menuProps" />
    <ApiTable Title="MenuItem Properties" Properties="@_itemProps" />
    <ApiTable Title="SubMenu Properties" Properties="@_subMenuProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Mode", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Inline", DefaultValue = "Inline", Options = ["Inline", "Horizontal", "Vertical"] },
        new() { Name = "Theme", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Light", DefaultValue = "Light", Options = ["Light", "Dark"] },
        new() { Name = "SelectedKey", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "dashboard", DefaultValue = "dashboard", Options = ["dashboard", "analytics", "settings"] },
        new() { Name = "Collapsed", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string _selectedKey = "dashboard";

    private const string _inlineCode = """
        <Menu @bind-SelectedKey="selectedKey" Mode="MenuMode.Inline">
            <MenuItem Key="dashboard">
                <Icon><Icon Name="@IconNames.Home" Size="14" /></Icon>
                <ChildContent>Dashboard</ChildContent>
            </MenuItem>
            <SubMenu Key="sub-users" Title="User Management">
                <Icon><Icon Name="@IconNames.User" Size="14" /></Icon>
                <ChildContent>
                    <MenuItem Key="all-users">All Users</MenuItem>
                    <MenuItem Key="roles">Roles & Permissions</MenuItem>
                </ChildContent>
            </SubMenu>
            <MenuItem Key="settings">
                <Icon><Icon Name="@IconNames.Settings" Size="14" /></Icon>
                <ChildContent>Settings</ChildContent>
            </MenuItem>
        </Menu>
        """;

    private const string _horizontalCode = """
        <Menu Mode="MenuMode.Horizontal" SelectedKey="nav-home">
            <MenuItem Key="nav-home">Overview</MenuItem>
            <MenuItem Key="nav-features">Features</MenuItem>
            <MenuItem Key="nav-docs">Documentation</MenuItem>
            <MenuItem Key="nav-pricing">Pricing</MenuItem>
        </Menu>
        """;

    private readonly ApiTable.ApiProp[] _menuProps =
    [
        new("Mode", "Layout mode: Inline, Vertical, or Horizontal.", "MenuMode", "MenuMode.Inline"),
        new("Theme", "Visual theme: Light or Dark.", "MenuTheme", "MenuTheme.Light"),
        new("SelectedKey", "Currently selected menu item key.", "string?", "null"),
        new("OpenKeys", "List of open submenu keys in inline mode.", "List<string>", "[]"),
        new("Collapsed", "Whether inline menu is in collapsed compact mode.", "bool", "false"),
        new("OnSelect", "Event callback invoked when a menu item is selected.", "EventCallback<MenuSelectEventArgs>", "null"),
        new("ChildContent", "MenuItem, SubMenu, or MenuGroup children.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Key", "Unique key for this item.", "string", "required"),
        new("Icon", "Icon name to display.", "string?", "null"),
        new("Disabled", "Whether the item is disabled.", "bool", "false"),
        new("ChildContent", "Label text.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _subMenuProps =
    [
        new("Key", "Unique key for the submenu.", "string", "required"),
        new("Title", "Submenu label text.", "string", "null"),
        new("Icon", "Icon name.", "string?", "null"),
        new("ChildContent", "Submenu items.", "RenderFragment?", "null")
    ];
}