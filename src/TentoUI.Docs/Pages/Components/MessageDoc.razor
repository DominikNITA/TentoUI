@page "/components/message"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Message - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Message</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Display global feedback messages at the top-center of the screen with auto-dismiss timers and distinct type icons.
        </p>
    </div>

    @* Example 1: Message Types *@
    <DemoCard Title="Message Types" Description="Trigger toasts for Success, Info, Warning, and Error outcomes." Code="@_typesCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Primary" OnClick="@(() => MessageService.Success("Operation completed successfully!"))">
                Success
            </Button>
            <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Info("Informational note."))">
                Info
            </Button>
            <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Warning("Warning: verify inputs."))">
                Warning
            </Button>
            <Button Danger="true" OnClick="@(() => MessageService.Error("Failed to save changes."))">
                Error
            </Button>
        </div>
    </DemoCard>

    @* Example 2: Custom Duration *@
    <DemoCard Title="Custom Duration" Description="Customize the auto-dismiss timer in seconds (default is 3s)." Code="@_durationCode">
        <div class="flex items-center gap-3">
            <Button OnClick="@(() => MessageService.Success("This message persists for 8 seconds!", 8))">
                8-Second Toast
            </Button>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="IMessageService Methods" Properties="@_props" />
</div>

@code {
    private const string _typesCode = """
        <Button Type="ButtonType.Primary" OnClick="@(() => MessageService.Success("Operation completed successfully!"))">
            Success
        </Button>
        <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Info("Informational note."))">
            Info
        </Button>
        <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Warning("Warning: verify inputs."))">
            Warning
        </Button>
        <Button Danger="true" OnClick="@(() => MessageService.Error("Failed to save changes."))">
            Error
        </Button>
        """;

    private const string _durationCode = """
        <Button OnClick="@(() => MessageService.Success("This message persists for 8 seconds!", 8))">
            8-Second Toast
        </Button>
        """;

    private readonly ApiProp[] _props =
    [
        new("Success", "Displays a green success toast icon and message.", "void (string content, double? duration = 3)", "-"),
        new("Info", "Displays a blue informational toast.", "void (string content, double? duration = 3)", "-"),
        new("Warning", "Displays an amber warning toast.", "void (string content, double? duration = 3)", "-"),
        new("Error", "Displays a red error toast.", "void (string content, double? duration = 3)", "-")
    ];
}
