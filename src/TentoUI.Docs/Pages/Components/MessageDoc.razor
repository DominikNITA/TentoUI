@page "/components/message"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Message - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Message</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Display global feedback messages at the top-center of the screen with auto-dismiss timers and distinct type icons.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Trigger message toasts dynamically with custom message and duration.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex flex-wrap items-center justify-center gap-3">
            <Button Type="ButtonType.Primary" OnClick="@(() => MessageService.Success(_customMessage, _duration))">
                Trigger Success
            </Button>
            <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Info(_customMessage, _duration))">
                Trigger Info
            </Button>
            <Button Type="ButtonType.Default" OnClick="@(() => MessageService.Warning(_customMessage, _duration))">
                Trigger Warning
            </Button>
            <Button Danger="true" OnClick="@(() => MessageService.Error(_customMessage, _duration))">
                Trigger Error
            </Button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Message Text</label>
                <input type="text"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_customMessage" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Duration (Seconds)</label>
                <input type="number"
                       min="1"
                       max="10"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_duration" />
            </div>
        </div>
    </div>

    <ApiTable Title="IMessageService Methods" Properties="@_props" />
</div>

@code {
    private string _customMessage = "Configuration saved successfully!";
    private double _duration = 3;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Success(content, duration)", "Show success message toast.", "void", "duration = 3.0"),
        new("Info(content, duration)", "Show informational message toast.", "void", "duration = 3.0"),
        new("Warning(content, duration)", "Show warning notice message toast.", "void", "duration = 3.0"),
        new("Error(content, duration)", "Show error message toast.", "void", "duration = 3.0"),
        new("Loading(content, duration)", "Show loading message toast.", "IMessageRef", "duration = 0 (manual dismiss)"),
        new("Destroy()", "Dismiss all active messages immediately.", "void", "-")
    ];
}
