@page "/components/modal"
@namespace TentoUI.Docs.Pages.Components
@inject IModalService ModalService
@inject IMessageService MessageService

<PageTitle>Modal &amp; Dialogs - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Modal &amp; Dialogs</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Modal dialogs for user confirmations, alerts, and rich form submissions.
        </p>
    </div>

    @* Form Modal Demo *@
    <DemoCard Title="Form Modal with Initial Data" Description="Open a modal containing a validated Form, passing initial record data." Code="@_formModalCode">
        <div class="flex items-center gap-3">
            <Button Type="ButtonType.Primary" OnClick="OpenEditModal">Edit Member Details</Button>
        </div>

        <Modal @bind-Visible="_isFormModalOpen"
               Title="Edit Member Profile"
               Width="500px"
               ConfirmLoading="_isSaving"
               OkText="Save"
               OnOk="SaveMemberAsync">
            <div class="space-y-4">
                <Form Model="@_editModel" Layout="FormLayout.Vertical">
                    <FormItem Label="Full Name" Required="true" For="@(() => _editModel.Name)">
                        <Input @bind-Value="_editModel.Name" />
                    </FormItem>
                    <FormItem Label="Email Address" Required="true" For="@(() => _editModel.Email)">
                        <Input @bind-Value="_editModel.Email" />
                    </FormItem>
                    <FormItem Label="Role" Required="true">
                        <Select TItem="string" TValue="string" DataSource="@_roles" @bind-Value="_editModel.Role" />
                    </FormItem>
                </Form>
            </div>
        </Modal>
    </DemoCard>

    @* Confirmation Modal Demo *@
    <DemoCard Title="Programmatic Confirm Dialog" Description="Open a confirmation modal using IModalService." Code="@_confirmCode">
        <Button Type="ButtonType.Default" Danger="true" OnClick="ConfirmDeleteAsync">
            Delete Account
        </Button>
    </DemoCard>

    <ApiTable Title="Modal Properties" Properties="@_modalProps" />
    <ApiTable Title="IModalService Methods" Properties="@_serviceProps" />
</div>

@code {
    private bool _isFormModalOpen;
    private bool _isSaving;
    private MemberEditDto _editModel = new();
    private readonly string[] _roles = ["Administrator", "Editor", "Contributor"];

    private void OpenEditModal()
    {
        _editModel = new MemberEditDto
        {
            Name = "Alice Johnson",
            Email = "alice@example.com",
            Role = "Administrator"
        };
        _isFormModalOpen = true;
    }

    private async Task SaveMemberAsync()
    {
        _isSaving = true;
        await Task.Delay(400);
        _isSaving = false;
        _isFormModalOpen = false;
        MessageService.Success($"Saved member {_editModel.Name} successfully!");
    }

    private async Task ConfirmDeleteAsync()
    {
        bool confirmed = await ModalService.ConfirmAsync(
            title: "Delete Account",
            content: "Are you sure you want to delete this account? All associated records will be permanently removed.",
            type: ModalType.Error);

        if (confirmed)
        {
            MessageService.Success("Account successfully deleted.");
        }
    }

    public class MemberEditDto
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = "Editor";
    }

    private const string _formModalCode = @"<Button Type=""ButtonType.Primary"" OnClick=""OpenEditModal"">Edit Member</Button>

<Modal @bind-Visible=""_isFormModalOpen"" Title=""Edit Member Profile"" OnOk=""SaveMemberAsync"">
    <Form Model=""@_editModel"" Layout=""FormLayout.Vertical"">
        <FormItem Label=""Full Name"" Required=""true"" For=""@(() => _editModel.Name)"">
            <Input @bind-Value=""_editModel.Name"" />
        </FormItem>
        <FormItem Label=""Email Address"" Required=""true"" For=""@(() => _editModel.Email)"">
            <Input @bind-Value=""_editModel.Email"" />
        </FormItem>
    </Form>
</Modal>";

    private const string _confirmCode = @"@inject IModalService ModalService

bool confirmed = await ModalService.ConfirmAsync(
    title: ""Delete Account"",
    content: ""Are you sure you want to delete this account?"",
    type: ModalType.Error);";

    private readonly ApiTable.ApiProp[] _modalProps =
    [
        new("Visible", "Whether the modal dialog is visible (bindable via @bind-Visible).", "bool", "false"),
        new("Title", "Modal dialog header title.", "string?", "null"),
        new("Width", "Width of the modal window in px.", "int", "520"),
        new("Centered", "Whether to vertically center the modal in the viewport.", "bool", "false"),
        new("MaskClosable", "Whether clicking the dark background mask dismisses the dialog.", "bool", "true"),
        new("OkText", "Text label for the primary confirmation button.", "string", "'OK'"),
        new("CancelText", "Text label for the secondary cancel button.", "string", "'Cancel'"),
        new("ConfirmLoading", "Display a spinner on the OK button while executing async task.", "bool", "false"),
        new("OnOk", "Callback triggered when user clicks the OK button.", "EventCallback", "null"),
        new("OnCancel", "Callback triggered when user clicks Cancel or closes modal.", "EventCallback", "null"),
        new("ChildContent", "Body markup/forms rendered inside the modal.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _serviceProps =
    [
        new("ConfirmAsync(title, content, type)", "Opens confirmation modal dialog returning Task<bool> (true if confirmed).", "Task<bool>", "-"),
        new("SuccessAsync(title, content)", "Opens success alert dialog returning Task.", "Task", "-"),
        new("ErrorAsync(title, content)", "Opens error alert dialog returning Task.", "Task", "-"),
        new("WarningAsync(title, content)", "Opens warning alert dialog returning Task.", "Task", "-")
    ];
}
