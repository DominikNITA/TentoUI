@page "/components/modal"
@namespace TentoUI.Docs.Pages.Components
@inject IModalService ModalService
@inject IMessageService MessageService

<PageTitle>Modal &amp; Dialogs - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Modal &amp; Dialogs</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Modal dialogs for user confirmations, alerts, and rich form submissions with support for declarative components and programmatic IModalService dialogs.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Modal Interactive Playground"
                     ComponentTag="Modal"
                     Controls="@_playgroundControls" />

    @* Setup Note for IModalService *@
    <div class="rounded-xl border border-sky-200 dark:border-sky-800 bg-sky-50/70 dark:bg-sky-950/30 p-4 text-xs text-sky-900 dark:text-sky-200 space-y-2">
        <div class="flex items-center gap-2 font-bold text-sky-800 dark:text-sky-300">
            <Icon Name="@IconNames.Info" Size="16" />
            <span>Configuring Programmatic IModalService</span>
        </div>
        <p class="leading-relaxed">
            To use programmatic dialogs (<code class="px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-900 font-mono text-[11px]">ModalService.ConfirmAsync</code>, <code class="px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-900 font-mono text-[11px]">ModalService.SuccessAsync</code>, etc.), ensure the following setup is present in your application:
        </p>
        <ol class="list-decimal list-inside space-y-1 font-mono text-[11px] text-sky-800 dark:text-sky-300">
            <li>Register TentoUI services in <span class="font-semibold">Program.cs</span>: <code class="bg-sky-100 dark:bg-sky-900 px-1 py-0.5 rounded">builder.Services.AddTentoUI();</code></li>
            <li>Place the host component in <span class="font-semibold">MainLayout.razor</span> or <span class="font-semibold">App.razor</span>: <code class="bg-sky-100 dark:bg-sky-900 px-1 py-0.5 rounded">&lt;ModalHost /&gt;</code></li>
            <li>Inject the service into your Razor component: <code class="bg-sky-100 dark:bg-sky-900 px-1 py-0.5 rounded">@@inject IModalService ModalService</code></li>
        </ol>
    </div>

    @* Form Modal Demo *@
    <DemoCard Title="Form Modal with Initial Data" Description="Open a modal containing a validated Form, passing initial record data." Code="@_formModalCode">
        <div class="flex items-center gap-3">
            <Button Type="ButtonType.Primary" OnClick="OpenEditModal">Edit Member Details</Button>
        </div>

        <Modal @bind-Visible="_isFormModalOpen"
               Title="Edit Member Profile"
               Width="520px"
               ConfirmLoading="_isSaving"
               OkText="Save"
               OnOk="SaveMemberAsync">
            <div class="space-y-4">
                <Form Model="@_editModel" Layout="FormLayout.Vertical">
                    <FormItem Label="Full Name" Required="true" For="@(() => _editModel.Name)">
                        <Input @bind-Value="_editModel.Name" />
                    </FormItem>
                    <FormItem Label="Email Address" Required="true" For="@(() => _editModel.Email)">
                        <Input @bind-Value="_editModel.Email" />
                    </FormItem>
                    <FormItem Label="Role" Required="true">
                        <Select TItem="string" TValue="string" DataSource="@_roles" @bind-Value="_editModel.Role" />
                    </FormItem>
                </Form>
            </div>
        </Modal>
    </DemoCard>

    @* Confirmation Modal Demo *@
    <DemoCard Title="Programmatic Confirm &amp; Alert Dialogs"
              Description="Open confirmation dialogs and alert popups dynamically from C# code via IModalService without declaring markup modals."
              Code="@_confirmCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Default" Danger="true" OnClick="ConfirmDeleteAsync">
                Confirm Delete (Danger)
            </Button>
            <Button Type="ButtonType.Primary" OnClick="ShowSuccessDialogAsync">
                Success Dialog
            </Button>
            <Button Type="ButtonType.Default" OnClick="ShowWarningDialogAsync">
                Warning Dialog
            </Button>
        </div>
    </DemoCard>

    <ApiTable Title="Modal Properties" ComponentType="@typeof(Modal)" />
    <ApiTable Title="IModalService Methods" Properties="@_serviceProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Confirm Action", DefaultValue = "" },
        new() { Name = "OkText", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Confirm", DefaultValue = "OK" },
        new() { Name = "CancelText", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Dismiss", DefaultValue = "Cancel" },
        new() { Name = "Danger", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Centered", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Closable", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Content", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "<p class=\"text-sm text-slate-600\">Are you sure you want to proceed with this operation?</p>", DefaultValue = "", IsChildContent = true }
    ];

    private bool _isFormModalOpen;
    private bool _isSaving;
    private MemberEditDto _editModel = new();
    private readonly string[] _roles = ["Administrator", "Editor", "Contributor"];

    private void OpenEditModal()
    {
        _editModel = new MemberEditDto
        {
            Name = "Alice Johnson",
            Email = "alice@example.com",
            Role = "Administrator"
        };
        _isFormModalOpen = true;
    }

    private async Task SaveMemberAsync()
    {
        _isSaving = true;
        await Task.Delay(400);
        _isSaving = false;
        _isFormModalOpen = false;
        MessageService.Success($"Saved member {_editModel.Name} successfully!");
    }

    private async Task ConfirmDeleteAsync()
    {
        bool confirmed = await ModalService.ConfirmAsync(
            title: "Delete Account",
            content: "Are you sure you want to delete this account? All associated records will be permanently removed.",
            type: ModalType.Error);

        if (confirmed)
        {
            MessageService.Success("Account successfully deleted.");
        }
    }

    private async Task ShowSuccessDialogAsync()
    {
        await ModalService.SuccessAsync(
            title: "Payment Processed",
            content: "Your transaction has been approved and invoice #9402 was sent to your email.");
    }

    private async Task ShowWarningDialogAsync()
    {
        await ModalService.WarningAsync(
            title: "Unsaved Changes",
            content: "You have uncommitted modifications. Navigating away now will discard them.");
    }

    public class MemberEditDto
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = "Editor";
    }

    private const string _formModalCode = """
        <Button Type="ButtonType.Primary" OnClick="OpenEditModal">Edit Member</Button>

        <Modal @bind-Visible="isFormModalOpen" Title="Edit Member Profile" Width="520px" OnOk="SaveMemberAsync">
            <Form Model="@editModel" Layout="FormLayout.Vertical">
                <FormItem Label="Full Name" Required="true">
                    <Input @bind-Value="editModel.Name" />
                </FormItem>
                <FormItem Label="Email Address" Required="true">
                    <Input @bind-Value="editModel.Email" />
                </FormItem>
            </Form>
        </Modal>
        """;

    private const string _confirmCode = """
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Default" Danger="true" OnClick="ConfirmDeleteAsync">
                Confirm Delete (Danger)
            </Button>
            <Button Type="ButtonType.Primary" OnClick="ShowSuccessDialogAsync">
                Success Dialog
            </Button>
            <Button Type="ButtonType.Default" OnClick="ShowWarningDialogAsync">
                Warning Dialog
            </Button>
        </div>
        """;

    private readonly ApiTable.ApiProp[] _serviceProps =
    [
        new("ConfirmAsync(title, content, type)", "Opens confirmation modal dialog returning Task<bool> (true if confirmed).", "Task<bool>", "-"),
        new("SuccessAsync(title, content)", "Opens success alert dialog returning Task.", "Task", "-"),
        new("ErrorAsync(title, content)", "Opens error alert dialog returning Task.", "Task", "-"),
        new("WarningAsync(title, content)", "Opens warning alert dialog returning Task.", "Task", "-")
    ];
}