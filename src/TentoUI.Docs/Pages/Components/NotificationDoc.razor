@page "/components/notification"
@namespace TentoUI.Docs.Pages.Components
@inject INotificationService NotificationService

<PageTitle>Notification - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Notification</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Display rich notification alert cards in viewport corners with titles, detailed descriptions, custom icons, and auto-dismiss.
        </p>
    </div>

    @* Example 1: Notification Types *@
    <DemoCard Title="Notification Types" Description="Trigger corner notifications for Success, Info, Warning, and Error events." Code="@_typesCode">
        <div class="flex flex-wrap items-center gap-3">
            <Button Type="ButtonType.Primary" OnClick="@(() => NotificationService.Success("Deployment Finished", "All services were verified and deployed successfully."))">
                Success Notice
            </Button>
            <Button Type="ButtonType.Default" OnClick="@(() => NotificationService.Info("New Updates Available", "A new version of the client library is available."))">
                Info Notice
            </Button>
            <Button Type="ButtonType.Default" OnClick="@(() => NotificationService.Warning("Quota Threshold", "You have used 85% of your storage limit."))">
                Warning Notice
            </Button>
            <Button Danger="true" OnClick="@(() => NotificationService.Error("Build Failed", "Compilation timed out after 300 seconds."))">
                Error Notice
            </Button>
        </div>
    </DemoCard>

    @* Example 2: Extended Duration *@
    <DemoCard Title="Persistent / Custom Duration" Description="Customize the notification auto-dismiss delay." Code="@_durationCode">
        <div class="flex items-center gap-3">
            <Button OnClick="@(() => NotificationService.Info("Security Alert", "A new device logged in from Frankfurt, Germany.", 10))">
                10-Second Notice
            </Button>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="INotificationService Methods" Properties="@_serviceProps" />
</div>

@code {
    private const string _typesCode = """
        <Button Type="ButtonType.Primary" OnClick="@(() => NotificationService.Success("Deployment Finished", "All services were verified and deployed successfully."))">
            Success Notice
        </Button>
        <Button Type="ButtonType.Default" OnClick="@(() => NotificationService.Info("New Updates Available", "A new version is available."))">
            Info Notice
        </Button>
        <Button Danger="true" OnClick="@(() => NotificationService.Error("Build Failed", "Compilation timed out."))">
            Error Notice
        </Button>
        """;

    private const string _durationCode = """
        <Button OnClick="@(() => NotificationService.Info("Security Alert", "A new device logged in.", 10))">
            10-Second Notice
        </Button>
        """;

    private readonly ApiProp[] _serviceProps =
    [
        new("Success", "Opens green success notification card with title and body.", "void (string title, string description, double? duration = 4.5)", "-"),
        new("Info", "Opens blue informational notification card.", "void (string title, string description, double? duration = 4.5)", "-"),
        new("Warning", "Opens amber warning notification card.", "void (string title, string description, double? duration = 4.5)", "-"),
        new("Error", "Opens red error notification card.", "void (string title, string description, double? duration = 4.5)", "-")
    ];
}
