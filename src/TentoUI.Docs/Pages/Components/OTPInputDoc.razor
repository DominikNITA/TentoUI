@page "/components/otp-input"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>OTPInput - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">OTPInput / InputOTP</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Segmented one-time passcode verification input supporting clipboard paste, visual separators, and masked PIN entry.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="OTPInput Interactive Playground"
                     ComponentTag="OTPInput"
                     Controls="@_playgroundControls" />

    <DemoCard Title="6-Digit Verification &amp; Masked PIN" Description="Supports automatic multi-digit paste and completion callbacks." Code="@_otpCode">
        <div class="flex flex-col gap-6 p-2">
            <div>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">6-Digit SMS Verification</span>
                <OTPInput @bind-Value="_code"
                          Length="6"
                          ShowSeparator="true"
                          OnComplete="@(c => MessageService.Success($"Code verified: {c}"))" />
            </div>
            <div>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">4-Digit Masked Security PIN</span>
                <OTPInput Value="4829" Length="4" Mask="true" />
            </div>
        </div>
    </DemoCard>

    <ApiTable Title="OTPInput Properties" ComponentType="@typeof(OTPInput)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Length", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "6", DefaultValue = "6" },
        new() { Name = "Mask", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "ShowSeparator", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Separator", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "-", DefaultValue = "-" },
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "None", DefaultValue = "None", Options = ["None", "Error", "Warning", "Success"] },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string? _code = "128940";

    private const string _otpCode = """
        <div class="flex flex-col gap-6">
            <div>
                <span class="block text-xs font-medium text-slate-500 mb-2">6-Digit SMS Verification</span>
                <OTPInput Value="128940" Length="6" ShowSeparator="true" />
            </div>
            <div>
                <span class="block text-xs font-medium text-slate-500 mb-2">4-Digit Masked Security PIN</span>
                <OTPInput Value="4829" Length="4" Mask="true" />
            </div>
        </div>
        """;
}
