@page "/components/pagination"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Pagination - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Pagination</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A long list can be divided into several pages using pagination, with support for quick jump inputs and page size changers.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Pagination Interactive Playground"
                     ComponentTag="Pagination"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Pagination *@
    <DemoCard Title="Basic Pagination" Description="Standard page numbering with previous and next arrow buttons." Code="@_basicCode">
        <div class="flex flex-col items-center gap-3 p-4">
            <Pagination Total="50" @bind-Current="_basicPage" />
            <span class="text-xs text-slate-400">Current page: @_basicPage</span>
        </div>
    </DemoCard>

    @* Example 2: Full Controls *@
    <DemoCard Title="Size Changer &amp; Quick Jumper" Description="Includes dropdown selector for page sizes and numeric input to jump directly to target page." Code="@_fullCode">
        <div class="flex flex-col items-center gap-3 p-4">
            <Pagination Total="480"
                        @bind-Current="_page"
                        @bind-PageSize="_pageSize"
                        ShowSizeChanger="true"
                        ShowQuickJumper="true" />
            <span class="text-xs text-slate-400">Viewing page @_page with @_pageSize items per page</span>
        </div>
    </DemoCard>

    @* Example 3: Simple Compact Mode *@
    <DemoCard Title="Simple Compact Mode" Description="Compact indicator for constrained sidebars or mobile footers." Code="@_simpleCode">
        <div class="flex items-center justify-center p-4">
            <Pagination Total="100" @bind-Current="_simplePage" Simple="true" />
        </div>
    </DemoCard>

    <ApiTable Title="Pagination Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Total", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "120", DefaultValue = "0" },
        new() { Name = "Current", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "1", DefaultValue = "1" },
        new() { Name = "PageSize", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "10", DefaultValue = "10" },
        new() { Name = "Simple", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "ShowSizeChanger", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private int _basicPage = 1;
    private int _page = 2;
    private int _pageSize = 10;
    private int _simplePage = 1;

    private const string _basicCode = """
        <Pagination Total="50" @bind-Current="basicPage" />
        """;

    private const string _fullCode = """
        <Pagination Total="480"
                    @bind-Current="page"
                    @bind-PageSize="pageSize"
                    ShowSizeChanger="true"
                    ShowQuickJumper="true" />
        """;

    private const string _simpleCode = """
        <Pagination Total="100" @bind-Current="simplePage" Simple="true" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Current", "Current page number (1-based, bindable via @bind-Current).", "int", "1"),
        new("PageSize", "Number of data items per page (bindable via @bind-PageSize).", "int", "10"),
        new("Total", "Total count of data items.", "int", "0"),
        new("ShowSizeChanger", "Display page size changer dropdown.", "bool", "false"),
        new("ShowQuickJumper", "Display input field to jump directly to page.", "bool", "false"),
        new("Simple", "Render compact mini pagination.", "bool", "false"),
        new("Disabled", "Whether pagination interaction is disabled.", "bool", "false"),
        new("OnChange", "Callback triggered when page changes.", "EventCallback<int>", "null")
    ];
}