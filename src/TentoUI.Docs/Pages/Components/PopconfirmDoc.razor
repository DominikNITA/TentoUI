@page "/components/popconfirm"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Popconfirm - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Popconfirm</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A compact confirmation popover triggered by clicking an action button, prompting the user before destructive execution.
        </p>
    </div>

    @* Example 1: Basic Popconfirm *@
    <DemoCard Title="Basic Popconfirm" Description="Prompt user confirmation before executing a destructive action." Code="@_basicCode">
        <div class="p-4 flex items-center justify-center">
            <Popconfirm Title="Delete this task?"
                        Description="This action cannot be undone."
                        OkText="Yes, Delete"
                        CancelText="No"
                        OnConfirm="@(() => MessageService.Success("Item deleted successfully!"))"
                        OnCancel="@(() => MessageService.Info("Deletion cancelled."))">
                <Button Danger="true">
                    Delete Task
                </Button>
            </Popconfirm>
        </div>
    </DemoCard>

    @* Example 2: Non-Destructive Action *@
    <DemoCard Title="Publish Confirmation" Description="Confirming positive operations like publishing or archiving." Code="@_publishCode">
        <div class="p-4 flex items-center justify-center">
            <Popconfirm Title="Publish changes to production?"
                        Description="Live users will see the changes immediately."
                        OkText="Publish"
                        CancelText="Review"
                        OnConfirm="@(() => MessageService.Success("Published!"))">
                <Button Type="ButtonType.Primary">
                    Publish Release
                </Button>
            </Popconfirm>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Popconfirm Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <Popconfirm Title="Delete this task?"
                    Description="This action cannot be undone."
                    OkText="Yes, Delete"
                    CancelText="No"
                    OnConfirm="@HandleDelete">
            <Button Danger="true">Delete Task</Button>
        </Popconfirm>
        """;

    private const string _publishCode = """
        <Popconfirm Title="Publish changes to production?"
                    Description="Live users will see changes immediately."
                    OkText="Publish"
                    OnConfirm="@HandlePublish">
            <Button Type="ButtonType.Primary">Publish Release</Button>
        </Popconfirm>
        """;

    private readonly ApiProp[] _props =
    [
        new("Title", "Confirmation title question.", "string", "-"),
        new("Description", "Detailed explanation text.", "string?", "null"),
        new("OkText", "Label for confirmation OK button.", "string", "OK"),
        new("CancelText", "Label for cancel button.", "string", "Cancel"),
        new("OnConfirm", "Callback when OK is confirmed.", "EventCallback", "null"),
        new("OnCancel", "Callback when Cancel is clicked.", "EventCallback", "null"),
        new("ChildContent", "Trigger element wrapped by the popconfirm.", "RenderFragment?", "null")
    ];
}
