@page "/components/popover"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Popover - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Popover</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            The floating card popped by clicking or hovering, containing rich formatted titles and action buttons.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Popover Interactive Playground"
                     ComponentTag="Popover"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Hover Popover *@
    <DemoCard Title="Hover Popover" Description="Floating card opened when hovering over the anchor button." Code="@_hoverCode">
        <div class="py-14 flex items-center justify-center">
            <Popover Title="Cluster Statistics" Trigger="TooltipTrigger.Hover" Placement="TooltipPlacement.Top">
                <ContentTemplate>
                    <div class="w-56 space-y-2 text-xs">
                        <p class="text-slate-500">Node memory usage is currently at 42% across all availability zones.</p>
                        <Button Type="ButtonType.Primary" Size="ComponentSize.Small" Block="true">View Metrics</Button>
                    </div>
                </ContentTemplate>
                <ChildContent>
                    <Button Type="ButtonType.Default">Hover for Cluster Metrics</Button>
                </ChildContent>
            </Popover>
        </div>
    </DemoCard>

    @* Example 2: Click Trigger *@
    <DemoCard Title="Click Trigger Popover" Description="Requires a click to open and remains visible until clicked again or dismissed." Code="@_clickCode">
        <div class="py-14 flex items-center justify-center">
            <Popover Title="User Quick Actions" Trigger="TooltipTrigger.Click" Placement="TooltipPlacement.Bottom">
                <ContentTemplate>
                    <div class="w-48 space-y-2 text-xs">
                        <a href="javascript:void(0)" class="block text-slate-700 dark:text-slate-300 hover:text-primary-600">Profile Settings</a>
                        <a href="javascript:void(0)" class="block text-slate-700 dark:text-slate-300 hover:text-primary-600">API Credentials</a>
                        <div class="border-t border-slate-100 dark:border-slate-800 pt-1">
                            <a href="javascript:void(0)" class="block text-red-500 hover:underline">Sign Out</a>
                        </div>
                    </div>
                </ContentTemplate>
                <ChildContent>
                    <Button Type="ButtonType.Primary">Click for Options</Button>
                </ChildContent>
            </Popover>
        </div>
    </DemoCard>

    <ApiTable Title="Popover Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "System Notifications", DefaultValue = "" },
        new() { Name = "Content", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "All 14 background services are operating within normal parameters.", DefaultValue = "" },
        new() { Name = "Placement", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "TooltipPlacement.Top", DefaultValue = "TooltipPlacement.Top", Options = ["TooltipPlacement.Top", "TooltipPlacement.Bottom", "TooltipPlacement.Left", "TooltipPlacement.Right"] },
        new() { Name = "Trigger", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "TooltipTrigger.Click", DefaultValue = "TooltipTrigger.Click", Options = ["TooltipTrigger.Click", "TooltipTrigger.Hover"] },
        new() { Name = "ContentSlot", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "<Button Type=\"ButtonType.Default\">Toggle Popover</Button>", DefaultValue = "", IsChildContent = true }
    ];

    private const string _hoverCode = """
        <div class="py-14 flex items-center justify-center">
            <Popover Title="Cluster Statistics" Trigger="TooltipTrigger.Hover" Placement="TooltipPlacement.Top">
                <ContentTemplate>
                    <div class="w-56 space-y-2 text-xs">
                        <p class="text-slate-500">Node memory usage is at 42%.</p>
                        <Button Type="ButtonType.Primary" Size="ComponentSize.Small" Block="true">View Metrics</Button>
                    </div>
                </ContentTemplate>
                <ChildContent>
                    <Button Type="ButtonType.Default">Hover for Metrics</Button>
                </ChildContent>
            </Popover>
        </div>
        """;

    private const string _clickCode = """
        <div class="py-14 flex items-center justify-center">
            <Popover Title="User Quick Actions" Trigger="TooltipTrigger.Click" Placement="TooltipPlacement.Bottom">
                <ContentTemplate>
                    <div class="w-48 space-y-2 text-xs">
                        <a href="#" class="block">Profile Settings</a>
                        <a href="#" class="block text-red-500">Sign Out</a>
                    </div>
                </ContentTemplate>
                <ChildContent>
                    <Button Type="ButtonType.Primary">Click for Options</Button>
                </ChildContent>
            </Popover>
        </div>
        """;

    private readonly ApiProp[] _props =
    [
        new("Title", "Title text of the floating popover card.", "string?", "null"),
        new("TitleTemplate", "Custom title template fragment.", "RenderFragment?", "null"),
        new("Content", "Content text inside the card.", "string?", "null"),
        new("ContentTemplate", "Custom content template inside the card.", "RenderFragment?", "null"),
        new("Trigger", "Popover trigger mode: Hover or Click.", "TooltipTrigger", "TooltipTrigger.Click"),
        new("Placement", "Direction to float relative to trigger (Top, Bottom, Left, Right).", "TooltipPlacement", "TooltipPlacement.Top"),
        new("ChildContent", "Anchor element that triggers the popover.", "RenderFragment?", "null")
    ];
}