@page "/components/popover"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Popover - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Popover</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            The floating card popped by clicking or hovering, containing rich formatted titles and action buttons.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Trigger popover on hover or click with custom placements.</p>
            </div>
        </div>

        <div class="p-12 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Popover Title="Cluster Statistics" Trigger="_trigger" Placement="_placement">
                <ContentTemplate>
                    <div class="w-56 space-y-2 text-xs">
                        <p class="text-slate-500">Node memory usage is currently at 42% across all availability zones.</p>
                        <Button Type="ButtonType.Primary" Size="ComponentSize.Small" Block="true">View Metrics</Button>
                    </div>
                </ContentTemplate>
                <ChildContent>
                    <Button Type="ButtonType.Default">Hover / Click for Details</Button>
                </ChildContent>
            </Popover>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Trigger Event</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_trigger">
                    <option value="@TooltipTrigger.Hover">Hover</option>
                    <option value="@TooltipTrigger.Click">Click</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Placement</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_placement">
                    <option value="@TooltipPlacement.Top">Top</option>
                    <option value="@TooltipPlacement.Bottom">Bottom</option>
                    <option value="@TooltipPlacement.Left">Left</option>
                    <option value="@TooltipPlacement.Right">Right</option>
                </select>
            </div>
        </div>
    </div>

    <ApiTable Title="Popover Properties" Properties="@_props" />
</div>

@code {
    private TooltipTrigger _trigger = TooltipTrigger.Hover;
    private TooltipPlacement _placement = TooltipPlacement.Top;

    private readonly ApiProp[] _props =
    [
        new("Title", "Title text of the floating popover card.", "string?", "null"),
        new("TitleTemplate", "Custom title template fragment.", "RenderFragment?", "null"),
        new("Content", "Content text inside the card.", "string?", "null"),
        new("ContentTemplate", "Custom content template inside the card.", "RenderFragment?", "null"),
        new("Trigger", "Popover trigger mode: Hover or Click.", "TooltipTrigger", "TooltipTrigger.Click"),
        new("Placement", "Direction to float relative to trigger (Top, Bottom, Left, Right).", "TooltipPlacement", "TooltipPlacement.Top"),
        new("ChildContent", "Anchor element that triggers the popover.", "RenderFragment?", "null")
    ];
}
