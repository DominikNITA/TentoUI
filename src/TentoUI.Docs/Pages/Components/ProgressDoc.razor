@page "/components/progress"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Progress - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Progress</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Displays the current progress of an operation flow with animated bars, circular rings, and status highlights.
        </p>
    </div>

    @* Example 1: Linear Bars *@
    <DemoCard Title="Linear Progress Bars" Description="Standard linear bars with percentage text and status colors." Code="@_linearCode">
        <div class="space-y-4 w-full max-w-md">
            <Progress Percent="30" />
            <Progress Percent="70" Status="ProgressStatus.Active" />
            <Progress Percent="100" Status="ProgressStatus.Success" />
            <Progress Percent="50" Status="ProgressStatus.Exception" />
        </div>
    </DemoCard>

    @* Example 2: Circular Progress *@
    <DemoCard Title="Circular Progress" Description="Circular ring progress indicators for dashboards and statistics." Code="@_circleCode">
        <div class="flex items-center gap-6">
            <Progress Percent="75" Type="ProgressType.Circle" />
            <Progress Percent="100" Type="ProgressType.Circle" Status="ProgressStatus.Success" />
            <Progress Percent="60" Type="ProgressType.Circle" Status="ProgressStatus.Exception" />
        </div>
    </DemoCard>

    @* Example 3: Dynamic Controls *@
    <DemoCard Title="Dynamic Progress Updates" Description="Adjust progress values dynamically via buttons or background tasks." Code="@_dynamicCode">
        <div class="space-y-4 w-full max-w-md">
            <Progress Percent="_dynamicPercent" Status="ProgressStatus.Active" />
            <div class="flex items-center gap-2">
                <Button Size="ComponentSize.Small" OnClick="@(() => _dynamicPercent = Math.Max(0, _dynamicPercent - 10))">
                    -10%
                </Button>
                <Button Size="ComponentSize.Small" OnClick="@(() => _dynamicPercent = Math.Min(100, _dynamicPercent + 10))">
                    +10%
                </Button>
            </div>
        </div>
    </DemoCard>

    @* API Reference Table *@
    <ApiTable Title="Progress Properties" Properties="@_props" />
</div>

@code {
    private int _dynamicPercent = 40;

    private const string _linearCode = """
        <Progress Percent="30" />
        <Progress Percent="70" Status="ProgressStatus.Active" />
        <Progress Percent="100" Status="ProgressStatus.Success" />
        <Progress Percent="50" Status="ProgressStatus.Exception" />
        """;

    private const string _circleCode = """
        <Progress Percent="75" Type="ProgressType.Circle" />
        <Progress Percent="100" Type="ProgressType.Circle" Status="ProgressStatus.Success" />
        """;

    private const string _dynamicCode = """
        <Progress Percent="@_percent" Status="ProgressStatus.Active" />
        <Button OnClick="IncreaseProgress">+10%</Button>
        """;

    private readonly ApiProp[] _props =
    [
        new("Percent", "Completion percentage from 0 to 100.", "int", "0"),
        new("Type", "Visual shape: Line or Circle.", "ProgressType", "ProgressType.Line"),
        new("Status", "Status style override: Normal, Success, Exception, Active.", "ProgressStatus?", "null"),
        new("ShowInfo", "Whether to show percentage text suffix.", "bool", "true"),
        new("StrokeColor", "Custom color for progress bar fill.", "string?", "null")
    ];
}
