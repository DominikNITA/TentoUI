@page "/components/qrcode"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>QRCode - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">QRCode</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Generate crisp, standard-compliant SVG QR codes client-side with zero external image requests, supporting custom dimensions, colors, error correction levels, central icons, and expiry states.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="QRCode Interactive Playground"
                     ComponentTag="QRCode"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic QR Code *@
    <DemoCard Title="Basic QR Code" Description="Generates standard ISO-compliant scannable QR codes for URLs or text data." Code="@_basicCode">
        <div class="p-6 flex items-center justify-center">
            <QRCode Value="https://github.com/DominikNITA/TentoUI" Size="140" />
        </div>
    </DemoCard>

    @* Example 2: Custom Sizing & Color *@
    <DemoCard Title="Custom Size &amp; Colors" Description="Control dimensions and color accents to suit your branding." Code="@_colorsCode">
        <div class="p-6 flex flex-wrap items-center justify-center gap-8">
            <QRCode Value="https://github.com/DominikNITA" Size="120" Color="#2563eb" />
            <QRCode Value="https://github.com/DominikNITA/TentoUI" Size="120" Color="#059669" />
        </div>
    </DemoCard>

    @* Example 3: Expired State *@
    <DemoCard Title="Status Overlays (Expired / Loading)" Description="Includes built-in interactive refresh overlay when a time-sensitive code expires." Code="@_statusCode">
        <div class="p-6 flex items-center justify-center">
            <QRCode Value="https://tentoui.dev/auth/session"
                    Size="140"
                    Status="_qrStatus"
                    OnRefresh="HandleRefresh" />
        </div>
    </DemoCard>

    @* Example 4: Center Icon & Error Level *@
    <DemoCard Title="Logo Icon &amp; Error Correction Level" Description="Embed a center icon image with high error correction (Level Q or H) so the code remains 100% scannable." Code="@_iconCode">
        <div class="p-6 flex items-center justify-center">
            <QRCode Value="https://tentoui.dev"
                    Size="160"
                    ErrorLevel="QRCodeErrorLevel.H"
                    Icon="favicon.png"
                    IconSize="36" />
        </div>
    </DemoCard>

    <ApiTable Title="QRCode Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Value", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "https://github.com/DominikNITA/TentoUI", DefaultValue = "" },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "140", DefaultValue = "160" },
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "QRCodeStatus.Active", DefaultValue = "QRCodeStatus.Active", Options = ["QRCodeStatus.Active", "QRCodeStatus.Loading", "QRCodeStatus.Expired"] },
        new() { Name = "Bordered", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" }
    ];

    private QRCodeStatus _qrStatus = QRCodeStatus.Expired;

    private void HandleRefresh()
    {
        _qrStatus = QRCodeStatus.Active;
        MessageService.Success("QR code refreshed successfully!");
    }

    private const string _basicCode = """
        <QRCode Value="https://github.com/DominikNITA/TentoUI" Size="140" />
        """;

    private const string _colorsCode = """
        <QRCode Value="https://github.com/DominikNITA" Size="120" Color="#2563eb" />
        <QRCode Value="https://github.com/DominikNITA/TentoUI" Size="120" Color="#059669" />
        """;

    private const string _statusCode = """
        <QRCode Value="https://tentoui.dev/auth/session"
                Size="140"
                Status="QRCodeStatus.Expired"
                OnRefresh="HandleRefresh" />
        """;

    private const string _iconCode = """
        <QRCode Value="https://tentoui.dev"
                Size="160"
                ErrorLevel="QRCodeErrorLevel.H"
                Icon="favicon.png"
                IconSize="36" />
        """;

    private readonly ApiProp[] _props =
    [
        new("Value", "The text or URL encoded in the QR code.", "string", "required"),
        new("Size", "Width and height dimension in pixels.", "int", "160"),
        new("Color", "Foreground pixel color hex string.", "string", "'#000000'"),
        new("BgColor", "Background fill color hex string.", "string", "'#ffffff'"),
        new("Bordered", "Whether to show outer border card frame.", "bool", "true"),
        new("Status", "Status overlay: Active, Expired, or Loading.", "QRCodeStatus", "QRCodeStatus.Active"),
        new("ErrorLevel", "Error correction capacity: L (7%), M (15%), Q (25%), H (30%).", "QRCodeErrorLevel", "QRCodeErrorLevel.M"),
        new("Icon", "Optional central logo/icon image URL.", "string?", "null"),
        new("IconSize", "Pixel size of the central logo.", "int", "40"),
        new("OnRefresh", "Callback executed when user clicks Refresh in Expired state.", "EventCallback", "null")
    ];
}
