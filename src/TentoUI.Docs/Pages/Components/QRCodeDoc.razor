@page "/components/qrcode"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>QRCode - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">QRCode</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Generate crisp SVG QR codes client-side with zero external image requests, supporting custom dimensions, colors, and expiry states.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Type text to generate QR code in real-time, adjust size, or test expired state.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <QRCode Value="@_value"
                    Size="_size"
                    Color="@_color"
                    Status="_status"
                    OnRefresh="@(() => { _status = QRCodeStatus.Active; MessageService.Success("QR code refreshed!"); })" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Encoded Value</label>
                <input type="text"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_value"
                       @bind:event="oninput" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Dimension Size (px)</label>
                <input type="number"
                       min="96"
                       max="256"
                       step="16"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_size" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Status Overlay</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_status">
                    <option value="@QRCodeStatus.Active">Active</option>
                    <option value="@QRCodeStatus.Loading">Loading</option>
                    <option value="@QRCodeStatus.Expired">Expired (Refresh button)</option>
                </select>
            </div>
        </div>
    </div>

    <ApiTable Title="QRCode Properties" Properties="@_props" />
</div>

@code {
    private string _value = "https://github.com/dominik/TentoUI";
    private int _size = 140;
    private string _color = "#0f172a";
    private QRCodeStatus _status = QRCodeStatus.Active;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "The text or URL encoded in the QR code.", "string", "required"),
        new("Size", "Width and height dimension in pixels.", "int", "160"),
        new("Color", "Foreground pixel color hex string.", "string", "'#000000'"),
        new("BgColor", "Background fill color hex string.", "string", "'#ffffff'"),
        new("Status", "Status overlay: Active, Expired, or Loading.", "QRCodeStatus", "QRCodeStatus.Active"),
        new("OnRefresh", "Callback executed when user clicks Refresh in Expired state.", "EventCallback", "null")
    ];
}
