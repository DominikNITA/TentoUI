@page "/components/radio"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Radio - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Radio</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Used to select a single state or value from multiple mutually exclusive options.
        </p>
    </div>

    @* Example 1: Basic Radio Group *@
    <DemoCard Title="Basic Radio Group" Description="Single choice selection across multiple items." Code="@_basicCode">
        <div class="p-2 space-y-3">
            <RadioGroup TValue="string" @bind-Value="_selectedPlan">
                <Radio Value="@("free")">Free Tier ($0/mo)</Radio>
                <Radio Value="@("pro")">Pro Team ($29/mo)</Radio>
                <Radio Value="@("enterprise")">Enterprise (Custom)</Radio>
            </RadioGroup>
            <div class="text-xs text-slate-400 font-mono">Selected Plan: @_selectedPlan</div>
        </div>
    </DemoCard>

    @* Example 2: Radio Button Style *@
    <DemoCard Title="Radio Button Style" Description="Render radio choices as contiguous toggle buttons." Code="@_buttonCode">
        <div class="p-2 space-y-3">
            <RadioGroup TValue="string" @bind-Value="_selectedPeriod" ButtonStyle="RadioButtonStyle.Solid">
                <Radio Value="@("monthly")">Monthly</Radio>
                <Radio Value="@("quarterly")">Quarterly</Radio>
                <Radio Value="@("yearly")">Yearly (Save 20%)</Radio>
            </RadioGroup>
            <div class="text-xs text-slate-400 font-mono">Billing Interval: @_selectedPeriod</div>
        </div>
    </DemoCard>

    @* Example 3: Vertical Radio Group *@
    <DemoCard Title="Vertical Radio Group" Description="Stack choices vertically with Vertical='true'." Code="@_verticalCode">
        <div class="p-2 space-y-2">
            <RadioGroup TValue="string" @bind-Value="_selectedNotification" Vertical="true">
                <Radio Value="@("all")">All new messages and direct mentions</Radio>
                <Radio Value="@("mentions")">Direct @@mentions and replies only</Radio>
                <Radio Value="@("mute")">Mute all email and push notifications</Radio>
            </RadioGroup>
            <div class="text-xs text-slate-400 font-mono mt-2">Notification preference: @_selectedNotification</div>
        </div>
    </DemoCard>

    @* Example 4: Disabled Options *@
    <DemoCard Title="Disabled Options" Description="Selectively disable individual radio options." Code="@_disabledCode">
        <div class="p-2">
            <RadioGroup TValue="string" @bind-Value="_selectedRegion">
                <Radio Value="@("us-east")">US East (N. Virginia)</Radio>
                <Radio Value="@("eu-central")">EU Central (Frankfurt)</Radio>
                <Radio Value="@("ap-south")" Disabled="true">Asia Pacific (Mumbai - Full)</Radio>
            </RadioGroup>
        </div>
    </DemoCard>

    <ApiTable Title="RadioGroup Properties" Properties="@_groupProps" />
    <ApiTable Title="Radio Properties" Properties="@_radioProps" />
</div>

@code {
    private string _selectedPlan = "pro";
    private string _selectedPeriod = "monthly";
    private string _selectedRegion = "us-east";
    private string _selectedNotification = "mentions";

    private const string _basicCode = """
        <RadioGroup TValue="string" @bind-Value="selectedPlan">
            <Radio Value="@("free")">Free Tier ($0/mo)</Radio>
            <Radio Value="@("pro")">Pro Team ($29/mo)</Radio>
            <Radio Value="@("enterprise")">Enterprise (Custom)</Radio>
        </RadioGroup>
        """;

    private const string _verticalCode = """
        <RadioGroup TValue="string" @bind-Value="selectedNotification" Vertical="true">
            <Radio Value="@("all")">All new messages</Radio>
            <Radio Value="@("mentions")">Direct @mentions only</Radio>
            <Radio Value="@("mute")">Mute all notifications</Radio>
        </RadioGroup>
        """;

    private const string _buttonCode = """
        <RadioGroup TValue="string" @bind-Value="selectedPeriod" ButtonStyle="RadioButtonStyle.Solid">
            <Radio Value="@("monthly")">Monthly</Radio>
            <Radio Value="@("quarterly")">Quarterly</Radio>
            <Radio Value="@("yearly")">Yearly (Save 20%)</Radio>
        </RadioGroup>
        """;

    private const string _disabledCode = """
        <RadioGroup TValue="string" @bind-Value="selectedRegion">
            <Radio Value="@("us-east")">US East (N. Virginia)</Radio>
            <Radio Value="@("eu-central")">EU Central (Frankfurt)</Radio>
            <Radio Value="@("ap-south")" Disabled="true">Asia Pacific (Full)</Radio>
        </RadioGroup>
        """;

    private readonly ApiTable.ApiProp[] _groupProps =
    [
        new("Value", "Selected option value (bindable via @bind-Value).", "TValue", "default"),
        new("Vertical", "Whether to layout radio options vertically in a column.", "bool", "false"),
        new("Disabled", "Disables all radio choices within this group.", "bool", "false"),
        new("ButtonStyle", "Visual style when rendered as buttons (Outline, Solid).", "RadioButtonStyle", "RadioButtonStyle.Outline"),
        new("ChildContent", "Radio child elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _radioProps =
    [
        new("Value", "Unique value represented by this radio choice.", "TValue", "default"),
        new("Disabled", "Whether this single choice is disabled.", "bool", "false"),
        new("ChildContent", "Label text.", "RenderFragment?", "null")
    ];
}