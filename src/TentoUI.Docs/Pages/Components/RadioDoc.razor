@page "/components/radio"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Radio - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Radio</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Used to select a single state or value from multiple mutually exclusive options.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Select options dynamically and test group disabled toggles.</p>
            </div>
            <div class="text-xs text-slate-400">
                Selected: <strong class="text-primary-600 dark:text-primary-400 font-mono">@_selectedPlan</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40">
            <RadioGroup TValue="string" @bind-Value="_selectedPlan" Disabled="_disabled">
                <Radio Value="@("free")">Free Tier ($0)</Radio>
                <Radio Value="@("pro")">Pro Team ($29/mo)</Radio>
                <Radio Value="@("enterprise")">Enterprise (Custom)</Radio>
            </RadioGroup>
        </div>

        <div class="flex items-center gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                <span>Disable All Radio Options</span>
            </label>
        </div>
    </div>

    <ApiTable Title="RadioGroup Properties" Properties="@_groupProps" />
    <ApiTable Title="Radio Properties" Properties="@_radioProps" />
</div>

@code {
    private string _selectedPlan = "pro";
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _groupProps =
    [
        new("Value", "Selected option value (bindable via @bind-Value).", "TValue", "default"),
        new("Disabled", "Disables all radio choices within this group.", "bool", "false"),
        new("ButtonStyle", "Visual style when rendered as buttons (Outline, Solid).", "RadioButtonStyle", "RadioButtonStyle.Outline"),
        new("ChildContent", "Radio child elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _radioProps =
    [
        new("Value", "Unique value represented by this radio choice.", "TValue", "default"),
        new("Disabled", "Whether this single choice is disabled.", "bool", "false"),
        new("ChildContent", "Label text.", "RenderFragment?", "null")
    ];
}
