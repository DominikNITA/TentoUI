@page "/components/rate"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Rate - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Rate</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Rate component for star evaluations and customer score collection with dynamic hover and clear interactions.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Click stars to evaluate and toggle read-only / clear options.</p>
            </div>
            <div class="text-xs text-slate-400">
                Score: <strong class="text-amber-500 font-mono text-sm">@_score / @_count</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Rate @bind-Value="_score"
                  Count="_count"
                  AllowClear="_allowClear"
                  Disabled="_disabled"
                  ReadOnly="_readOnly" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Star Count</label>
                <input type="number"
                       min="3"
                       max="10"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_count" />
            </div>
            <div class="flex items-center gap-4 pt-5">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_allowClear" class="rounded text-primary-600" />
                    <span>Allow Clear</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_readOnly" class="rounded text-primary-600" />
                    <span>Read Only</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="Rate Properties" Properties="@_props" />
</div>

@code {
    private int _score = 4;
    private int _count = 5;
    private bool _allowClear = true;
    private bool _readOnly;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current rating score (bindable via @bind-Value).", "int", "0"),
        new("Count", "Star count total.", "int", "5"),
        new("AllowClear", "Whether to allow clear when clicking again.", "bool", "true"),
        new("ReadOnly", "Read only, unable to interact.", "bool", "false"),
        new("Disabled", "Disabled, unable to interact.", "bool", "false"),
        new("Tooltips", "Tooltip text for each star.", "IReadOnlyList<string>?", "null")
    ];
}
