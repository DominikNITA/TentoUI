@page "/components/result"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Result - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Result</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Used to feed back the results of a series of operational tasks, such as successful order confirmation or operational exceptions.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Result Interactive Playground"
                     ComponentTag="Result"
                     Controls="@_playgroundControls" />

    @* Example 1: Success Result *@
    <DemoCard Title="Success Result" Description="Show a positive confirmation message with primary actions." Code="@_successCode">
        <Result Status="ResultStatus.Success"
                Title="Successfully Purchased Cloud Instance"
                SubTitle="Order number: 20261028-4091. Cloud deployment will finish in 1-3 minutes.">
            <Extra>
                <Button Type="ButtonType.Primary">Go to Console</Button>
                <Button Type="ButtonType.Default">View Order</Button>
            </Extra>
        </Result>
    </DemoCard>

    @* Example 2: Warning & Error *@
    <DemoCard Title="Warning &amp; Error" Description="Notify users of issues requiring attention or submission failures." Code="@_errorWarningCode">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-4 border border-slate-200 dark:border-slate-800 rounded-xl bg-slate-50/50 dark:bg-slate-950/40">
                <Result Status="ResultStatus.Warning"
                        Title="Configuration Incomplete"
                        SubTitle="Please verify your network VPC CIDR before continuing.">
                    <Extra>
                        <Button Type="ButtonType.Primary">Review Settings</Button>
                    </Extra>
                </Result>
            </div>
            <div class="p-4 border border-slate-200 dark:border-slate-800 rounded-xl bg-slate-50/50 dark:bg-slate-950/40">
                <Result Status="ResultStatus.Error"
                        Title="Submission Failed"
                        SubTitle="Please check card details and network connectivity before resubmitting.">
                    <Extra>
                        <Button Type="ButtonType.Primary" Danger="true">Retry Payment</Button>
                    </Extra>
                </Result>
            </div>
        </div>
    </DemoCard>

    @* Example 3: Info Result with Detailed Content *@
    <DemoCard Title="Info with Detailed Content" Description="Informational status feedback including nested child content." Code="@_infoCode">
        <Result Status="ResultStatus.Info"
                Title="Your operation has been submitted"
                SubTitle="Task ID: #98421. You will receive an email confirmation once completed.">
            <Extra>
                <Button Type="ButtonType.Primary">Track Progress</Button>
            </Extra>
            <ChildContent>
                <div class="text-xs text-slate-500 space-y-1">
                    <p class="font-medium text-slate-700 dark:text-slate-300">Next Steps:</p>
                    <p>• Automated security scanning in progress</p>
                    <p>• DNS propagation takes up to 10 minutes</p>
                </div>
            </ChildContent>
        </Result>
    </DemoCard>

    <ApiTable Title="Result Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "ResultStatus.Success", DefaultValue = "ResultStatus.Info", Options = ["ResultStatus.Success", "ResultStatus.Info", "ResultStatus.Warning", "ResultStatus.Error"] },
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Successfully Deployed Application", DefaultValue = "" },
        new() { Name = "SubTitle", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Production instance is healthy and serving live requests.", DefaultValue = "" }
    ];

    private const string _successCode = """
        <Result Status="ResultStatus.Success"
                Title="Successfully Purchased Cloud Instance"
                SubTitle="Order number: 20261028-4091. Cloud deployment will finish in 1-3 minutes.">
            <Extra>
                <Button Type="ButtonType.Primary">Go to Console</Button>
                <Button Type="ButtonType.Default">View Order</Button>
            </Extra>
        </Result>
        """;

    private const string _errorWarningCode = """
        <Result Status="ResultStatus.Warning"
                Title="Configuration Incomplete"
                SubTitle="Please verify your network VPC CIDR before continuing.">
            <Extra>
                <Button Type="ButtonType.Primary">Review Settings</Button>
            </Extra>
        </Result>

        <Result Status="ResultStatus.Error"
                Title="Submission Failed"
                SubTitle="Please check card details before resubmitting.">
            <Extra>
                <Button Type="ButtonType.Primary" Danger="true">Retry Payment</Button>
            </Extra>
        </Result>
        """;

    private const string _infoCode = """
        <Result Status="ResultStatus.Info"
                Title="Your operation has been submitted"
                SubTitle="Task ID: #98421. You will receive an email confirmation once completed.">
            <Extra>
                <Button Type="ButtonType.Primary">Track Progress</Button>
            </Extra>
        </Result>
        """;

    private readonly ApiProp[] _props =
    [
        new("Status", "Result status: Success, Error, Info, Warning.", "ResultStatus", "ResultStatus.Info"),
        new("Title", "The title text.", "string?", "null"),
        new("SubTitle", "The sub title text.", "string?", "null"),
        new("Icon", "Custom icon template.", "RenderFragment?", "null"),
        new("Extra", "Operating area action buttons.", "RenderFragment?", "null"),
        new("ChildContent", "Custom detailed content area.", "RenderFragment?", "null")
    ];
}