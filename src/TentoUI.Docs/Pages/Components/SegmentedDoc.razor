@page "/components/segmented"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Segmented - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Segmented</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Segmented controls display mutually exclusive options or views horizontally, functioning as modern pill tabs or radio buttons.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Tweak segmented size, block mode, and disabled state.</p>
            </div>
            <span class="text-xs font-mono bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded text-slate-600 dark:text-slate-300">
                Selected: <strong>@_selectedVal</strong>
            </span>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Segmented TValue="string"
                       Value="@_selectedVal"
                       ValueChanged="@((v) => _selectedVal = v)"
                       Options="@_options"
                       Size="@_size"
                       Block="@_block"
                       Disabled="@_disabled" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Size</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_size">
                    <option value="@ComponentSize.Small">Small</option>
                    <option value="@ComponentSize.Middle">Middle</option>
                    <option value="@ComponentSize.Large">Large</option>
                </select>
            </div>
            <div class="flex items-center pt-5">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_block" class="rounded text-primary-600" />
                    <span>Block (Full Width)</span>
                </label>
            </div>
            <div class="flex items-center pt-5">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    @* Examples Section *@
    <div class="space-y-6">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Examples</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <DemoCard Title="With Icons" Description="Segments with leading icons for view switchers.">
                <div class="p-4 flex justify-center">
                    <Segmented TValue="string"
                               Value="@_viewMode"
                               ValueChanged="@((v) => _viewMode = v)"
                               Options="@_iconOptions" />
                </div>
            </DemoCard>

            <DemoCard Title="Disabled Option" Description="Individual options can be disabled selectively.">
                <div class="p-4 flex justify-center">
                    <Segmented TValue="string"
                               Value="@_scope"
                               ValueChanged="@((v) => _scope = v)"
                               Options="@_disabledOptions" />
                </div>
            </DemoCard>
        </div>
    </div>

    @* API Documentation *@
    <div class="space-y-4 pt-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">API Reference</h2>
        <ApiTable Title="Segmented<TValue> Properties" Properties="@_apiProps" />
    </div>
</div>

@code {
    private string _selectedVal = "Daily";
    private ComponentSize _size = ComponentSize.Middle;
    private bool _block = false;
    private bool _disabled = false;

    private string _viewMode = "grid";
    private string _scope = "team";

    private readonly SegmentedOption<string>[] _options = new[]
    {
        new SegmentedOption<string>("Daily", "Daily"),
        new SegmentedOption<string>("Weekly", "Weekly"),
        new SegmentedOption<string>("Monthly", "Monthly"),
        new SegmentedOption<string>("Quarterly", "Quarterly")
    };

    private readonly SegmentedOption<string>[] _iconOptions = new[]
    {
        new SegmentedOption<string>("calendar", "Calendar", IconNames.Calendar),
        new SegmentedOption<string>("clock", "Timeline", IconNames.Clock)
    };

    private readonly SegmentedOption<string>[] _disabledOptions = new[]
    {
        new SegmentedOption<string>("me", "Only Me"),
        new SegmentedOption<string>("team", "Team"),
        new SegmentedOption<string>("all", "Organization", Disabled: true)
    };

    private readonly ApiProp[] _apiProps = new[]
    {
        new ApiProp("Value", "Currently selected option value", "TValue", "-"),
        new ApiProp("ValueChanged", "Callback when selection changes", "EventCallback<TValue>", "-"),
        new ApiProp("OnChange", "Callback triggered on selection change", "EventCallback<TValue>", "-"),
        new ApiProp("Options", "List of SegmentedOption<TValue> items", "IEnumerable<SegmentedOption<TValue>>", "-"),
        new ApiProp("OptionTemplate", "Custom template for each segment", "RenderFragment<SegmentedOption<TValue>>", "-"),
        new ApiProp("Disabled", "Whether the entire segmented control is disabled", "bool", "false"),
        new ApiProp("Block", "Fit container width", "bool", "false"),
        new ApiProp("Size", "Size of segmented control: Small, Middle, Large", "ComponentSize", "Middle")
    };
}
