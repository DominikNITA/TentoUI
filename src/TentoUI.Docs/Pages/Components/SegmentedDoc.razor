@page "/components/segmented"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Segmented - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Segmented</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Segmented controls display mutually exclusive options or views horizontally, functioning as modern pill tabs or radio buttons.
        </p>
    </div>

    @* Example 1: Basic Segmented *@
    <DemoCard Title="Basic Usage" Description="Linear pill selector for choosing timeframes or views." Code="@_basicCode">
        <div class="flex flex-col sm:flex-row items-center gap-4">
            <Segmented TValue="string"
                       Value="@_selectedVal"
                       ValueChanged="@((v) => _selectedVal = v)"
                       Options="@_options" />
            <span class="text-xs font-mono text-slate-500">Selected: <strong>@_selectedVal</strong></span>
        </div>
    </DemoCard>

    @* Example 2: With Icons *@
    <DemoCard Title="Segmented with Icons" Description="Segments featuring icon glyphs for compact toolbar views." Code="@_iconCode">
        <div class="flex flex-col sm:flex-row items-center gap-4">
            <Segmented TValue="string"
                       Value="@_viewMode"
                       ValueChanged="@((v) => _viewMode = v)"
                       Options="@_iconOptions" />
            <span class="text-xs font-mono text-slate-500">Active View: <strong>@_viewMode</strong></span>
        </div>
    </DemoCard>

    @* Example 3: Sizes & Disabled Option *@
    <DemoCard Title="Sizes &amp; Disabled State" Description="Supports Small, Middle, and Large sizes, and selectively disabled items." Code="@_sizesCode">
        <div class="space-y-4">
            <Segmented TValue="string"
                       Value="@_sizeVal"
                       ValueChanged="@((v) => _sizeVal = v)"
                       Options="@_options"
                       Size="ComponentSize.Small" />

            <Segmented TValue="string"
                       Value="@_scope"
                       ValueChanged="@((v) => _scope = v)"
                       Options="@_disabledOptions" />
        </div>
    </DemoCard>

    <ApiTable Title="Segmented<TValue> Properties" Properties="@_apiProps" />
</div>

@code {
    private string _selectedVal = "Daily";
    private string _sizeVal = "Daily";
    private string _viewMode = "edit";
    private string _scope = "team";

    private readonly SegmentedOption<string>[] _options =
    [
        new("Daily", "Daily"),
        new("Weekly", "Weekly"),
        new("Monthly", "Monthly"),
        new("Quarterly", "Quarterly")
    ];

    private readonly SegmentedOption<string>[] _iconOptions =
    [
        new("edit", "Edit", IconNames.Edit),
        new("menu", "Menu", IconNames.Menu)
    ];

    private readonly SegmentedOption<string>[] _disabledOptions =
    [
        new("personal", "Personal"),
        new("team", "Team"),
        new("enterprise", "Enterprise (Locked)", Disabled: true)
    ];

    private const string _basicCode = """
        <Segmented TValue="string"
                   @bind-Value="selectedVal"
                   Options="@options" />
        """;

    private const string _iconCode = """
        <Segmented TValue="string"
                   @bind-Value="viewMode"
                   Options="@iconOptions" />
        """;

    private const string _sizesCode = """
        <Segmented TValue="string"
                   @bind-Value="val"
                   Options="@options"
                   Size="ComponentSize.Small" />

        <Segmented TValue="string"
                   @bind-Value="scope"
                   Options="@disabledOptions" />
        """;

    private readonly ApiTable.ApiProp[] _apiProps =
    [
        new("Value", "Current selected value.", "TValue?", "default"),
        new("ValueChanged", "Callback when selected value changes.", "EventCallback<TValue>", "—"),
        new("Options", "List of SegmentedOption<TValue> items.", "IReadOnlyList<SegmentedOption<TValue>>", "empty"),
        new("Size", "Control height (Small, Middle, Large).", "ComponentSize", "ComponentSize.Middle"),
        new("Block", "Fit parent container width (flex-1 items).", "bool", "false"),
        new("Disabled", "Disable all interaction.", "bool", "false"),
        new("Class", "Additional CSS class names.", "string?", "null")
    ];
}