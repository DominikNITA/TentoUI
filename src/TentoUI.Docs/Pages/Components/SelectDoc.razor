@page "/components/select"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Select - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Select</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Select component to pick values from an options menu, supporting single, multiple, and search-filterable modes.
            Options can be specified as a direct inline string list or bound to strongly-typed collections.
        </p>
    </div>

    @* Example 1: Basic Select with Inline Options *@
    <DemoCard Title="Basic Single Select"
              Description="Choose a destination from an inline options list. All options are visible and editable in the code."
              Code="@_basicCode" />

    @* Example 2: Searchable Select *@
    <DemoCard Title="Search Filter"
              Description="Allows users to type and filter long option lists instantaneously."
              Code="@_searchCode" />

    @* Example 3: Multiple Mode *@
    <DemoCard Title="Multiple Tag Selection"
              Description="Select multiple options simultaneously rendered as removable chips."
              Code="@_multipleCode" />

    <ApiTable Title="Select Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <div class="max-w-xs p-2">
            <Select TItem="string"
                    TValue="string"
                    Placeholder="Choose a destination..."
                    Options="Warsaw, Berlin, London, Paris, Tokyo, Sydney"
                    AllowClear="true" />
        </div>
        """;

    private const string _searchCode = """
        <div class="max-w-xs p-2">
            <Select TItem="string"
                    TValue="string"
                    Placeholder="Search city name..."
                    Options="Warsaw, Berlin, London, Paris, Tokyo, New York, San Francisco, Singapore, Zurich"
                    ShowSearch="true"
                    AllowClear="true" />
        </div>
        """;

    private const string _multipleCode = """
        <div class="max-w-sm p-2">
            <Select TItem="string"
                    TValue="string"
                    Mode="SelectMode.Multiple"
                    Placeholder="Select multiple destinations..."
                    Options="Warsaw, Berlin, London, Paris, Tokyo, Rome, Madrid" />
        </div>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Options", "Comma-separated string of options (e.g. 'Option 1, Option 2').", "string?", "null"),
        new("DataSource", "The source data collection for strongly-typed items.", "IEnumerable<TItem>?", "null"),
        new("Value", "Current selected value (bindable via @bind-Value).", "TValue", "default"),
        new("Values", "Selected values for multiple mode (bindable via @bind-Values).", "IEnumerable<TValue>?", "null"),
        new("Mode", "Selection mode: Single or Multiple.", "SelectMode", "SelectMode.Single"),
        new("ValueProperty", "Selector function to get option value from typed item.", "Func<TItem, TValue>?", "null"),
        new("LabelProperty", "Selector function to get option display label.", "Func<TItem, string>?", "null"),
        new("Placeholder", "Placeholder text.", "string?", "'Select an option'"),
        new("ShowSearch", "Enable instant filtering search input.", "bool", "false"),
        new("AllowClear", "Whether clear button is visible.", "bool", "false"),
        new("Disabled", "Whether select component is disabled.", "bool", "false")
    ];
}
