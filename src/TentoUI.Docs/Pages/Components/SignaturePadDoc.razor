@page "/components/signature-pad"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>SignaturePad - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">SignaturePad</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Zero-JS vector SVG signature capture pad supporting mouse, touch, and stylus input with Undo, Clear, and data-URI export.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="SignaturePad Interactive Playground"
                     ComponentTag="SignaturePad"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Digital Approval Signature Capture" Description="@("Draw directly on the pad below; exports an SVG data URL via @bind-Value.")" Code="@_sigCode">
        <div class="space-y-3 max-w-lg">
            <SignaturePad @bind-Value="_signatureDataUrl" />
            @if (!string.IsNullOrEmpty(_signatureDataUrl))
            {
                <div class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">
                    ✓ Signature captured (@_signatureDataUrl.Length bytes)
                </div>
            }
        </div>
    </DemoCard>

    <ApiTable Title="SignaturePad Properties" ComponentType="@typeof(SignaturePad)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Placeholder", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Sign here to approve contract", DefaultValue = "" },
        new() { Name = "StrokeWidth", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "2", DefaultValue = "2" },
        new() { Name = "StrokeColor", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "#0f172a", DefaultValue = "#0f172a" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string? _signatureDataUrl;

    private const string _sigCode = """
        <SignaturePad Placeholder="Sign here to approve contract" />
        """;
}
