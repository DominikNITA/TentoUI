@page "/components/skeleton"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Skeleton - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Skeleton</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Provide a placeholder while you wait for content to load, or to visualize content that doesn't exist yet.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Skeleton Interactive Playground"
                     ComponentTag="Skeleton"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Skeleton *@
    <DemoCard Title="Basic Skeleton" Description="Simple placeholder with title and paragraph rows." Code="@_basicCode">
        <div class="max-w-md">
            <Skeleton Active="true" Rows="3" />
        </div>
    </DemoCard>

    @* Example 2: Complex Profile Skeleton *@
    <DemoCard Title="Profile Skeleton" Description="Skeleton placeholder with circular avatar and shimmer animation." Code="@_profileCode">
        <div class="max-w-lg p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
            <Skeleton Active="true" Avatar="true" Rows="3" />
        </div>
    </DemoCard>

    @* Example 3: Dynamic Content Switching *@
    <DemoCard Title="Dynamic Loading Toggle" Description="Wrap actual content. Toggling Loading smoothly switches between skeleton and rendered markup." Code="@_dynamicCode">
        <div class="space-y-4 max-w-lg">
            <div class="flex items-center gap-3">
                <Button Type="ButtonType.Default" OnClick="() => _isLoading = !_isLoading">
                    @(_isLoading ? "Simulate Content Loaded" : "Reset to Skeleton")
                </Button>
                <span class="text-xs text-slate-600 dark:text-slate-400">Current status: @(_isLoading ? "Loading..." : "Loaded")</span>
            </div>

            <div class="p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm">
                <Skeleton Loading="_isLoading" Active="true" Avatar="true" Rows="2">
                    <div class="flex items-start gap-3">
                        <Avatar Text="AL" Size="ComponentSize.Large" />
                        <div class="space-y-1">
                            <h4 class="font-bold text-sm text-slate-900 dark:text-white">Alice Lawson</h4>
                            <p class="text-xs text-slate-500">Staff Infrastructure Engineer at Global Cloud Inc.</p>
                        </div>
                    </div>
                </Skeleton>
            </div>
        </div>
    </DemoCard>

    <ApiTable Title="Skeleton Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Active", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Avatar", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Title", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Paragraph", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Rows", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "3", DefaultValue = "3" }
    ];

    private bool _isLoading = true;

    private const string _basicCode = """
        <Skeleton Active="true" Rows="3" />
        """;

    private const string _profileCode = """
        <Skeleton Active="true" Avatar="true" Rows="3" />
        """;

    private const string _dynamicCode = """
        <Skeleton Loading="@isLoading" Active="true" Avatar="true" Rows="2">
            <div class="flex items-start gap-3">
                <Avatar Text="AL" Size="ComponentSize.Large" />
                <div>
                    <h4 class="font-bold text-sm">Alice Lawson</h4>
                    <p class="text-xs text-slate-500">Staff Infrastructure Engineer</p>
                </div>
            </div>
        </Skeleton>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Loading", "Whether to show skeleton placeholder or actual child content.", "bool", "true"),
        new("Active", "Show pulse shimmer animation effect.", "bool", "true"),
        new("Avatar", "Show circular avatar placeholder.", "bool", "false"),
        new("Title", "Show heading title placeholder line.", "bool", "true"),
        new("Paragraph", "Show paragraph lines placeholder.", "bool", "true"),
        new("Rows", "Paragraph line count.", "int", "3"),
        new("ChildContent", "Actual content rendered when Loading is false.", "RenderFragment?", "null")
    ];
}