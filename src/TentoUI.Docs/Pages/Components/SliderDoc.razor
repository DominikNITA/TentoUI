@page "/components/slider"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Slider - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Slider</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A Slider component for displaying current value and intervals along a continuous or discrete range bar.
        </p>
    </div>

    @* Example 1: Basic Slider *@
    <DemoCard Title="Basic Slider" Description="Continuous range slider with two-way double binding." Code="@_basicCode">
        <div class="max-w-md p-4 space-y-2">
            <Slider @bind-Value="_val" Min="0" Max="100" />
            <div class="text-xs text-slate-400 font-mono">Current Value: @_val%</div>
        </div>
    </DemoCard>

    @* Example 2: Show Value Badge *@
    <DemoCard Title="Value Badge Indicator" Description="Displays numeric badge alongside the track." Code="@_badgeCode">
        <div class="max-w-md p-4">
            <Slider @bind-Value="_valBadge" Min="0" Max="100" ShowValue="true" />
        </div>
    </DemoCard>

    @* Example 3: Discrete Steps *@
    <DemoCard Title="Discrete Step Increments" Description="Steps only by increments of 10." Code="@_stepsCode">
        <div class="max-w-md p-4 space-y-2">
            <Slider @bind-Value="_stepVal" Min="0" Max="100" Step="10" ShowValue="true" />
            <div class="text-xs text-slate-400 font-mono">Stepped Value: @_stepVal</div>
        </div>
    </DemoCard>

    <ApiTable Title="Slider Properties" Properties="@_props" />
</div>

@code {
    private double _val = 35;
    private double _valBadge = 70;
    private double _stepVal = 20;

    private const string _basicCode = """
        <Slider @bind-Value="val" Min="0" Max="100" />
        """;

    private const string _badgeCode = """
        <Slider @bind-Value="valBadge" Min="0" Max="100" ShowValue="true" />
        """;

    private const string _stepsCode = """
        <Slider @bind-Value="stepVal" Min="0" Max="100" Step="10" ShowValue="true" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current numeric slider value (bindable via @bind-Value).", "double", "0"),
        new("Min", "The minimum value the slider can slide to.", "double", "0"),
        new("Max", "The maximum value the slider can slide to.", "double", "100"),
        new("Step", "The granularity the slider can step through.", "double", "1"),
        new("ShowValue", "Whether to show the current value indicator badge.", "bool", "false"),
        new("Disabled", "If true, the slider will not be interactable.", "bool", "false"),
        new("TipFormatter", "Custom tooltip/value string formatting function.", "Func<double, string>?", "null")
    ];
}