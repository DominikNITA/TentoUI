@page "/components/slider"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Slider - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Slider</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A Slider component for displaying current value and intervals along a continuous or discrete range bar.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Drag slider and adjust bounds dynamically.</p>
            </div>
            <div class="text-xs text-slate-400">
                Value: <strong class="text-primary-600 dark:text-primary-400 font-mono text-sm">@_val%</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-md mx-auto">
            <Slider @bind-Value="_val"
                    Min="_min"
                    Max="_max"
                    Step="_step"
                    ShowValue="true"
                    Disabled="_disabled" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Step</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_step" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Min</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_min" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Max</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_max" />
            </div>
            <div class="flex items-center gap-4 pt-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="Slider Properties" Properties="@_props" />
</div>

@code {
    private double _val = 35;
    private double _min = 0;
    private double _max = 100;
    private double _step = 1;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current numeric slider value (bindable via @bind-Value).", "double", "0"),
        new("Min", "The minimum value the slider can slide to.", "double", "0"),
        new("Max", "The maximum value the slider can slide to.", "double", "100"),
        new("Step", "The granularity the slider can step through.", "double", "1"),
        new("ShowValue", "Whether to show the current value indicator badge.", "bool", "false"),
        new("Disabled", "If true, the slider will not be interactable.", "bool", "false"),
        new("TipFormatter", "Custom tooltip/value string formatting function.", "Func<double, string>?", "null")
    ];
}
