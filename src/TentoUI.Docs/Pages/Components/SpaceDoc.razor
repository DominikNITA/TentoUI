@page "/components/space"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Space - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Space</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Sets uniform spacing between child components, supporting horizontal, vertical, and wrapping layouts.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Space Interactive Playground"
                     ComponentTag="Space"
                     Controls="@_playgroundControls" />

    @* Example 1: Horizontal Space *@
    <DemoCard Title="Horizontal Flow" Description="Default horizontal arrangement with even spacing between elements." Code="@_horizontalCode">
        <div class="p-2">
            <Space Direction="SpaceDirection.Horizontal" Wrap="true">
                <Button Type="ButtonType.Primary">Primary Action</Button>
                <Button Type="ButtonType.Default">Default</Button>
                <Button Type="ButtonType.Dashed">Dashed</Button>
                <Button Danger="true">Danger</Button>
            </Space>
        </div>
    </DemoCard>

    @* Example 2: Vertical Space *@
    <DemoCard Title="Vertical Flow" Description="Stack inputs or buttons with uniform vertical spacing." Code="@_verticalCode">
        <div class="p-2">
            <Space Direction="SpaceDirection.Vertical" Class="w-full max-w-xs">
                <Input Placeholder="First Name" />
                <Input Placeholder="Last Name" />
                <Button Type="ButtonType.Primary" Block="true">Save Contact</Button>
            </Space>
        </div>
    </DemoCard>

    @* Example 3: Space Gaps Scale *@
    <DemoCard Title="Space Scale Variants" Description="Spacing with Small (8px), Middle (16px), or Large (24px) gaps." Code="@_sizesCode">
        <div class="space-y-4 p-2">
            <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Small">
                <Tag Color="blue">Tag 1</Tag>
                <Tag Color="blue">Tag 2</Tag>
                <Tag Color="blue">Tag 3</Tag>
            </Space>
            <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Large">
                <Tag Color="green">Large Gap A</Tag>
                <Tag Color="green">Large Gap B</Tag>
                <Tag Color="green">Large Gap C</Tag>
            </Space>
        </div>
    </DemoCard>

    <ApiTable Title="Space Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Direction", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Horizontal", DefaultValue = "Horizontal", Options = ["Horizontal", "Vertical"] },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Middle", DefaultValue = "Middle", Options = ["Small", "Middle", "Large"] },
        new() { Name = "Align", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Center", DefaultValue = "", Options = ["Start", "End", "Center", "Baseline"] },
        new() { Name = "Wrap", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" }
    ];

    private const string _horizontalCode = """
        <Space Direction="SpaceDirection.Horizontal" Wrap="true">
            <Button Type="ButtonType.Primary">Primary Action</Button>
            <Button Type="ButtonType.Default">Default</Button>
            <Button Type="ButtonType.Dashed">Dashed</Button>
            <Button Danger="true">Danger</Button>
        </Space>
        """;

    private const string _verticalCode = """
        <Space Direction="SpaceDirection.Vertical" Class="w-full max-w-xs">
            <Input Placeholder="First Name" />
            <Input Placeholder="Last Name" />
            <Button Type="ButtonType.Primary" Block="true">Save Contact</Button>
        </Space>
        """;

    private const string _sizesCode = """
        <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Small">
            <Tag Color="blue">Tag 1</Tag>
            <Tag Color="blue">Tag 2</Tag>
        </Space>
        <Space Direction="SpaceDirection.Horizontal" Size="SpaceSize.Large">
            <Tag Color="green">Large Gap A</Tag>
            <Tag Color="green">Large Gap B</Tag>
        </Space>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Direction", "Layout flow direction (Horizontal, Vertical).", "SpaceDirection", "SpaceDirection.Horizontal"),
        new("Size", "Spacing size: SpaceSize enum (Small, Middle, Large), int pixels, or string.", "object", "SpaceSize.Middle"),
        new("Align", "Cross-axis alignment (Start, End, Center, Baseline).", "SpaceAlign?", "null"),
        new("Wrap", "Whether child elements wrap across multiple rows.", "bool", "false"),
        new("Split", "Template rendered between each pair of items.", "RenderFragment?", "null"),
        new("ChildContent", "Items laid out inside the space container.", "RenderFragment?", "null")
    ];
}