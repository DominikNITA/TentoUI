@page "/components/spin"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Spin - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Spin</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A spinner for displaying loading states of a page, container, or background operation.
        </p>
    </div>

    @* Example 1: Basic Spinners *@
    <DemoCard Title="Spinner Sizes" Description="Standalone spinners with Small, Middle, and Large scales." Code="@_sizesCode">
        <div class="flex items-center gap-8 p-4">
            <Spin Size="ComponentSize.Small" />
            <Spin Size="ComponentSize.Middle" />
            <Spin Size="ComponentSize.Large" />
        </div>
    </DemoCard>

    @* Example 2: Spin with Tip *@
    <DemoCard Title="Custom Tip Message" Description="Add descriptive text beneath the spinner." Code="@_tipCode">
        <div class="p-4">
            <Spin Tip="Synchronizing telemetry..." />
        </div>
    </DemoCard>

    @* Example 3: Container Loading Overlay *@
    <DemoCard Title="Container Overlay" Description="Wrap cards, forms, or data views to display a blurred loading backdrop." Code="@_containerCode">
        <div class="space-y-4 max-w-lg">
            <Button Type="ButtonType.Default" OnClick="() => _spinning = !_spinning">
                Toggle Loading (@(_spinning ? "Stop" : "Start"))
            </Button>

            <Spin Spinning="_spinning" Tip="Processing data...">
                <div class="p-6 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 text-xs">
                    <h4 class="font-bold text-sm text-slate-800 dark:text-white">Live Data Feed</h4>
                    <p class="text-slate-500">Processing live telemetry stream from IoT gateway devices.</p>
                    <div class="h-2 bg-slate-100 dark:bg-slate-800 rounded"></div>
                </div>
            </Spin>
        </div>
    </DemoCard>

    <ApiTable Title="Spin Properties" Properties="@_props" />
</div>

@code {
    private bool _spinning = true;

    private const string _sizesCode = """
        <Spin Size="ComponentSize.Small" />
        <Spin Size="ComponentSize.Middle" />
        <Spin Size="ComponentSize.Large" />
        """;

    private const string _tipCode = """
        <Spin Tip="Synchronizing telemetry..." />
        """;

    private const string _containerCode = """
        <Spin Spinning="@spinning" Tip="Processing data...">
            <div class="p-6 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800">
                <h4 class="font-bold text-sm">Live Data Feed</h4>
                <p class="text-xs text-slate-500">Processing live telemetry stream...</p>
            </div>
        </Spin>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Spinning", "Whether Spin is spinning (loading).", "bool", "true"),
        new("Size", "Size scale of the spinner (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Tip", "Customize description text rendered below the spinner.", "string?", "null"),
        new("Delay", "Specifies a delay in milliseconds for loading state.", "int?", "null"),
        new("FullScreen", "Whether to render full-screen fixed spinner backdrop.", "bool", "false"),
        new("ChildContent", "Wrapped element to display blurred overlay upon.", "RenderFragment?", "null")
    ];
}