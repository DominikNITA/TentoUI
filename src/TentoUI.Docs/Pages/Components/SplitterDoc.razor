@page "/components/splitter"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Splitter - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Splitter</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Accessible resizable split panes with keyboard arrow adjustments, min/max constraints, and collapsible panel triggers.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Splitter Interactive Playground"
                     ComponentTag="Splitter"
                     Controls="@_playgroundControls" />

    <DemoCard Title="Collapsible Horizontal Splitter" Description="Use keyboard arrows on the separator handle or click the collapse button to toggle the side pane." Code="@_splitterCode">
        <Splitter Split="35" Collapsible="true">
            <SplitterPanel>
                <div class="p-4 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <strong>Navigation Pane (35%)</strong>
                    <p class="mt-1 text-slate-600 dark:text-slate-400">Focus the separator and press ArrowLeft/ArrowRight to resize.</p>
                </div>
            </SplitterPanel>
            <SplitterPanel>
                <div class="p-4 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <strong>Main Workspace (65%)</strong>
                    <p class="mt-1 text-slate-600 dark:text-slate-400">Primary editor or inspection viewport.</p>
                </div>
            </SplitterPanel>
        </Splitter>
    </DemoCard>

    <ApiTable Title="Splitter Properties" ComponentType="@typeof(Splitter)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Orientation", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Horizontal", DefaultValue = "Horizontal", Options = ["Horizontal", "Vertical"] },
        new() { Name = "Split", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "35", DefaultValue = "50" },
        new() { Name = "Min", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "10", DefaultValue = "10" },
        new() { Name = "Max", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "90", DefaultValue = "90" },
        new() { Name = "Step", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "5", DefaultValue = "5" },
        new() { Name = "Collapsible", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private const string _splitterCode = """
        <Splitter Split="35" Collapsible="true">
            <SplitterPanel>
                <div class="p-4">Navigation Pane (35%)</div>
            </SplitterPanel>
            <SplitterPanel>
                <div class="p-4">Main Workspace (65%)</div>
            </SplitterPanel>
        </Splitter>
        """;
}
