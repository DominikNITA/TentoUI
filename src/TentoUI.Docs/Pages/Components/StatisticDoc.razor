@page "/components/statistic"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Statistic - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Statistic</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Display statistic numbers, key performance indicators (KPIs), currency balances, and trend summaries.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Modify metrics, precision, and titles dynamically.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Statistic Title="@_title" Value="_val" Precision="_precision">
                <Prefix><span class="text-emerald-500 mr-1">$</span></Prefix>
                <Suffix><span class="text-xs text-slate-400 ml-1">USD</span></Suffix>
            </Statistic>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Title</label>
                <input type="text"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_title" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Numeric Value</label>
                <input type="number"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_val" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Decimal Precision</label>
                <input type="number"
                       min="0"
                       max="4"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_precision" />
            </div>
        </div>
    </div>

    <ApiTable Title="Statistic Properties" Properties="@_props" />
</div>

@code {
    private string _title = "Monthly Recurring Revenue";
    private double _val = 128450.75;
    private int _precision = 2;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Title", "Title descriptor for the statistic.", "string?", "null"),
        new("Value", "Numerical or textual value.", "object?", "null"),
        new("Precision", "Decimal precision for number formatting.", "int?", "null"),
        new("Prefix", "Prefix icon or symbol (e.g. '$').", "RenderFragment?", "null"),
        new("Suffix", "Suffix text or unit (e.g. '%', 'users').", "RenderFragment?", "null"),
        new("ValueStyle", "Custom CSS style applied to the value text.", "string?", "null")
    ];
}
