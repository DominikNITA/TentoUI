@page "/components/statistic"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Statistic - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Statistic</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Display statistic numbers, key performance indicators (KPIs), currency balances, and trend summaries.
        </p>
    </div>

    @* Example 1: Basic Statistics *@
    <DemoCard Title="Basic Statistics" Description="Clean numeric metrics for dashboards and reports." Code="@_basicCode">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 p-4">
            <Statistic Title="Active Users" Value="112893" />
            <Statistic Title="Account Balance" Value="93245" Precision="2">
                <Prefix><span class="text-slate-500 mr-1">$</span></Prefix>
            </Statistic>
            <Statistic Title="Server Health" Value="99.98">
                <Suffix><span class="text-slate-400 ml-1">%</span></Suffix>
            </Statistic>
        </div>
    </DemoCard>

    @* Example 2: Financial Metrics with Prefix and Suffix *@
    <DemoCard Title="Financial Metrics" Description="Includes currency prefix and ISO currency suffix tags." Code="@_financeCode">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 p-4">
            <Statistic Title="Monthly Recurring Revenue" Value="128450.75" Precision="2">
                <Prefix><span class="text-emerald-500 mr-1">$</span></Prefix>
                <Suffix><span class="text-xs text-slate-400 ml-1">USD</span></Suffix>
            </Statistic>
            <Statistic Title="Customer Acquisition Cost" Value="42.50" Precision="2">
                <Prefix><span class="text-indigo-500 mr-1">$</span></Prefix>
                <Suffix><span class="text-xs text-slate-400 ml-1">USD</span></Suffix>
            </Statistic>
        </div>
    </DemoCard>

    @* Example 3: Performance Trends *@
    <DemoCard Title="Growth &amp; Feedback Trends" Description="Highlight positive or negative performance indicators." Code="@_growthCode">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 p-4">
            <Statistic Title="Feedback Rating" Value="4.8" Precision="1">
                <Prefix><span class="text-amber-400 mr-1">★</span></Prefix>
                <Suffix><span class="text-xs text-slate-400 ml-1">/ 5.0</span></Suffix>
            </Statistic>
            <Statistic Title="Year-over-Year Growth" Value="24.8" Precision="1">
                <Prefix><span class="text-emerald-500 mr-1">▲</span></Prefix>
                <Suffix><span class="text-xs text-emerald-500 ml-1">%</span></Suffix>
            </Statistic>
        </div>
    </DemoCard>

    <ApiTable Title="Statistic Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <Statistic Title="Active Users" Value="112893" />
        <Statistic Title="Account Balance" Value="93245" Precision="2">
            <Prefix><span class="text-slate-500 mr-1">$</span></Prefix>
        </Statistic>
        """;

    private const string _financeCode = """
        <Statistic Title="Monthly Recurring Revenue" Value="128450.75" Precision="2">
            <Prefix><span class="text-emerald-500 mr-1">$</span></Prefix>
            <Suffix><span class="text-xs text-slate-400 ml-1">USD</span></Suffix>
        </Statistic>
        """;

    private const string _growthCode = """
        <Statistic Title="Year-over-Year Growth" Value="24.8" Precision="1">
            <Prefix><span class="text-emerald-500 mr-1">▲</span></Prefix>
            <Suffix><span class="text-xs text-emerald-500 ml-1">%</span></Suffix>
        </Statistic>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Title", "Title descriptor for the statistic.", "string?", "null"),
        new("Value", "Numerical or textual value.", "object?", "null"),
        new("Precision", "Decimal precision for number formatting.", "int?", "null"),
        new("Prefix", "Prefix icon or symbol (e.g. '$').", "RenderFragment?", "null"),
        new("Suffix", "Suffix text or unit (e.g. '%', 'users').", "RenderFragment?", "null"),
        new("ValueStyle", "Custom CSS style applied to the value text.", "string?", "null")
    ];
}