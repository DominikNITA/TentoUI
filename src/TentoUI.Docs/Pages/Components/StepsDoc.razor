@page "/components/steps"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Steps - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Steps</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A navigation component that guides users through the steps of a specified linear task.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Steps Interactive Playground"
                     ComponentTag="Steps"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Horizontal Steps *@
    <DemoCard Title="Basic Steps" Description="Simple linear progress flow across multi-stage wizard." Code="@_basicCode">
        <div class="p-4">
            <Steps Current="1">
                <Step Title="Personal Info" Description="Provide name and contact email" />
                <Step Title="Identity Check" Description="Upload government verification" />
                <Step Title="Complete" Description="Ready to launch workspace" />
            </Steps>
        </div>
    </DemoCard>

    @* Example 2: Interactive Step Navigation *@
    <DemoCard Title="Interactive Step Navigation" Description="Includes Previous and Next buttons that update the active stage index." Code="@_interactiveCode">
        <div class="p-4 space-y-6">
            <Steps Current="_currentStep">
                <Step Title="Step 1" Description="Account setup" />
                <Step Title="Step 2" Description="Profile information" />
                <Step Title="Step 3" Description="Payment method" />
            </Steps>
            <div class="flex items-center gap-3">
                <Button Disabled="@(_currentStep == 0)" OnClick="@(() => _currentStep = Math.Max(0, _currentStep - 1))">
                    Previous
                </Button>
                <Button Type="ButtonType.Primary" Disabled="@(_currentStep == 2)" OnClick="@(() => _currentStep = Math.Min(2, _currentStep + 1))">
                    Next
                </Button>
                <span class="text-xs text-slate-400">Step @(_currentStep + 1) of 3</span>
            </div>
        </div>
    </DemoCard>

    @* Example 3: Vertical Steps *@
    <DemoCard Title="Vertical Steps" Description="Vertical orientation suitable for sidebars or mobile workflows." Code="@_verticalCode">
        <div class="p-4 max-w-md">
            <Steps Current="1" Direction="StepsDirection.Vertical">
                <Step Title="Order Placed" Description="Received on 2026-10-28 10:14" />
                <Step Title="In Transit" Description="Carrier: DHL Express" />
                <Step Title="Delivered" Description="Signature required upon receipt" />
            </Steps>
        </div>
    </DemoCard>

    <ApiTable Title="Steps Properties" Properties="@_stepsProps" />
    <ApiTable Title="Step Properties" Properties="@_stepProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Current", Kind = PropsPlayground.PlaygroundControlKind.Number, CurrentValue = "1", DefaultValue = "" },
        new() { Name = "Direction", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "StepsDirection.Horizontal", DefaultValue = "StepsDirection.Horizontal", Options = ["StepsDirection.Horizontal", "StepsDirection.Vertical"] },
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "StepStatus.Process", DefaultValue = "StepStatus.Process", Options = ["StepStatus.Process", "StepStatus.Finish", "StepStatus.Error", "StepStatus.Wait"] },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "ComponentSize.Middle", DefaultValue = "ComponentSize.Middle", Options = ["ComponentSize.Small", "ComponentSize.Middle"] }
    ];

    private int _currentStep = 0;

    private const string _basicCode = """
        <Steps Current="1">
            <Step Title="Personal Info" Description="Provide name and contact email" />
            <Step Title="Identity Check" Description="Upload government verification" />
            <Step Title="Complete" Description="Ready to launch workspace" />
        </Steps>
        """;

    private const string _interactiveCode = """
        <Steps Current="@currentStep">
            <Step Title="Step 1" Description="Account setup" />
            <Step Title="Step 2" Description="Profile information" />
            <Step Title="Step 3" Description="Payment method" />
        </Steps>
        <div class="flex gap-3">
            <Button OnClick="Prev">Previous</Button>
            <Button Type="ButtonType.Primary" OnClick="Next">Next</Button>
        </div>
        """;

    private const string _verticalCode = """
        <Steps Current="1" Direction="StepsDirection.Vertical">
            <Step Title="Order Placed" Description="Received on 10:14" />
            <Step Title="In Transit" Description="Carrier: DHL Express" />
            <Step Title="Delivered" Description="Signature required" />
        </Steps>
        """;

    private readonly ApiTable.ApiProp[] _stepsProps =
    [
        new("Current", "Index of the current active step (0-indexed).", "int", "0"),
        new("Direction", "Layout direction: Horizontal or Vertical.", "StepsDirection", "StepsDirection.Horizontal"),
        new("Size", "Size scale of step indicators (Small or Middle).", "ComponentSize?", "null"),
        new("Status", "Current step status override (Wait, Process, Finish, Error).", "StepStatus?", "null"),
        new("OnChange", "Callback when a clickable step indicator is selected.", "EventCallback<int>", "null"),
        new("ChildContent", "Step elements.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _stepProps =
    [
        new("Title", "Title of the step.", "string", "null"),
        new("Description", "Detailed description text.", "string?", "null"),
        new("Icon", "Custom icon name.", "string?", "null"),
        new("Disabled", "Whether this step cannot be clicked.", "bool", "false")
    ];
}