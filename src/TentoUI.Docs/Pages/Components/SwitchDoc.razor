@page "/components/switch"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Switch - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Switch</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Switching Selector: state toggle between two mutually exclusive options with smooth animated transitions.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Toggle switch state and check size and loading variants.</p>
            </div>
            <div class="text-xs text-slate-400">
                State: <strong class="text-primary-600 dark:text-primary-400 font-mono">@(_active ? "Active (ON)" : "Inactive (OFF)")</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Switch @bind-Checked="_active"
                    Size="_size"
                    Loading="_loading"
                    Disabled="_disabled">
                <CheckedChildren>ON</CheckedChildren>
                <UnCheckedChildren>OFF</UnCheckedChildren>
            </Switch>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Size</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_size">
                    <option value="@ComponentSize.Small">Small</option>
                    <option value="@ComponentSize.Middle">Middle (Default)</option>
                    <option value="@ComponentSize.Large">Large</option>
                </select>
            </div>
            <div class="flex items-center gap-4 pt-5 sm:col-span-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_loading" class="rounded text-primary-600" />
                    <span>Loading Spinner</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="Switch Properties" Properties="@_props" />
</div>

@code {
    private bool _active = true;
    private ComponentSize _size = ComponentSize.Middle;
    private bool _loading;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Checked", "Determines whether the switch is checked (bindable via @bind-Checked).", "bool", "false"),
        new("Size", "Visual size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Loading", "Displays loading state and ignores clicks.", "bool", "false"),
        new("Disabled", "Whether the switch is disabled.", "bool", "false"),
        new("CheckedChildren", "Content to be shown when in the checked state.", "RenderFragment?", "null"),
        new("UnCheckedChildren", "Content to be shown when in the unchecked state.", "RenderFragment?", "null")
    ];
}
