@page "/components/switch"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Switch - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Switch</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Switching Selector: state toggle between two mutually exclusive options with smooth animated transitions.
        </p>
    </div>

    @* Example 1: Basic Switch *@
    <DemoCard Title="Basic Switch" Description="Standard toggle switch with two-way boolean binding." Code="@_basicCode">
        <div class="flex items-center gap-4 p-2">
            <Switch @bind-Checked="_basicSwitch" />
            <span class="text-xs text-slate-500 font-mono">Status: @(_basicSwitch ? "Enabled" : "Disabled")</span>
        </div>
    </DemoCard>

    @* Example 2: Text / Icons in Switch *@
    <DemoCard Title="Text &amp; Inner Icons" Description="Render custom labels or icon glyphs inside the switch pill." Code="@_innerCode">
        <div class="flex flex-wrap items-center gap-6 p-2">
            <Switch @bind-Checked="_wifi">
                <CheckedChildren>ON</CheckedChildren>
                <UnCheckedChildren>OFF</UnCheckedChildren>
            </Switch>
            <Switch @bind-Checked="_notifications">
                <CheckedChildren>1</CheckedChildren>
                <UnCheckedChildren>0</UnCheckedChildren>
            </Switch>
        </div>
    </DemoCard>

    @* Example 3: Sizes & Loading *@
    <DemoCard Title="Sizes &amp; Loading State" Description="Supports Small, Middle, Large sizes, and asynchronous loading spinners." Code="@_sizesCode">
        <div class="flex flex-wrap items-center gap-6 p-2">
            <Switch Size="ComponentSize.Small" Checked="true" />
            <Switch Size="ComponentSize.Middle" Checked="true" />
            <Switch Size="ComponentSize.Large" Checked="true" />
            <Switch Loading="true" Checked="true" />
            <Switch Disabled="true" Checked="false" />
        </div>
    </DemoCard>

    <ApiTable Title="Switch Properties" Properties="@_props" />
</div>

@code {
    private bool _basicSwitch = true;
    private bool _wifi = true;
    private bool _notifications;

    private const string _basicCode = """
        <Switch @bind-Checked="basicSwitch" />
        """;

    private const string _innerCode = """
        <Switch @bind-Checked="wifi">
            <CheckedChildren>ON</CheckedChildren>
            <UnCheckedChildren>OFF</UnCheckedChildren>
        </Switch>
        """;

    private const string _sizesCode = """
        <Switch Size="ComponentSize.Small" Checked="true" />
        <Switch Size="ComponentSize.Middle" Checked="true" />
        <Switch Size="ComponentSize.Large" Checked="true" />
        <Switch Loading="true" Checked="true" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Checked", "Determines whether the switch is checked (bindable via @bind-Checked).", "bool", "false"),
        new("Size", "Visual size scale (Small, Middle, Large).", "ComponentSize?", "null"),
        new("Loading", "Displays loading state and ignores clicks.", "bool", "false"),
        new("Disabled", "Whether the switch is disabled.", "bool", "false"),
        new("CheckedChildren", "Content to be shown when in the checked state.", "RenderFragment?", "null"),
        new("UnCheckedChildren", "Content to be shown when in the unchecked state.", "RenderFragment?", "null")
    ];
}