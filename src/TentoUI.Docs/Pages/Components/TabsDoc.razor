@page "/components/tabs"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Tabs - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tabs</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Switch between alternate views or content panels inside a compact container, supporting line and card styles.
        </p>
    </div>

    @* Example 1: Basic Line Tabs *@
    <DemoCard Title="Line Tabs" Description="Default underline indicator with responsive panel switching." Code="@_lineCode">
        <div class="p-2">
            <Tabs @bind-ActiveKey="_activeTab" Type="TabType.Line">
                <TabPane Key="general" Tab="General Profile">
                    <div class="p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 space-y-2">
                        <h4 class="font-bold text-slate-800 dark:text-white text-sm">Profile Details</h4>
                        <p>Configure personal credentials, display name, and avatar settings.</p>
                    </div>
                </TabPane>
                <TabPane Key="security" Tab="Security">
                    <div class="p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 space-y-2">
                        <h4 class="font-bold text-slate-800 dark:text-white text-sm">Security &amp; 2FA</h4>
                        <p>Manage two-factor authenticator app and personal access tokens.</p>
                    </div>
                </TabPane>
                <TabPane Key="notifications" Tab="Notifications">
                    <div class="p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 space-y-2">
                        <h4 class="font-bold text-slate-800 dark:text-white text-sm">Email Preferences</h4>
                        <p>Receive weekly digest and critical workspace deployment alerts.</p>
                    </div>
                </TabPane>
            </Tabs>
        </div>
    </DemoCard>

    @* Example 2: Card Style Tabs *@
    <DemoCard Title="Card Style Tabs" Description="Pill/card headers with distinct active tab boundaries." Code="@_cardCode">
        <div class="p-2">
            <Tabs DefaultActiveKey="tab-1" Type="TabType.Card">
                <TabPane Key="tab-1" Tab="Tab 1">
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/60 rounded-b-lg border border-slate-200 dark:border-slate-800 text-xs">
                        Content of Tab Pane 1
                    </div>
                </TabPane>
                <TabPane Key="tab-2" Tab="Tab 2">
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/60 rounded-b-lg border border-slate-200 dark:border-slate-800 text-xs">
                        Content of Tab Pane 2
                    </div>
                </TabPane>
                <TabPane Key="tab-3" Tab="Tab 3 (Disabled)" Disabled="true">
                    <div class="p-4">Disabled Tab Content</div>
                </TabPane>
            </Tabs>
        </div>
    </DemoCard>

    <ApiTable Title="Tabs Properties" Properties="@_tabsProps" />
    <ApiTable Title="TabPane Properties" Properties="@_paneProps" />
</div>

@code {
    private string _activeTab = "general";

    private const string _lineCode = """
        <Tabs @bind-ActiveKey="activeTab" Type="TabType.Line">
            <TabPane Key="general" Tab="General Profile">
                <p>Configure personal credentials and avatar settings.</p>
            </TabPane>
            <TabPane Key="security" Tab="Security">
                <p>Manage two-factor authenticator app.</p>
            </TabPane>
            <TabPane Key="notifications" Tab="Notifications">
                <p>Receive weekly digest alerts.</p>
            </TabPane>
        </Tabs>
        """;

    private const string _cardCode = """
        <Tabs DefaultActiveKey="tab-1" Type="TabType.Card">
            <TabPane Key="tab-1" Tab="Tab 1">
                <p>Content of Tab Pane 1</p>
            </TabPane>
            <TabPane Key="tab-2" Tab="Tab 2">
                <p>Content of Tab Pane 2</p>
            </TabPane>
            <TabPane Key="tab-3" Tab="Tab 3" Disabled="true">
                <p>Disabled Tab Content</p>
            </TabPane>
        </Tabs>
        """;

    private readonly ApiProp[] _tabsProps =
    [
        new("ActiveKey", "Currently active tab key (two-way bindable via @bind-ActiveKey).", "string?", "null"),
        new("DefaultActiveKey", "Initial active tab key if not controlled.", "string?", "null"),
        new("Type", "Visual tab style (Line, Card, EditableCard).", "TabType", "TabType.Line"),
        new("Position", "Tab bar placement (Top, Bottom, Left, Right).", "TabPosition", "TabPosition.Top"),
        new("Size", "Size scale of the tabs.", "ComponentSize?", "null"),
        new("OnChange", "Callback executed when active tab changes.", "EventCallback<string>", "null"),
        new("ChildContent", "TabPane elements.", "RenderFragment?", "null")
    ];

    private readonly ApiProp[] _paneProps =
    [
        new("Key", "Unique identifier for this tab pane.", "string", "required"),
        new("Tab", "Label text rendered in tab header.", "string", "null"),
        new("TabTemplate", "Custom template rendered in tab header.", "RenderFragment?", "null"),
        new("Disabled", "Whether this tab is disabled.", "bool", "false"),
        new("ChildContent", "Content rendered when this tab is active.", "RenderFragment?", "null")
    ];
}