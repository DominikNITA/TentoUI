@page "/components/tag"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Tag - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tag</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Used for categorizing or tagging objects with colored chips, closable dismissals, and selectable filters.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Tag Interactive Playground"
                     ComponentTag="Tag"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Tags & Closable *@
    <DemoCard Title="Basic &amp; Closable Tags" Description="Standard tags with optional dismiss button." Code="@_basicCode">
        <div class="flex flex-wrap items-center gap-3 p-2">
            <Tag>Default Tag</Tag>
            <Tag Closable="true" OnClose="@(() => MessageService.Info("Tag dismissed"))">Closable Tag</Tag>
            <Tag Color="blue">Blue Tag</Tag>
            <Tag Color="green" Closable="true">Success Closable</Tag>
        </div>
    </DemoCard>

    @* Example 2: Color Presets *@
    <DemoCard Title="Color Presets" Description="Standard semantic and decorative colors for status indicators." Code="@_colorsCode">
        <div class="flex flex-wrap items-center gap-2 p-2">
            <Tag Color="blue">blue</Tag>
            <Tag Color="green">green</Tag>
            <Tag Color="gold">gold</Tag>
            <Tag Color="red">red</Tag>
            <Tag Color="purple">purple</Tag>
            <Tag Color="cyan">cyan</Tag>
            <Tag Color="magenta">magenta</Tag>
        </div>
    </DemoCard>

    @* Example 3: Custom Hex Codes *@
    <DemoCard Title="Custom Hex Colors" Description="Supports arbitrary custom background hex codes." Code="@_hexCode">
        <div class="flex flex-wrap items-center gap-2 p-2">
            <Tag Color="#f50">#f50</Tag>
            <Tag Color="#2db7f5">#2db7f5</Tag>
            <Tag Color="#87d068">#87d068</Tag>
            <Tag Color="#108ee9">#108ee9</Tag>
        </div>
    </DemoCard>

    <ApiTable Title="Tag Properties" ComponentType="@typeof(Tag)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Label", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Feature Preview", IsChildContent = true },
        new() { Name = "Color", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "blue", DefaultValue = "", Options = ["", "blue", "green", "gold", "red", "purple", "cyan", "magenta", "orange", "#108ee9", "#87d068", "#f50"] },
        new() { Name = "Closable", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" }
    ];

    private const string _basicCode = """
        <Tag>Default Tag</Tag>
        <Tag Closable="true">Closable Tag</Tag>
        <Tag Color="blue">Blue Tag</Tag>
        <Tag Color="green" Closable="true">Success Closable</Tag>
        """;

    private const string _colorsCode = """
        <Tag Color="blue">blue</Tag>
        <Tag Color="green">green</Tag>
        <Tag Color="gold">gold</Tag>
        <Tag Color="red">red</Tag>
        <Tag Color="purple">purple</Tag>
        """;

    private const string _hexCode = """
        <Tag Color="#f50">#f50</Tag>
        <Tag Color="#2db7f5">#2db7f5</Tag>
        <Tag Color="#87d068">#87d068</Tag>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Color", "Preset color string (e.g. 'blue', 'green', 'red') or custom hex code.", "string?", "null"),
        new("TagColor", "Strongly-typed TagColor enum value.", "TagColor?", "null"),
        new("Closable", "Whether the tag can be closed via an 'x' icon.", "bool", "false"),
        new("Checkable", "Whether the tag functions as a toggle pill.", "bool", "false"),
        new("Checked", "Checked state when Checkable is true.", "bool", "false"),
        new("OnClose", "Callback executed when close icon is clicked.", "EventCallback", "null"),
        new("ChildContent", "Tag content.", "RenderFragment?", "null")
    ];
}