@page "/components/textarea"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>TextArea - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">TextArea</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            For multi-line input data, providing character counters, clear buttons, and custom row dimensions.
        </p>
    </div>

    @* Example 1: Basic TextArea *@
    <DemoCard Title="Basic TextArea" Description="Multi-line text editor with placeholder and row sizing." Code="@_basicCode">
        <div class="max-w-lg p-2 space-y-2">
            <TextArea @bind-Value="_text" Rows="3" Placeholder="Enter notes or feedback..." />
            <div class="text-xs text-slate-400 font-mono">Bound Value: @_text</div>
        </div>
    </DemoCard>

    @* Example 2: Character Counter *@
    <DemoCard Title="Character Counter &amp; MaxLength" Description="Visual character indicator enforcing maximum character limits." Code="@_countCode">
        <div class="max-w-lg p-2">
            <TextArea @bind-Value="_bio"
                      Rows="4"
                      MaxLength="150"
                      ShowCount="true"
                      Placeholder="Write a brief profile summary..." />
        </div>
    </DemoCard>

    @* Example 3: Clear Button & Disabled *@
    <DemoCard Title="Allow Clear &amp; Disabled" Description="Includes 1-click text clearing or read-only locked state." Code="@_clearCode">
        <div class="space-y-4 max-w-lg p-2">
            <TextArea Value="Click the x icon on the right to clear this text" AllowClear="true" Rows="2" />
            <TextArea Value="This textarea is currently disabled" Disabled="true" Rows="2" />
        </div>
    </DemoCard>

    <ApiTable Title="TextArea Properties" Properties="@_props" />
</div>

@code {
    private string? _text = "TentoUI provides high-performance Blazor components.";
    private string? _bio = "Engineering lead passionate about modern UI libraries.";

    private const string _basicCode = """
        <TextArea @bind-Value="text" Rows="3" Placeholder="Enter notes..." />
        """;

    private const string _countCode = """
        <TextArea @bind-Value="bio"
                  Rows="4"
                  MaxLength="150"
                  ShowCount="true"
                  Placeholder="Write a brief profile summary..." />
        """;

    private const string _clearCode = """
        <TextArea Value="Clearable content" AllowClear="true" Rows="2" />
        <TextArea Value="Disabled content" Disabled="true" Rows="2" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current text string (bindable via @bind-Value).", "string?", "null"),
        new("Rows", "Height of the textarea expressed in text rows.", "int", "3"),
        new("MaxLength", "Maximum permitted character length.", "int?", "null"),
        new("ShowCount", "Display active character count indicator.", "bool", "false"),
        new("AllowClear", "Display clear button when text is present.", "bool", "false"),
        new("Disabled", "Whether the textarea is disabled.", "bool", "false"),
        new("Placeholder", "Placeholder text.", "string?", "null")
    ];
}