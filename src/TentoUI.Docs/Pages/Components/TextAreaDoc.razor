@page "/components/textarea"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>TextArea - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">TextArea</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            For multi-line input data, providing character counters, clear buttons, and custom row dimensions.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Configure rows, character count limits, and clear button toggles.</p>
            </div>
            <div class="text-xs text-slate-400">
                Length: <strong class="text-primary-600 dark:text-primary-400 font-mono">@(_text?.Length ?? 0)</strong> chars
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-lg mx-auto">
            <TextArea @bind-Value="_text"
                      Rows="_rows"
                      MaxLength="_maxLength"
                      ShowCount="_showCount"
                      AllowClear="_allowClear"
                      Disabled="_disabled"
                      Placeholder="Write a detailed description..." />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Rows</label>
                <input type="number"
                       min="2"
                       max="10"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_rows" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Max Length</label>
                <input type="number"
                       min="10"
                       max="1000"
                       step="50"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_maxLength" />
            </div>
            <div class="sm:col-span-2 flex items-center gap-4 pt-2">
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_showCount" class="rounded text-primary-600" />
                    <span>Show Character Count</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_allowClear" class="rounded text-primary-600" />
                    <span>Allow Clear</span>
                </label>
                <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                    <input type="checkbox" @bind="_disabled" class="rounded text-primary-600" />
                    <span>Disabled</span>
                </label>
            </div>
        </div>
    </div>

    <ApiTable Title="TextArea Properties" Properties="@_props" />
</div>

@code {
    private string? _text = "TentoUI provides high-performance Blazor components.";
    private int _rows = 4;
    private int? _maxLength = 200;
    private bool _showCount = true;
    private bool _allowClear = true;
    private bool _disabled;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current text string (bindable via @bind-Value).", "string?", "null"),
        new("Rows", "Height of the textarea expressed in text rows.", "int", "3"),
        new("MaxLength", "Maximum permitted character length.", "int?", "null"),
        new("ShowCount", "Display active character count indicator.", "bool", "false"),
        new("AllowClear", "Display clear button when text is present.", "bool", "false"),
        new("Disabled", "Whether the textarea is disabled.", "bool", "false"),
        new("Placeholder", "Placeholder text.", "string?", "null")
    ];
}
