@page "/components/time-picker"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>TimePicker - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">TimePicker</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            To select or input a time of day with interactive hour/minute selector panels.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="TimePicker Interactive Playground"
                     ComponentTag="TimePicker"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic TimePicker *@
    <DemoCard Title="Basic TimePicker" Description="Select hour and minute with 24-hour time formatting." Code="@_basicCode">
        <div class="max-w-xs p-2 space-y-2">
            <TimePicker @bind-Value="_time"
                        Format="HH:mm"
                        AllowClear="true" />
            <div class="text-xs text-slate-400 font-mono">Selected Time: @(_time?.ToString("HH:mm") ?? "None")</div>
        </div>
    </DemoCard>

    @* Example 2: With Seconds *@
    <DemoCard Title="TimePicker with Seconds" Description="Displays third column for precise second selections." Code="@_secondsCode">
        <div class="max-w-xs p-2">
            <TimePicker Value="@(new TimeOnly(12, 45, 30))"
                        Format="HH:mm:ss"
                        ShowSeconds="true"
                        AllowClear="true" />
        </div>
    </DemoCard>

    <ApiTable Title="TimePicker Properties" Properties="@_props" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Placeholder", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Select time", DefaultValue = "Select time" },
        new() { Name = "Format", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "HH:mm", DefaultValue = "HH:mm", Options = ["HH:mm", "HH:mm:ss", "hh:mm tt"] },
        new() { Name = "ShowSeconds", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" },
        new() { Name = "Size", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "Middle", DefaultValue = "Middle", Options = ["Small", "Middle", "Large"] },
        new() { Name = "Status", Kind = PropsPlayground.PlaygroundControlKind.Select, CurrentValue = "None", DefaultValue = "None", Options = ["None", "Error", "Warning", "Success"] },
        new() { Name = "AllowClear", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private TimeOnly? _time = new(15, 30);

    private const string _basicCode = """
        <TimePicker @bind-Value="time"
                    Format="HH:mm"
                    AllowClear="true" />
        """;

    private const string _secondsCode = """
        <TimePicker Value="@(new TimeOnly(12, 45, 30))"
                    Format="HH:mm:ss"
                    ShowSeconds="true" />
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Value", "Current selected time (bindable via @bind-Value).", "TimeOnly?", "null"),
        new("Format", "Format string for time display.", "string", "HH:mm"),
        new("ShowSeconds", "Whether to show seconds column in picker.", "bool", "false"),
        new("HourStep", "Interval between hours.", "int", "1"),
        new("MinuteStep", "Interval between minutes.", "int", "1"),
        new("AllowClear", "Whether clear button is visible.", "bool", "true"),
        new("Disabled", "Whether picker is disabled.", "bool", "false")
    ];
}