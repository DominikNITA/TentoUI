@page "/components/timeline"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Timeline - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Timeline</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Displays a series of events in chronological order with colored nodes and custom dates.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Timeline Interactive Playground"
                     ComponentTag="Timeline"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Timeline *@
    <DemoCard Title="Basic Timeline" Description="Sequential list of operational milestones with date labels." Code="@_basicCode">
        <div class="p-4">
            <Timeline>
                <TimelineItem Color="green" Label="2026-10-28">Released TentoUI v1.0.0 on NuGet</TimelineItem>
                <TimelineItem Color="blue" Label="2026-10-20">Completed 40+ AntDesign Tailwind components</TimelineItem>
                <TimelineItem Color="gray" Label="2026-10-01">Extracted standalone git repository</TimelineItem>
            </Timeline>
        </div>
    </DemoCard>

    @* Example 2: Colored Status Nodes *@
    <DemoCard Title="Status Milestone Nodes" Description="Use green, blue, amber, and red color codes to depict task progress." Code="@_coloredCode">
        <div class="p-4">
            <Timeline>
                <TimelineItem Color="green">Production deployment verified and active</TimelineItem>
                <TimelineItem Color="green">Database migration script executed (0 errors)</TimelineItem>
                <TimelineItem Color="amber">Integration tests finished with 1 warning</TimelineItem>
                <TimelineItem Color="red">Initial SSL handshake timeout (resolved)</TimelineItem>
                <TimelineItem Color="blue">GitHub Actions runner triggered</TimelineItem>
            </Timeline>
        </div>
    </DemoCard>

    <ApiTable Title="Timeline Properties" Properties="@_timelineProps" />
    <ApiTable Title="TimelineItem Properties" Properties="@_itemProps" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Content", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "<TimelineItem Color=\"green\" Label=\"2026-10-28\">Released TentoUI v1.0.0 on NuGet</TimelineItem>\n<TimelineItem Color=\"blue\" Label=\"2026-10-20\">Completed 40+ AntDesign Tailwind components</TimelineItem>\n<TimelineItem Color=\"gray\" Label=\"2026-10-01\">Extracted standalone repository</TimelineItem>", DefaultValue = "", IsChildContent = true }
    ];

    private const string _basicCode = """
        <Timeline>
            <TimelineItem Color="green" Label="2026-10-28">Released TentoUI v1.0.0 on NuGet</TimelineItem>
            <TimelineItem Color="blue" Label="2026-10-20">Completed 40+ AntDesign Tailwind components</TimelineItem>
            <TimelineItem Color="gray" Label="2026-10-01">Extracted standalone git repository</TimelineItem>
        </Timeline>
        """;

    private const string _coloredCode = """
        <Timeline>
            <TimelineItem Color="green">Production deployment verified and active</TimelineItem>
            <TimelineItem Color="green">Database migration executed</TimelineItem>
            <TimelineItem Color="amber">Integration tests finished with 1 warning</TimelineItem>
            <TimelineItem Color="red">Initial SSL handshake timeout (resolved)</TimelineItem>
        </Timeline>
        """;

    private readonly ApiTable.ApiProp[] _timelineProps =
    [
        new("Mode", "Node alignment mode (Left, Alternate, Right).", "TimelineMode", "TimelineMode.Left"),
        new("Reverse", "Whether to reverse chronological order of events.", "bool", "false"),
        new("ChildContent", "TimelineItem children.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _itemProps =
    [
        new("Color", "Circle dot color (e.g. 'blue', 'green', 'red', 'gray').", "string", "'blue'"),
        new("Label", "Date or label text rendered beside the event.", "string?", "null"),
        new("Dot", "Custom dot template icon.", "RenderFragment?", "null"),
        new("ChildContent", "Event description content.", "RenderFragment?", "null")
    ];
}