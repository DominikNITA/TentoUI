@page "/components/tooltip"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Tooltip - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tooltip</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A simple text popup tip displayed when hovering over or focusing on an element.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Hover over the button to view the tooltip positioned by placement.</p>
            </div>
        </div>

        <div class="p-12 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Tooltip Title="@_tip" Placement="_placement" Color="@_color">
                <Button Type="ButtonType.Primary">Hover to View Tooltip</Button>
            </Tooltip>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Tooltip Text</label>
                <input type="text"
                       class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                       @bind="_tip"
                       @bind:event="oninput" />
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Placement</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_placement">
                    <option value="@TooltipPlacement.Top">Top</option>
                    <option value="@TooltipPlacement.Bottom">Bottom</option>
                    <option value="@TooltipPlacement.Left">Left</option>
                    <option value="@TooltipPlacement.Right">Right</option>
                </select>
            </div>
            <div>
                <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Color Theme</label>
                <select class="w-full rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 text-xs text-slate-800 dark:text-slate-200"
                        @bind="_color">
                    <option value="">Default (Dark)</option>
                    <option value="#3b82f6">Blue</option>
                    <option value="#10b981">Green</option>
                    <option value="#ef4444">Red</option>
                </select>
            </div>
        </div>
    </div>

    <ApiTable Title="Tooltip Properties" Properties="@_props" />
</div>

@code {
    private string _tip = "Helpful contextual hint tooltip";
    private TooltipPlacement _placement = TooltipPlacement.Top;
    private string _color = "";

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Title", "Text tooltip to display on hover.", "string?", "null"),
        new("Placement", "The position of tooltip relative to target (Top, Bottom, Left, Right).", "TooltipPlacement", "TooltipPlacement.Top"),
        new("Color", "Custom background color.", "string?", "null"),
        new("ChildContent", "Target element that triggers the tooltip on hover.", "RenderFragment?", "null")
    ];
}
