@page "/components/tooltip"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Tooltip - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tooltip</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A simple text popup tip displayed when hovering over or focusing on an element with placement directions, arrow indicators, and custom accent colors.
        </p>
    </div>

    @* Example 1: Basic Tooltip *@
    <DemoCard Title="Basic Usage" Description="Hover over the target to reveal contextual prompt text." Code="@_basicCode">
        <div class="p-4">
            <Tooltip Title="Prompt text appears on hover">
                <Button Type="ButtonType.Primary">Hover over me</Button>
            </Tooltip>
        </div>
    </DemoCard>

    @* Example 2: Placements *@
    <DemoCard Title="Placement Directions" Description="Supports Top, Bottom, Left, and Right positioning with generous spacing between triggers." Code="@_placementsCode">
        <div class="flex flex-wrap items-center gap-4 p-4">
            <Tooltip Title="Top tooltip message" Placement="TooltipPlacement.Top">
                <Button Type="ButtonType.Default">Top</Button>
            </Tooltip>
            <Tooltip Title="Bottom tooltip message" Placement="TooltipPlacement.Bottom">
                <Button Type="ButtonType.Default">Bottom</Button>
            </Tooltip>
            <Tooltip Title="Left tooltip message" Placement="TooltipPlacement.Left">
                <Button Type="ButtonType.Default">Left</Button>
            </Tooltip>
            <Tooltip Title="Right tooltip message" Placement="TooltipPlacement.Right">
                <Button Type="ButtonType.Default">Right</Button>
            </Tooltip>
        </div>
    </DemoCard>

    @* Example 3: Custom Colors *@
    <DemoCard Title="Custom Colors" Description="Customize tooltip accent background colors without black arrow artifacts." Code="@_colorsCode">
        <div class="flex flex-wrap items-center gap-4 p-4">
            <Tooltip Title="Primary blue style" Color="#3b82f6">
                <Button Type="ButtonType.Default">Blue Tooltip</Button>
            </Tooltip>
            <Tooltip Title="Success green style" Color="#10b981">
                <Button Type="ButtonType.Default">Green Tooltip</Button>
            </Tooltip>
            <Tooltip Title="Danger red style" Color="#ef4444">
                <Button Type="ButtonType.Default">Red Tooltip</Button>
            </Tooltip>
            <Tooltip Title="Purple accent style" Color="#8b5cf6">
                <Button Type="ButtonType.Default">Purple Tooltip</Button>
            </Tooltip>
        </div>
    </DemoCard>

    <ApiTable Title="Tooltip Properties" ComponentType="@typeof(Tooltip)" />
</div>

@code {
    private const string _basicCode = """
        <Tooltip Title="Prompt text appears on hover">
            <Button Type="ButtonType.Primary">Hover over me</Button>
        </Tooltip>
        """;

    private const string _placementsCode = """
        <div class="flex flex-wrap items-center gap-4">
            <Tooltip Title="Top tooltip message" Placement="TooltipPlacement.Top">
                <Button Type="ButtonType.Default">Top</Button>
            </Tooltip>
            <Tooltip Title="Bottom tooltip message" Placement="TooltipPlacement.Bottom">
                <Button Type="ButtonType.Default">Bottom</Button>
            </Tooltip>
            <Tooltip Title="Left tooltip message" Placement="TooltipPlacement.Left">
                <Button Type="ButtonType.Default">Left</Button>
            </Tooltip>
            <Tooltip Title="Right tooltip message" Placement="TooltipPlacement.Right">
                <Button Type="ButtonType.Default">Right</Button>
            </Tooltip>
        </div>
        """;

    private const string _colorsCode = """
        <div class="flex flex-wrap items-center gap-4">
            <Tooltip Title="Primary blue style" Color="#3b82f6">
                <Button Type="ButtonType.Default">Blue Tooltip</Button>
            </Tooltip>
            <Tooltip Title="Success green style" Color="#10b981">
                <Button Type="ButtonType.Default">Green Tooltip</Button>
            </Tooltip>
            <Tooltip Title="Danger red style" Color="#ef4444">
                <Button Type="ButtonType.Default">Red Tooltip</Button>
            </Tooltip>
            <Tooltip Title="Purple accent style" Color="#8b5cf6">
                <Button Type="ButtonType.Default">Purple Tooltip</Button>
            </Tooltip>
        </div>
        """;
}