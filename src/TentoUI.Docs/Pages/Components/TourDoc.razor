@page "/components/tour"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Tour - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tour</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A popup tour component for guiding new users through essential features and workflow steps.
        </p>
    </div>

    @* Example 1: Basic Guided Tour *@
    <DemoCard Title="Product Onboarding Tour" Description="Launch a step-by-step walkthrough modal with next, previous, and finish actions." Code="@_tourCode">
        <div class="p-6 flex items-center justify-center">
            <Button Type="ButtonType.Primary" OnClick="@(() => _open = true)">
                Start Product Walkthrough
            </Button>

            <Tour @bind-Open="_open" @bind-Current="_current" Mask="true" OnClose="OnTourClosed">
                <TourStep Title="Welcome to TentoUI"
                          Description="TentoUI provides AntDesign-patterned components beautifully styled with Tailwind CSS for .NET 10." />
                <TourStep Title="Live Editable Demos"
                          Description="Every component includes real dynamic live-editable code cards with 1-click copy." />
                <TourStep Title="GitHub Pages Ready"
                          Description="Deploy your documentation as a 100% client-side Blazor WebAssembly static website." />
            </Tour>
        </div>
    </DemoCard>

    @* Example 2: Minimal Tour Without Backdrop Mask *@
    <DemoCard Title="Tour Without Backdrop Mask" Description="Run a tour without darkening the background page." Code="@_noMaskCode">
        <div class="p-6 flex items-center justify-center">
            <Button Type="ButtonType.Default" OnClick="@(() => _openNoMask = true)">
                Start Tour (No Mask)
            </Button>

            <Tour @bind-Open="_openNoMask" @bind-Current="_currentNoMask" Mask="false">
                <TourStep Title="Lightweight Mode"
                          Description="A subtle floating tour popup that keeps the page completely interactive." />
                <TourStep Title="Ready to Ship"
                          Description="Works effortlessly in modern WebAssembly applications." />
            </Tour>
        </div>
    </DemoCard>

    <ApiTable Title="Tour Properties" Properties="@_tourProps" />
    <ApiTable Title="TourStep Properties" Properties="@_stepProps" />
</div>

@code {
    private bool _open;
    private int _current;
    private bool _openNoMask;
    private int _currentNoMask;

    private void OnTourClosed()
    {
        MessageService.Info("Onboarding tour completed!");
    }

    private const string _tourCode = """
        <Button Type="ButtonType.Primary" OnClick="@(() => open = true)">
            Start Product Walkthrough
        </Button>

        <Tour @bind-Open="open" @bind-Current="current" Mask="true">
            <TourStep Title="Welcome to TentoUI"
                      Description="TentoUI provides AntDesign-patterned components." />
            <TourStep Title="Live Editable Demos"
                      Description="Every component includes real dynamic live-editable code cards." />
            <TourStep Title="GitHub Pages Ready"
                      Description="Deploy your documentation as static Blazor WebAssembly." />
        </Tour>
        """;

    private const string _noMaskCode = """
        <Tour @bind-Open="open" @bind-Current="current" Mask="false">
            <TourStep Title="Lightweight Mode"
                      Description="Subtle floating tour popup without background mask." />
            <TourStep Title="Ready to Ship"
                      Description="Works effortlessly in modern WebAssembly applications." />
        </Tour>
        """;

    private readonly ApiTable.ApiProp[] _tourProps =
    [
        new("Open", "Whether the tour is active (bindable via @bind-Open).", "bool", "false"),
        new("Current", "Index of the current active step (0-indexed, bindable via @bind-Current).", "int", "0"),
        new("Mask", "Whether to show blurred backdrop mask.", "bool", "true"),
        new("OnClose", "Callback executed when user closes the tour.", "EventCallback", "null"),
        new("OnChange", "Callback executed when step index changes.", "EventCallback<int>", "null"),
        new("ChildContent", "TourStep children.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _stepProps =
    [
        new("Title", "Title header of the tour step.", "string", "null"),
        new("Description", "Explanatory description of the tour step.", "string?", "null"),
        new("Target", "CSS selector for target element highlight.", "string?", "null")
    ];
}