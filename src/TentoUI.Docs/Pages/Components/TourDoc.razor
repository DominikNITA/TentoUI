@page "/components/tour"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Tour - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tour</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A popup tour component for guiding new users through essential features, interface targets, and multi-step workflows.
        </p>
    </div>

    @* Example 1: Targeted Guided Tour *@
    <DemoCard Title="Targeted Interface Walkthrough" Description="Guide users across concrete DOM targets using CSS selectors (#tour-search, #tour-action, #tour-settings)." Code="@_tourCode">
        <div class="p-6 flex flex-col items-center gap-6 w-full">
            <div class="w-full max-w-xl p-4 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Mock Application Header</div>
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div id="tour-search" class="relative flex-1 min-w-[200px]">
                        <Input Placeholder="Search components or docs..." PrefixIcon="@IconNames.Search" />
                    </div>
                    <div class="flex items-center gap-2">
                        <div id="tour-action">
                            <Button Type="ButtonType.Primary" Icon="@IconNames.Plus">New Project</Button>
                        </div>
                        <div id="tour-settings">
                            <Button Type="ButtonType.Default" Icon="@IconNames.Settings" />
                        </div>
                    </div>
                </div>
            </div>

            <Button Type="ButtonType.Primary" OnClick="@StartMainTour">
                Start Guided Tour
            </Button>

            <Tour @bind-Open="_open" @bind-Current="_current" Mask="true" OnClose="OnTourClosed" OnFinish="OnTourFinished">
                <TourStep Target="#tour-search"
                          Title="Global Search"
                          Description="Quickly locate any component, form control, layout pattern, or design token across the library." />
                <TourStep Target="#tour-action"
                          Title="Primary Actions"
                          Description="Trigger primary operations like launching the project creation dialog or provisioning resources." />
                <TourStep Target="#tour-settings"
                          Title="Preferences & Theming"
                          Description="Configure application options, switch dark mode variants, or manage authentication state." />
            </Tour>
        </div>
    </DemoCard>

    @* Example 2: Minimal Tour Without Backdrop Mask *@
    <DemoCard Title="Tour Without Backdrop Mask" Description="Run a non-blocking floating tour without dimming the background viewport." Code="@_noMaskCode">
        <div class="p-6 flex flex-col items-center gap-4">
            <Button Type="ButtonType.Default" OnClick="@StartNoMaskTour">
                Start Tour (No Mask)
            </Button>

            <Tour @bind-Open="_openNoMask" @bind-Current="_currentNoMask" Mask="false" OnClose="OnNoMaskClosed">
                <TourStep Title="Lightweight Float Mode"
                          Description="A non-blocking floating card allowing users to interact with the underlying interface while learning." />
                <TourStep Title="Step 2 of Exploration"
                          Description="Progress through key tips without dimming or locking out standard navigation." />
                <TourStep Title="Ready to Ship"
                          Description="Seamlessly integrated with .NET 10 Blazor WebAssembly and Tailwind styling." />
            </Tour>
        </div>
    </DemoCard>

    <ApiTable Title="Tour Properties" ComponentType="@typeof(Tour)" />
    <ApiTable Title="TourStep Properties" ComponentType="@typeof(TourStep)" />
</div>

@code {
    private bool _open = false;
    private int _current = 0;
    private bool _openNoMask = false;
    private int _currentNoMask = 0;

    private void StartMainTour()
    {
        _current = 0;
        _open = true;
    }

    private void StartNoMaskTour()
    {
        _currentNoMask = 0;
        _openNoMask = true;
    }

    private void OnTourClosed()
    {
        MessageService.Info("Tour was dismissed.");
    }

    private void OnTourFinished()
    {
        MessageService.Success("Great job! You finished the onboarding tour.");
    }

    private void OnNoMaskClosed()
    {
        MessageService.Info("Lightweight tour dismissed.");
    }

    private const string _tourCode = """
        <div class="flex items-center gap-3">
            <div id="tour-search">
                <Input Placeholder="Search..." PrefixIcon="search" />
            </div>
            <div id="tour-action">
                <Button Type="ButtonType.Primary" Icon="plus">New Project</Button>
            </div>
            <div id="tour-settings">
                <Button Type="ButtonType.Default" Icon="settings" />
            </div>
        </div>

        <Button Type="ButtonType.Primary" OnClick="@(() => { current = 0; open = true; })">
            Start Guided Tour
        </Button>

        <Tour @bind-Open="open" @bind-Current="current" Mask="true">
            <TourStep Target="#tour-search"
                      Title="Global Search"
                      Description="Quickly locate any component or design token." />
            <TourStep Target="#tour-action"
                      Title="Primary Actions"
                      Description="Trigger primary operations like creating projects." />
            <TourStep Target="#tour-settings"
                      Title="Preferences & Theming"
                      Description="Configure application options and dark mode." />
        </Tour>
        """;

    private const string _noMaskCode = """
        <Button Type="ButtonType.Default" OnClick="@(() => { current = 0; open = true; })">
            Start Tour (No Mask)
        </Button>

        <Tour @bind-Open="open" @bind-Current="current" Mask="false">
            <TourStep Title="Lightweight Float Mode"
                      Description="A non-blocking floating card allowing interface interaction." />
            <TourStep Title="Step 2 of Exploration"
                      Description="Progress through key tips without dimming." />
            <TourStep Title="Ready to Ship"
                      Description="Seamlessly integrated with .NET 10 Blazor WebAssembly." />
        </Tour>
        """;
}
