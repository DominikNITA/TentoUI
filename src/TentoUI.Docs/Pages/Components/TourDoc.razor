@page "/components/tour"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Tour - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tour</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A popup tour component for guiding new users through the essential features and workflow steps of your application.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Launch guided onboarding tour modal with next / previous controls.</p>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex items-center justify-center">
            <Button Type="ButtonType.Primary" OnClick="@(() => _open = true)">
                Start Product Walkthrough
            </Button>

            <Tour @bind-Open="_open" @bind-Current="_current" Mask="_mask">
                <TourStep Title="Welcome to TentoUI"
                          Description="TentoUI provides AntDesign-patterned components beautifully styled with Tailwind CSS for .NET 10." />
                <TourStep Title="Interactive Documentation"
                          Description="Every component includes real dynamic knobs to test states, sizes, and variations in real time." />
                <TourStep Title="GitHub Pages Ready"
                          Description="Deploy your documentation as a 100% client-side Blazor WebAssembly static website." />
            </Tour>
        </div>

        <div class="flex items-center gap-4 pt-2 text-xs border-t border-slate-100 dark:border-slate-800">
            <label class="flex items-center gap-1.5 font-medium cursor-pointer text-slate-700 dark:text-slate-300">
                <input type="checkbox" @bind="_mask" class="rounded text-primary-600" />
                <span>Show Backdrop Mask Blur</span>
            </label>
        </div>
    </div>

    <ApiTable Title="Tour Properties" Properties="@_tourProps" />
    <ApiTable Title="TourStep Properties" Properties="@_stepProps" />
</div>

@code {
    private bool _open;
    private int _current;
    private bool _mask = true;

    private readonly ApiTable.ApiProp[] _tourProps =
    [
        new("Open", "Whether the tour is active (bindable via @bind-Open).", "bool", "false"),
        new("Current", "Index of the current active step (0-indexed, bindable via @bind-Current).", "int", "0"),
        new("Mask", "Whether to show blurred backdrop mask.", "bool", "true"),
        new("OnClose", "Callback executed when user closes the tour.", "EventCallback", "null"),
        new("OnChange", "Callback executed when step index changes.", "EventCallback<int>", "null"),
        new("ChildContent", "TourStep children.", "RenderFragment?", "null")
    ];

    private readonly ApiTable.ApiProp[] _stepProps =
    [
        new("Title", "Title header of the tour step.", "string", "null"),
        new("Description", "Explanatory description of the tour step.", "string?", "null"),
        new("Target", "CSS selector for target element highlight.", "string?", "null")
    ];
}
