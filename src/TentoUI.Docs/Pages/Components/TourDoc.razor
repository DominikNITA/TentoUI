@page "/components/tour"
@namespace TentoUI.Docs.Pages.Components
@inject IMessageService MessageService

<PageTitle>Tour &amp; Popconfirm - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Tour &amp; Popconfirm</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Contextual popover confirmations and step-by-step user onboarding tours.
        </p>
    </div>

    <DemoCard Title="Popconfirm" Description="Inline confirmation popover before executing destructive actions." Code="@_popconfirmCode">
        <Popconfirm Title="Delete Item"
                    Description="Are you certain you want to permanently delete this item?"
                    OkText="Yes, delete"
                    CancelText="Cancel"
                    OnConfirm="@(() => MessageService.Success("Item was deleted!"))"
                    OnCancel="@(() => MessageService.Info("Action cancelled."))">
            <Button Danger="true">
                Delete Record
            </Button>
        </Popconfirm>
    </DemoCard>
</div>

@code {
    private const string _popconfirmCode = @"<Popconfirm Title=""Delete Item""
            Description=""Are you certain you want to delete this item?""
            OkText=""Yes, delete""
            CancelText=""Cancel""
            OnConfirm=""@HandleConfirm"">
    <Button Danger=""true"">Delete Record</Button>
</Popconfirm>";
}
