@page "/components/transfer"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Transfer - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Transfer</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            Double-column list shuttle transfer for moving items between source and target lists.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="Transfer Interactive Playground"
                     ComponentTag="Transfer"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic Transfer Shuttle *@
    <DemoCard Title="Transfer Shuttle with Search" Description="Move items between source and target lists with search filtering." Code="@_transferCode">
        <div class="p-2">
            <Transfer DataSource="@_items"
                      @bind-TargetKeys="_targetKeys"
                      Titles="@(new[] { "Available Roles", "Assigned Roles" })"
                      ShowSearch="true" />
            <p class="text-xs text-slate-600 dark:text-slate-400 font-mono mt-3">Assigned keys: @string.Join(", ", _targetKeys)</p>
        </div>
    </DemoCard>

    @* Example 2: Minimal Transfer *@
    <DemoCard Title="Compact Transfer without Search" Description="Direct shuttle controls for smaller option sets." Code="@_compactCode">
        <div class="p-2">
            <Transfer DataSource="@_items"
                      @bind-TargetKeys="_compactKeys"
                      Titles="@(new[] { "Left List", "Right List" })"
                      ShowSearch="false" />
        </div>
    </DemoCard>

    <ApiTable Title="Transfer Properties" ComponentType="@typeof(Transfer)" />
    <ApiTable Title="TransferItem Properties" ComponentType="@typeof(TransferItem)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "ShowSearch", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private HashSet<string> _targetKeys = new() { "editor" };
    private HashSet<string> _compactKeys = new() { "developer" };

    private readonly TransferItem[] _items =
    [
        new("admin", "Administrator", "Full system access"),
        new("editor", "Content Editor", "Can publish blog posts"),
        new("moderator", "Community Moderator", "Can flag user content"),
        new("billing", "Billing Officer", "Manages invoices"),
        new("developer", "Developer", "Access to API tokens and webhooks")
    ];

    private const string _transferCode = """
        <Transfer DataSource="@items"
                  @bind-TargetKeys="targetKeys"
                  Titles="@(new[] { "Available Roles", "Assigned Roles" })"
                  ShowSearch="true" />
        """;

    private const string _compactCode = """
        <Transfer DataSource="@items"
                  @bind-TargetKeys="compactKeys"
                  Titles="@(new[] { "Left List", "Right List" })"
                  ShowSearch="false" />
        """;
}