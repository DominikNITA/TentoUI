@page "/components/tree-select"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>TreeSelect - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">TreeSelect</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            A dropdown selection component containing an expandable hierarchical tree structure.
        </p>
    </div>

    @* Interactive Playground *@
    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">Interactive Playground</h3>
                <p class="text-xs text-slate-400">Expand tree branches and select target node dynamically.</p>
            </div>
            <div class="text-xs text-slate-400">
                Selected: <strong class="text-primary-600 dark:text-primary-400 font-mono text-sm">@_selectedKey</strong>
            </div>
        </div>

        <div class="p-8 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 max-w-xs mx-auto">
            <TreeSelect TreeData="@_treeData"
                        @bind-Value="_selectedKey"
                        Placeholder="Select file or directory..."
                        AllowClear="true"
                        ShowSearch="true" />
        </div>
    </div>

    <ApiTable Title="TreeSelect Properties" Properties="@_props" />
</div>

@code {
    private string? _selectedKey = "components";

    private readonly TreeDataNode[] _treeData =
    [
        new("src", "src",
        [
            new("components", "Components",
            [
                new("table", "Table.razor", isLeaf: true),
                new("button", "Button.razor", isLeaf: true),
                new("input", "Input.razor", isLeaf: true)
            ]),
            new("project", "TentoUI.csproj", isLeaf: true)
        ]),
        new("readme", "README.md", isLeaf: true)
    ];

    private readonly ApiTable.ApiProp[] _props =
    [
        new("TreeData", "Hierarchical data structure of tree nodes.", "IEnumerable<TreeDataNode>?", "null"),
        new("Value", "Current selected node key (bindable via @bind-Value).", "string?", "null"),
        new("Placeholder", "Placeholder text.", "string?", "'Please select'"),
        new("AllowClear", "Whether clear icon is enabled.", "bool", "true"),
        new("ShowSearch", "Whether to display search filter input.", "bool", "false")
    ];
}
