@page "/components/tree-select"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>TreeSelect - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">TreeSelect</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
            A dropdown selection component containing an expandable hierarchical tree structure.
        </p>
    </div>

    @* Interactive Props Playground *@
    <PropsPlayground Title="TreeSelect Interactive Playground"
                     ComponentTag="TreeSelect"
                     Controls="@_playgroundControls" />

    @* Example 1: Basic TreeSelect *@
    <DemoCard Title="Basic TreeSelect" Description="Dropdown picker with nested folder and file tree navigation." Code="@_basicCode">
        <div class="max-w-xs p-2 space-y-2">
            <TreeSelect TreeData="@_treeData"
                        @bind-Value="_selectedKey"
                        Placeholder="Select file or directory..."
                        AllowClear="true" />
            <div class="text-xs text-slate-400 font-mono">Selected Key: @_selectedKey</div>
        </div>
    </DemoCard>

    @* Example 2: Searchable TreeSelect *@
    <DemoCard Title="Searchable Tree Nodes" Description="Type keywords to filter matching branch and leaf nodes directly." Code="@_searchCode">
        <div class="max-w-xs p-2 space-y-2">
            <TreeSelect TreeData="@_treeData"
                        @bind-Value="_searchKey"
                        Placeholder="Search codebase files..."
                        ShowSearch="true"
                        AllowClear="true" />
            <div class="text-xs text-slate-400 font-mono">Selected Key: @_searchKey</div>
        </div>
    </DemoCard>

    <ApiTable Title="TreeSelect Properties" ComponentType="@typeof(TreeSelect)" />
    <ApiTable Title="TreeDataNode Properties" ComponentType="@typeof(TreeDataNode)" />
</div>

@code {
    private readonly List<PropsPlayground.PlaygroundControl> _playgroundControls =
    [
        new() { Name = "Placeholder", Kind = PropsPlayground.PlaygroundControlKind.Text, CurrentValue = "Select file or directory...", DefaultValue = "Please select" },
        new() { Name = "AllowClear", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "true" },
        new() { Name = "ShowSearch", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "true", DefaultValue = "false" },
        new() { Name = "Disabled", Kind = PropsPlayground.PlaygroundControlKind.Boolean, CurrentValue = "false", DefaultValue = "false" }
    ];

    private string? _selectedKey = "components";
    private string? _searchKey = "table";

    private readonly TreeDataNode[] _treeData =
    [
        new("src", "src",
        [
            new("components", "Components",
            [
                new("table", "Table.razor", isLeaf: true),
                new("button", "Button.razor", isLeaf: true),
                new("input", "Input.razor", isLeaf: true)
            ]),
            new("project", "TentoUI.csproj", isLeaf: true)
        ]),
        new("readme", "README.md", isLeaf: true)
    ];

    private const string _basicCode = """
        <TreeSelect TreeData="@treeData"
                    @bind-Value="selectedKey"
                    Placeholder="Select node..."
                    AllowClear="true" />
        """;

    private const string _searchCode = """
        <TreeSelect TreeData="@treeData"
                    @bind-Value="searchKey"
                    Placeholder="Search files..."
                    ShowSearch="true" />
        """;
}