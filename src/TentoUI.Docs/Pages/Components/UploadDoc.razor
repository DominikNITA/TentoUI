@page "/components/upload"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Upload &amp; Sliders - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Upload, Slider &amp; Rate</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            File upload controls, continuous/stepped range sliders, and star rating evaluations.
        </p>
    </div>

    <DemoCard Title="Star Rating" Description="Clickable 5-star rating with hover preview." Code="@_rateCode">
        <div class="flex items-center gap-4">
            <Rate @bind-Value="_rating" />
            <span class="text-xs font-semibold text-slate-500">Score: @_rating / 5</span>
        </div>
    </DemoCard>

    <DemoCard Title="Upload Button" Description="Standard file picker with file size validation and list display." Code="@_uploadCode">
        <div class="max-w-md">
            <Upload ButtonText="Select Documentation Files"
                    Hint="Supports PDF, PNG, or Markdown up to 10MB." />
        </div>
    </DemoCard>
</div>

@code {
    private int _rating = 4;

    private const string _rateCode = @"<Rate @bind-Value=""_rating"" />";
    private const string _uploadCode = @"<Upload ButtonText=""Select Documentation Files""
        Hint=""Supports PDF, PNG, or Markdown up to 10MB."" />";
}
