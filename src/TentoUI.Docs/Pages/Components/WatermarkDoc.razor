@page "/components/watermark"
@namespace TentoUI.Docs.Pages.Components

<PageTitle>Watermark - TentoUI</PageTitle>

<div class="max-w-5xl space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Watermark</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Overlay watermarks across page elements to protect proprietary copyright and confidential documents.
        </p>
    </div>

    @* Example 1: Basic Watermark *@
    <DemoCard Title="Confidential Document Watermark" Description="Repeated diagonal watermark text superimposed over secure content." Code="@_basicCode">
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
            <Watermark Content="TentoUI CONFIDENTIAL" Rotate="-22" FontSize="14">
                <div class="h-48 p-6 flex flex-col justify-between">
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        This confidential workspace preview contains proprietary analytics and customer metrics.
                    </p>
                    <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
                        <span class="font-bold text-xs text-slate-800 dark:text-slate-200">Financial Ledger #4092</span>
                        <p class="text-xs text-slate-500 mt-0.5">Net surplus: $148,200.00 USD</p>
                    </div>
                </div>
            </Watermark>
        </div>
    </DemoCard>

    @* Example 2: Custom Text & Angle *@
    <DemoCard Title="Draft &amp; Internal Only" Description="Configure custom rotation angle and distinct security classification copy." Code="@_draftCode">
        <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
            <Watermark Content="INTERNAL REVIEW ONLY" Rotate="-15" FontSize="16">
                <div class="h-40 p-6 flex items-center justify-center text-slate-500 text-sm">
                    Legal Contract Review Draft — Pending Executive Sign-off
                </div>
            </Watermark>
        </div>
    </DemoCard>

    <ApiTable Title="Watermark Properties" Properties="@_props" />
</div>

@code {
    private const string _basicCode = """
        <Watermark Content="TentoUI CONFIDENTIAL" Rotate="-22" FontSize="14">
            <div class="h-48 p-6">
                <p>This confidential workspace preview contains proprietary analytics.</p>
                <div class="p-3 bg-slate-50 rounded-lg">
                    <span>Financial Ledger #4092</span>
                </div>
            </div>
        </Watermark>
        """;

    private const string _draftCode = """
        <Watermark Content="INTERNAL REVIEW ONLY" Rotate="-15" FontSize="16">
            <div class="h-40 p-6 flex items-center justify-center text-slate-500">
                Legal Contract Review Draft — Pending Executive Sign-off
            </div>
        </Watermark>
        """;

    private readonly ApiTable.ApiProp[] _props =
    [
        new("Content", "The watermark text to repeat.", "string?", "'TentoUI'"),
        new("Rotate", "Rotation angle in degrees.", "int", "-22"),
        new("FontSize", "Font size of watermark text in px.", "int", "14"),
        new("FontColor", "Color of watermark text.", "string?", "rgba(0,0,0,0.15)"),
        new("Width", "Watermark canvas pattern width in px.", "int", "120"),
        new("Height", "Watermark canvas pattern height in px.", "int", "64"),
        new("ZIndex", "Z-index of the overlay pattern.", "int", "9"),
        new("ChildContent", "Document or area content to overlay.", "RenderFragment?", "null")
    ];
}