@page "/overview/ai-setup"
@namespace TentoUI.Docs.Pages.Overview
@inject IJSRuntime JSRuntime
@inject IMessageService MessageService

<PageTitle>AI Agent Integration - TentoUI</PageTitle>

<div class="max-w-4xl space-y-8">
    <div>
        <div class="flex items-center gap-2 mb-2">
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                Agentic Coding Ready
            </span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">AI Agent Integration (llms.txt)</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Equip AI coding assistants (Claude, Cursor, Copilot, ChatGPT, Gemini CLI, Windsurf) to write 100% compliant TentoUI Blazor components.
        </p>
    </div>

    @* Step 1: Install Skills via MSBuild *@
    <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold">1</span>
                <span>Install Pre-Built AI Skills (1-Command)</span>
            </h3>
            <button type="button" class="text-xs text-primary-600 dark:text-primary-400 font-semibold hover:underline inline-flex items-center gap-1"
                    @onclick='() => CopyTextAsync("dotnet msbuild -t:TentoUIInstallSkills")'>
                <Icon Name="@IconNames.Copy" Size="12" /> Copy Command
            </button>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            TentoUI ships with built-in AI skills (<code class="font-mono">SKILL.md</code>) for Tailwind setup and component usage. Run this MSBuild target in your project to extract them into your local <code class="font-mono">.skills/</code> directory:
        </p>
        <div class="p-3.5 rounded-lg bg-slate-950 text-slate-200 font-mono text-xs overflow-x-auto">
            <code>dotnet msbuild -t:TentoUIInstallSkills</code>
        </div>
        <p class="text-xs text-slate-400">
            For specific agent skill folders (e.g. Gemini CLI, Claude Code), pass target:
        </p>
        <div class="p-3 rounded-lg bg-slate-950 text-slate-200 font-mono text-xs overflow-x-auto">
            <code>dotnet msbuild -t:TentoUIInstallSkills -p:TentoUISkillsTarget=.gemini/config/skills/</code>
        </div>
    </div>

    @* Step 2: System Prompt for Cursor / Claude Rules *@
    <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold">2</span>
                    <span>Cursor / Claude / Copilot Prompt Rule</span>
                </h3>
                <p class="text-xs text-slate-400 mt-1">Copy and save into <code class="font-mono text-slate-300">.cursorrules</code> or your project prompt.</p>
            </div>
            <button type="button" class="px-3 py-1.5 rounded-md bg-purple-600 hover:bg-purple-700 text-white font-semibold text-xs inline-flex items-center gap-1.5 shadow-sm transition-colors"
                    @onclick='() => CopyTextAsync(_aiSystemPrompt)'>
                <Icon Name="@IconNames.Copy" Size="13" /> Copy System Prompt
            </button>
        </div>

        <div class="p-4 rounded-lg bg-slate-950 text-slate-200 font-mono text-xs overflow-x-auto leading-relaxed border border-slate-800">
            <pre class="whitespace-pre-wrap"><code>@_aiSystemPrompt</code></pre>
        </div>
    </div>

    @* Step 3: Machine-Readable llms.txt standard *@
    <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-3">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold">3</span>
            <span>Standard llms.txt Endpoint</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            This documentation site exposes a standardized <code class="font-mono">llms.txt</code> file formatted specifically for AI context ingestion:
        </p>
        <div class="p-3 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-mono text-xs flex items-center justify-between">
            <code>/llms.txt</code>
            <a href="llms.txt" target="_blank" class="text-xs text-primary-600 dark:text-primary-400 font-semibold hover:underline inline-flex items-center gap-1">
                View llms.txt <Icon Name="@IconNames.ExternalLink" Size="12" />
            </a>
        </div>
        <div class="p-3 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-mono text-xs flex items-center justify-between">
            <code>/llms-full.txt (Complete Component &amp; Tailwind Skill Bundle)</code>
            <a href="llms-full.txt" target="_blank" class="text-xs text-primary-600 dark:text-primary-400 font-semibold hover:underline inline-flex items-center gap-1">
                View llms-full.txt <Icon Name="@IconNames.ExternalLink" Size="12" />
            </a>
        </div>
    </div>
</div>

@code {
    private const string _aiSystemPrompt = """
        You are an expert Blazor developer building UI with the TentoUI component library in .NET 10.
        Follow these core rules:

        1. Framework & Imports:
           - In _Imports.razor: Ensure '@using TentoUI' and '@using TentoUI.Configuration' are present.
           - Do not use 'Microsoft.AspNetCore.Components.Forms.InputNumber' or 'System.Collections.Generic.List' blindly without namespace disambiguation, as TentoUI provides <TentoUI.InputNumber> and <TentoUI.List>.

        2. Styling & Layout:
           - TentoUI is styled with Tailwind CSS v4. Never inject Bootstrap CSS into TentoUI projects.
           - All brand theming is driven by CSS variables (--tento-primary-500, etc.) or <TentoConfigProvider Theme="@theme">.
           - Do not hardcode raw hex codes into component class attributes; use semantic classes (e.g. text-primary-600, bg-slate-50 dark:bg-slate-900).

        3. Component Syntax:
           - Buttons: <Button Type="ButtonType.Primary" Size="ComponentSize.Middle">Label</Button>
           - Icons: <Icon Name="@IconNames.Check" Size="16" />. When passing icon to Button or Menu, use child markup: <Icon><TentoUI.Icon Name="@IconNames.Home" Size="14" /></Icon>.
           - Feedback hosts: Ensure <ModalHost />, <NotificationHost />, and <MessageHost /> are in MainLayout.razor.
           - Modals: Use IModalService.OpenAsync<TComponent>(title, parameters) or declarative <Modal IsVisible="@_open" Title="Title">...</Modal>.
        """;

    private async Task CopyTextAsync(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text.Trim());
            MessageService.Success("Copied to clipboard!");
        }
        catch
        {
            MessageService.Info("Copied!");
        }
    }
}
