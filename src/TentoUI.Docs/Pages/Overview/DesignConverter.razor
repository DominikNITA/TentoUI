@page "/overview/design-converter"
@namespace TentoUI.Docs.Pages.Overview
@inject IJSRuntime JSRuntime
@inject IMessageService MessageService

<PageTitle>Design.md to Theme Configs - TentoUI</PageTitle>

<div class="max-w-6xl space-y-8">
    <div>
        <div class="flex items-center gap-2 mb-2">
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300">
                Design System Transformer
            </span>
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                Dark Variants Supported
            </span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Design.md to Theme Configs</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
            Paste any <code class="font-mono text-xs">Design.md</code> specification or design tokens YAML (with optional dark theme variants). TentoUI automatically converts it into C# code, Razor providers, CSS variables, and <code class="font-mono text-xs">appsettings.json</code> with live light &amp; dark UI preview.
        </p>
    </div>

    @* Preset Loaders *@
    <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-semibold text-slate-500">Preset Examples:</span>
        <button type="button"
                class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                @onclick="LoadDuolingoPreset">
            🦉 Duolingo (Lime &amp; Sky + Dark Mode)
        </button>
        <button type="button"
                class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                @onclick="LoadModernSaaSPreset">
            🚀 Modern SaaS (Indigo &amp; Slate + Dark Mode)
        </button>
        <button type="button"
                class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                @onclick="LoadCyberpunkPreset">
            ⚡ Cyberpunk (Neon Pink &amp; Cyan + Dark Mode)
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        @* Column 1: Markdown / YAML Editor *@
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    Design.md (YAML Frontmatter)
                </span>
                <span class="text-[11px] text-slate-400 font-mono">live parsing</span>
            </div>
            <textarea rows="20"
                      class="w-full rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-950 text-slate-100 font-mono text-xs p-4 leading-relaxed focus:outline-none focus:border-primary-500 selection:bg-primary-600"
                      @bind="_markdownInput"
                      @bind:event="oninput"
                      @bind:after="OnInputChanged"
                      placeholder="Paste your Design.md content here..."></textarea>
        </div>

        @* Column 2: Live UI Preview with extracted theme *@
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    Live Component Preview
                </span>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-500">Dark Mode:</span>
                    <Switch Checked="@_previewDarkMode" CheckedChanged="@OnPreviewDarkModeChanged" Size="ComponentSize.Small" />
                </div>
            </div>

            <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-5"
                 style="@_theme.ToCssStyle()">
                <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-base text-slate-900 dark:text-white">
                            @(_tokens.Name ?? "Custom Design System")
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                            @(_tokens.Description ?? "Rendered dynamically using TentoConfigProvider token binding.")
                        </p>
                    </div>
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded font-semibold bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400">
                        @(_previewDarkMode ? "Dark Variant" : "Light Variant")
                    </span>
                </div>

                @* Interactive sample components *@
                <div class="flex items-center gap-3 flex-wrap">
                    <button type="button"
                            class="px-4 py-2 rounded-md font-semibold text-xs shadow-sm transition-all"
                            style="background-color: var(--tento-primary-500, #3b82f6); color: var(--tento-text-inverse, #ffffff); border-radius: var(--tento-radius-md, 0.375rem);">
                        Primary Button
                    </button>
                    <button type="button"
                            class="px-4 py-2 rounded-md font-semibold text-xs border transition-all"
                            style="border-color: var(--tento-primary-500, #3b82f6); color: var(--tento-primary-500, #3b82f6); border-radius: var(--tento-radius-md, 0.375rem);">
                        Outline Button
                    </button>
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full"
                          style="background-color: var(--tento-primary-500, #3b82f6); color: var(--tento-text-inverse, #ffffff);">
                        Active Chip
                    </span>
                </div>

                <div class="p-4 rounded-lg border text-xs space-y-2"
                     style="background-color: var(--tento-bg-app, #f8fafc); border-color: var(--tento-border-base, #e2e8f0); border-radius: var(--tento-radius-md, 0.375rem);">
                    <div class="flex items-center justify-between font-semibold" style="color: var(--tento-text-base, #0f172a);">
                        <span>Status Overview</span>
                        <span class="font-mono text-[11px]" style="color: var(--tento-primary-500, #3b82f6);">
                            Primary: @(_previewDarkMode ? (_tokens.DarkPrimaryColor ?? _tokens.PrimaryColor) : _tokens.PrimaryColor)
                        </span>
                    </div>
                    <p style="color: var(--tento-text-muted, #64748b);">
                        Typography font: <code class="font-mono font-semibold">@(_tokens.FontFamily ?? "system default")</code> | Radius: <code class="font-mono font-semibold">@(_tokens.BorderRadius ?? "default")</code>
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* Output Configurations Section *@
    <div class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Generated Configurations</h2>
            <div class="flex items-center gap-2">
                <button type="button"
                        class="px-3 py-1.5 rounded-lg text-xs font-semibold @(_activeTab == "csharp" ? "bg-primary-600 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300")"
                        @onclick='() => _activeTab = "csharp"'>
                    C# (Program.cs)
                </button>
                <button type="button"
                        class="px-3 py-1.5 rounded-lg text-xs font-semibold @(_activeTab == "razor" ? "bg-primary-600 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300")"
                        @onclick='() => _activeTab = "razor"'>
                    Blazor Razor
                </button>
                <button type="button"
                        class="px-3 py-1.5 rounded-lg text-xs font-semibold @(_activeTab == "css" ? "bg-primary-600 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300")"
                        @onclick='() => _activeTab = "css"'>
                    CSS Variables
                </button>
                <button type="button"
                        class="px-3 py-1.5 rounded-lg text-xs font-semibold @(_activeTab == "json" ? "bg-primary-600 text-white" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300")"
                        @onclick='() => _activeTab = "json"'>
                    appsettings.json
                </button>
            </div>
        </div>

        <div class="relative rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-950 p-4 font-mono text-xs text-slate-200 overflow-x-auto leading-relaxed shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-3 text-[11px] text-slate-400">
                <span>@(GetTabLabel())</span>
                <button type="button"
                        class="px-2.5 py-1 rounded bg-primary-600 hover:bg-primary-700 text-white font-semibold inline-flex items-center gap-1 transition-colors"
                        @onclick="CopyActiveCodeAsync">
                    <Icon Name="@IconNames.Copy" Size="12" /> Copy Config
                </button>
            </div>
            <pre class="whitespace-pre-wrap"><code>@GetActiveSnippet()</code></pre>
        </div>
    </div>
</div>

@code {
    private string _activeTab = "csharp";
    private string _markdownInput = string.Empty;
    private bool _previewDarkMode = false;
    private DesignTokens _tokens = new();
    private TentoTheme _theme = new();

    protected override void OnInitialized()
    {
        LoadDuolingoPreset();
    }

    private void OnPreviewDarkModeChanged(bool dark)
    {
        _previewDarkMode = dark;
        _theme.DarkMode = dark;
    }

    private void OnInputChanged()
    {
        _tokens = DesignTokensParser.Parse(_markdownInput);
        _theme = _tokens.ToTentoTheme();
        _theme.DarkMode = _previewDarkMode;
    }

    private void LoadDuolingoPreset()
    {
        _markdownInput = """
            ---
            version: alpha
            name: Duolingo
            description: "Free, fun, and effective courses in languages and more."
            sourceUrl: "https://www.duolingo.com"

            colors:
              primary: "#58cc02"
              on-primary: "#ffffff"
              background: "#ddf4ff"
              text: "#3c3c3c"
              text-muted: "#777777"
              accent: "#1cb0f6"
              dark:
                primary: "#78e025"
                background: "#131f24"
                surface: "#18282e"
                text: "#f7f7f7"
                text-muted: "#9ba8b0"

            typography:
              body:
                fontFamily: "duolingo-sans, sans-serif"

            radius:
              sm: 16px
            ---
            """;
        OnInputChanged();
    }

    private void LoadModernSaaSPreset()
    {
        _markdownInput = """
            ---
            name: Modern Cloud SaaS
            description: "Enterprise multi-tenant cloud application design system."

            colors:
              primary: "#6366f1"
              on-primary: "#ffffff"
              background: "#f8fafc"
              text: "#0f172a"
              text-muted: "#64748b"
              accent: "#0ea5e9"
              dark:
                primary: "#818cf8"
                background: "#090d16"
                surface: "#111827"
                text: "#f8fafc"
                text-muted: "#94a3b8"

            typography:
              body:
                fontFamily: "Inter, sans-serif"

            radius:
              sm: 8px
            ---
            """;
        OnInputChanged();
    }

    private void LoadCyberpunkPreset()
    {
        _markdownInput = """
            ---
            name: Neon Cyberpunk
            description: "High-contrast dark synthwave design tokens."

            colors:
              primary: "#ec4899"
              on-primary: "#ffffff"
              background: "#0f172a"
              text: "#f8fafc"
              text-muted: "#94a3b8"
              accent: "#06b6d4"
              dark:
                primary: "#f472b6"
                background: "#05070e"
                surface: "#0c0f1d"
                text: "#ffffff"
                text-muted: "#cbd5e1"

            typography:
              body:
                fontFamily: "JetBrains Mono, monospace"

            radius:
              sm: 4px
            ---
            """;
        OnInputChanged();
    }

    private string GetTabLabel() => _activeTab switch
    {
        "csharp" => "Program.cs (C# Service Registration)",
        "razor" => "App.razor / MainLayout.razor (<TentoConfigProvider>)",
        "css" => "Styles/app.tailwind.css (CSS Variables: Light & Dark)",
        "json" => "appsettings.json (Theme Config)",
        _ => "Config"
    };

    private string GetActiveSnippet() => _activeTab switch
    {
        "csharp" => _tokens.ToCSharpCode(),
        "razor" => $"<TentoConfigProvider Theme=\"@theme\" DarkMode=\"@_isDark\">\n    @* Your Application Content *@\n</TentoConfigProvider>\n\n@code {{\n    private bool _isDark = false;\n    private readonly TentoTheme theme = new()\n    {{\n        PrimaryColor = \"{_tokens.PrimaryColor ?? "#3b82f6"}\",\n        AppBgColor = \"{_tokens.BackgroundColor ?? "#f8fafc"}\",\n        BaseTextColor = \"{_tokens.TextColor ?? "#0f172a"}\",\n        Dark =\n        {{\n            PrimaryColor = \"{_tokens.DarkPrimaryColor ?? "#60a5fa"}\",\n            AppBgColor = \"{_tokens.DarkBackgroundColor ?? "#090d16"}\",\n            SurfaceBgColor = \"{_tokens.DarkSurfaceColor ?? "#111827"}\"\n        }}\n    }};\n}}",
        "css" => _tokens.ToCssVariables(),
        "json" => _tokens.ToJsonConfig(),
        _ => string.Empty
    };

    private async Task CopyActiveCodeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", GetActiveSnippet().Trim());
            MessageService.Success("Configuration copied to clipboard!");
        }
        catch
        {
            MessageService.Info("Copied!");
        }
    }
}
