@page "/overview/versioning"
@namespace TentoUI.Docs.Pages.Overview
@inject IMessageService MessageService

<PageTitle>Multi-Version Documentation - TentoUI</PageTitle>

<div class="max-w-4xl space-y-10">
    @* Page Header *@
    <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 border border-primary-200 dark:border-primary-800 mb-3">
            <span>Documentation Architecture</span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Multi-Version Documentation</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            How TentoUI documentation supports multiple library versions, static hosting deployments on GitHub Pages, automated release workflows, and cross-version routing.
        </p>
    </div>

    @* Section 1: Architectural Strategy *@
    <div class="space-y-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-950 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold">1</span>
            <span>Static Hosting Architecture (GitHub Pages &amp; CDNs)</span>
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Because TentoUI Docs is compiled as a <strong>100% client-side Blazor WebAssembly static application</strong>, supporting multiple versions is accomplished using a <strong>Subdirectory Multi-Deployment Strategy</strong> (the industry standard used by React, Angular, Tailwind CSS, and Microsoft Docs):
        </p>

        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-3 font-mono text-xs">
            <div class="text-slate-400 text-[11px] font-sans font-medium uppercase tracking-wider">GitHub Pages Directory Structure</div>
            <div class="space-y-1.5 text-slate-700 dark:text-slate-300">
                <div class="flex items-center gap-2">
                    <span class="text-primary-500 font-bold">├──</span>
                    <span class="text-slate-900 dark:text-white font-bold">index.html</span>
                    <span class="text-slate-400 font-sans text-[11px]">→ Root redirect script (forwards automatically to /latest/ or /v1.0/)</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-primary-500 font-bold">├──</span>
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold">versions.json</span>
                    <span class="text-slate-400 font-sans text-[11px]">→ Global version manifest listing all active releases and paths</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-primary-500 font-bold">├──</span>
                    <span class="font-bold text-slate-900 dark:text-white">latest/</span>
                    <span class="text-slate-400 font-sans text-[11px]">→ Symlink or copy of the current stable release (v1.0.0)</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-primary-500 font-bold">├──</span>
                    <span class="font-bold text-slate-900 dark:text-white">v1.0/</span>
                    <span class="text-slate-400 font-sans text-[11px]">→ Full standalone Blazor WASM build for v1.0.0</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-primary-500 font-bold">├──</span>
                    <span class="font-bold text-slate-900 dark:text-white">v0.9/</span>
                    <span class="text-slate-400 font-sans text-[11px]">→ Preserved Blazor WASM build for legacy v0.9.0</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-primary-500 font-bold">└──</span>
                    <span class="font-bold text-slate-900 dark:text-white">next/</span>
                    <span class="text-slate-400 font-sans text-[11px]">→ Nightly / preview build from master branch</span>
                </div>
            </div>
        </div>
    </div>

    @* Section 2: Global Version Manifest *@
    <div class="space-y-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-950 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold">2</span>
            <span>The versions.json Manifest Schema</span>
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            The documentation app reads a simple JSON manifest at root. When a user opens the version selector, the dropdown dynamically populates all available documentation builds without requiring code changes:
        </p>

        <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 font-mono text-xs text-slate-200 overflow-x-auto leading-relaxed">
<pre>[
  {
    "version": "1.0.0",
    "label": "v1.0.0 (Latest)",
    "path": "/v1.0/",
    "isLatest": true,
    "releaseDate": "2026-10-28",
    "notes": "General Availability release"
  },
  {
    "version": "1.1.0-preview",
    "label": "v1.1.0 (Next)",
    "path": "/next/",
    "isPreview": true,
    "releaseDate": "2026-11-15",
    "notes": "Expanded showcase templates &amp; data entry suite"
  },
  {
    "version": "0.9.0",
    "label": "v0.9.0",
    "path": "/v0.9/",
    "isLegacy": true,
    "releaseDate": "2026-09-15",
    "notes": "Legacy preview release"
  }
]</pre>
        </div>
    </div>

    @* Section 3: Automated GitHub Actions Workflow *@
    <div class="space-y-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-950 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold">3</span>
            <span>Automated GitHub Actions Multi-Version Workflow</span>
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Here is the complete GitHub Actions workflow to publish versioned docs to the <code>gh-pages</code> branch whenever a Git release tag (e.g. <code>v1.0.0</code>) is pushed. It preserves all previous versions and copies the new release into its designated version folder:
        </p>

        <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 font-mono text-xs text-slate-200 overflow-x-auto leading-relaxed">
<pre>name: Publish Versioned Documentation

on:
  push:
    tags:
      - 'v*.*.*'
    branches:
      - master

permissions:
  contents: write

jobs:
  deploy-docs:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Setup Node.js &amp; Tailwind
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Build Minified CSS
        run: |
          cd src/TentoUI.Docs
          npm ci
          npm run css:build

      - name: Publish Blazor WASM
        run: |
          dotnet publish src/TentoUI.Docs/TentoUI.Docs.csproj -c Release -o output

      - name: Checkout gh-pages Branch
        uses: actions/checkout@v4
        with:
          ref: gh-pages
          path: gh-pages-branch

      - name: Copy Versioned Artifacts
        run: |
          # Extract release tag or default to 'latest'
          VERSION_TAG="${{ github.ref_name }}"
          if [[ "$VERSION_TAG" =~ ^v[0-9] ]]; then
            MAJOR_MINOR=$(echo "$VERSION_TAG" | grep -oE '^v[0-9]+\.[0-9]+')
            mkdir -p "gh-pages-branch/$MAJOR_MINOR"
            cp -r output/wwwroot/* "gh-pages-branch/$MAJOR_MINOR/"
            # Also update latest copy
            mkdir -p "gh-pages-branch/latest"
            cp -r output/wwwroot/* "gh-pages-branch/latest/"
          else
            mkdir -p "gh-pages-branch/next"
            cp -r output/wwwroot/* "gh-pages-branch/next/"
          fi

      - name: Deploy to GitHub Pages
        run: |
          cd gh-pages-branch
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@@users.noreply.github.com"
          git add .
          git commit -m "docs: release $VERSION_TAG to gh-pages" || exit 0
          git push origin gh-pages</pre>
        </div>
    </div>

    @* Section 4: Cross-Version Route Mapping *@
    <div class="space-y-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-950 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold">4</span>
            <span>Cross-Version Route Preservation</span>
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            When developers are reading a specific component page (e.g. <code>/components/table</code>) and switch versions via the header dropdown, the client-side router preserves the relative path:
        </p>

        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800 space-y-1">
                <span class="font-bold text-slate-700 dark:text-slate-300">From Version 1.0</span>
                <p class="font-mono text-primary-600 dark:text-primary-400">https://tentoui.dev/v1.0/components/table</p>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800 space-y-1">
                <span class="font-bold text-slate-700 dark:text-slate-300">Switched to Version 1.1</span>
                <p class="font-mono text-emerald-600 dark:text-emerald-400">https://tentoui.dev/v1.1/components/table</p>
            </div>
        </div>
    </div>

    @* Section 5: In-Code Version Badges *@
    <div class="space-y-4">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-950 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold">5</span>
            <span>Component Version Compatibility Badges</span>
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Within component documentation, individual parameters or new components can be annotated with version badges to notify users of minimum required versions:
        </p>

        <div class="flex flex-wrap items-center gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs">
            <span class="px-2 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                Added in v1.0.0
            </span>
            <span class="px-2 py-0.5 rounded-full font-bold bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-300 border border-sky-200 dark:border-sky-800">
                New in v1.1.0
            </span>
            <span class="px-2 py-0.5 rounded-full font-bold bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                Deprecated in v1.2.0
            </span>
        </div>
    </div>
</div>
