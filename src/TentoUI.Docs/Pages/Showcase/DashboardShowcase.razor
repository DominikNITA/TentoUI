@page "/showcase/dashboard"
@namespace TentoUI.Docs.Pages.Showcase
@inject NavigationManager Navigation
@inject IMessageService MessageService

<PageTitle>Analytics Dashboard - TentoUI Showcase</PageTitle>

<div class="max-w-7xl mx-auto space-y-6 pb-12">
    @* Navigation & Top Action Bar *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-3">
            <Button Size="ComponentSize.Small" OnClick="@(() => Navigation.NavigateTo("showcase"))">
                <span class="inline-flex items-center gap-1.5">
                    <Icon Name="@IconNames.ArrowLeft" Size="14" />
                    <span>Showcases</span>
                </span>
            </Button>
            <div class="h-4 w-px bg-slate-300 dark:bg-slate-700"></div>
            <div>
                <h1 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>Cloud &amp; Infrastructure Dashboard</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-400">
                        Operational
                    </span>
                </h1>
                <p class="text-xs text-slate-500">Live compute metrics and managed cluster workloads</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <Segmented TValue="string"
                       Value="@_selectedPeriod"
                       ValueChanged="HandlePeriodChanged"
                       Options="@_periodOptions"
                       Size="ComponentSize.Small" />

            <Button Size="ComponentSize.Small" OnClick="RefreshMetricsAsync" Loading="@_isRefreshing">
                <span class="inline-flex items-center gap-1.5">
                    <Icon Name="@IconNames.RefreshCw" Size="13" />
                    <span>Refresh</span>
                </span>
            </Button>

            <Button Type="ButtonType.Primary" Size="ComponentSize.Small" OnClick="@(() => MessageService.Success("Exporting operations report..."))">
                <span class="inline-flex items-center gap-1.5">
                    <Icon Name="@IconNames.Download" Size="13" />
                    <span>Export</span>
                </span>
            </Button>
        </div>
    </div>

    @* System Notification Alert *@
    <Alert Type="AlertType.Info"
           Message="Scheduled Node Maintenance: Worker pools in us-east-2 will execute rolling zero-downtime kernel updates tonight at 02:00 UTC."
           Closable="true"
           ShowIcon="true" />

    @* Primary KPI Metrics Strip *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <Card Class="shadow-xs hover:border-primary-400 transition-colors">
            <div class="flex items-start justify-between">
                <Statistic Title="Monthly Run Rate"
                           Value="@_mrrValue"
                           Precision="2">
                    <Prefix>$</Prefix>
                </Statistic>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400">
                    +14.8%
                </span>
            </div>
            <div class="mt-2 text-[11px] text-slate-400 flex items-center gap-1">
                <span>vs. previous period</span>
                <span class="font-semibold text-slate-600 dark:text-slate-300">($124,300)</span>
            </div>
        </Card>

        <Card Class="shadow-xs hover:border-primary-400 transition-colors">
            <div class="flex items-start justify-between">
                <Statistic Title="Active Node Instances"
                           Value="@_activeNodes" />
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-primary-50 text-primary-600 dark:bg-primary-950/60 dark:text-primary-400">
                    +42 Nodes
                </span>
            </div>
            <div class="mt-2 text-[11px] text-slate-400">
                12 worker groups across 3 multi-zone clusters
            </div>
        </Card>

        <Card Class="shadow-xs hover:border-primary-400 transition-colors">
            <div class="flex items-start justify-between">
                <Statistic Title="Ingestion Bandwidth"
                           Value="@_throughput"
                           Precision="2">
                    <Suffix>GB/s</Suffix>
                </Statistic>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400">
                    99.99% SLA
                </span>
            </div>
            <div class="mt-2 text-[11px] text-slate-400">
                Peak burst capacity 12.0 GB/s
            </div>
        </Card>

        <Card Class="shadow-xs hover:border-primary-400 transition-colors">
            <div class="flex items-start justify-between">
                <Statistic Title="p99 Edge Latency"
                           Value="@_p99Latency">
                    <Suffix>ms</Suffix>
                </Statistic>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400">
                    -4ms Faster
                </span>
            </div>
            <div class="mt-2 text-[11px] text-slate-400">
                Global Anycast CDN distribution
            </div>
        </Card>
    </div>

    @* Main Content 2-Column Layout *@
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        @* Left Column: Resources and Workloads (8 cols) *@
        <div class="lg:col-span-8 space-y-6">
            @* Compute Resources Card *@
            <Card Title="Cluster Resource Utilization">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 py-2">
                    <div class="flex flex-col items-center text-center space-y-2">
                        <Progress Type="ProgressType.Circle"
                                  Percent="@_cpuPercent"
                                  CircleSize="84" />
                        <div>
                            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block">CPU Load</span>
                            <span class="text-[11px] text-slate-400">96 / 128 vCPUs</span>
                        </div>
                    </div>

                    <div class="flex flex-col items-center text-center space-y-2">
                        <Progress Type="ProgressType.Circle"
                                  Percent="@_ramPercent"
                                  CircleSize="84" />
                        <div>
                            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 block">Memory Allocation</span>
                            <span class="text-[11px] text-slate-400">384 / 512 GB RAM</span>
                        </div>
                    </div>

                    <div class="sm:col-span-2 flex flex-col justify-center space-y-4 px-2">
                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <span class="font-medium text-slate-700 dark:text-slate-300">NVMe High-Speed Storage</span>
                                <span class="font-mono text-slate-500">6.4 TB / 10 TB</span>
                            </div>
                            <Progress Percent="64" Size="ComponentSize.Small" />
                        </div>

                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <span class="font-medium text-slate-700 dark:text-slate-300">Network Egress Pool</span>
                                <span class="font-mono text-slate-500">42% of 50 Gbps</span>
                            </div>
                            <Progress Percent="42" Size="ComponentSize.Small" />
                        </div>
                    </div>
                </div>
            </Card>

            @* Workloads Table *@
            <Card Title="Managed Services &amp; Workloads">
                <div class="mb-4 flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="w-full sm:w-64">
                        <Input Placeholder="Search services..."
                               @bind-Value="_searchQuery"
                               AllowClear="true" />
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-500">Environment:</span>
                        <Tag Color="blue">Production</Tag>
                        <Tag Color="green">Live Traffic</Tag>
                    </div>
                </div>

                <Table TItem="WorkloadRecord"
                       DataSource="@FilteredWorkloads"
                       Striped="true"
                       Bordered="false"
                       PageSize="5">
                    <TableColumn TItem="WorkloadRecord" Title="Service" Property="@(w => w.Name)" Sortable="true" Context="w">
                        <div class="flex items-center gap-2.5">
                            <div class="w-7 h-7 rounded-md bg-primary-100 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-xs">
                                @w.Name[..1]
                            </div>
                            <div>
                                <span class="font-semibold text-slate-800 dark:text-slate-200 block text-xs">@w.Name</span>
                                <span class="text-[10px] text-slate-400 font-mono">@w.Namespace</span>
                            </div>
                        </div>
                    </TableColumn>

                    <TableColumn TItem="WorkloadRecord" Title="Region" Property="@(w => w.Region)" Sortable="true" Context="w">
                        <span class="text-xs font-mono text-slate-600 dark:text-slate-400">@w.Region</span>
                    </TableColumn>

                    <TableColumn TItem="WorkloadRecord" Title="Replicas" Property="@(w => w.Replicas)" Context="w">
                        <span class="text-xs font-mono font-medium text-slate-700 dark:text-slate-300">@w.Replicas</span>
                    </TableColumn>

                    <TableColumn TItem="WorkloadRecord" Title="Status" Property="@(w => w.Status)" Sortable="true" Context="w">
                        @switch (w.Status)
                        {
                            case "Running":
                                <Tag Color="green">Running</Tag>
                                break;
                            case "Scaling":
                                <Tag Color="blue">Scaling</Tag>
                                break;
                            case "Warning":
                                <Tag Color="orange">Degraded</Tag>
                                break;
                            default:
                                <Tag>@w.Status</Tag>
                                break;
                        }
                    </TableColumn>

                    <TableColumn TItem="WorkloadRecord" Title="Actions" Context="w">
                        <div class="flex items-center gap-1.5">
                            <Button Size="ComponentSize.Small" OnClick="@(() => MessageService.Info($"Restarting pod for {w.Name}..."))">
                                Restart
                            </Button>
                        </div>
                    </TableColumn>
                </Table>
            </Card>
        </div>

        @* Right Column: Operations Timeline & Configuration (4 cols) *@
        <div class="lg:col-span-4 space-y-6">
            @* Operations Timeline Card *@
            <Card Title="Recent Operational Events">
                <div class="py-2">
                    <Timeline>
                        <TimelineItem Color="green" Label="12:45 UTC">
                            <span class="font-semibold text-xs text-slate-800 dark:text-slate-200 block">Release v1.4.2 Deployed</span>
                            <span class="text-[11px] text-slate-500">18 pods swapped seamlessly with rolling update.</span>
                        </TimelineItem>
                        <TimelineItem Color="blue" Label="11:30 UTC">
                            <span class="font-semibold text-xs text-slate-800 dark:text-slate-200 block">Autoscaler Triggered</span>
                            <span class="text-[11px] text-slate-500">Added 4 worker nodes due to sustained traffic surge.</span>
                        </TimelineItem>
                        <TimelineItem Color="green" Label="09:15 UTC">
                            <span class="font-semibold text-xs text-slate-800 dark:text-slate-200 block">Database Backup Verified</span>
                            <span class="text-[11px] text-slate-500">PostgreSQL snapshot (142 GB) synced to S3.</span>
                        </TimelineItem>
                        <TimelineItem Color="amber" Label="06:00 UTC">
                            <span class="font-semibold text-xs text-slate-800 dark:text-slate-200 block">SSL Certificate Renewed</span>
                            <span class="text-[11px] text-slate-500">Wildcard domain TLS certificate refreshed for 90 days.</span>
                        </TimelineItem>
                    </Timeline>
                </div>
            </Card>

            @* Quick Controls Card *@
            <Card Title="Live Cluster Preferences">
                <div class="space-y-4 text-xs">
                    <div class="flex items-center justify-between py-1">
                        <div>
                            <span class="font-medium text-slate-800 dark:text-slate-200 block">Dynamic Autoscaling</span>
                            <span class="text-[11px] text-slate-400">Scale node groups automatically on high load</span>
                        </div>
                        <Switch @bind-Checked="_autoScale" />
                    </div>

                    <div class="h-px bg-slate-100 dark:bg-slate-800"></div>

                    <div class="flex items-center justify-between py-1">
                        <div>
                            <span class="font-medium text-slate-800 dark:text-slate-200 block">Edge CDN Cache Bypass</span>
                            <span class="text-[11px] text-slate-400">Force immediate origin cache revalidation</span>
                        </div>
                        <Switch @bind-Checked="_cdnBypass" />
                    </div>

                    <div class="h-px bg-slate-100 dark:bg-slate-800"></div>

                    <div class="flex items-center justify-between py-1">
                        <div>
                            <span class="font-medium text-slate-800 dark:text-slate-200 block">Strict TLS Enforcement</span>
                            <span class="text-[11px] text-slate-400">Reject inbound connections below TLS 1.3</span>
                        </div>
                        <Switch @bind-Checked="_strictTls" />
                    </div>

                    <div class="h-px bg-slate-100 dark:bg-slate-800"></div>

                    <div class="pt-2">
                        <Popconfirm Title="Flush cluster cache?"
                                    Description="This may momentarily increase backend database queries."
                                    OkText="Yes, Flush"
                                    CancelText="Cancel"
                                    OnConfirm="FlushCache">
                            <Button Danger="true" Class="w-full">
                                Flush Cluster Cache
                            </Button>
                        </Popconfirm>
                    </div>
                </div>
            </Card>
        </div>
    </div>
</div>

@code {
    private string _selectedPeriod = "30D";
    private bool _isRefreshing = false;
    private string _searchQuery = string.Empty;

    private double _mrrValue = 142850.00;
    private int _activeNodes = 1248;
    private double _throughput = 3.84;
    private int _p99Latency = 24;

    private int _cpuPercent = 74;
    private int _ramPercent = 68;

    private bool _autoScale = true;
    private bool _cdnBypass = false;
    private bool _strictTls = true;

    private readonly SegmentedOption<string>[] _periodOptions =
    [
        new("Today", "Today"),
        new("7D", "7 Days"),
        new("30D", "30 Days"),
        new("1Y", "1 Year")
    ];

    public record WorkloadRecord(string Name, string Namespace, string Region, string Replicas, string Status);

    private readonly System.Collections.Generic.List<WorkloadRecord> _workloads =
    [
        new("auth-service", "security", "us-east-1", "8 / 8", "Running"),
        new("payment-gateway", "billing", "us-east-1", "12 / 12", "Running"),
        new("vector-search-engine", "ai-core", "us-west-2", "16 / 16", "Scaling"),
        new("inventory-sync", "operations", "eu-west-1", "4 / 4", "Running"),
        new("notification-dispatcher", "messaging", "us-east-1", "6 / 6", "Running"),
        new("analytics-pipeline", "telemetry", "us-west-2", "2 / 4", "Warning"),
        new("api-edge-router", "networking", "global", "32 / 32", "Running")
    ];

    private IEnumerable<WorkloadRecord> FilteredWorkloads
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery)) return _workloads;
            return _workloads.Where(w =>
                w.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                w.Namespace.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                w.Region.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void HandlePeriodChanged(string period)
    {
        _selectedPeriod = period;
        switch (period)
        {
            case "Today":
                _mrrValue = 4760.00;
                _activeNodes = 1210;
                _cpuPercent = 62;
                _ramPercent = 55;
                break;
            case "7D":
                _mrrValue = 33200.00;
                _activeNodes = 1235;
                _cpuPercent = 69;
                _ramPercent = 64;
                break;
            case "30D":
                _mrrValue = 142850.00;
                _activeNodes = 1248;
                _cpuPercent = 74;
                _ramPercent = 68;
                break;
            case "1Y":
                _mrrValue = 1714200.00;
                _activeNodes = 1380;
                _cpuPercent = 81;
                _ramPercent = 77;
                break;
        }
        MessageService.Info($"Loaded metrics for period: {period}");
    }

    private async Task RefreshMetricsAsync()
    {
        _isRefreshing = true;
        await Task.Delay(400);
        _isRefreshing = false;
        MessageService.Success("Cluster metrics updated successfully.");
    }

    private void FlushCache()
    {
        MessageService.Success("Global cluster edge cache purged successfully.");
    }
}
