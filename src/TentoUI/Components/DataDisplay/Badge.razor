@namespace TentoUI
@inherits TentoComponentBase

<span class="@ComputeBadgeWrapperClass()" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent

    @if (Dot || IsDot || (Status != null && !Count.HasValue))
    {
        <span class="@ComputeDotClass()" style="@(!string.IsNullOrEmpty(Color) ? $"background-color: {Color};" : null)" aria-label="Status indicator"></span>
        @if (!string.IsNullOrEmpty(Text))
        {
            <span class="ml-2 text-xs text-slate-700 dark:text-slate-300">@Text</span>
        }
    }
    else if (Count.HasValue && (Count.Value > 0 || ShowZero))
    {
        <sup class="@ComputeCountClass()" style="@(!string.IsNullOrEmpty(Color) ? $"background-color: {Color};" : null)" aria-label="@($"{Count.Value} notifications")">
            @(Count.Value > OverflowCount ? $"{OverflowCount}+" : Count.Value.ToString())
        </sup>
    }
</span>

@code {
    [Parameter] public int? Count { get; set; }
    [Parameter] public int OverflowCount { get; set; } = 99;
    [Parameter] public bool Dot { get; set; }
    [Parameter] public bool IsDot { get; set; }
    [Parameter] public bool ShowZero { get; set; }
    [Parameter] public object? Status { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private BadgeStatus ResolvedStatus
    {
        get
        {
            if (Status is BadgeStatus s) return s;
            if (Status is string str)
            {
                var cleaned = str.Replace("BadgeStatus.", "", StringComparison.OrdinalIgnoreCase).Trim();
                if (Enum.TryParse<BadgeStatus>(cleaned, true, out var parsed))
                    return parsed;
            }
            return BadgeStatus.Default;
        }
    }

    private string ComputeBadgeWrapperClass()
    {
        return new CssBuilder("tento-badge")
            .AddClass(ChildContent != null ? "relative inline-block" : "inline-flex items-center")
            .AddClass(Class)
            .Build();
    }

    private string ComputeDotClass()
    {
        if (!string.IsNullOrEmpty(Color))
        {
            var pos = ChildContent != null ? "absolute top-0 right-0 -mt-1 -mr-1" : "";
            return new CssBuilder("tento-badge-dot h-2 w-2 rounded-full")
                .AddClass(pos)
                .Build();
        }

        var dotColor = ResolvedStatus switch
        {
            BadgeStatus.Success => "bg-emerald-500",
            BadgeStatus.Error => "bg-red-500",
            BadgeStatus.Warning => "bg-amber-500",
            BadgeStatus.Processing => "bg-blue-500",
            _ => "bg-slate-400"
        };

        var posClass = ChildContent != null ? "absolute top-0 right-0 -mt-1 -mr-1" : "";

        return new CssBuilder("tento-badge-dot h-2 w-2 rounded-full")
            .AddClass(dotColor)
            .AddClass(posClass)
            .Build();
    }

    private string ComputeCountClass()
    {
        var posClass = ChildContent != null ? "absolute -top-2 -right-2 transform translate-x-1/2 -translate-y-1/2" : "";

        return new CssBuilder("tento-badge-count rounded-full bg-red-500 text-white text-xs px-1.5 py-0.5 font-medium leading-none")
            .AddClass(posClass)
            .Build();
    }
}
