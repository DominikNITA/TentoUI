@namespace TentoUI
@inherits TentoInputBase<string?>
@attribute [Since("1.1.0")]

@{
    var suggestions = GetEffectiveSuggestions();
}

<div id="@ElementId" class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    @if (suggestions.Count > 0)
    {
        <div class="flex flex-wrap items-center gap-1.5 mb-2" role="list" aria-label="Prompt suggestions">
            @foreach (var chip in suggestions)
            {
                <button type="button"
                        role="listitem"
                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-primary-50 hover:text-primary-600 dark:hover:bg-primary-950/40 dark:hover:text-primary-400 border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer"
                        @onclick="() => ApplySuggestion(chip)">
                    <Icon Name="sparkles" Class="w-3 h-3 text-primary-500" />
                    <span>@chip</span>
                </button>
            }
        </div>
    }

    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs focus-within:border-primary-500 focus-within:ring-2 focus-within:ring-primary-500/20 transition-all p-2.5">
        <textarea class="w-full bg-transparent text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none resize-none"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  disabled="@(Disabled || Loading)"
                  aria-label="@(Placeholder ?? "Prompt input")"
                  value="@CurrentValueAsString"
                  @oninput="OnTextInput"
                  @onkeydown="HandleKeyDown"></textarea>

        <div class="flex items-center justify-between pt-2 mt-1 border-t border-slate-100 dark:border-slate-800/80">
            <div class="flex items-center gap-1 text-xs text-slate-400">
                <Kbd Keys="Enter" /> <span>to send</span>
            </div>

            <div class="flex items-center gap-2">
                @if (Loading)
                {
                    <Button Type="ButtonType.Default" Size="ComponentSize.Small" OnClick="HandleStop">
                        Stop
                    </Button>
                }
                <Button Type="ButtonType.Primary"
                        Size="ComponentSize.Small"
                        Disabled="@(Disabled || Loading || string.IsNullOrWhiteSpace(CurrentValue))"
                        Loading="@Loading"
                        OnClick="SubmitPrompt">
                    Send
                </Button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Placeholder { get; set; } = "Ask AI anything or type a command...";
    [Parameter] public int Rows { get; set; } = 2;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public IReadOnlyList<string>? Suggestions { get; set; }
    [Parameter] public string? SuggestionsString { get; set; }
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }

    private string ComputedClass => new CssBuilder("w-full")
        .AddClass(Class)
        .Build();

    private IReadOnlyList<string> GetEffectiveSuggestions()
    {
        if (Suggestions is { Count: > 0 })
            return Suggestions;

        if (!string.IsNullOrWhiteSpace(SuggestionsString))
        {
            return SuggestionsString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        }

        return [];
    }

    private void OnTextInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }

    private async Task ApplySuggestion(string suggestion)
    {
        CurrentValueAsString = suggestion;
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(suggestion);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SubmitPrompt();
        }
    }

    private async Task SubmitPrompt()
    {
        if (Disabled || Loading || string.IsNullOrWhiteSpace(CurrentValue))
            return;

        var prompt = CurrentValue.Trim();
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(prompt);

        CurrentValueAsString = string.Empty;
    }

    private async Task HandleStop()
    {
        if (OnStop.HasDelegate)
            await OnStop.InvokeAsync();
    }
}
