@namespace TentoUI
@inherits TentoComponentBase
@using QRCoder

<div class="@ComputedClass" style="@ComputedWrapperStyle" @attributes="AdditionalAttributes">
    <div class="@ComputedCardClass">
        @if (_matrixSize > 0)
        {
            <svg class="block"
                 width="@Size"
                 height="@Size"
                 viewBox="0 0 @_matrixSize @_matrixSize"
                 xmlns="http://www.w3.org/2000/svg"
                 shape-rendering="crispEdges">
                <rect width="@_matrixSize" height="@_matrixSize" fill="@BgColor" />
                <path d="@_svgPathData" fill="@Color" />

                @if (!string.IsNullOrEmpty(Icon))
                {
                    var iconModuleSize = Math.Max(4, (int)Math.Round((double)IconSize / Size * _matrixSize));
                    var iconPos = (_matrixSize - iconModuleSize) / 2.0;

                    <!-- Cutout behind icon so modules don't clash -->
                    <rect x="@(iconPos - 0.5)"
                          y="@(iconPos - 0.5)"
                          width="@(iconModuleSize + 1)"
                          height="@(iconModuleSize + 1)"
                          rx="1"
                          fill="@BgColor" />

                    <image href="@Icon"
                           x="@iconPos"
                           y="@iconPos"
                           width="@iconModuleSize"
                           height="@iconModuleSize"
                           preserveAspectRatio="xMidYMid meet" />
                }
            </svg>
        }
        else
        {
            <div style="width: @(Size)px; height: @(Size)px;" class="flex items-center justify-center text-xs text-slate-400">
                <span>No QR Data</span>
            </div>
        }

        @if (Status != QRCodeStatus.Active)
        {
            <div class="absolute inset-0 bg-white/85 dark:bg-slate-900/85 backdrop-blur-[2px] rounded-lg flex flex-col items-center justify-center p-3 text-center z-10 transition-opacity">
                @if (Status == QRCodeStatus.Loading)
                {
                    <span class="animate-spin text-primary-500 mb-1.5">
                        <Icon Name="@IconNames.Loader2" Size="24" />
                    </span>
                    <span class="text-xs text-slate-500 font-medium">Loading...</span>
                }
                else if (Status == QRCodeStatus.Expired)
                {
                    <Icon Name="@IconNames.AlertCircle" Size="24" Class="text-amber-500 mb-1.5" />
                    <span class="text-xs text-slate-600 dark:text-slate-300 mb-2 font-medium">QR code expired</span>
                    <button type="button"
                            class="px-2.5 py-1 text-xs rounded bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors inline-flex items-center gap-1.5 shadow-sm"
                            @onclick="OnRefresh">
                        <Icon Name="@IconNames.RefreshCw" Size="12" />
                        <span>Refresh</span>
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public int Size { get; set; } = 160;
    [Parameter] public string Color { get; set; } = "#000000";
    [Parameter] public string BgColor { get; set; } = "#ffffff";
    [Parameter] public bool Bordered { get; set; } = true;
    [Parameter] public QRCodeStatus Status { get; set; } = QRCodeStatus.Active;
    [Parameter] public QRCodeErrorLevel ErrorLevel { get; set; } = QRCodeErrorLevel.M;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public int IconSize { get; set; } = 40;
    [Parameter] public EventCallback OnRefresh { get; set; }

    private int _matrixSize;
    private string _svgPathData = string.Empty;
    private string? _lastValue;
    private QRCodeErrorLevel _lastErrorLevel;

    protected override void OnParametersSet()
    {
        if (Value != _lastValue || ErrorLevel != _lastErrorLevel)
        {
            _lastValue = Value;
            _lastErrorLevel = ErrorLevel;
            RegenerateMatrix();
        }
    }

    private void RegenerateMatrix()
    {
        if (string.IsNullOrWhiteSpace(Value))
        {
            _matrixSize = 0;
            _svgPathData = string.Empty;
            return;
        }

        try
        {
            using var generator = new QRCodeGenerator();
            var ecc = ErrorLevel switch
            {
                QRCodeErrorLevel.L => QRCodeGenerator.ECCLevel.L,
                QRCodeErrorLevel.Q => QRCodeGenerator.ECCLevel.Q,
                QRCodeErrorLevel.H => QRCodeGenerator.ECCLevel.H,
                _ => QRCodeGenerator.ECCLevel.M
            };

            if (!string.IsNullOrEmpty(Icon) && ecc == QRCodeGenerator.ECCLevel.L)
            {
                ecc = QRCodeGenerator.ECCLevel.M;
            }

            using var qrData = generator.CreateQrCode(Value, ecc);
            var matrix = qrData.ModuleMatrix;
            _matrixSize = matrix.Count;

            var sb = new System.Text.StringBuilder();
            for (int y = 0; y < _matrixSize; y++)
            {
                for (int x = 0; x < _matrixSize; x++)
                {
                    if (matrix[y][x])
                    {
                        sb.Append('M').Append(x).Append(' ').Append(y).Append("h1v1h-1z ");
                    }
                }
            }
            _svgPathData = sb.ToString();
        }
        catch
        {
            _matrixSize = 0;
            _svgPathData = string.Empty;
        }
    }

    private string ComputedCardClass => new CssBuilder("relative inline-flex items-center justify-center")
        .AddClass("p-2 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm", Bordered)
        .Build();

    private string ComputedClass => new CssBuilder("tento-qrcode inline-block")
        .AddClass(Class)
        .Build();

    private string ComputedWrapperStyle => new StyleBuilder()
        .AddStyle(Style)
        .Build();
}
