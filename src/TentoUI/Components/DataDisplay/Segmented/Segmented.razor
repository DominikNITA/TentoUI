@namespace TentoUI
@typeparam TValue
@inherits TentoComponentBase

<CascadingValue Value="@this" IsFixed="true">
    <div class="hidden">
        @ChildContent
    </div>
</CascadingValue>

<div role="radiogroup"
     aria-label="@(AriaLabel ?? "Segmented control")"
     class="@ComputedWrapperClass"
     style="@Style"
     @attributes="AdditionalAttributes">
    @foreach (var opt in EffectiveOptions)
    {
        var isSelected = EqualityComparer<TValue>.Default.Equals(opt.Value, Value);
        var isOptDisabled = Disabled || opt.Disabled;

        <button type="button"
                role="radio"
                aria-checked="@(isSelected ? "true" : "false")"
                disabled="@isOptDisabled"
                data-value="@opt.Value"
                class="@ComputeOptionClass(isSelected, isOptDisabled)"
                @onclick="@(() => SelectOptionAsync(opt.Value, isOptDisabled))">
            @if (OptionTemplate != null)
            {
                @OptionTemplate(opt)
            }
            else if (opt.Template != null)
            {
                @opt.Template
            }
            else
            {
                <div class="inline-flex items-center justify-center gap-1.5 min-w-0">
                    @if (!string.IsNullOrEmpty(opt.Icon))
                    {
                        <Icon Name="@opt.Icon" Size="@ComputeIconSize()" />
                    }
                    @if (!string.IsNullOrEmpty(opt.Label))
                    {
                        <span class="truncate">@opt.Label</span>
                    }
                    else
                    {
                        <span class="truncate">@opt.Value?.ToString()</span>
                    }
                </div>
            }
        </button>
    }
</div>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public EventCallback<TValue> OnChange { get; set; }
    [Parameter] public object? Options { get; set; }
    [Parameter] public RenderFragment<SegmentedOption<TValue>>? OptionTemplate { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public ComponentSize? Size { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private readonly System.Collections.Generic.List<SegmentedItem<TValue>> _items = new();

    internal void RegisterItem(SegmentedItem<TValue> item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            if (Value == null && _items.Count == 1)
            {
                Value = item.Value;
            }
            StateHasChanged();
        }
    }

    internal void NotifyItemChanged()
    {
        StateHasChanged();
    }

    internal void UnregisterItem(SegmentedItem<TValue> item)
    {
        if (_items.Remove(item))
        {
            StateHasChanged();
        }
    }

    private IEnumerable<SegmentedOption<TValue>> EffectiveOptions
    {
        get
        {
            // 1. Declarative child items (<SegmentedItem>)
            if (_items.Count > 0)
            {
                return _items.Select(i => new SegmentedOption<TValue>(
                    i.Value,
                    i.Label,
                    i.Icon,
                    i.Disabled,
                    i.ChildContent));
            }

            // 2. Options as IEnumerable<SegmentedOption<TValue>>
            if (Options is IEnumerable<SegmentedOption<TValue>> segOpts)
            {
                return segOpts;
            }

            // 3. Options as comma-separated string
            if (Options is string optStr && !string.IsNullOrWhiteSpace(optStr))
            {
                return ParseOptionsFromString(optStr);
            }

            // 4. Options as IEnumerable
            if (Options is System.Collections.IEnumerable enumerable)
            {
                var list = new System.Collections.Generic.List<SegmentedOption<TValue>>();
                foreach (var item in enumerable)
                {
                    if (item is SegmentedOption<TValue> so)
                    {
                        list.Add(so);
                    }
                    else if (item is TValue tv)
                    {
                        list.Add(new SegmentedOption<TValue>(tv, tv?.ToString()));
                    }
                    else if (item != null)
                    {
                        var str = item.ToString() ?? string.Empty;
                        list.Add(new SegmentedOption<TValue>(ConvertStringToValue(str), str));
                    }
                }
                return list;
            }

            return Enumerable.Empty<SegmentedOption<TValue>>();
        }
    }

    private IEnumerable<SegmentedOption<TValue>> ParseOptionsFromString(string optStr)
    {
        return optStr.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => new SegmentedOption<TValue>(ConvertStringToValue(s), s));
    }

    private static TValue ConvertStringToValue(string s)
    {
        if (typeof(TValue) == typeof(string))
            return (TValue)(object)s;
        try
        {
            return (TValue)Convert.ChangeType(s, typeof(TValue), System.Globalization.CultureInfo.InvariantCulture);
        }
        catch
        {
            return default!;
        }
    }

    private async Task SelectOptionAsync(TValue nextValue, bool isOptDisabled)
    {
        if (isOptDisabled) return;
        if (!EqualityComparer<TValue>.Default.Equals(Value, nextValue))
        {
            Value = nextValue;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }
            if (OnChange.HasDelegate)
            {
                await OnChange.InvokeAsync(Value);
            }
        }
    }

    private int ComputeIconSize() => ResolvedSize(Size) switch
    {
        ComponentSize.Small => 13,
        ComponentSize.Large => 18,
        _ => 15
    };

    private string ComputedWrapperClass => new CssBuilder("tento-segmented inline-flex p-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 select-none")
        .AddClass("w-full flex", Block)
        .AddClass("opacity-50 cursor-not-allowed", Disabled)
        .AddClass(Class)
        .Build();

    private string ComputeOptionClass(bool isSelected, bool isOptDisabled)
    {
        var sizePadding = ResolvedSize(Size) switch
        {
            ComponentSize.Small => "px-2 py-0.5 text-xs",
            ComponentSize.Large => "px-4 py-2 text-base",
            _ => "px-3 py-1 text-xs"
        };

        return new CssBuilder($"tento-segmented-item rounded-md font-medium transition-all duration-150 {sizePadding}")
            .AddClass("flex-1 text-center", Block)
            .AddClass("bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm font-semibold", isSelected)
            .AddClass("hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-slate-700/50", !isSelected && !isOptDisabled)
            .AddClass("opacity-40 cursor-not-allowed", isOptDisabled)
            .Build();
    }
}
