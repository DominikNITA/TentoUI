@namespace TentoUI
@inherits TentoComponentBase

<div class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    @if (TitleTemplate != null)
    {
        <div class="tento-statistic-title text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">
            @TitleTemplate
        </div>
    }
    else if (!string.IsNullOrEmpty(Title))
    {
        <div class="tento-statistic-title text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">
            @Title
        </div>
    }

    <div class="tento-statistic-content flex items-baseline gap-1.5 text-2xl font-semibold text-slate-900 dark:text-white" style="@ValueStyle">
        @if (Prefix != null)
        {
            <span class="tento-statistic-prefix text-base">@Prefix</span>
        }
        <span class="tento-statistic-value">@FormattedValue</span>
        @if (Suffix != null)
        {
            <span class="tento-statistic-suffix text-sm font-normal text-slate-500 dark:text-slate-400">@Suffix</span>
        }
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleTemplate { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public int? Precision { get; set; }
    [Parameter] public RenderFragment? Prefix { get; set; }
    [Parameter] public RenderFragment? Suffix { get; set; }
    [Parameter] public string? ValueStyle { get; set; }

    private string FormattedValue
    {
        get
        {
            if (Value == null) return string.Empty;
            if (Precision.HasValue && double.TryParse(Value.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var num))
            {
                return num.ToString($"N{Precision.Value}", System.Globalization.CultureInfo.InvariantCulture);
            }
            return Value.ToString() ?? string.Empty;
        }
    }

    private string ComputedClass => new CssBuilder("tento-statistic inline-flex flex-col")
        .AddClass(Class)
        .Build();
}
