@namespace TentoUI
@inherits TentoComponentBase

@if (_visible)
{
    <span class="@ComputeTagClass()" style="@ComputeTagStyle()" @attributes="AdditionalAttributes">
        @if (Icon != null)
        {
            <span class="mr-1 inline-flex items-center">@Icon</span>
        }
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
        @if (Closable)
        {
            <button type="button"
                    class="ml-1 text-xs opacity-60 hover:opacity-100 transition-opacity focus:outline-none"
                    aria-label="Close tag"
                    @onclick="@HandleClose">
                &times;
            </button>
        }
    </span>
}

@code {
    [Parameter] public string? Color { get; set; }
    [Parameter] public TagColor? TagColor { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool Closable { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClose { get; set; }

    private bool _visible = true;

    private async Task HandleClose(MouseEventArgs e)
    {
        _visible = false;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync(e);
        }
    }

    private string ComputeTagClass()
    {
        var resolvedColor = Color ?? TagColor?.ToString();

        var colorClass = resolvedColor switch
        {
            "Success" => "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800",
            "Warning" => "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800",
            "Error" => "bg-red-50 text-red-700 border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-800",
            "Info" => "bg-sky-50 text-sky-700 border-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-800",
            "Primary" => "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800",
            _ => "bg-slate-50 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700"
        };

        return new CssBuilder("tento-tag inline-flex items-center px-2 py-0.5 rounded text-xs border select-none")
            .AddClass(colorClass)
            .AddClass(Class)
            .Build();
    }

    private string ComputeTagStyle()
    {
        if (!string.IsNullOrEmpty(Color) && Color.StartsWith("#"))
        {
            return new StyleBuilder()
                .AddStyle("background-color", $"{Color}15")
                .AddStyle("color", Color)
                .AddStyle("border-color", $"{Color}40")
                .AddStyle(Style)
                .Build();
        }

        return Style ?? "";
    }
}
