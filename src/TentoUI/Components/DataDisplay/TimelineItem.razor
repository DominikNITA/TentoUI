@namespace TentoUI
@inherits TentoComponentBase

<li class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    <span class="@ComputedDotClass">
        @if (Dot != null)
        {
            @Dot
        }
    </span>

    @if (!string.IsNullOrEmpty(Label))
    {
        <time class="tento-timeline-label block mb-1 text-xs font-normal leading-none text-slate-400 dark:text-slate-500">
            @Label
        </time>
    }

    <div class="tento-timeline-content text-sm text-slate-700 dark:text-slate-200">
        @ChildContent
    </div>
</li>

@code {
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? Dot { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedClass => new CssBuilder("tento-timeline-item ml-4 relative")
        .AddClass(Class)
        .Build();

    private string ComputedDotClass
    {
        get
        {
            var colorClass = Color.ToLowerInvariant() switch
            {
                "green" or "success" => "bg-emerald-500 ring-emerald-100 dark:ring-emerald-950",
                "red" or "error" or "danger" => "bg-red-500 ring-red-100 dark:ring-red-950",
                "amber" or "warning" => "bg-amber-500 ring-amber-100 dark:ring-amber-950",
                "gray" or "slate" => "bg-slate-400 ring-slate-100 dark:ring-slate-800",
                _ => "bg-primary-500 ring-primary-100 dark:ring-primary-950"
            };

            return $"tento-timeline-dot absolute -left-[21px] top-1 flex items-center justify-center w-3 h-3 rounded-full ring-4 {colorClass}";
        }
    }
}
