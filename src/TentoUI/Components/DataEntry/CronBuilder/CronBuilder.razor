@namespace TentoUI
@inherits TentoInputBase<string?>
@attribute [Since("1.0.0")]

<div id="@ElementId" class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
        <div class="inline-flex flex-wrap gap-1" role="tablist" aria-label="Schedule frequency">
            @foreach (var mode in Enum.GetValues<CronScheduleMode>())
            {
                var active = _mode == mode;
                <button type="button"
                        role="tab"
                        aria-selected="@(active ? "true" : "false")"
                        disabled="@Disabled"
                        class="px-2.5 py-1 rounded-lg text-xs font-medium transition-colors cursor-pointer @(active ? "bg-primary-600 text-white" : "text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-800")"
                        @onclick="() => SelectMode(mode)">
                    @mode
                </button>
            }
        </div>
        <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-slate-900 text-emerald-400 border border-slate-700" aria-label="Generated cron expression">
            @(CurrentValue ?? "*/5 * * * *")
        </span>
    </div>

    <div class="p-4 space-y-4 bg-white dark:bg-slate-950 text-sm">
        @if (_mode == CronScheduleMode.Minutes)
        {
            <div class="flex items-center gap-2">
                <span class="text-slate-700 dark:text-slate-300">Run every</span>
                <input type="number" min="1" max="59" value="@_everyMinutes" disabled="@Disabled"
                       aria-label="Minutes interval"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnEveryMinutesChanged" />
                <span class="text-slate-700 dark:text-slate-300">minute(s)</span>
            </div>
        }
        else if (_mode == CronScheduleMode.Hourly)
        {
            <div class="flex items-center gap-2">
                <span class="text-slate-700 dark:text-slate-300">At minute</span>
                <input type="number" min="0" max="59" value="@_minute" disabled="@Disabled"
                       aria-label="Minute of hour"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnMinuteChanged" />
                <span class="text-slate-700 dark:text-slate-300">past every hour</span>
            </div>
        }
        else if (_mode == CronScheduleMode.Daily)
        {
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-slate-700 dark:text-slate-300">Every day at</span>
                <input type="number" min="0" max="23" value="@_hour" disabled="@Disabled"
                       aria-label="Hour of day"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnHourChanged" />
                <span>:</span>
                <input type="number" min="0" max="59" value="@_minute" disabled="@Disabled"
                       aria-label="Minute of hour"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnMinuteChanged" />
            </div>
        }
        else if (_mode == CronScheduleMode.Weekly)
        {
            <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Days of week">
                    @for (var d = 0; d < DayNames.Length; d++)
                    {
                        var dayIndex = d;
                        var selected = _selectedDays.Contains(dayIndex);
                        <button type="button"
                                disabled="@Disabled"
                                class="px-2.5 py-1 rounded-lg text-xs font-medium border transition-colors cursor-pointer @(selected ? "bg-primary-600 text-white border-primary-600" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")"
                                @onclick="() => ToggleDay(dayIndex)">
                            @DayNames[dayIndex]
                        </button>
                    }
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-slate-700 dark:text-slate-300">At</span>
                    <input type="number" min="0" max="23" value="@_hour" disabled="@Disabled"
                           aria-label="Hour of day"
                           class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                           @onchange="OnHourChanged" />
                    <span>:</span>
                    <input type="number" min="0" max="59" value="@_minute" disabled="@Disabled"
                           aria-label="Minute of hour"
                           class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                           @onchange="OnMinuteChanged" />
                </div>
            </div>
        }
        else if (_mode == CronScheduleMode.Monthly)
        {
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-slate-700 dark:text-slate-300">On day</span>
                <input type="number" min="1" max="31" value="@_dayOfMonth" disabled="@Disabled"
                       aria-label="Day of month"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnDayOfMonthChanged" />
                <span class="text-slate-700 dark:text-slate-300">of the month at</span>
                <input type="number" min="0" max="23" value="@_hour" disabled="@Disabled"
                       aria-label="Hour of day"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnHourChanged" />
                <span>:</span>
                <input type="number" min="0" max="59" value="@_minute" disabled="@Disabled"
                       aria-label="Minute of hour"
                       class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm"
                       @onchange="OnMinuteChanged" />
            </div>
        }
        else
        {
            <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1">Raw 5-field Cron Expression (min hour dom mon dow)</label>
                <input type="text"
                       value="@CurrentValueAsString"
                       disabled="@Disabled"
                       aria-label="Custom cron expression"
                       class="w-full px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 font-mono text-sm"
                       @oninput="e => CurrentValueAsString = e.Value?.ToString()" />
            </div>
        }

        <div class="flex items-center gap-2 pt-2 border-t border-slate-100 dark:border-slate-900 text-xs text-slate-500 dark:text-slate-400">
            <Icon Name="clock" Class="w-3.5 h-3.5 text-primary-500 shrink-0" />
            <span>@GetHumanDescription()</span>
        </div>
    </div>
</div>

@code {
    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private CronScheduleMode _mode = CronScheduleMode.Daily;
    private int _everyMinutes = 5;
    private int _minute = 0;
    private int _hour = 9;
    private int _dayOfMonth = 1;
    private readonly HashSet<int> _selectedDays = [1, 2, 3, 4, 5];

    private string ComputedClass => new CssBuilder("rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-2xs")
        .AddClass(Class)
        .Build();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (string.IsNullOrWhiteSpace(CurrentValue))
        {
            RebuildCronExpression();
        }
    }

    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }

    private void SelectMode(CronScheduleMode mode)
    {
        _mode = mode;
        if (mode != CronScheduleMode.Custom)
            RebuildCronExpression();
    }

    private void OnEveryMinutesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _everyMinutes = Math.Clamp(v, 1, 59);
            RebuildCronExpression();
        }
    }

    private void OnMinuteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _minute = Math.Clamp(v, 0, 59);
            RebuildCronExpression();
        }
    }

    private void OnHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _hour = Math.Clamp(v, 0, 23);
            RebuildCronExpression();
        }
    }

    private void OnDayOfMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            _dayOfMonth = Math.Clamp(v, 1, 31);
            RebuildCronExpression();
        }
    }

    private void ToggleDay(int dayIndex)
    {
        if (!_selectedDays.Remove(dayIndex))
            _selectedDays.Add(dayIndex);
        if (_selectedDays.Count == 0)
            _selectedDays.Add(1);

        RebuildCronExpression();
    }

    private void RebuildCronExpression()
    {
        var expr = _mode switch
        {
            CronScheduleMode.Minutes => $"*/{_everyMinutes} * * * *",
            CronScheduleMode.Hourly => $"{_minute} * * * *",
            CronScheduleMode.Daily => $"{_minute} {_hour} * * *",
            CronScheduleMode.Weekly => $"{_minute} {_hour} * * {string.Join(",", _selectedDays.OrderBy(d => d))}",
            CronScheduleMode.Monthly => $"{_minute} {_hour} {_dayOfMonth} * *",
            _ => CurrentValue ?? "0 9 * * *"
        };

        CurrentValueAsString = expr;
    }

    private string GetHumanDescription()
    {
        return _mode switch
        {
            CronScheduleMode.Minutes => $"Runs every {_everyMinutes} minute(s).",
            CronScheduleMode.Hourly => $"Runs at minute {_minute:D2} past every hour.",
            CronScheduleMode.Daily => $"Runs every day at {_hour:D2}:{_minute:D2}.",
            CronScheduleMode.Weekly => $"Runs at {_hour:D2}:{_minute:D2} on {string.Join(", ", _selectedDays.OrderBy(d => d).Select(d => DayNames[d]))}.",
            CronScheduleMode.Monthly => $"Runs on day {_dayOfMonth} of every month at {_hour:D2}:{_minute:D2}.",
            _ => $"Custom cron schedule: {CurrentValue ?? "0 9 * * *"}"
        };
    }
}
