@namespace TentoUI
@inherits TentoComponentBase

<EditForm EditContext="@_effectiveEditContext"
          OnValidSubmit="@HandleValidSubmit"
          OnInvalidSubmit="@HandleInvalidSubmit"
          OnSubmit="@OnSubmit"
          class="@ComputeClass()"
          style="@Style"
          @attributes="AdditionalAttributes">
    @if (EnableDataAnnotations && _effectiveEditContext != null)
    {
        <DataAnnotationsValidator />
    }
    <CascadingValue Value="@_formContext" IsFixed="true">
        @if (Disabled)
        {
            <fieldset disabled class="w-full space-y-inherit">
                @ChildContent
            </fieldset>
        }
        else
        {
            @ChildContent
        }
    </CascadingValue>
</EditForm>

@code {
    [Parameter] public object? Model { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public FormLayout Layout { get; set; } = FormLayout.Vertical;
    [Parameter] public string? LabelColClass { get; set; }
    [Parameter] public string? WrapperColClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool EnableDataAnnotations { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnFinish { get; set; }
    [Parameter] public EventCallback<EditContext> OnFinishFailed { get; set; }

    private readonly FormContext _formContext = new();
    private EditContext? _effectiveEditContext;
    private object? _fallbackModel;

    protected override void OnParametersSet()
    {
        if (EditContext != null)
        {
            _effectiveEditContext = EditContext;
        }
        else if (Model != null && (_effectiveEditContext == null || _effectiveEditContext.Model != Model))
        {
            _effectiveEditContext = new EditContext(Model);
        }
        else if (Model == null && EditContext == null)
        {
            _fallbackModel ??= new object();
            _effectiveEditContext = new EditContext(_fallbackModel);
        }

        _formContext.EditContext = _effectiveEditContext;
        _formContext.Layout = Layout;
        if (!string.IsNullOrEmpty(LabelColClass)) _formContext.LabelColClass = LabelColClass;
        if (!string.IsNullOrEmpty(WrapperColClass)) _formContext.WrapperColClass = WrapperColClass;
        _formContext.Disabled = Disabled;
    }

    private async Task HandleValidSubmit(EditContext context)
    {
        if (OnValidSubmit.HasDelegate)
        {
            await OnValidSubmit.InvokeAsync(context);
        }
        if (OnFinish.HasDelegate)
        {
            await OnFinish.InvokeAsync(context);
        }
    }

    private async Task HandleInvalidSubmit(EditContext context)
    {
        if (OnInvalidSubmit.HasDelegate)
        {
            await OnInvalidSubmit.InvokeAsync(context);
        }
        if (OnFinishFailed.HasDelegate)
        {
            await OnFinishFailed.InvokeAsync(context);
        }
    }

    private string ComputeClass() => new CssBuilder("tento-form w-full")
        .AddClass("space-y-4", Layout == FormLayout.Vertical)
        .AddClass("grid grid-cols-12 gap-4", Layout == FormLayout.Horizontal)
        .AddClass("flex flex-wrap items-center gap-4", Layout == FormLayout.Inline)
        .AddClass(Class)
        .Build();
}
