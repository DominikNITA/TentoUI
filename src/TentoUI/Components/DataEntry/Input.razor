@namespace TentoUI
@inherits TentoInputBase<string>

<div class="@ComputeWrapperClass()" style="@Style">
    @if (Prefix != null)
    {
        <span class="tento-input-prefix mr-2 inline-flex items-center text-slate-400 select-none">
            @Prefix
        </span>
    }

    <input id="@ElementId"
           type="@EffectiveType"
           value="@CurrentValue"
           @oninput="@HandleInput"
           @onchange="@HandleChange"
           @onkeydown="@HandleKeyDown"
           @onfocus="@OnFocus"
           @onblur="@OnBlur"
           placeholder="@Placeholder"
           disabled="@IsDisabled"
           readonly="@ReadOnly"
           maxlength="@MaxLength"
           class="@ComputeInputClass()"
           aria-invalid="@(EffectiveStatus == ComponentStatus.Error ? "true" : "false")"
           aria-describedby="@(EffectiveStatus == ComponentStatus.Error ? $"{ElementId}-error" : null)"
           @attributes="AdditionalAttributes" />

    @if (AllowClear && !string.IsNullOrEmpty(CurrentValue) && !IsDisabled && !ReadOnly)
    {
        <button type="button"
                class="tento-input-clear-btn inline-flex items-center pr-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors focus:outline-none"
                aria-label="Clear input"
                @onclick="@ClearValue">
            <span class="text-base leading-none">&times;</span>
        </button>
    }

    @if (Type == InputType.Password && AllowShowPassword)
    {
        <button type="button"
                class="inline-flex items-center px-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 focus:outline-none"
                aria-label="Toggle password visibility"
                aria-pressed="@_showPassword"
                @onclick="@TogglePasswordVisibility">
            @if (_showPassword)
            {
                <Icon Name="IconNames.EyeOff" Size="16" />
            }
            else
            {
                <Icon Name="IconNames.Eye" Size="16" />
            }
        </button>
    }

    @if (Suffix != null)
    {
        <span class="tento-input-suffix ml-2 inline-flex items-center text-slate-400 select-none">
            @Suffix
        </span>
    }

    @if (ShowCount && MaxLength.HasValue)
    {
        <span class="inline-flex items-center pr-3 text-xs text-slate-400 select-none">
            @(CurrentValue?.Length ?? 0) / @MaxLength
        </span>
    }
</div>

@code {
    [Parameter] public InputType Type { get; set; } = InputType.Text;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool AllowShowPassword { get; set; } = true;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool ShowCount { get; set; }
    [Parameter] public RenderFragment? Prefix { get; set; }
    [Parameter] public RenderFragment? Suffix { get; set; }

    [Parameter] public EventCallback<KeyboardEventArgs> OnPressEnter { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnFocus { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    private bool _showPassword;

    private string EffectiveType => Type switch
    {
        InputType.Password => _showPassword ? "text" : "password",
        InputType.Email => "email",
        InputType.Number => "number",
        InputType.Tel => "tel",
        InputType.Url => "url",
        _ => "text"
    };

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task HandleInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private async Task ClearValue()
    {
        CurrentValueAsString = string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnPressEnter.HasDelegate)
        {
            await OnPressEnter.InvokeAsync(e);
        }
    }

    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

    private string ComputeWrapperClass()
    {
        var statusClass = EffectiveStatus == ComponentStatus.Error
            ? "border-red-500 focus:ring-red-500 focus-within:border-red-500 focus-within:ring-1 focus-within:ring-red-500"
            : (EffectiveStatus == ComponentStatus.Warning
                ? "border-amber-500 focus:ring-amber-500"
                : "border-slate-300 dark:border-slate-600 focus:ring-primary-500 focus-within:border-primary-500 focus-within:ring-1 focus-within:ring-primary-500");

        return new CssBuilder("tento-input-wrapper flex items-center w-full rounded-md border bg-white dark:bg-slate-900 shadow-sm transition-all")
            .AddClass(statusClass)
            .AddClass("opacity-60 bg-slate-100 dark:bg-slate-800 cursor-not-allowed", IsDisabled)
            .AddClass(Class)
            .Build();
    }

    private string ComputeInputClass()
    {
        var size = ResolvedSize(Size);
        return new CssBuilder("w-full bg-transparent text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none border-none")
            .AddClass("py-1 px-2 text-xs", size == ComponentSize.Small)
            .AddClass("py-1.5 px-3 text-sm", size == ComponentSize.Middle)
            .AddClass("py-2 px-4 text-base", size == ComponentSize.Large)
            .AddClass("cursor-not-allowed", IsDisabled)
            .Build();
    }
}
