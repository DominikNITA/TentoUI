@namespace TentoUI
@typeparam TValue
@using System.Globalization
@inherits TentoInputBase<TValue>

<div class="@ComputedWrapperClass" style="@Style">
    @if (Prefix != null)
    {
        <span class="tento-input-number-prefix pl-3 flex items-center text-slate-400 text-sm select-none">
            @Prefix
        </span>
    }

    <input id="@ElementId"
           type="number"
           step="@ResolvedStep"
           min="@ResolvedMin"
           max="@ResolvedMax"
           placeholder="@Placeholder"
           disabled="@IsDisabled"
           readonly="@ReadOnly"
           value="@BindConverter.FormatValue(CurrentValueAsString)"
           class="@ComputedInputClass"
           @onchange="HandleInputChange"
           @attributes="AdditionalAttributes" />

    @if (Controls && !ReadOnly)
    {
        <div class="tento-input-number-handlers flex flex-col border-l border-slate-300 dark:border-slate-600 shrink-0">
            <button type="button"
                    aria-label="Increase Value"
                    disabled="@IsDisabled"
                    class="tento-input-number-up px-2 py-0.5 text-[10px] leading-none text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-40"
                    @onclick="@(() => StepByAsync(1))">
                &#9650;
            </button>
            <button type="button"
                    aria-label="Decrease Value"
                    disabled="@IsDisabled"
                    class="tento-input-number-down px-2 py-0.5 text-[10px] leading-none border-t border-slate-300 dark:border-slate-600 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 disabled:opacity-40"
                    @onclick="@(() => StepByAsync(-1))">
                &#9660;
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public TValue? Step { get; set; }
    [Parameter] public TValue? Min { get; set; }
    [Parameter] public TValue? Max { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Controls { get; set; } = true;
    [Parameter] public RenderFragment? Prefix { get; set; }

    private string? ResolvedMin => Min != null ? Convert.ToString(Min, CultureInfo.InvariantCulture) : null;
    private string? ResolvedMax => Max != null ? Convert.ToString(Max, CultureInfo.InvariantCulture) : null;
    private string ResolvedStep => Step != null
        ? Convert.ToString(Step, CultureInfo.InvariantCulture)!
        : (typeof(TValue) == typeof(decimal) || typeof(TValue) == typeof(double) || typeof(TValue) == typeof(float) ? "any" : "1");

    protected override bool TryParseValueFromString(string? value, out TValue result, out string validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.InvariantCulture, out var parsed) && parsed is not null)
        {
            result = ClampIfNeeded(parsed);
            validationErrorMessage = string.Empty;
            return true;
        }

        result = default!;
        validationErrorMessage = $"The {DisplayName ?? FieldIdentifier.FieldName} field must be a number.";
        return false;
    }

    private void HandleInputChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private Task StepByAsync(int direction)
    {
        if (IsDisabled || ReadOnly) return Task.CompletedTask;

        decimal current = 0;
        if (CurrentValue != null && decimal.TryParse(Convert.ToString(CurrentValue, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed))
        {
            current = parsed;
        }

        decimal step = 1;
        if (Step != null && decimal.TryParse(Convert.ToString(Step, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var s))
        {
            step = s;
        }

        decimal next = current + (direction * step);

        if (Min != null && decimal.TryParse(Convert.ToString(Min, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var minVal) && next < minVal)
            next = minVal;

        if (Max != null && decimal.TryParse(Convert.ToString(Max, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var maxVal) && next > maxVal)
            next = maxVal;

        CurrentValueAsString = next.ToString(CultureInfo.InvariantCulture);
        return Task.CompletedTask;
    }

    private TValue ClampIfNeeded(TValue val)
    {
        if (Min == null && Max == null) return val;
        if (decimal.TryParse(Convert.ToString(val, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var num))
        {
            var clamped = num;
            if (Min != null && decimal.TryParse(Convert.ToString(Min, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var minVal) && clamped < minVal)
                clamped = minVal;
            if (Max != null && decimal.TryParse(Convert.ToString(Max, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out var maxVal) && clamped > maxVal)
                clamped = maxVal;

            if (clamped != num &&
                BindConverter.TryConvertTo<TValue>(clamped.ToString(CultureInfo.InvariantCulture), CultureInfo.InvariantCulture, out var converted) &&
                converted is not null)
            {
                return converted;
            }
        }
        return val;
    }

    private string ComputedWrapperClass => new CssBuilder("tento-input-number inline-flex items-stretch rounded-md border bg-white dark:bg-slate-900 overflow-hidden transition-colors focus-within:ring-2")
        .AddClass(GetStatusBorderClass())
        .AddClass("opacity-50 cursor-not-allowed bg-slate-50 dark:bg-slate-800", IsDisabled)
        .AddClass(Class)
        .Build();

    private string ComputedInputClass
    {
        get
        {
            var sizeClass = ResolvedSize(Size) switch
            {
                ComponentSize.Small => "px-2.5 py-1 text-xs",
                ComponentSize.Large => "px-4 py-2.5 text-base",
                _ => "px-3 py-1.5 text-sm"
            };
            return $"w-full bg-transparent text-slate-900 dark:text-slate-100 focus:outline-none {sizeClass}";
        }
    }
}
