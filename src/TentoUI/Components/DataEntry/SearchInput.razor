@namespace TentoUI
@inherits TentoComponentBase

<div class="tento-search-input relative w-full" style="@Style" @attributes="AdditionalAttributes">
    <Input Value="@Value"
           ValueChanged="@HandleValueChanged"
           ValueExpression="@ValueExpression"
           Placeholder="@Placeholder"
           AllowClear="@AllowClear"
           Size="@Size"
           Disabled="@Disabled"
           OnPressEnter="@(() => OnSearch.InvokeAsync(Value))">
        <Suffix>
            <button type="button"
                    class="text-slate-400 hover:text-primary-500 transition-colors p-1"
                    aria-label="Search"
                    @onclick="@(() => OnSearch.InvokeAsync(Value))">
                <Icon Name="@IconNames.Search" Size="16" />
            </button>
        </Suffix>
    </Input>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Search...";
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public ComponentSize? Size { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string?> OnSearch { get; set; }

    private async Task HandleValueChanged(string? val)
    {
        Value = val;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(val);
        }
    }
}
