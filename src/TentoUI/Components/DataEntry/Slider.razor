@namespace TentoUI
@using System.Globalization
@inherits TentoComponentBase

<div class="@ComputedWrapperClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="flex items-center gap-3 w-full">
        <input type="range"
               min="@Min.ToString(CultureInfo.InvariantCulture)"
               max="@Max.ToString(CultureInfo.InvariantCulture)"
               step="@Step.ToString(CultureInfo.InvariantCulture)"
               disabled="@Disabled"
               aria-label="@(AriaLabel ?? "Slider")"
               aria-valuemin="@Min"
               aria-valuemax="@Max"
               aria-valuenow="@Value"
               value="@Value.ToString(CultureInfo.InvariantCulture)"
               class="tento-slider-input w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-primary-500 disabled:opacity-40 disabled:cursor-not-allowed"
               @oninput="HandleChangeAsync"
               @onchange="HandleChangeAsync" />

        @if (ShowValue)
        {
            <span class="tento-slider-value text-xs font-medium text-slate-600 dark:text-slate-300 min-w-[2.5rem] text-right">
                @(TipFormatter != null ? TipFormatter(Value) : Value.ToString(CultureInfo.InvariantCulture))
            </span>
        }
    </div>

    @if (Marks != null && Marks.Count > 0)
    {
        <div class="tento-slider-marks flex justify-between text-[11px] text-slate-400 dark:text-slate-500 mt-1 px-0.5">
            @foreach (var mark in Marks.OrderBy(k => k.Key))
            {
                <span data-mark-value="@mark.Key">@mark.Value</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public EventCallback<double> OnChange { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public Func<double, string>? TipFormatter { get; set; }
    [Parameter] public IReadOnlyDictionary<double, string>? Marks { get; set; }

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed))
        {
            Value = Math.Clamp(parsed, Min, Max);
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(Value);
            }
            if (OnChange.HasDelegate)
            {
                await OnChange.InvokeAsync(Value);
            }
        }
    }

    private string ComputedWrapperClass => new CssBuilder("tento-slider w-full flex flex-col")
        .AddClass(Class)
        .Build();
}
