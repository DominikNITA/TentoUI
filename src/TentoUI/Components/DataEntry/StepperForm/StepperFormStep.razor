@namespace TentoUI
@implements IDisposable
@attribute [Since("1.0.3")]

@code {
    [CascadingParameter] protected IStepperFormContext? ParentForm { get; set; }

    /// <summary>
    /// Step header title text.
    /// </summary>
    [Parameter, Since("1.0.3")] public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Optional subtitle or brief explanation text.
    /// </summary>
    [Parameter, Since("1.0.3")] public string? SubTitle { get; set; }

    /// <summary>
    /// Optional descriptive help text.
    /// </summary>
    [Parameter, Since("1.0.3")] public string? Description { get; set; }

    /// <summary>
    /// Optional custom Lucide icon name.
    /// </summary>
    [Parameter, Since("1.0.3")] public string? Icon { get; set; }

    /// <summary>
    /// Whether direct navigation to this step is disabled.
    /// </summary>
    [Parameter, Since("1.0.3")] public bool Disabled { get; set; }

    /// <summary>
    /// Form fields or body content for this step.
    /// </summary>
    [Parameter, Since("1.0.3")] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        ParentForm?.RegisterStep(this);
    }

    public void Dispose()
    {
        ParentForm?.UnregisterStep(this);
    }
}
