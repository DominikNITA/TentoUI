@namespace TentoUI
@inherits TentoInputBase<bool>

<button type="button"
        id="@ElementId"
        role="switch"
        aria-checked="@(CurrentValue ? "true" : "false")"
        aria-label="@ComputeAriaLabel()"
        disabled="@(IsDisabled || Loading)"
        class="@ComputeSwitchClass()"
        style="@Style"
        @onclick="@Toggle"
        @attributes="AdditionalAttributes">
    
    <span class="@ComputeThumbClass()">
        @if (Loading)
        {
            <span class="animate-spin inline-flex items-center justify-center">
                <svg class="w-2.5 h-2.5 text-primary-500" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
            </span>
        }
    </span>

    @if (HasChildren)
    {
        <span class="@ComputeChildrenClass()">
            @if (CurrentValue)
            {
                @CheckedChildren
            }
            else
            {
                @UnCheckedChildren
            }
        </span>
    }
</button>

@code {
    [Parameter]
    public bool Checked
    {
        get => CurrentValue;
        set => CurrentValue = value;
    }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public RenderFragment? CheckedChildren { get; set; }
    [Parameter] public RenderFragment? UnCheckedChildren { get; set; }

    private bool HasChildren => CheckedChildren != null || UnCheckedChildren != null;

    private string? ComputeAriaLabel()
    {
        if (!string.IsNullOrEmpty(AriaLabel)) return AriaLabel;
        if (AdditionalAttributes != null && (AdditionalAttributes.ContainsKey("aria-label") || AdditionalAttributes.ContainsKey("aria-labelledby")))
            return null;
        if (!string.IsNullOrEmpty(DisplayName)) return DisplayName;
        if (FormItemContext != null && !string.IsNullOrEmpty(FormItemContext.Label)) return FormItemContext.Label;
        return "Toggle switch";
    }

    private async Task Toggle()
    {
        if (IsDisabled || Loading) return;
        CurrentValue = !CurrentValue;
        if (CheckedChanged.HasDelegate)
        {
            await CheckedChanged.InvokeAsync(CurrentValue);
        }
    }

    protected override bool TryParseValueFromString(string? value, out bool result, out string validationErrorMessage)
    {
        result = bool.TryParse(value, out var b) && b;
        validationErrorMessage = string.Empty;
        return true;
    }

    private string ComputeSwitchClass()
    {
        var size = ResolvedSize(Size);

        var sizeClass = size switch
        {
            ComponentSize.Small => HasChildren ? "h-4 w-11" : "h-4 w-7",
            ComponentSize.Large => HasChildren ? "h-7 w-16" : "h-7 w-14",
            _ => HasChildren ? "h-6 w-14" : "h-6 w-11"
        };

        return new CssBuilder("tento-switch relative inline-flex items-center rounded-full transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500/50 select-none")
            .AddClass(sizeClass)
            .AddClass("bg-primary-500", CurrentValue)
            .AddClass("bg-slate-300 dark:bg-slate-700", !CurrentValue)
            .AddClass("opacity-50 cursor-not-allowed", IsDisabled || Loading)
            .AddClass("cursor-pointer", !IsDisabled && !Loading)
            .AddClass(Class)
            .Build();
    }

    private string ComputeThumbClass()
    {
        var size = ResolvedSize(Size);

        var (dimensions, offset) = size switch
        {
            ComponentSize.Small => ("h-3 w-3", CurrentValue ? (HasChildren ? "translate-x-7" : "translate-x-3") : "translate-x-0"),
            ComponentSize.Large => ("h-6 w-6", CurrentValue ? (HasChildren ? "translate-x-9" : "translate-x-7") : "translate-x-0"),
            _ => ("h-5 w-5", CurrentValue ? (HasChildren ? "translate-x-8" : "translate-x-5") : "translate-x-0")
        };

        return new CssBuilder("pointer-events-none absolute left-0.5 top-0.5 transform rounded-full bg-white shadow-md transition-transform flex items-center justify-center")
            .AddClass(dimensions)
            .AddClass(offset)
            .Build();
    }

    private string ComputeChildrenClass()
    {
        var size = ResolvedSize(Size);

        var (padding, textSize) = size switch
        {
            ComponentSize.Small => (CurrentValue ? "pr-4 pl-1.5" : "pl-4 pr-1.5", "text-[10px]"),
            ComponentSize.Large => (CurrentValue ? "pr-8 pl-2.5" : "pl-8 pr-2.5", "text-sm"),
            _ => (CurrentValue ? "pr-7 pl-2" : "pl-7 pr-2", "text-xs")
        };

        return new CssBuilder("w-full flex items-center justify-center font-medium text-white transition-all")
            .AddClass(padding)
            .AddClass(textSize)
            .Build();
    }
}
