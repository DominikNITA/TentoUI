@namespace TentoUI
@inherits TentoComponentBase
@attribute [Since("1.1.0")]

<div class="tento-timerangepicker relative inline-flex items-center w-full"
     @onkeydown="HandleKeyDownAsync"
     style="@Style"
     @attributes="AdditionalAttributes">
    <div role="group"
         aria-label="Time range selector"
         aria-expanded="@(_isOpen ? "true" : "false")"
         class="@ComputeWrapperClass()"
         @onclick="ToggleOpen">
        <span class="text-slate-400 mr-2 inline-flex items-center shrink-0">
            <Icon Name="@IconNames.Clock" Size="15" />
        </span>

        <input type="text"
               value="@FormattedStart"
               placeholder="@PlaceholderStart"
               disabled="@Disabled"
               readonly="true"
               aria-label="Start time"
               class="w-full bg-transparent text-xs sm:text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none cursor-pointer" />

        <span class="mx-2 text-slate-400 text-xs select-none" aria-hidden="true">→</span>

        <input type="text"
               value="@FormattedEnd"
               placeholder="@PlaceholderEnd"
               disabled="@Disabled"
               readonly="true"
               aria-label="End time"
               class="w-full bg-transparent text-xs sm:text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none cursor-pointer" />

        @if (AllowClear && (StartTime.HasValue || EndTime.HasValue) && !Disabled)
        {
            <button type="button"
                    aria-label="Clear time range"
                    class="ml-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 shrink-0"
                    @onclick:stopPropagation="true"
                    @onclick="ClearRangeAsync">
                <Icon Name="@IconNames.X" Size="14" />
            </button>
        }
    </div>

    @if (_isOpen && !Disabled)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
        <div role="dialog"
             aria-modal="true"
             aria-label="Time Range Selector"
             class="tento-timerangepicker-popup absolute left-0 top-full mt-1 z-50 p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl w-80">
            <div class="grid grid-cols-2 gap-3 divide-x divide-slate-100 dark:divide-slate-800">
                @* Start Time Column *@
                <div class="space-y-1.5">
                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1">Start Time</div>
                    <div class="max-h-44 overflow-y-auto space-y-0.5 pr-1">
                        @foreach (var slot in TimeSlots)
                        {
                            var isSelected = StartTime.HasValue && StartTime.Value.Hour == slot.Hour && StartTime.Value.Minute == slot.Minute;
                            <button type="button"
                                    data-start-time="@slot.ToString("HH:mm")"
                                    class="@ComputeSlotClass(isSelected)"
                                    @onclick="@(() => SelectStartTimeAsync(slot))">
                                @slot.ToString(Format)
                            </button>
                        }
                    </div>
                </div>

                @* End Time Column *@
                <div class="space-y-1.5 pl-3">
                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1">End Time</div>
                    <div class="max-h-44 overflow-y-auto space-y-0.5 pr-1">
                        @foreach (var slot in TimeSlots)
                        {
                            var isSelected = EndTime.HasValue && EndTime.Value.Hour == slot.Hour && EndTime.Value.Minute == slot.Minute;
                            <button type="button"
                                    data-end-time="@slot.ToString("HH:mm")"
                                    class="@ComputeSlotClass(isSelected)"
                                    @onclick="@(() => SelectEndTimeAsync(slot))">
                                @slot.ToString(Format)
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-3 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <button type="button"
                        class="text-xs text-primary-500 hover:underline font-medium"
                        @onclick="SelectBusinessHoursAsync">
                    Business Hours (09:00 - 17:00)
                </button>
                <Button Size="ComponentSize.Small" Type="ButtonType.Primary" OnClick="Close">
                    Done
                </Button>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Selected start time.
    /// </summary>
    [Parameter] public TimeOnly? StartTime { get; set; }

    /// <summary>
    /// Callback invoked when <see cref="StartTime"/> changes.
    /// </summary>
    [Parameter] public EventCallback<TimeOnly?> StartTimeChanged { get; set; }

    /// <summary>
    /// Selected end time.
    /// </summary>
    [Parameter] public TimeOnly? EndTime { get; set; }

    /// <summary>
    /// Callback invoked when <see cref="EndTime"/> changes.
    /// </summary>
    [Parameter] public EventCallback<TimeOnly?> EndTimeChanged { get; set; }

    /// <summary>
    /// Callback invoked with the updated <see cref="TimeRange"/>.
    /// </summary>
    [Parameter] public EventCallback<TimeRange> OnRangeChange { get; set; }

    /// <summary>
    /// Time format string (defaults to "HH:mm").
    /// </summary>
    [Parameter] public string Format { get; set; } = "HH:mm";

    /// <summary>
    /// Minute interval between selectable time slots (defaults to 30).
    /// </summary>
    [Parameter] public int MinuteStep { get; set; } = 30;

    /// <summary>
    /// Placeholder for start time input.
    /// </summary>
    [Parameter] public string PlaceholderStart { get; set; } = "Start time";

    /// <summary>
    /// Placeholder for end time input.
    /// </summary>
    [Parameter] public string PlaceholderEnd { get; set; } = "End time";

    /// <summary>
    /// Shows a clear button when a time range is selected.
    /// </summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>
    /// Disables user interaction when true.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    private bool _isOpen;

    private string FormattedStart => StartTime.HasValue ? StartTime.Value.ToString(Format) : string.Empty;
    private string FormattedEnd => EndTime.HasValue ? EndTime.Value.ToString(Format) : string.Empty;

    private IEnumerable<TimeOnly> TimeSlots
    {
        get
        {
            var step = Math.Clamp(MinuteStep, 5, 60);
            for (var mins = 0; mins < 24 * 60; mins += step)
            {
                yield return new TimeOnly(mins / 60, mins % 60);
            }
        }
    }

    private void ToggleOpen()
    {
        if (!Disabled) _isOpen = !_isOpen;
    }

    private void Close() => _isOpen = false;

    private async Task SelectStartTimeAsync(TimeOnly slot)
    {
        StartTime = slot;
        await NotifyRangeAsync();
    }

    private async Task SelectEndTimeAsync(TimeOnly slot)
    {
        EndTime = slot;
        await NotifyRangeAsync();
    }

    private async Task SelectBusinessHoursAsync()
    {
        StartTime = new TimeOnly(9, 0);
        EndTime = new TimeOnly(17, 0);
        _isOpen = false;
        await NotifyRangeAsync();
    }

    private async Task ClearRangeAsync()
    {
        StartTime = null;
        EndTime = null;
        await NotifyRangeAsync();
    }

    private async Task NotifyRangeAsync()
    {
        if (StartTimeChanged.HasDelegate) await StartTimeChanged.InvokeAsync(StartTime);
        if (EndTimeChanged.HasDelegate) await EndTimeChanged.InvokeAsync(EndTime);
        if (OnRangeChange.HasDelegate) await OnRangeChange.InvokeAsync(new TimeRange(StartTime, EndTime));
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _isOpen = false;
        return Task.CompletedTask;
    }

    private string ComputeWrapperClass() => new CssBuilder("flex items-center w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-1.5 shadow-sm min-h-[38px] cursor-pointer transition-all hover:border-primary-500")
        .AddClass("opacity-60 bg-slate-100 dark:bg-slate-800 cursor-not-allowed", Disabled)
        .AddClass(Class)
        .Build();

    private static string ComputeSlotClass(bool isSelected) => new CssBuilder("w-full text-left px-2.5 py-1 rounded text-xs font-mono transition-colors")
        .AddClass("bg-primary-500 text-white font-bold", isSelected)
        .AddClass("text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800", !isSelected)
        .Build();
}
