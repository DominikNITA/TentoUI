@namespace TentoUI
@inherits TentoComponentBase

@if (Open)
{
    <div class="tento-drawer-root fixed inset-0 z-50 overflow-hidden"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@($"drawer-title-{_drawerId}")"
         @attributes="AdditionalAttributes">
        
        @if (Mask)
        {
            <div class="tento-drawer-mask fixed inset-0 bg-slate-900/50 backdrop-blur-[1px] tento-animate-fade-in"
                 @onclick="HandleMaskClickAsync"></div>
        }

        <div class="@ComputedPanelClass" style="@ComputedPanelStyle">
            @if (Closable || !string.IsNullOrEmpty(Title) || Extra != null)
            {
                <div class="tento-drawer-header px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-3">
                        @if (Closable)
                        {
                            <button type="button"
                                    aria-label="Close drawer"
                                    class="tento-drawer-close p-1 rounded-md text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                    @onclick="CloseAsync">
                                <Icon Name="@IconNames.X" Size="18" />
                            </button>
                        }
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <h3 id="@($"drawer-title-{_drawerId}")" class="tento-drawer-title text-base font-semibold text-slate-900 dark:text-white">
                                @Title
                            </h3>
                        }
                    </div>

                    @if (Extra != null)
                    {
                        <div class="tento-drawer-extra">@Extra</div>
                    }
                </div>
            }

            <div class="tento-drawer-body flex-1 overflow-y-auto p-6 text-sm text-slate-700 dark:text-slate-300">
                @ChildContent
            </div>

            @if (Footer != null)
            {
                <div class="tento-drawer-footer px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 shrink-0">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public DrawerPlacement Placement { get; set; } = DrawerPlacement.Right;
    [Parameter] public string Width { get; set; } = "378px";
    [Parameter] public string Height { get; set; } = "320px";
    [Parameter] public bool Closable { get; set; } = true;
    [Parameter] public bool Mask { get; set; } = true;
    [Parameter] public bool MaskClosable { get; set; } = true;
    [Parameter] public RenderFragment? Extra { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _drawerId = Guid.NewGuid().ToString("N");

    private async Task HandleMaskClickAsync()
    {
        if (MaskClosable)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        Open = false;
        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(false);
        }
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private string ComputedPanelClass
    {
        get
        {
            var posClass = Placement switch
            {
                DrawerPlacement.Left => "inset-y-0 left-0 h-full border-r tento-animate-slide-right",
                DrawerPlacement.Top => "inset-x-0 top-0 w-full border-b tento-animate-slide-down",
                DrawerPlacement.Bottom => "inset-x-0 bottom-0 w-full border-t tento-animate-slide-up",
                _ => "inset-y-0 right-0 h-full border-l tento-animate-slide-left"
            };

            return new CssBuilder($"tento-drawer-content fixed z-10 flex flex-col bg-white dark:bg-slate-900 shadow-2xl border-slate-200 dark:border-slate-800 {posClass}")
                .AddClass(Class)
                .Build();
        }
    }

    private string ComputedPanelStyle
    {
        get
        {
            var isHorizontal = Placement is DrawerPlacement.Left or DrawerPlacement.Right;
            return new StyleBuilder()
                .AddStyle("width", Width, isHorizontal)
                .AddStyle("max-width", "100vw", isHorizontal)
                .AddStyle("height", Height, !isHorizontal)
                .AddStyle("max-height", "100vh", !isHorizontal)
                .AddStyle(Style)
                .Build();
        }
    }
}
