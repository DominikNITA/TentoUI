@namespace TentoUI
@inject IModalService ModalService
@implements IDisposable

@foreach (var modal in ModalService.ActiveModals)
{
    var currentModal = modal;
    <Modal Visible="true"
           Title="@currentModal.Options.Title"
           Width="@currentModal.Options.Width"
           MaskClosable="@currentModal.Options.MaskClosable"
           OkText="@currentModal.Options.OkText"
           CancelText="@currentModal.Options.CancelText"
           OkType="@currentModal.Options.OkType"
           Danger="@currentModal.Options.OkDanger"
           OnOk="@(() => ModalService.ResolveModal(currentModal.Id, true))"
           OnCancel="@(() => ModalService.ResolveModal(currentModal.Id, false))">

        <div class="flex items-start gap-4">
            <div class="mt-0.5">
                @switch (currentModal.Options.Type)
                {
                    case ModalType.Success:
                        <Icon Name="@IconNames.CheckCircle" Class="text-emerald-500" Size="22" />
                        break;
                    case ModalType.Warning:
                        <Icon Name="@IconNames.AlertTriangle" Class="text-amber-500" Size="22" />
                        break;
                    case ModalType.Error:
                        <Icon Name="@IconNames.XCircle" Class="text-rose-500" Size="22" />
                        break;
                    case ModalType.Info:
                        <Icon Name="@IconNames.Info" Class="text-sky-500" Size="22" />
                        break;
                    default:
                        <Icon Name="@IconNames.HelpCircle" Class="text-primary-500" Size="22" />
                        break;
                }
            </div>
            <div class="flex-1">
                @if (currentModal.Options.ContentTemplate != null)
                {
                    @currentModal.Options.ContentTemplate
                }
                else
                {
                    <p class="text-sm text-slate-600 dark:text-slate-300">@currentModal.Options.Content</p>
                }
            </div>
        </div>
    </Modal>
}

@code {
    protected override void OnInitialized()
    {
        ModalService.OnModalChanged += HandleModalChanged;
    }

    private void HandleModalChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ModalService.OnModalChanged -= HandleModalChanged;
    }
}
