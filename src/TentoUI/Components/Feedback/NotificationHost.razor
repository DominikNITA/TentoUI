@namespace TentoUI
@inject INotificationService NotificationService
@implements IDisposable

@foreach (var placement in _placements)
{
    var group = NotificationService.Notifications.Where(n => n.Placement == placement).ToList();
    if (group.Count > 0)
    {
        <div class="@ComputeContainerClass(placement)"
             role="region"
             aria-label="@($"System notifications {placement}")"
             aria-live="polite">
            @foreach (var n in group)
            {
                <div class="pointer-events-auto w-80 sm:w-96 shadow-lg rounded-lg p-4 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 transition-all duration-300 animate-in fade-in"
                     id="@($"tento-notification-{n.Key}")">
                    <div class="flex items-start gap-3">
                        @if (n.Icon != null)
                        {
                            <div class="shrink-0 mt-0.5">@n.Icon</div>
                        }
                        else
                        {
                            @switch (n.Type)
                            {
                                case NotificationType.Success:
                                    <Icon Name="@IconNames.CheckCircle" Class="text-emerald-500 shrink-0 mt-0.5" Size="20" />
                                    break;
                                case NotificationType.Warning:
                                    <Icon Name="@IconNames.AlertTriangle" Class="text-amber-500 shrink-0 mt-0.5" Size="20" />
                                    break;
                                case NotificationType.Error:
                                    <Icon Name="@IconNames.XCircle" Class="text-rose-500 shrink-0 mt-0.5" Size="20" />
                                    break;
                                case NotificationType.Info:
                                    <Icon Name="@IconNames.Info" Class="text-primary-500 shrink-0 mt-0.5" Size="20" />
                                    break;
                            }
                        }

                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <h4 class="text-sm font-semibold text-slate-900 dark:text-white leading-tight">
                                    @if (n.TitleTemplate != null)
                                    {
                                        @n.TitleTemplate
                                    }
                                    else
                                    {
                                        <span>@n.Title</span>
                                    }
                                </h4>
                                <button type="button"
                                        aria-label="Close notification"
                                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 rounded transition-colors"
                                        @onclick="n.Close">
                                    <Icon Name="@IconNames.X" Size="14" />
                                </button>
                            </div>

                            @if (n.DescriptionTemplate != null || !string.IsNullOrEmpty(n.Description))
                            {
                                <div class="mt-1 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                                    @if (n.DescriptionTemplate != null)
                                    {
                                        @n.DescriptionTemplate
                                    }
                                    else
                                    {
                                        <span>@n.Description</span>
                                    }
                                </div>
                            }

                            @if (n.Btn != null)
                            {
                                <div class="mt-3 flex justify-end">
                                    @n.Btn
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private static readonly NotificationPlacement[] _placements =
    [
        NotificationPlacement.TopRight,
        NotificationPlacement.TopLeft,
        NotificationPlacement.BottomRight,
        NotificationPlacement.BottomLeft
    ];

    protected override void OnInitialized()
    {
        NotificationService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NotificationService.OnChange -= HandleChange;
    }

    private static string ComputeContainerClass(NotificationPlacement placement) => placement switch
    {
        NotificationPlacement.TopLeft => "fixed top-4 left-4 z-[2100] flex flex-col gap-2.5 pointer-events-none",
        NotificationPlacement.BottomRight => "fixed bottom-4 right-4 z-[2100] flex flex-col-reverse gap-2.5 pointer-events-none",
        NotificationPlacement.BottomLeft => "fixed bottom-4 left-4 z-[2100] flex flex-col-reverse gap-2.5 pointer-events-none",
        _ => "fixed top-4 right-4 z-[2100] flex flex-col gap-2.5 pointer-events-none"
    };
}
