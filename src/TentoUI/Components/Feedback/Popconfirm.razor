@namespace TentoUI
@inherits TentoComponentBase

<div class="@ComputedWrapperClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="tento-popconfirm-trigger inline-block"
         @onclick="ToggleOpenAsync">
        @ChildContent
    </div>

    @if (IsOpen && !Disabled)
    {
        <div role="alertdialog"
             aria-label="@Title"
             class="tento-popconfirm-overlay absolute bottom-full left-1/2 -translate-x-1/2 mb-2 z-50 w-64 p-3 rounded-lg shadow-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-left">
            <div class="flex items-start gap-2">
                <Icon Name="@Icon" Size="16" Class="text-amber-500 shrink-0 mt-0.5" />
                <div class="flex-1 min-w-0">
                    <p class="tento-popconfirm-title text-xs font-semibold text-slate-900 dark:text-white">@Title</p>
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <p class="tento-popconfirm-description mt-1 text-xs text-slate-500 dark:text-slate-400">@Description</p>
                    }
                </div>
            </div>

            <div class="mt-3 flex items-center justify-end gap-2">
                <button type="button"
                        class="tento-popconfirm-cancel px-2.5 py-1 text-xs rounded border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        @onclick="HandleCancelAsync">
                    @CancelText
                </button>
                <button type="button"
                        class="tento-popconfirm-ok px-2.5 py-1 text-xs rounded bg-primary-500 text-white hover:bg-primary-600 font-medium"
                        @onclick="HandleConfirmAsync">
                    @OkText
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Are you sure?";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string OkText { get; set; } = "Yes";
    [Parameter] public string CancelText { get; set; } = "No";
    [Parameter] public string Icon { get; set; } = IconNames.AlertCircle;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _internalOpen;
    private bool IsOpen => OpenChanged.HasDelegate ? Open : (_internalOpen || Open);

    private async Task SetOpenAsync(bool value)
    {
        if (Disabled) return;
        _internalOpen = value;
        Open = value;
        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(value);
        }
    }

    private async Task ToggleOpenAsync()
    {
        if (Disabled) return;
        await SetOpenAsync(!IsOpen);
    }

    private async Task HandleConfirmAsync()
    {
        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }
        await SetOpenAsync(false);
    }

    private async Task HandleCancelAsync()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
        await SetOpenAsync(false);
    }

    private string ComputedWrapperClass => new CssBuilder("tento-popconfirm relative inline-block")
        .AddClass(Class)
        .Build();
}
