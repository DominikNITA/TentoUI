@namespace TentoUI
@using System.Globalization
@inherits TentoComponentBase

<div role="progressbar"
     aria-label="@(AriaLabel ?? (AdditionalAttributes != null && AdditionalAttributes.ContainsKey("aria-label") ? null : "Progress"))"
     aria-valuemin="0"
     aria-valuemax="100"
     aria-valuenow="@ClampedPercent"
     data-progress-status="@EffectiveStatus.ToString().ToLowerInvariant()"
     class="@ComputedWrapperClass"
     style="@Style"
     @attributes="AdditionalAttributes">
    
    @if (Type == ProgressType.Circle)
    {
        <div class="tento-progress-circle relative inline-flex items-center justify-center" style="@($"width: {CircleSize}px; height: {CircleSize}px;")">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                <circle class="text-slate-200 dark:text-slate-700"
                        stroke-width="8"
                        stroke="currentColor"
                        fill="transparent"
                        r="42"
                        cx="50"
                        cy="50" />
                <circle class="@ComputeStrokeColorClass()"
                        stroke-width="8"
                        stroke-dasharray="@CircleCircumference.ToString(CultureInfo.InvariantCulture)"
                        stroke-dashoffset="@CircleDashOffset.ToString(CultureInfo.InvariantCulture)"
                        stroke-linecap="round"
                        stroke="currentColor"
                        fill="transparent"
                        r="42"
                        cx="50"
                        cy="50" />
            </svg>
            @if (ShowInfo)
            {
                <span class="tento-progress-text absolute text-xs font-semibold text-slate-700 dark:text-slate-200">
                    @FormatDisplayText()
                </span>
            }
        </div>
    }
    else
    {
        <div class="flex items-center gap-3 w-full">
            <div class="@ComputeTrackClass()">
                <div class="@ComputeBarClass()"
                     style="@($"width: {ClampedPercent}%; {(StrokeColor != null ? $"background-color: {StrokeColor};" : "")}")">
                </div>
            </div>
            @if (ShowInfo)
            {
                <span class="tento-progress-text text-xs font-medium text-slate-600 dark:text-slate-300 shrink-0">
                    @FormatDisplayText()
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Percent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public ProgressType Type { get; set; } = ProgressType.Line;
    [Parameter] public ProgressStatus? Status { get; set; }
    [Parameter] public bool ShowInfo { get; set; } = true;
    [Parameter] public string? StrokeColor { get; set; }
    [Parameter] public int CircleSize { get; set; } = 96;
    [Parameter] public ComponentSize? Size { get; set; }
    [Parameter] public Func<int, string>? Format { get; set; }

    private int ClampedPercent => Math.Clamp(Percent, 0, 100);
    private const double CircleCircumference = 2 * Math.PI * 42;
    private double CircleDashOffset => CircleCircumference - (ClampedPercent / 100.0) * CircleCircumference;

    private ProgressStatus EffectiveStatus
    {
        get
        {
            if (Status.HasValue) return Status.Value;
            return ClampedPercent >= 100 ? ProgressStatus.Success : ProgressStatus.Normal;
        }
    }

    private string FormatDisplayText()
    {
        if (Format != null) return Format(ClampedPercent);
        return $"{ClampedPercent}%";
    }

    private string ComputedWrapperClass => new CssBuilder("tento-progress")
        .AddClass("w-full", Type == ProgressType.Line)
        .AddClass("inline-flex", Type == ProgressType.Circle)
        .AddClass(Class)
        .Build();

    private string ComputeTrackClass()
    {
        var height = ResolvedSize(Size) == ComponentSize.Small ? "h-1.5" : "h-2.5";
        return $"tento-progress-track flex-1 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden {height}";
    }

    private string ComputeBarClass()
    {
        var color = EffectiveStatus switch
        {
            ProgressStatus.Success => "bg-emerald-500",
            ProgressStatus.Exception => "bg-red-500",
            _ => "bg-primary-500"
        };
        var pulse = EffectiveStatus == ProgressStatus.Active ? "animate-pulse" : "";
        return $"tento-progress-bar h-full rounded-full transition-all duration-300 {color} {pulse}";
    }

    private string ComputeStrokeColorClass() => EffectiveStatus switch
    {
        ProgressStatus.Success => "text-emerald-500",
        ProgressStatus.Exception => "text-red-500",
        _ => "text-primary-500"
    };
}
