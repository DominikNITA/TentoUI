@namespace TentoUI
@inherits TentoComponentBase

<div class="relative inline-block"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @onfocusin="HandleFocusIn"
     @onfocusout="HandleFocusOut"
     @onclick="HandleClick"
     aria-describedby="@(IsOpen ? _tooltipId : null)"
     @attributes="AdditionalAttributes">

    @ChildContent

    @if (IsOpen && (!string.IsNullOrEmpty(Title) || TitleTemplate != null))
    {
        <div id="@_tooltipId"
             role="tooltip"
             class="@BubbleComputedClass"
             style="@BubbleStyle">
            @if (TitleTemplate != null)
            {
                @TitleTemplate
            }
            else
            {
                <span>@Title</span>
            }

            @if (Arrow)
            {
                <span class="@ArrowComputedClass" style="@ArrowStyle"></span>
            }
        </div>
    }
</div>

@code {
    private readonly string _tooltipId = $"tento-tooltip-{Guid.NewGuid():N}";
    private bool _internalVisible;

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleTemplate { get; set; }
    [Parameter] public TooltipPlacement Placement { get; set; } = TooltipPlacement.Top;
    [Parameter] public TooltipTrigger Trigger { get; set; } = TooltipTrigger.Hover;
    [Parameter] public bool Arrow { get; set; } = true;
    [Parameter] public string? Color { get; set; }
    [Parameter] public bool? Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsOpen => Visible ?? _internalVisible;

    private string BubbleComputedClass => new CssBuilder("absolute z-50 whitespace-nowrap px-2.5 py-1 text-xs font-medium text-white rounded shadow-md pointer-events-none transition-all duration-150")
        .AddClass("bg-slate-900 dark:bg-slate-800", string.IsNullOrEmpty(Color))
        .AddClass("bottom-full left-1/2 -translate-x-1/2 mb-2", Placement == TooltipPlacement.Top)
        .AddClass("top-full left-1/2 -translate-x-1/2 mt-2", Placement == TooltipPlacement.Bottom)
        .AddClass("right-full top-1/2 -translate-y-1/2 mr-2", Placement == TooltipPlacement.Left)
        .AddClass("left-full top-1/2 -translate-y-1/2 ml-2", Placement == TooltipPlacement.Right)
        .AddClass("bottom-full left-0 mb-2", Placement == TooltipPlacement.TopLeft)
        .AddClass("bottom-full right-0 mb-2", Placement == TooltipPlacement.TopRight)
        .AddClass("top-full left-0 mt-2", Placement == TooltipPlacement.BottomLeft)
        .AddClass("top-full right-0 mt-2", Placement == TooltipPlacement.BottomRight)
        .AddClass(Class)
        .Build();

    private string ArrowComputedClass => new CssBuilder("absolute w-2 h-2 rotate-45")
        .AddClass("bg-slate-900 dark:bg-slate-800", string.IsNullOrEmpty(Color))
        .AddClass("top-full left-1/2 -translate-x-1/2 -mt-1", Placement == TooltipPlacement.Top || Placement == TooltipPlacement.TopLeft || Placement == TooltipPlacement.TopRight)
        .AddClass("bottom-full left-1/2 -translate-x-1/2 -mb-1", Placement == TooltipPlacement.Bottom || Placement == TooltipPlacement.BottomLeft || Placement == TooltipPlacement.BottomRight)
        .AddClass("left-full top-1/2 -translate-y-1/2 -ml-1", Placement == TooltipPlacement.Left)
        .AddClass("right-full top-1/2 -translate-y-1/2 -mr-1", Placement == TooltipPlacement.Right)
        .Build();

    private string BubbleStyle => new StyleBuilder()
        .AddStyle("background-color", Color, !string.IsNullOrEmpty(Color))
        .AddStyle(Style)
        .Build();

    private string ArrowStyle => new StyleBuilder()
        .AddStyle("background-color", Color, !string.IsNullOrEmpty(Color))
        .Build();

    private async Task SetVisibility(bool visible)
    {
        _internalVisible = visible;
        if (VisibleChanged.HasDelegate)
        {
            await VisibleChanged.InvokeAsync(visible);
        }
    }

    private async Task HandleMouseEnter() { if (Trigger == TooltipTrigger.Hover) await SetVisibility(true); }
    private async Task HandleMouseLeave() { if (Trigger == TooltipTrigger.Hover) await SetVisibility(false); }
    private async Task HandleFocusIn() { if (Trigger == TooltipTrigger.Focus || Trigger == TooltipTrigger.Hover) await SetVisibility(true); }
    private async Task HandleFocusOut() { if (Trigger == TooltipTrigger.Focus || Trigger == TooltipTrigger.Hover) await SetVisibility(false); }
    private async Task HandleClick() { if (Trigger == TooltipTrigger.Click) await SetVisibility(!IsOpen); }
}
