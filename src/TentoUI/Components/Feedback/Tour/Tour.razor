@namespace TentoUI
@inherits TentoComponentBase

<CascadingValue Value="@this" IsFixed="true">
    <div class="hidden">
        @ChildContent
    </div>
</CascadingValue>

@if (Open && _steps.Count > 0)
{
    var currentStep = _steps[EffectiveCurrent];
    var isLast = EffectiveCurrent == _steps.Count - 1;

    <div class="tento-tour-root fixed inset-0 z-50 flex items-center justify-center p-4"
         role="dialog"
         aria-modal="true"
         aria-label="@currentStep.Title">
        
        @if (Mask)
        {
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-[1px] transition-opacity"
                 @onclick="CloseAsync"></div>
        }

        <div class="relative z-10 w-80 sm:w-96 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xl p-5 text-slate-800 dark:text-slate-100 animate-in fade-in zoom-in-95">
            <div class="flex items-start justify-between gap-2 mb-2">
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">
                    @currentStep.Title
                </h4>
                <button type="button"
                        aria-label="Close tour"
                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 rounded"
                        @onclick="CloseAsync">
                    <Icon Name="@IconNames.X" Size="14" />
                </button>
            </div>

            @if (!string.IsNullOrEmpty(currentStep.Description))
            {
                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
                    @currentStep.Description
                </p>
            }

            <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-700 text-xs">
                <span class="text-slate-400 font-medium">
                    @(EffectiveCurrent + 1) / @_steps.Count
                </span>

                <div class="flex items-center gap-2">
                    @if (EffectiveCurrent > 0)
                    {
                        <button type="button"
                                class="px-2.5 py-1 rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200"
                                @onclick="PrevAsync">
                            Previous
                        </button>
                    }

                    <button type="button"
                            class="px-3 py-1 rounded bg-primary-500 hover:bg-primary-600 text-white font-medium"
                            @onclick="NextOrFinishAsync">
                        @(isLast ? "Finish" : "Next")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public int Current { get; set; }
    [Parameter] public EventCallback<int> CurrentChanged { get; set; }
    [Parameter] public bool Mask { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly System.Collections.Generic.List<TourStep> _steps = new();
    private int EffectiveCurrent => Math.Clamp(Current, 0, Math.Max(0, _steps.Count - 1));

    internal void RegisterStep(TourStep step)
    {
        if (!_steps.Contains(step))
        {
            _steps.Add(step);
            StateHasChanged();
        }
    }

    internal void UnregisterStep(TourStep step)
    {
        if (_steps.Remove(step))
        {
            StateHasChanged();
        }
    }

    private async Task CloseAsync()
    {
        Open = false;
        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(false);
        }
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task PrevAsync()
    {
        if (EffectiveCurrent > 0)
        {
            Current = EffectiveCurrent - 1;
            if (CurrentChanged.HasDelegate)
            {
                await CurrentChanged.InvokeAsync(Current);
            }
        }
    }

    private async Task NextOrFinishAsync()
    {
        if (EffectiveCurrent < _steps.Count - 1)
        {
            Current = EffectiveCurrent + 1;
            if (CurrentChanged.HasDelegate)
            {
                await CurrentChanged.InvokeAsync(Current);
            }
        }
        else
        {
            await CloseAsync();
            if (OnFinish.HasDelegate)
            {
                await OnFinish.InvokeAsync();
            }
        }
    }
}
