@namespace TentoUI
@inherits TentoComponentBase

@if (Type == DividerType.Vertical)
{
    <div class="@ComputedVerticalClass" role="separator" style="@Style" @attributes="AdditionalAttributes"></div>
}
else if (ChildContent != null || !string.IsNullOrEmpty(Title))
{
    <div class="@ComputedHorizontalWithTitleClass" role="separator" style="@Style" @attributes="AdditionalAttributes">
        @if (Orientation == DividerOrientation.Center || Orientation == DividerOrientation.Right)
        {
            <span class="@(Orientation == DividerOrientation.Right ? "before:w-full border-t border-slate-300 flex-1 mr-4" : "before:w-1/2 border-t border-slate-300 flex-1 mr-4")"></span>
        }
        else
        {
            <span class="border-t border-slate-300 w-6 mr-4"></span>
        }

        <span class="tento-divider-inner-text text-sm font-medium text-slate-700 dark:text-slate-300">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @Title
            }
        </span>

        @if (Orientation == DividerOrientation.Center || Orientation == DividerOrientation.Left)
        {
            <span class="@(Orientation == DividerOrientation.Left ? "after:w-full border-t border-slate-300 flex-1 ml-4" : "after:w-1/2 border-t border-slate-300 flex-1 ml-4")"></span>
        }
        else
        {
            <span class="border-t border-slate-300 w-6 ml-4"></span>
        }
    </div>
}
else
{
    <div class="@ComputedHorizontalClass" role="separator" style="@Style" @attributes="AdditionalAttributes"></div>
}

@code {
    [Parameter] public DividerType Type { get; set; } = DividerType.Horizontal;
    [Parameter] public DividerOrientation Orientation { get; set; } = DividerOrientation.Center;
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Dashed { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedVerticalClass => new CssBuilder("tento-divider inline-block border-l border-slate-300 h-4 mx-2 align-middle")
        .AddClass("border-dashed", Dashed)
        .AddClass(Class)
        .Build();

    private string ComputedHorizontalClass => new CssBuilder("tento-divider border-t border-slate-300 w-full my-4")
        .AddClass("border-dashed", Dashed)
        .AddClass(Class)
        .Build();

    private string ComputedHorizontalWithTitleClass
    {
        get
        {
            var orientationClass = Orientation switch
            {
                DividerOrientation.Left => "after:w-full",
                DividerOrientation.Right => "before:w-full",
                _ => "before:w-1/2 after:w-1/2"
            };

            return new CssBuilder("tento-divider flex items-center my-4")
                .AddClass(orientationClass)
                .AddClass(Class)
                .Build();
        }
    }
}
