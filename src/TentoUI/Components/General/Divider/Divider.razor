@namespace TentoUI
@inherits TentoComponentBase

@if (Type == DividerType.Vertical)
{
    <div class="@ComputedVerticalClass" role="separator" aria-orientation="vertical" style="@Style" @attributes="AdditionalAttributes"></div>
}
else if (ChildContent != null || !string.IsNullOrEmpty(Title))
{
    <div class="@ComputedHorizontalWithTitleClass" role="separator" aria-orientation="horizontal" style="@Style" @attributes="AdditionalAttributes">
        <div class="@LeftSegmentClass"></div>
        <span class="tento-divider-inner-text shrink-0 px-3 text-sm font-medium text-slate-700 dark:text-slate-300">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @Title
            }
        </span>
        <div class="@RightSegmentClass"></div>
    </div>
}
else
{
    <div class="@ComputedHorizontalClass" role="separator" aria-orientation="horizontal" style="@Style" @attributes="AdditionalAttributes"></div>
}

@code {
    [Parameter] public DividerType Type { get; set; } = DividerType.Horizontal;
    [Parameter] public DividerOrientation Orientation { get; set; } = DividerOrientation.Center;
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Dashed { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedVerticalClass => new CssBuilder("tento-divider inline-block border-l border-slate-300 dark:border-slate-600 h-4 mx-2 align-middle")
        .AddClass("border-dashed", Dashed)
        .AddClass("border-solid", !Dashed)
        .AddClass(Class)
        .Build();

    private string ComputedHorizontalClass => new CssBuilder("tento-divider border-t border-slate-300 dark:border-slate-700 w-full my-4 shrink-0")
        .AddClass("border-dashed", Dashed)
        .AddClass("border-solid", !Dashed)
        .AddClass(Class)
        .Build();

    private string LeftSegmentClass => new CssBuilder("border-t border-slate-300 dark:border-slate-700")
        .AddClass("border-dashed", Dashed)
        .AddClass("border-solid", !Dashed)
        .AddClass("w-8 shrink-0", Orientation == DividerOrientation.Left)
        .AddClass("flex-1", Orientation != DividerOrientation.Left)
        .Build();

    private string RightSegmentClass => new CssBuilder("border-t border-slate-300 dark:border-slate-700")
        .AddClass("border-dashed", Dashed)
        .AddClass("border-solid", !Dashed)
        .AddClass("w-8 shrink-0", Orientation == DividerOrientation.Right)
        .AddClass("flex-1", Orientation != DividerOrientation.Right)
        .Build();

    private string ComputedHorizontalWithTitleClass => new CssBuilder("tento-divider flex items-center w-full my-4")
        .AddClass("before:w-1/2 after:w-1/2", Orientation == DividerOrientation.Center)
        .AddClass("after:w-full", Orientation == DividerOrientation.Left)
        .AddClass("before:w-full", Orientation == DividerOrientation.Right)
        .AddClass(Class)
        .Build();
}
