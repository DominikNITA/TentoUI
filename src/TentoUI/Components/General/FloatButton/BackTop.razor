@namespace TentoUI
@inject IJSRuntime JSRuntime
@inherits TentoComponentBase

<div class="tento-backtop fixed bottom-8 right-8 z-40" style="@Style" @attributes="AdditionalAttributes">
    <button type="button"
            class="@ComputedClass"
            aria-label="Back to top"
            @onclick="ScrollToTopAsync">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            <Icon Name="@IconNames.ArrowUp" Size="18" />
        }
    </button>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task ScrollToTopAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
        }
        catch
        {
            // Fallback in test context where JS is mocked
        }
    }

    private string ComputedClass => new CssBuilder("w-11 h-11 rounded-full bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-700 transition-transform hover:scale-105 active:scale-95")
        .AddClass(Class)
        .Build();
}
