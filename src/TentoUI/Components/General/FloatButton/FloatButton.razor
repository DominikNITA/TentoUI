@namespace TentoUI
@inherits TentoComponentBase

@if (!string.IsNullOrEmpty(Href))
{
    <a href="@Href"
       target="@Target"
       class="@ComputedClass"
       style="@Style"
       aria-label="@(AriaLabel ?? Description ?? "Floating action")"
       @attributes="AdditionalAttributes">
        @RenderContent()
    </a>
}
else
{
    <button type="button"
            class="@ComputedClass"
            style="@Style"
            aria-label="@(AriaLabel ?? Description ?? "Floating action")"
            @onclick="OnClick"
            @attributes="AdditionalAttributes">
        @RenderContent()
    </button>
}

@code {
    [Parameter] public FloatButtonShape Shape { get; set; } = FloatButtonShape.Circle;
    [Parameter] public FloatButtonType Type { get; set; } = FloatButtonType.Default;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? IconTemplate { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private RenderFragment RenderContent() => __builder =>
    {
        if (IconTemplate != null)
        {
            @IconTemplate
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <Icon Name="@Icon" Size="18" />
        }

        if (ChildContent != null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrEmpty(Description))
        {
            <span class="text-[10px] leading-tight font-medium mt-0.5">@Description</span>
        }
    };

    private string ComputedClass
    {
        get
        {
            var shapeClass = Shape == FloatButtonShape.Circle ? "rounded-full" : "rounded-lg";
            var colorClass = Type == FloatButtonType.Primary
                ? "bg-primary-500 hover:bg-primary-600 text-white shadow-primary-500/30"
                : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700";

            return new CssBuilder($"tento-float-button inline-flex flex-col items-center justify-center w-11 h-11 shadow-lg transition-transform hover:scale-105 active:scale-95 {shapeClass} {colorClass}")
                .AddClass(Class)
                .Build();
        }
    }
}
