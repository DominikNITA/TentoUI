@namespace TentoUI
@inherits TentoComponentBase

<span class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    @RenderContent()
</span>

@code {
    [Parameter] public TypographyType Type { get; set; } = TypographyType.Default;
    [Parameter] public bool Strong { get; set; }
    [Parameter] public bool Code { get; set; }
    [Parameter] public bool Mark { get; set; }
    [Parameter] public bool Underline { get; set; }
    [Parameter] public bool Delete { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedClass
    {
        get
        {
            var typeClass = Type switch
            {
                TypographyType.Secondary => "text-slate-500",
                TypographyType.Success => "text-emerald-500",
                TypographyType.Warning => "text-amber-500",
                TypographyType.Danger => "text-red-500",
                _ => "text-slate-900 dark:text-slate-100"
            };

            return new CssBuilder("tento-typography-text")
                .AddClass(typeClass)
                .AddClass("opacity-50 cursor-not-allowed", Disabled)
                .AddClass(Class)
                .Build();
        }
    }

    private RenderFragment RenderContent() => __builder =>
    {
        RenderFragment current = ChildContent ?? (_ => { });

        if (Underline)
        {
            var prev = current;
            current = b =>
            {
                b.OpenElement(0, "u");
                b.AddContent(1, prev);
                b.CloseElement();
            };
        }

        if (Delete)
        {
            var prev = current;
            current = b =>
            {
                b.OpenElement(0, "del");
                b.AddContent(1, prev);
                b.CloseElement();
            };
        }

        if (Mark)
        {
            var prev = current;
            current = b =>
            {
                b.OpenElement(0, "mark");
                b.AddAttribute(1, "class", "bg-yellow-200");
                b.AddContent(2, prev);
                b.CloseElement();
            };
        }

        if (Code)
        {
            var prev = current;
            current = b =>
            {
                b.OpenElement(0, "code");
                b.AddAttribute(1, "class", "bg-slate-100 rounded px-1 text-sm font-mono");
                b.AddContent(2, prev);
                b.CloseElement();
            };
        }

        if (Strong)
        {
            var prev = current;
            current = b =>
            {
                b.OpenElement(0, "strong");
                b.AddContent(1, prev);
                b.CloseElement();
            };
        }

        @current
    };
}
