@namespace TentoUI
@inherits TentoComponentBase

<main class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</main>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ComputedClass => new CssBuilder("tento-content flex-1 p-6 overflow-y-auto min-h-0 bg-transparent text-slate-900 dark:text-slate-100")
        .AddClass(Class)
        .Build();
}
