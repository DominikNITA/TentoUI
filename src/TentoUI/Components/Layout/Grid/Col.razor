@namespace TentoUI
@inherits TentoComponentBase

<div class="@ComputedClass" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private RowContext? RowContext { get; set; }

    [Parameter] public int Span { get; set; } = 24;
    [Parameter] public int Offset { get; set; }
    [Parameter] public int? Order { get; set; }
    [Parameter] public object? Xs { get; set; }
    [Parameter] public object? Sm { get; set; }
    [Parameter] public object? Md { get; set; }
    [Parameter] public object? Lg { get; set; }
    [Parameter] public object? Xl { get; set; }
    [Parameter] public object? Xxl { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string GetWidthClass(int span) => span switch
    {
        24 => "w-full",
        12 => "w-1/2",
        8 => "w-1/3",
        6 => "w-1/4",
        0 => "hidden",
        _ => $"w-[calc(100%*{span}/24)]"
    };

    private static string GetOffsetClass(int offset) => offset switch
    {
        6 => "ml-1/4",
        12 => "ml-1/2",
        8 => "ml-1/3",
        0 => "",
        _ => $"ml-[calc(100%*{offset}/24)]"
    };

    private static string GetBreakpointClass(string prefix, object? val)
    {
        if (val == null) return "";
        int span = val is int s ? s : (val is ColSpanSettings cs ? cs.Span ?? 0 : 0);
        return span switch
        {
            24 => $"{prefix}:w-full",
            12 => $"{prefix}:w-1/2",
            8 => $"{prefix}:w-1/3",
            6 => $"{prefix}:w-1/4",
            _ => $"{prefix}:w-[calc(100%*{span}/24)]"
        };
    }

    private string ComputedClass
    {
        get
        {
            var width = GetWidthClass(Span);
            var offset = GetOffsetClass(Offset);
            var padding = (RowContext != null && RowContext.HorizontalGutter > 0)
                ? $"px-{RowContext.HorizontalGutter / 2}"
                : "";

            return new CssBuilder("tento-col")
                .AddClass(width)
                .AddClass(offset)
                .AddClass(padding)
                .AddClass(GetBreakpointClass("xs", Xs))
                .AddClass(GetBreakpointClass("sm", Sm))
                .AddClass(GetBreakpointClass("md", Md))
                .AddClass(GetBreakpointClass("lg", Lg))
                .AddClass(GetBreakpointClass("xl", Xl))
                .AddClass(GetBreakpointClass("2xl", Xxl))
                .AddClass(Class)
                .Build();
        }
    }
}
