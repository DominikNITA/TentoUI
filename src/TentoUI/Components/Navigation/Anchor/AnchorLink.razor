@namespace TentoUI
@inherits TentoComponentBase

<li class="tento-anchor-link">
    <a href="@Href"
       class="@ComputeLinkClass(IsActive)"
       @onclick="HandleClickAsync">
        @if (TitleTemplate != null)
        {
            @TitleTemplate
        }
        else
        {
            <span>@Title</span>
        }
    </a>

    @if (ChildContent != null)
    {
        <ul class="space-y-1.5 pl-3 mt-1.5">
            @ChildContent
        </ul>
    }
</li>

@code {
    [CascadingParameter] protected Anchor? ParentAnchor { get; set; }

    [Parameter] public string Href { get; set; } = "#";
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleTemplate { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsActive => ParentAnchor?.CurrentActiveHref == Href;

    private async Task HandleClickAsync()
    {
        if (ParentAnchor != null)
        {
            await ParentAnchor.SetActiveAsync(Href);
        }
    }

    private static string ComputeLinkClass(bool isActive)
    {
        return new CssBuilder("block truncate transition-colors py-0.5")
            .AddClass("text-primary-600 dark:text-primary-400 font-semibold", isActive)
            .AddClass("text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200", !isActive)
            .Build();
    }
}
