@namespace TentoUI
@inherits TentoComponentBase
@using TentoUI.Extensibility
@using Microsoft.AspNetCore.Components.Web

<div class="@CssClass"
     style="@Style"
     @oncontextmenu="HandleContextMenuAsync"
     @oncontextmenu:preventDefault="true"
     @attributes="AdditionalAttributes">
    @ChildContent

    @if (IsOpen)
    {
        <div class="fixed inset-0 z-40"
             @onclick="CloseAsync"
             @oncontextmenu="HandleBackdropContextMenuAsync"
             @oncontextmenu:preventDefault="true"></div>
        <div role="menu"
             tabindex="-1"
             aria-label="@AriaLabel"
             style="@($"left: {_x}px; top: {_y}px;")"
             @onkeydown="HandleKeyDownAsync"
             class="tento-context-menu fixed z-50 min-w-[12rem] py-1 rounded-lg shadow-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 focus:outline-none">
            @if (Overlay != null)
            {
                @Overlay
            }
            else if (Items != null)
            {
                @foreach (var item in Items)
                {
                    @if (item.DividerBefore)
                    {
                        <div role="separator" class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
                    }
                    <button type="button"
                            role="menuitem"
                            disabled="@item.Disabled"
                            data-menu-key="@item.Key"
                            @onclick="() => HandleItemClickAsync(item)"
                            class="@GetItemClass(item)">
                        <span class="flex items-center gap-2">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <Icon Name="@item.Icon" Size="14" />
                            }
                            <span>@item.Label</span>
                        </span>
                        @if (!string.IsNullOrEmpty(item.Shortcut))
                        {
                            <span class="text-[11px] font-mono text-slate-400 dark:text-slate-500 ml-4">@item.Shortcut</span>
                        }
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, Since("1.0.0")] public RenderFragment? Overlay { get; set; }
    [Parameter, Since("1.0.0")] public IEnumerable<DropdownMenuItem>? Items { get; set; }
    [Parameter, Since("1.0.0")] public string AriaLabel { get; set; } = "Context menu";
    [Parameter, Since("1.0.0")] public bool Disabled { get; set; }
    [Parameter, Since("1.0.0")] public EventCallback<string> OnItemClick { get; set; }
    [Parameter, Since("1.0.0")] public EventCallback<bool> OnOpenChange { get; set; }

    public bool IsOpen { get; private set; }

    private double _x = 24;
    private double _y = 24;

    private string CssClass => new CssBuilder("tento-context-menu-trigger relative")
        .AddClass(Class)
        .Build();

    private static string GetItemClass(DropdownMenuItem item) =>
        new CssBuilder("tento-context-menu-item w-full text-left px-3 py-1.5 text-sm flex items-center justify-between gap-2 border-0 outline-none rounded-none transition-colors")
            .AddClass("text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30", item.Danger && !item.Disabled)
            .AddClass("text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800", !item.Danger && !item.Disabled)
            .AddClass("opacity-50 cursor-not-allowed text-slate-400 dark:text-slate-600", item.Disabled)
            .Build();

    private async Task HandleContextMenuAsync(MouseEventArgs e)
    {
        if (Disabled) return;

        _x = e.ClientX > 0 ? e.ClientX : (e.OffsetX > 0 ? e.OffsetX : 24);
        _y = e.ClientY > 0 ? e.ClientY : (e.OffsetY > 0 ? e.OffsetY : 24);
        IsOpen = true;
        await OnOpenChange.InvokeAsync(true);
    }

    private async Task HandleBackdropContextMenuAsync(MouseEventArgs e)
    {
        // Right-clicking while open repositions the context menu to the new cursor coordinates
        _x = e.ClientX > 0 ? e.ClientX : 24;
        _y = e.ClientY > 0 ? e.ClientY : 24;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task HandleItemClickAsync(DropdownMenuItem item)
    {
        if (item.Disabled) return;

        if (OnItemClick.HasDelegate)
        {
            await OnItemClick.InvokeAsync(item.Key);
        }

        await CloseAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    public async Task CloseAsync()
    {
        if (!IsOpen) return;
        IsOpen = false;
        await OnOpenChange.InvokeAsync(false);
    }
}
