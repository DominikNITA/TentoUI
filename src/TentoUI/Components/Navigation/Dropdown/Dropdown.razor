@namespace TentoUI
@inherits TentoComponentBase

<div class="@ComputedWrapperClass"
     style="@Style"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @attributes="AdditionalAttributes">
    
    <div class="tento-dropdown-trigger inline-flex items-center"
         aria-haspopup="menu"
         aria-expanded="@(IsOpen ? "true" : "false")"
         @onclick="HandleTriggerClickAsync">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrEmpty(Text))
        {
            <Button Disabled="@Disabled" Size="@Size">
                <span class="inline-flex items-center gap-1">
                    <span>@Text</span>
                    <Icon Name="@IconNames.ChevronDown" Size="14" />
                </span>
            </Button>
        }
    </div>

    @if (IsOpen && !Disabled)
    {
        <div role="menu"
             class="@ComputedOverlayClass">
            @if (Overlay != null)
            {
                @Overlay
            }
            else if (Items != null)
            {
                @foreach (var item in Items)
                {
                    if (item.DividerBefore)
                    {
                        <div class="my-1 border-t border-slate-200 dark:border-slate-700" role="separator"></div>
                    }
                    <button type="button"
                            role="menuitem"
                            disabled="@item.Disabled"
                            data-menu-key="@item.Key"
                            class="@ComputeMenuItemClass(item)"
                            @onclick="@(() => HandleItemClickAsync(item))">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <Icon Name="@item.Icon" Size="14" />
                        }
                        <span>@item.Label</span>
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Overlay { get; set; }
    [Parameter] public IEnumerable<DropdownMenuItem>? Items { get; set; }
    [Parameter] public DropdownTrigger Trigger { get; set; } = DropdownTrigger.Click;
    [Parameter] public DropdownPlacement Placement { get; set; } = DropdownPlacement.BottomLeft;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnItemClick { get; set; }
    [Parameter] public ComponentSize? Size { get; set; }

    private bool _internalOpen;
    private bool IsOpen => OpenChanged.HasDelegate ? Open : (_internalOpen || Open);

    private async Task SetOpenAsync(bool value)
    {
        if (Disabled) return;
        _internalOpen = value;
        Open = value;
        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(value);
        }
    }

    private async Task HandleTriggerClickAsync()
    {
        if (Disabled) return;
        if (Trigger == DropdownTrigger.Click)
        {
            await SetOpenAsync(!IsOpen);
        }
    }

    private async Task HandleMouseEnter()
    {
        if (Trigger == DropdownTrigger.Hover && !Disabled)
        {
            await SetOpenAsync(true);
        }
    }

    private async Task HandleMouseLeave()
    {
        if (Trigger == DropdownTrigger.Hover && !Disabled)
        {
            await SetOpenAsync(false);
        }
    }

    private async Task HandleItemClickAsync(DropdownMenuItem item)
    {
        if (item.Disabled) return;
        if (OnItemClick.HasDelegate)
        {
            await OnItemClick.InvokeAsync(item.Key);
        }
        await SetOpenAsync(false);
    }

    private string ComputedWrapperClass => new CssBuilder("tento-dropdown relative inline-block text-left")
        .AddClass(Class)
        .Build();

    private string ComputedOverlayClass
    {
        get
        {
            var pos = Placement switch
            {
                DropdownPlacement.BottomRight => "top-full right-0 mt-1",
                DropdownPlacement.BottomCenter => "top-full left-1/2 -translate-x-1/2 mt-1",
                DropdownPlacement.TopLeft => "bottom-full left-0 mb-1",
                DropdownPlacement.TopRight => "bottom-full right-0 mb-1",
                DropdownPlacement.TopCenter => "bottom-full left-1/2 -translate-x-1/2 mb-1",
                _ => "top-full left-0 mt-1"
            };

            return $"tento-dropdown-menu absolute z-40 min-w-[10rem] py-1 rounded-md shadow-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none {pos}";
        }
    }

    private string ComputeMenuItemClass(DropdownMenuItem item)
    {
        return new CssBuilder("tento-dropdown-item w-full px-3 py-2 text-xs flex items-center gap-2 text-left transition-colors")
            .AddClass("text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30", item.Danger && !item.Disabled)
            .AddClass("text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60", !item.Danger && !item.Disabled)
            .AddClass("opacity-40 cursor-not-allowed text-slate-400", item.Disabled)
            .Build();
    }
}
