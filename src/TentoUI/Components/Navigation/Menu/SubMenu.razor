@namespace TentoUI
@inherits TentoComponentBase

<div class="@ComputedClass"
     aria-haspopup="true"
     aria-expanded="@(IsOpen ? "true" : "false")"
     style="@Style"
     @onclick="ToggleOpen"
     @attributes="AdditionalAttributes">
    <div class="tento-submenu-title flex items-center justify-between px-4 py-2 cursor-pointer text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
        <div class="flex items-center gap-2">
            @if (Icon != null)
            {
                <span class="inline-flex items-center">@Icon</span>
            }
            <span>
                @if (TitleTemplate != null)
                {
                    @TitleTemplate
                }
                else
                {
                    @Title
                }
            </span>
        </div>
        <Icon Name="@IconNames.ChevronDown" Size="14" Class="@($"transition-transform duration-200 {(IsOpen ? "rotate-180" : "")}")" />
    </div>

    @if (IsOpen)
    {
        <div class="pl-4 border-l border-slate-100 dark:border-slate-800 space-y-0.5" @onclick:stopPropagation="true">
            @ChildContent
        </div>
    }
</div>

@code {
    [CascadingParameter] private MenuContext? MenuContext { get; set; }

    [Parameter] public string Key { get; set; } = $"submenu-{Guid.NewGuid():N}";
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? TitleTemplate { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsOpen => MenuContext?.IsOpen(Key) ?? false;

    private void ToggleOpen()
    {
        MenuContext?.ToggleOpenKey(Key);
    }

    private string ComputedClass => new CssBuilder("tento-submenu")
        .AddClass(Class)
        .Build();
}
