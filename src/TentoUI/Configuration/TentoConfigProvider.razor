@namespace TentoUI
@using TentoUI.Configuration
@using TentoUI.Extensibility
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<CascadingValue Value="@ConfigContext" IsFixed="false">
    <div class="@ComputedClass"
         style="@ComputedStyle"
         data-theme="@(EffectiveDarkMode ? "dark" : "light")"
         dir="@(Direction == Direction.Rtl ? "rtl" : "ltr")"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Inject] private IServiceProvider? ServiceProvider { get; set; }

    [Parameter] public TentoTheme? Theme { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public bool SyncBodyTheme { get; set; }
    [Parameter] public bool InheritFontFamily { get; set; }
    [Parameter] public ComponentSize ComponentSize { get; set; } = ComponentSize.Middle;
    [Parameter] public Direction Direction { get; set; } = Direction.Ltr;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private TentoTheme? _injectedTheme;
    private static readonly TentoTheme _defaultTheme = new();
    private bool? _lastSyncedDark;

    private TentoTheme ActiveTheme => Theme ?? _injectedTheme ?? _defaultTheme;
    private bool EffectiveDarkMode => DarkMode || (ActiveTheme?.DarkMode ?? false);

    public TentoConfigContext ConfigContext => new(ActiveTheme, EffectiveDarkMode, ComponentSize, Direction);

    protected override void OnInitialized()
    {
        _injectedTheme = ServiceProvider?.GetService<TentoTheme>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SyncBodyTheme && _lastSyncedDark != EffectiveDarkMode)
        {
            _lastSyncedDark = EffectiveDarkMode;
            try
            {
                await JSRuntime.InvokeVoidAsync("tentoTheme.sync", EffectiveDarkMode);
            }
            catch { }
        }
    }

    private string ComputedClass => new CssBuilder("tento-config-provider")
        .AddClass("font-sans", !InheritFontFamily && string.IsNullOrEmpty(ActiveTheme.FontFamily))
        .AddClass("dark", EffectiveDarkMode)
        .AddClass(Class)
        .Build();

    private string ComputedStyle => new StyleBuilder()
        .AddStyle(ActiveTheme.ToCssStyle(EffectiveDarkMode))
        .AddStyle(Style)
        .Build();
}
